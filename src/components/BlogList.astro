---
// Blog listing in the live site's "basic grid" style: two columns on desktop, one on phones,
// 3:2 photo, category and date, centred title, "Read More". Used by /blog, its paged
// continuation, and the category and tag pages.
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  newer?: string; // link to newer posts, if any
  older?: string; // link to older posts, if any
  heading?: string;
}
const { posts, newer, older, heading } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-NZ', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Pacific/Auckland' });
---
<section class="blog-list">
  {heading && <h1>{heading}</h1>}
  <ul class="grid">
    {posts.map((p, i) => {
      const href = `/blog/${p.id}`;
      const img = p.data.thumbnail ?? p.data.gallery[0]?.src;
      return (
        <li>
          {img && (
            <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
              <Img src={img} alt="" sizes="(min-width: 768px) 44vw, 88vw" loading={i < 2 ? 'eager' : 'lazy'} />
            </a>
          )}
          <p class="meta">
            {p.data.categories.map((c) => <a href={`/blog/category/${encodeURIComponent(c)}`}>{c}</a>)}
            {p.data.categories.length > 0 && <span aria-hidden="true"> • </span>}
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          </p>
          <h2><a href={href}>{p.data.title}</a></h2>
          <a class="more" href={href} aria-label={`Read more: ${p.data.title}`}>Read More</a>
        </li>
      );
    })}
  </ul>
  {(newer || older) && (
    <nav class="pages" aria-label="More posts">
      {newer ? <a href={newer}>Newer Posts</a> : <span />}
      {older ? <a href={older}>Older Posts</a> : <span />}
    </nav>
  )}
</section>

<style>
  .blog-list { padding: 15px var(--pad) 60px; }
  .blog-list > h1 { margin: 20px 0 40px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 30px; }
  li { text-align: center; }
  .thumb { display: block; }
  .thumb :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .meta { margin: 20px 0 7px; font-size: var(--fs-body); color: var(--green); }
  .meta a { color: inherit; text-decoration: none; }
  h2 {
    margin: 0 0 30px;
    font-size: calc(21.72px + 0.493vw); /* 23.6px on phones → 28.8px at 1440 */
    line-height: 1.5;
    font-weight: 400;
  }
  h2 a { color: var(--green); text-decoration: none; }
  h2 a:hover { opacity: 0.8; }
  .more { font-size: 15px; line-height: 24px; color: var(--green); }
  .pages { display: flex; justify-content: space-between; margin-top: 50px; }
  .pages a { color: var(--black); text-decoration: none; }
  .pages a:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .blog-list { padding: 58px var(--pad) 100px; }
    .grid { grid-template-columns: 1fr 1fr; column-gap: 50px; row-gap: 55px; }
    .meta { margin: 30px 0 14px; }
    h2 { margin-bottom: 31px; }
  }
</style>

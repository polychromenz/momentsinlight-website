---
// The blog list in the refreshed design, used by /blog, its later pages, and the category and
// tag pages: a heading that rises in, filter buttons, story cards (cover cropped around the
// post's "Cover photo position", the same hover as the gallery pages), page buttons and a
// closing band. A search box above the cards searches every post (or just the category's).
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import BlogSearch from './BlogSearch.astro';
import { coverPosition, coverAlt, storyName } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  newer?: string; // link to newer posts, if any
  older?: string; // link to older posts, if any
  heading?: string;
  eyebrow?: string;
  /** Which filter button is current: 'all' or a category. */
  active?: string;
  page?: { n: number; of: number };
}
const { posts, newer, older, heading = 'Love stories & wedding planning', eyebrow = 'Journal', active = '', page } = Astro.props;

const filters = [
  { key: 'all', label: 'All', href: '/blog' },
  { key: 'Wedding', label: 'Love stories', href: '/blog/category/Wedding' },
  { key: 'Portrait', label: 'Portraits', href: '/blog/category/Portrait' },
  { key: 'Family', label: 'Family', href: '/blog/category/Family' },
  { key: 'Info', label: 'Wedding planning', href: '/blog/category/Info' },
];
const kindLabel = (c: string[]) => (c.includes('Wedding') ? 'Love story' : c.includes('Portrait') ? 'Portrait session' : c.includes('Family') ? 'Family session' : 'Wedding planning');
const month = (d: Date) => d.toLocaleDateString('en-NZ', { month: 'long', year: 'numeric', timeZone: 'Pacific/Auckland' });
---
<header class="intro wrap">
  <p class="eyebrow rise">{eyebrow}</p>
  <h1 class="display rise">{heading}</h1>
  <hr class="hairline rise" />
  <nav class="filters rise" aria-label="Show">
    {filters.map((f) => <a href={f.href} class:list={{ on: f.key === active }} aria-current={f.key === active ? 'page' : undefined}>{f.label}</a>)}
  </nav>
</header>

<section class="list wrap">
  <BlogSearch categories={active && active !== 'all' ? [active] : []}>
  <ul class="cards">
    {posts.map((p, i) => {
      const href = `/blog/${p.id}`;
      const img = p.data.thumbnail ?? p.data.gallery[0]?.src;
      const wedding = p.data.categories.includes('Wedding');
      const { name, place } = wedding ? storyName(p.data.title) : { name: p.data.title, place: '' };
      return (
        <li data-reveal="photo" style={`--d:${(i % 3) * 0.12}s`}>
          <a class="card" href={href}>
            <span class="frame">
              {img && (
                <Img src={img} alt={coverAlt(p.data)} sizes="(min-width: 1100px) 31vw, (min-width: 640px) 46vw, 90vw" loading={i < 3 ? 'eager' : 'lazy'}
                  style={`object-position:${coverPosition(p.data.thumbnailPosition) ?? '50% 50%'}`} />
              )}
              <span class="shade" aria-hidden="true"><span>{wedding ? 'View love story' : 'Read more'} <span class="arrow">→</span></span></span>
            </span>
            <span class="meta">{kindLabel(p.data.categories)} · <time datetime={p.data.date.toISOString()}>{month(p.data.date)}</time></span>
            <span class="name">{name}</span>
            {place && <span class="place">{place}</span>}
          </a>
        </li>
      );
    })}
  </ul>

  {(newer || older) && (
    <nav class="pages" aria-label="More posts">
      {newer ? <a class="btn btn--outline" href={newer}>← Newer posts</a> : <span />}
      {page && <span class="page-n">Page {page.n} of {page.of}</span>}
      {older ? <a class="btn" href={older}>Older posts →</a> : <span />}
    </nav>
  )}
  </BlogSearch>
</section>

<section class="closing">
  <div class="wrap" data-reveal>
    <h2 class="display">Is your date still free?</h2>
    <p>Tell me your date and venue, and I’ll let you know.</p>
    <p><a class="btn btn--light" href="/contact">Check your date</a></p>
  </div>
</section>

<style>
  .intro { max-width: calc(860px + 2 * var(--pad)); margin: 0 auto; padding-block: 64px 32px; text-align: center; }
  .intro h1 { font-size: clamp(34px, 3vw + 18px, 62px); margin: 0 0 24px; padding: 0; }
  .rise { animation: rise 1.3s var(--ease) both; }
  .rise:nth-child(2) { animation-delay: 0.1s; }
  .rise:nth-child(3) { animation-delay: 0.2s; }
  .rise:nth-child(4) { animation-delay: 0.3s; }
  hr.rise { animation-name: draw; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes draw { from { transform: scaleX(0); } to { transform: none; } }

  .filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .filters a { padding: 9px 18px; border: 1px solid #ddd3c4; border-radius: 12px 0; font-size: 14px; color: #444; text-decoration: none; background: var(--white); transition: border-radius 0.5s var(--ease), background-color 0.4s var(--ease), color 0.4s var(--ease); }
  .filters a:hover { opacity: 1; border-radius: 0 12px; border-color: var(--green); color: var(--green); }
  .filters a.on { background: var(--green); border-color: var(--green); color: var(--white); }

  .list { max-width: calc(1280px + 2 * var(--pad)); margin: 0 auto; padding-block: 24px 90px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 44px 28px; grid-template-columns: minmax(0, 1fr); }
  .card { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .frame {
    position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 2;
    border-radius: 32px 0; background: var(--champagne); transform: translateZ(0);
    transition: border-radius 0.8s var(--ease), box-shadow 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.6s var(--ease), filter 1.2s var(--ease); }
  .shade {
    position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 22px;
    background: linear-gradient(180deg, rgb(62 66 41 / 0) 45%, rgb(62 66 41 / 0.65) 100%);
    color: var(--champagne); font-size: 13px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase;
    opacity: 0; transition: opacity 0.6s var(--ease);
  }
  .shade > span { transform: translateY(14px); transition: transform 0.8s var(--ease); }
  .arrow { display: inline-block; transition: transform 0.8s var(--ease); }
  .meta { margin-top: 18px; font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); }
  .name { position: relative; align-self: flex-start; margin-top: 8px; font-size: 22px; font-weight: 300; line-height: 1.3; }
  .name::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: var(--sage); transform: scaleX(0); transform-origin: left; transition: transform 0.8s var(--ease); }
  .place { margin-top: 8px; font-size: 14px; letter-spacing: 0.04em; color: #666; }
  .card:hover, .card:focus-visible { opacity: 1; }
  .card:focus-visible { outline: none; }
  .card:focus-visible .frame { outline: 2px solid var(--green); outline-offset: 4px; }
  .card:is(:hover, :focus-visible) .frame { border-radius: 0 32px; transform: translateY(-4px); box-shadow: 0 22px 36px -26px rgb(0 0 0 / 0.55); }
  .card:is(:hover, :focus-visible) .frame :global(img) { transform: scale(1.06); filter: saturate(1.05); }
  .card:is(:hover, :focus-visible) .shade { opacity: 1; }
  .card:is(:hover, :focus-visible) .shade > span { transform: none; }
  .card:is(:hover, :focus-visible) .arrow { transform: translateX(5px); }
  .card:is(:hover, :focus-visible) .name::after { transform: scaleX(1); }

  .pages { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 64px; }
  .page-n { font-size: 14px; color: #777; letter-spacing: 0.06em; }

  .closing { background: var(--olive); color: var(--cream); padding-block: 88px; text-align: center; }
  .closing h2 { color: var(--champagne); font-size: clamp(30px, 2.4vw + 18px, 54px); margin: 0 0 16px; }
  .closing .btn { margin-top: 16px; }

  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 768px) {
    .intro { padding-block: 110px 40px; }
    .list { padding-bottom: 130px; }
    .closing { padding-block: 120px; }
  }
  @media (min-width: 1100px) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .frame, .frame :global(img), .shade, .shade > span, .arrow, .name::after { transition: none; }
    .card:is(:hover, :focus-visible) .frame, .card:is(:hover, :focus-visible) .frame :global(img) { transform: none; }
  }
</style>

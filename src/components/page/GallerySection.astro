---
// A Squarespace gallery section (masonry, slideshow, reel or grid) rebuilt from imported data.
// Reels use the same fading slideshow as the Weddings page, at the same height.
// Column counts, gaps and heights are the live site's at 390px and 1440px.
import Img from '../Img.astro';
import Slideshow from '../Slideshow.astro';

// first: the page's first section (its first photos load straight away); priority: its first
// photo is the page's main one.
interface Props { section: any; cls: string; subject?: string; first?: boolean; priority?: boolean }
const { section: s, cls, subject, first = false, priority = false } = Astro.props;
const load = (n: number) => (first && n < 4 ? 'eager' : 'lazy') as 'eager' | 'lazy';
const L = s.layout;
const design: string = s.design === 'fullscreen-slideshow' || s.design === 'reel' ? 'slideshow' : s.design;
const isReel = s.design === 'reel';
const alt = (i: any, n: number) => {
  const a = (i.alt || '').replace(/\.(jpe?g|png|gif|webp)$/i, '');
  return /^[_A-Z0-9 -]+$/i.test(a) && /\d/.test(a) ? (subject ? `${subject} – photo ${n + 1}` : '') : a;
};
const vw = (px: number, w: number) => `${Math.round((px / w) * 10000) / 100}vw`;
// Slideshows position photos with transforms, so measured gaps can be nonsense;
// keep them within a sensible range.
const gapOf = (g: number | undefined, fallback: number) => (g != null && g >= 0 && g <= 60 ? g : fallback);
L.m.gap = gapOf(L.m.gap, design === 'masonry' ? 3 : 2);
L.d.gap = gapOf(L.d.gap, design === 'masonry' ? 13 : 2);
const css =
  `.${cls}{--cols:${L.m.columns || 2};--gap:${L.m.gap || 3}px;--h:${vw(L.m.itemH || L.m.rect?.[2] || 300, 390)};}` +
  `@media (min-width:768px){.${cls}{--cols:${L.d.columns || 3};--gap:${L.d.gap || 13}px;--h:${vw(L.d.itemH || L.d.rect?.[2] || 600, 1440)};}}`;
---
{design === 'masonry' && (
  <ul class="g masonry">
    {s.images.map((i: any, n: number) => (
      <li>{i.href ? <a href={i.href}><Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 46vw, 44vw" loading={load(n)} priority={priority && n === 0} /></a> : <Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 46vw, 44vw" loading={load(n)} priority={priority && n === 0} />}</li>
    ))}
  </ul>
)}
{design === 'grid' && (
  <ul class="g grid">
    {s.images.map((i: any, n: number) => (
      <li><Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 30vw, 45vw" loading={load(n)} priority={priority && n === 0} /></li>
    ))}
  </ul>
)}
{design === 'slideshow' && (
  <div class:list={{ reel: isReel }}>
  <Slideshow
    label="Photo gallery"
    heightMobile={isReel ? '30vh' : vw(L.m.itemH || L.m.rect?.[2] || 300, 390)}
    heightDesktop={isReel ? '50vh' : vw(L.d.itemH || L.d.rect?.[2] || 600, 1440)}
    interval={5}
    first={priority}
    images={s.images.map((i: any, n: number) => ({ src: i.src, alt: alt(i, n), width: i.width, height: i.height }))}
  />
  </div>
)}
<style is:inline set:html={css}></style>

<style>
  .g { list-style: none; margin: 0; padding: 0 var(--pad); }
  .masonry { columns: var(--cols); column-gap: var(--gap); }
  .masonry li { break-inside: avoid; margin-bottom: var(--gap); }
  .masonry :global(img), .grid :global(img) { width: 100%; height: auto; }
  .grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--gap); }
  /* Space between a reel and the sections above and below it, as on the Weddings page. */
  .reel { padding-block: clamp(24px, 3vw, 44px); }
</style>

---
// A Squarespace gallery section (masonry, slideshow, reel or grid) rebuilt from imported data.
// Column counts, gaps and heights are the live site's at 390px and 1440px.
import Img from '../Img.astro';
import Slideshow from '../Slideshow.astro';

interface Props { section: any; cls: string; subject?: string }
const { section: s, cls, subject } = Astro.props;
const L = s.layout;
const design: string = s.design === 'fullscreen-slideshow' ? 'slideshow' : s.design;
const alt = (i: any, n: number) => {
  const a = (i.alt || '').replace(/\.(jpe?g|png|gif|webp)$/i, '');
  return /^[_A-Z0-9 -]+$/i.test(a) && /\d/.test(a) ? (subject ? `${subject} – photo ${n + 1}` : '') : a;
};
const vw = (px: number, w: number) => `${Math.round((px / w) * 10000) / 100}vw`;
// Slideshows and reels position photos with transforms, so measured gaps can be nonsense;
// keep them within a sensible range.
const gapOf = (g: number | undefined, fallback: number) => (g != null && g >= 0 && g <= 60 ? g : fallback);
L.m.gap = gapOf(L.m.gap, design === 'masonry' ? 3 : 2);
L.d.gap = gapOf(L.d.gap, design === 'masonry' ? 13 : 2);
const css =
  `.${cls}{--cols:${L.m.columns || 2};--gap:${L.m.gap || 3}px;--h:${vw(L.m.itemH || L.m.rect?.[2] || 300, 390)};}` +
  `@media (min-width:768px){.${cls}{--cols:${L.d.columns || 3};--gap:${L.d.gap || 13}px;--h:${vw(L.d.itemH || L.d.rect?.[2] || 600, 1440)};}}`;
---
{design === 'masonry' && (
  <ul class="g masonry">
    {s.images.map((i: any, n: number) => (
      <li>{i.href ? <a href={i.href}><Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 46vw, 44vw" /></a> : <Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 46vw, 44vw" />}</li>
    ))}
  </ul>
)}
{design === 'grid' && (
  <ul class="g grid">
    {s.images.map((i: any, n: number) => (
      <li><Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 30vw, 45vw" /></li>
    ))}
  </ul>
)}
{design === 'slideshow' && (
  <Slideshow
    label="Photo gallery"
    heightMobile={vw(L.m.itemH || L.m.rect?.[2] || 300, 390)}
    heightDesktop={vw(L.d.itemH || L.d.rect?.[2] || 600, 1440)}
    interval={5}
    images={s.images.map((i: any, n: number) => ({ src: i.src, alt: alt(i, n), width: i.width, height: i.height }))}
  />
)}
{design === 'reel' && (
  <div class:list={['g', 'scroller', design]} aria-roledescription="carousel" aria-label="Photo gallery">
    <ul class="track" tabindex="0">
      {s.images.map((i: any, n: number) => (
        <li class="slide"><Img src={i.src} alt={alt(i, n)} width={i.width} height={i.height} sizes="(min-width: 768px) 50vw, 90vw" /></li>
      ))}
    </ul>
    <button class="arrow prev" aria-label="Previous photo" hidden><svg viewBox="0 0 12 24" aria-hidden="true"><path d="M10 2 2 12l8 10" /></svg></button>
    <button class="arrow next" aria-label="Next photo" hidden><svg viewBox="0 0 12 24" aria-hidden="true"><path d="m2 2 8 10-8 10" /></svg></button>
  </div>
)}
<style is:inline set:html={css}></style>

<script>
  // Arrow buttons for slideshows and reels (scrolling also works by swipe, trackpad or keyboard).
  document.querySelectorAll<HTMLElement>('.scroller').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const go = (dir: number) => {
      const x = track.scrollLeft;
      const t = dir > 0 ? slides.find((s) => s.offsetLeft > x + 2) : [...slides].reverse().find((s) => s.offsetLeft < x - 2);
      if (t) track.scrollTo({ left: t.offsetLeft, behavior: smooth });
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.hidden = max < 2 || track.scrollLeft <= 2;
      next.hidden = max < 2 || track.scrollLeft >= max - 2;
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>

<style>
  .g { list-style: none; margin: 0; padding: 0 var(--pad); }
  .masonry { columns: var(--cols); column-gap: var(--gap); }
  .masonry li { break-inside: avoid; margin-bottom: var(--gap); }
  .masonry :global(img), .grid :global(img) { width: 100%; height: auto; }
  .grid { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--gap); }

  .scroller { position: relative; padding: 0; }
  .track {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    position: relative;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: none; scroll-snap-align: start; }
  .reel .slide :global(img) { height: var(--h); width: auto; max-width: none; }
  .reel .track { padding-inline: var(--pad); scroll-padding-inline: var(--pad); }
  .slideshow .slide { width: 100%; height: var(--h); }
  .slideshow .slide :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    cursor: pointer;
  }
  .arrow[hidden] { display: none; }
  .arrow svg { width: 10px; height: 20px; fill: none; stroke: var(--black); stroke-width: 1.5; }
  .prev { left: 12px; }
  .next { right: 12px; }
</style>

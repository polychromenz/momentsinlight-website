---
// A Squarespace "summary" block: a list of blog posts (e.g. the wedding galleries page).
// When the block has a `filter`, the list is built from the blog at build time, newest
// first: posts in any of `filter.categories`, or with `filter.tag`, up to `filter.limit`.
// So ticking a category in Pages CMS adds a post to the matching gallery page, and
// unticking it removes it. Without a filter, the posts the live block showed are used.
// Columns come from the live layout and are set per breakpoint by FluidSection (--cols).
import { getCollection } from 'astro:content';
import Img from '../Img.astro';
import { coverPosition, isLive } from '../../lib/blog';

interface Props { block: any }
const { block: b } = Astro.props;

let items: any[] = b.items ?? [];
if (b.filter) {
  const { categories, tag, limit } = b.filter as { categories?: string[]; tag?: string; limit?: number };
  const posts = (await getCollection('blog', isLive))
    .filter((p) =>
      (categories ? p.data.categories.some((c) => categories.includes(c)) : true) &&
      (tag ? p.data.tags.includes(tag) : true),
    )
    .sort((a, c) => c.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, limit ?? Infinity);
  items = posts.map((p) => ({
    href: `/blog/${p.id}`,
    title: p.data.title,
    thumb: { src: p.data.thumbnail ?? p.data.gallery[0]?.src, position: coverPosition(p.data.thumbnailPosition) },
  }));
}
const ratio = b.thumbRatio ? `100 / ${b.thumbRatio}` : '3 / 2';
const ts = b.titleStyle;
---
<div class="summary" style={`text-align:${b.textAlign}`}>
  {b.header && <h3 class="heading">{b.header}</h3>}
  <ul>
    {items.filter((i: any) => i.href).map((i: any) => (
      <li>
        {i.thumb?.src && (
          <a class="thumb" href={i.href} tabindex="-1" aria-hidden="true">
            <Img src={i.thumb.src} alt="" sizes="(min-width: 768px) 45vw, 90vw" style={`aspect-ratio:${ratio};object-position:${i.thumb.position ?? '50% 50%'}`} />
          </a>
        )}
        <a
          class="title"
          href={i.href}
          style={ts ? `font-size:${ts.fontSize};color:${ts.color};font-weight:${ts.fontWeight};line-height:${ts.lineHeight}` : undefined}
        >{i.title}</a>
        {i.metaText && <p class="meta">{i.metaText}</p>}
        {i.excerpt && <p class="excerpt">{i.excerpt}</p>}
        {b.showMore !== false && <a class="more" href={i.href} aria-hidden="true" tabindex="-1">Read more →</a>}
      </li>
    ))}
  </ul>
</div>

<style>
  .summary ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    column-gap: 1.5%;
    row-gap: 30px;
  }
  .thumb { display: block; margin-bottom: 15px; }
  .thumb :global(img) { width: 100%; height: auto; object-fit: cover; }
  .title { display: block; text-decoration: none; color: var(--green); font-size: 20px; line-height: 1.2; }
  .title:hover { opacity: 0.8; }
  .excerpt { margin: 8px 0 0; font-size: 15px; }
  .meta { margin: 6px 0 0; font-size: 14px; }
  .more { display: inline-block; margin-top: 10px; font-size: 14px; line-height: 20px; text-decoration: none; color: var(--green); }
</style>

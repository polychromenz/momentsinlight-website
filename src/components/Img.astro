---
// Responsive image: a srcset from Cloudflare Images' or Squarespace's resizing (see
// src/lib/images.mjs), so each device downloads the smallest size that looks sharp.
import { responsive } from '../lib/images.mjs';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
  /** Leave the photo unloaded (data-src/data-srcset) until a script sets it, e.g. slideshow
   * photos stacked out of sight, which the browser would otherwise all fetch at once. */
  deferred?: boolean;
  /** The page's main photo (usually the first one on screen): fetched before everything else. */
  priority?: boolean;
}
const { src, alt, width, height, sizes = '100vw', loading = 'lazy', class: className, style, deferred = false, priority = false } = Astro.props;
const img = responsive(src);
---
<img
  src={deferred ? undefined : img.src}
  srcset={deferred ? undefined : img.srcset}
  data-src={deferred ? img.src : undefined}
  data-srcset={deferred ? img.srcset : undefined}
  sizes={img.srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? 'eager' : loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  class={className}
  style={style}
/>

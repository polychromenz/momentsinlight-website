---
// Responsive image. While images are still hosted on Squarespace, build a srcset from its
// ?format=NNNw resizing. Swap this for Cloudflare Images once the original exports are in.
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}
const { src, alt, width, height, sizes = '100vw', loading = 'lazy', class: className, style } = Astro.props;

// Animated GIFs must be served as-is; Squarespace's resizing would flatten them.
const isSqs = src.includes('squarespace-cdn.com') && !/\.gif$/i.test(src.split('?')[0]);
const base = src.split('?')[0];
const widths = [500, 750, 1000, 1500, 2500];
const srcset = isSqs ? widths.map((w) => `${base}?format=${w}w ${w}w`).join(', ') : undefined;
const fallback = isSqs ? `${base}?format=1500w` : src;
---
<img
  src={fallback}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
  style={style}
/>

---
// Responsive image: a srcset from Cloudflare Images' or Squarespace's resizing (see
// src/lib/images.mjs), so each device downloads the smallest size that looks sharp.
import { responsive } from '../lib/images.mjs';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}
const { src, alt, width, height, sizes = '100vw', loading = 'lazy', class: className, style } = Astro.props;
const img = responsive(src);
---
<img
  src={img.src}
  srcset={img.srcset}
  sizes={img.srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
  style={style}
/>

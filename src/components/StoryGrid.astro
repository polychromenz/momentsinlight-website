---
// A grid of story cards for the gallery pages (Love Stories, Portraits, Family): every post
// in the given blog categories, newest first, so ticking a category in Pages CMS adds a post.
// Each card: the cover photo (cropped around the post's "Cover photo position"), the names
// and place. On hover the photo drifts larger, the frame's leaf corners swap sides, a soft
// shade rises with the link label, and a sage line draws under the names.
import { getCollection } from 'astro:content';
import Img from './Img.astro';
import { coverPosition, storyName } from '../lib/blog';

interface Props {
  categories?: string[];
  /** Only posts with this tag (e.g. a venue's weddings). */
  tag?: string;
  /** Exactly these posts, in this order (e.g. "More love stories" under a post). */
  ids?: string[];
  /** Words on the hover shade, e.g. "View love story". */
  linkLabel?: string;
  /** Split "Names | Place" titles into a name and a smaller place line (wedding posts). */
  splitTitles?: boolean;
}
const { categories, tag, ids, linkLabel = 'View gallery', splitTitles = true } = Astro.props;
const wanted = categories?.map((c) => c.toLowerCase());
const posts = (await getCollection('blog'))
  .filter((p) => (!wanted || p.data.categories.some((c) => wanted.includes(c.toLowerCase()))) && (!tag || p.data.tags.includes(tag)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const shown = ids ? ids.map((id) => posts.find((p) => p.id === id)).filter((p) => !!p) : posts;
---
<ul class="stories">
  {shown.map((p, i) => {
    const src = p.data.thumbnail ?? p.data.gallery[0]?.src;
    const { name, place } = splitTitles ? storyName(p.data.title) : { name: p.data.title, place: '' };
    return (
      <li data-reveal="photo" style={`--d:${(i % 3) * 0.12}s`}>
        <a class="card" href={`/blog/${p.id}`}>
          <span class="frame">
            {src && (
              <Img
                src={src}
                alt=""
                sizes="(min-width: 1100px) 31vw, (min-width: 640px) 46vw, 90vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                style={`object-position:${coverPosition(p.data.thumbnailPosition) ?? '50% 50%'}`}
              />
            )}
            <span class="shade" aria-hidden="true"><span>{linkLabel} <span class="arrow">→</span></span></span>
          </span>
          <span class="name">{name}</span>
          {place && <span class="place">{place}</span>}
        </a>
      </li>
    );
  })}
</ul>

<style>
  .stories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 44px 28px;
    grid-template-columns: minmax(0, 1fr);
  }
  .card { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 32px 0;
    aspect-ratio: 3 / 2;
    background: var(--champagne);
    transform: translateZ(0); /* keeps the rounded corners clipping during the zoom */
    transition: border-radius 0.8s var(--ease), box-shadow 0.8s var(--ease), transform 0.8s var(--ease);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease), filter 1.2s var(--ease);
  }
  .shade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 22px;
    background: linear-gradient(180deg, rgb(62 66 41 / 0) 45%, rgb(62 66 41 / 0.65) 100%);
    color: var(--champagne);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .shade > span { transform: translateY(14px); transition: transform 0.8s var(--ease); }
  .arrow { display: inline-block; transition: transform 0.8s var(--ease); }
  .name {
    position: relative;
    align-self: flex-start;
    margin-top: 18px;
    font-size: 22px;
    font-weight: 300;
    line-height: 1.25;
  }
  .name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--sage);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .place { margin-top: 8px; font-size: 14px; letter-spacing: 0.04em; color: #666; }

  .card:hover, .card:focus-visible { opacity: 1; }
  .card:focus-visible { outline: none; }
  .card:focus-visible .frame { outline: 2px solid var(--green); outline-offset: 4px; }
  .card:is(:hover, :focus-visible) .frame {
    border-radius: 0 32px;
    transform: translateY(-4px);
    box-shadow: 0 22px 36px -26px rgb(0 0 0 / 0.55);
  }
  .card:is(:hover, :focus-visible) .frame :global(img) { transform: scale(1.06); filter: saturate(1.05); }
  .card:is(:hover, :focus-visible) .shade { opacity: 1; }
  .card:is(:hover, :focus-visible) .shade > span { transform: none; }
  .card:is(:hover, :focus-visible) .arrow { transform: translateX(5px); }
  .card:is(:hover, :focus-visible) .name::after { transform: scaleX(1); }

  @media (min-width: 640px) {
    .stories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .stories { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame, .frame :global(img), .shade, .shade > span, .arrow, .name::after { transition: none; }
    .card:is(:hover, :focus-visible) .frame { transform: none; }
    .card:is(:hover, :focus-visible) .frame :global(img) { transform: none; }
  }
</style>

---
// Fading slideshow, matching the Squarespace slideshows: one photo at a time, shown whole
// (never cropped), cross-fading to the next every 5 seconds, with arrows and dots.
// Swipe on phones; ← → keys when focused. Autoplay pauses while the pointer is over it,
// while it has keyboard focus, when it's scrolled off screen or the tab is hidden, and is
// off entirely for visitors who've asked their device for reduced motion.
import Img from './Img.astro';

interface Props {
  images: { src: string; alt: string; width?: number; height?: number }[];
  label: string;
  /** Height on phones and on desktop, as CSS lengths, e.g. "30vh" and "50vh". */
  heightMobile?: string;
  heightDesktop?: string;
  /** Seconds each photo is shown. */
  interval?: number;
  /** Near the top of the page: its first photo is fetched before everything else. */
  first?: boolean;
  /** The full-width opening slideshow of the refreshed pages: deep olive behind the photos
   * (still shown whole, never cropped), with the slot's content (the page heading) laid over
   * the bottom on desktop and underneath on phones. */
  hero?: boolean;
}
const { images, label, heightMobile = '30vh', heightDesktop = '50vh', interval = 5, first = false, hero = false } = Astro.props;
const hasCaption = Astro.slots.has('default');
// Photos are shown whole inside a box the slideshow's height tall, so each is only as wide as
// its shape allows at that height (never wider than the screen); tell the browser so it
// fetches that size rather than a full-screen-width one.
const sizesFor = (g: { width?: number; height?: number }) => {
  if (hero || !g.width || !g.height) return '100vw';
  const r = Math.round((g.width / g.height) * 1000) / 1000;
  return `(min-width: 768px) min(100vw, calc(${heightDesktop} * ${r})), min(100vw, calc(${heightMobile} * ${r}))`;
};
---
{images.length > 0 && (
  <section
    class:list={['slideshow', { 'slideshow--hero': hero }]}
    aria-roledescription="carousel"
    aria-label={label}
    data-slideshow
    data-hero={hero ? '' : undefined}
    data-interval={interval}
    tabindex="0"
    style={`--h-m:${heightMobile};--h-d:${heightDesktop}`}
  >
    <ul class="slides" aria-live="off">
      {images.map((g, i) => (
        <li class:list={['slide', { active: i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${images.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
          <Img src={g.src} alt={g.alt} width={g.width} height={g.height} sizes={sizesFor(g)} loading={i < 2 ? 'eager' : 'lazy'} priority={first && i === 0} deferred={i >= 2} />
        </li>
      ))}
    </ul>
    {images.length > 1 && (
      <>
        <button type="button" class="arrow prev" aria-label="Previous photo">
          <svg viewBox="0 0 12 24" aria-hidden="true"><path d="M10 2 2 12l8 10" /></svg>
        </button>
        <button type="button" class="arrow next" aria-label="Next photo">
          <svg viewBox="0 0 12 24" aria-hidden="true"><path d="m2 2 8 10-8 10" /></svg>
        </button>
        <div class="dots" role="group" aria-label="Choose a photo">
          {images.map((_, i) => (
            <button type="button" class:list={['dot', { on: i === 0 }]} data-to={i} aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
          ))}
        </div>
      </>
    )}
    {hasCaption && <div class="caption"><slot /></div>}
  </section>
)}

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((show) => {
    const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...show.querySelectorAll<HTMLButtonElement>('.dot')];
    if (slides.length < 2) return;
    const delay = Number(show.dataset.interval || 5) * 1000;
    let index = 0;
    let timer = 0;
    let hovered = false, focused = false, visible = true;

    // Photos after the first two are left unloaded (data-src) until they're next up, as the
    // stacked slides would otherwise all download at once.
    const preload = (i: number) => {
      const img = slides[(i + slides.length) % slides.length].querySelector('img');
      if (!img) return;
      if (img.dataset.srcset) { img.srcset = img.dataset.srcset; delete img.dataset.srcset; }
      if (img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; }
      if (img.loading !== 'eager') img.loading = 'eager';
    };

    const go = (to: number) => {
      const next = (to + slides.length) % slides.length;
      if (next === index) return;
      preload(next); // in case of a jump (dots, back arrow) to a photo not loaded yet
      slides[index].classList.remove('active');
      slides[index].setAttribute('aria-hidden', 'true');
      dots[index]?.classList.remove('on');
      dots[index]?.removeAttribute('aria-current');
      index = next;
      slides[index].classList.add('active');
      slides[index].removeAttribute('aria-hidden');
      dots[index]?.classList.add('on');
      dots[index]?.setAttribute('aria-current', 'true');
      preload(index + 1);
      preload(index - 1);
      tintDots();
      schedule();
    };

    // Dots sitting on the white space beside a narrow (upright) photo would be white on white,
    // so those get a grey tint instead. Recomputed for each photo and on resize.
    const tintDots = () => {
      if (!dots.length) return;
      const img = slides[index].querySelector('img');
      const box = show.getBoundingClientRect();
      const ratio = img?.naturalWidth
        ? img.naturalWidth / img.naturalHeight
        : Number(img?.getAttribute('width')) / Number(img?.getAttribute('height')) || 1.5;
      const w = Math.min(box.width, box.height * ratio);
      const left = box.left + (box.width - w) / 2;
      const right = left + w;
      dots.forEach((d) => {
        const r = d.getBoundingClientRect();
        const x = r.left + r.width / 2;
        d.classList.toggle('off-photo', x < left + 4 || x > right - 4);
      });
    };

    // Restart the 5-second countdown after every change, so a manual click gets a full turn.
    const schedule = () => {
      clearTimeout(timer);
      if (reduce || hovered || focused || !visible || document.hidden) return;
      timer = window.setTimeout(() => go(index + 1), delay);
    };

    show.querySelector('.prev')?.addEventListener('click', () => go(index - 1));
    show.querySelector('.next')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.to))));
    show.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });

    // Swipe on touch screens.
    let startX = 0, startY = 0;
    show.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
    show.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Pause while someone is looking closely or it's out of view.
    show.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    show.addEventListener('mouseleave', () => { hovered = false; schedule(); });
    show.addEventListener('focusin', () => { focused = true; schedule(); });
    show.addEventListener('focusout', (e) => { if (!show.contains(e.relatedTarget as Node)) { focused = false; schedule(); } });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }, { threshold: 0.3 }).observe(show);
    document.addEventListener('visibilitychange', schedule);

    preload(1);
    tintDots();
    slides[0].querySelector('img')?.addEventListener('load', tintDots);
    addEventListener('resize', tintDots);
    schedule();
  });
</script>

<style>
  .slideshow {
    position: relative;
    height: var(--h-m);
    min-height: 200px;
    overflow: hidden;
  }
  .slideshow:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
  .slides { margin: 0; padding: 0; list-style: none; height: 100%; position: relative; }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 0s linear 1s;
  }
  .slide.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1s ease, visibility 0s;
  }
  .slide :global(img) { width: 100%; height: 100%; object-fit: contain; }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.7);
    color: var(--black);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .arrow:hover { opacity: 1; background: var(--white); }
  .arrow svg { width: 10px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .prev { left: 14px; }
  .next { right: 14px; }

  .dots {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px;
    width: max-content; /* one row when they fit, rather than wrapping at half the width */
    max-width: 90%;
  }
  .dot {
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .dot::before {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0 2px rgb(0 0 0 / 0.4);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .dot.on::before { background: var(--white); transform: scale(1.25); }
  .dot.off-photo::before { background: rgb(0 0 0 / 0.22); box-shadow: none; }
  .dot.off-photo.on::before { background: var(--green); }
  .dot:focus-visible { outline: 2px solid var(--white); outline-offset: -2px; border-radius: 50%; }

  /* Phones: swipe instead of arrows, and fewer dots would crowd the photo, so hide them. */
  @media (max-width: 767px) {
    .arrow { width: 34px; height: 34px; }
    .prev { left: 8px; }
    .next { right: 8px; }
    .dots { display: none; }
  }
  @media (min-width: 768px) {
    .slideshow { height: var(--h-d); }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide, .slide.active { transition: none; }
  }

  /* Full-width opening slideshow on champagne (the menu bar's colour), so where a photo
     doesn't fill the width it blends into the page. Photos are always shown whole. The heading
     sits underneath and rises gently into place as the page loads.
     Phones: the photo box is 3:2, so a landscape photo fills the width exactly.
     Desktop: as tall as fits under the menu, leaving room for the heading. */
  .slideshow--hero {
    --hh: 66.667vw;
    height: auto;
    min-height: 0;
    background: var(--champagne);
  }
  .slideshow--hero .slides { height: var(--hh); }
  .slideshow--hero .slide { transition: opacity 1.6s var(--ease), visibility 0s linear 1.6s; }
  .slideshow--hero .slide.active { transition: opacity 1.6s var(--ease), visibility 0s; }
  .slideshow--hero .arrow { top: calc(var(--hh) / 2); }
  .slideshow--hero .dots { bottom: auto; top: calc(var(--hh) - 30px); }
  .caption { padding: 30px var(--pad) 8px; text-align: center; }
  .caption > :global(*) { animation: rise 1.4s var(--ease) both; }
  .caption > :global(*:nth-child(2)) { animation-delay: 0.15s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (min-width: 768px) {
    .slideshow--hero { --hh: clamp(380px, min(66.667vw, calc(100svh - 300px)), 1000px); height: auto; }
    .caption { padding: 40px var(--pad) 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caption > :global(*) { animation: none; }
  }
</style>

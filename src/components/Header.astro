---
import Logo from './Logo.astro';
import { nav, cta } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
const inFolder = (item: (typeof nav)[number]) => item.children?.some((c) => isCurrent(c.href));
---
<header class="site-header">
  <div class="bar">
    <Logo />

    <nav class="desktop-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            {item.children ? (
              <>
                <button class:list={['top', { current: inFolder(item) }]} aria-expanded="false">{item.label}</button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="top" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <a class="btn" href={cta.href} aria-label={cta.label}><span class="cta-long">{cta.label}</span><span class="cta-short" aria-hidden="true">Check availability</span></a>
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Open menu</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="panel" data-panel="main">
      <ul>
        {nav.map((item) => (
          <li>
            {item.children
              ? <button data-open={item.label}>{item.label}</button>
              : <a href={item.href}>{item.label}</a>}
          </li>
        ))}
      </ul>
    </div>
    {nav.filter((i) => i.children).map((item) => (
      <div class="panel" data-panel={item.label} hidden>
        <ul>
          <li><button class="back" data-open="main">Back</button></li>
          {item.children!.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </div>
    ))}
    <a class="btn mobile-cta" href={cta.href}>{cta.label}</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const burger = header.querySelector<HTMLButtonElement>('.burger')!;
  const menu = header.querySelector<HTMLElement>('.mobile-menu')!;
  const panels = menu.querySelectorAll<HTMLElement>('.panel');

  const showPanel = (name: string) => panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    // The menu opens just below the header, whatever height it is (phones and tablets differ).
    menu.style.top = header.getBoundingClientRect().bottom + 'px';
    document.body.style.overflow = open ? 'hidden' : '';
    showPanel('main');
  });
  menu.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => showPanel(b.dataset.open!)),
  );

  // Desktop dropdowns: open on hover (CSS) or click/keyboard (here).
  header.querySelectorAll<HTMLButtonElement>('.has-sub > .top').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      header.querySelectorAll('.has-sub > .top').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-sub')) {
      header.querySelectorAll('.has-sub > .top').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--griseo);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* 97px tall on phones, 136px on desktop, with the logo's own clear space inside */
    padding: 18px calc(var(--pad) - 5.5px);
  }

  .desktop-nav { display: none; }
  .burger {
    position: relative;
    width: 40px;
    height: 40px;
    margin-right: -4px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .burger::before, .burger::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    height: 1.5px;
    background: var(--black);
    transition: transform 0.2s;
  }
  .burger::before { top: 13px; }
  .burger::after { top: 25px; }
  .burger[aria-expanded='true']::before { transform: translateY(6px) rotate(45deg); }
  .burger[aria-expanded='true']::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 97px 0 0;
    background: var(--white);
    display: flex;
    flex-direction: column;
    padding: 0 var(--pad) 24px;
    overflow-y: auto;
  }
  .mobile-menu[hidden], .panel[hidden] { display: none; }
  .panel { flex: 1; display: flex; align-items: center; justify-content: center; }
  .panel ul { list-style: none; margin: 0; padding: 0; text-align: center; }
  .panel li { margin: 0 0 23px; }
  .panel a, .panel button {
    font: inherit;
    font-size: 33.15px;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--black);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .panel button:not(.back)::after { content: ' ›'; }
  .panel .back::before { content: '‹ '; }
  .mobile-cta { width: 100%; min-height: 75px; }

  /* Tablets (768–999px) keep the phone header, with the menu button: the full menu and the
     date button don't fit. From 1000px the full menu shows; the button gets a shorter label
     until 1200px, where the long one fits on one line. */
  @media (min-width: 768px) {
    .bar { padding: 13px calc(var(--pad) - 9.9px); }
  }
  .cta-short { display: none; }
  @media (min-width: 1000px) and (max-width: 1199px) {
    .cta-long { display: none; }
    .cta-short { display: inline; }
  }
  @media (min-width: 1000px) {
    .burger, .mobile-menu { display: none !important; }
    .desktop-nav { display: flex; align-items: center; gap: 35px; }
    .desktop-nav > ul { display: flex; gap: 35px; list-style: none; margin: 0; padding: 0; }
    .top {
      font: inherit;
      font-size: var(--fs-body);
      letter-spacing: 0.02em;
      line-height: 1.2;
      color: var(--black);
      text-decoration: none;
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
    }
    .top:hover { opacity: 0.7; }
    .top[aria-current='page'], .top.current { text-decoration: underline; text-underline-offset: 0.2em; }

    .has-sub { position: relative; }
    .sub {
      display: none;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      min-width: 14rem;
      list-style: none;
      margin: 0;
      padding: 14px 0 10px;
      background: var(--griseo);
      text-align: center;
    }
    .sub a { display: block; padding: 6px 20px; color: var(--black); text-decoration: none; font-size: 15px; }
    .sub a:hover { color: var(--green); opacity: 1; }
    .has-sub:hover .sub,
    .has-sub:focus-within .sub,
    .top[aria-expanded='true'] + .sub { display: block; }
  }
</style>

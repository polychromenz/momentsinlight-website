---
// A search box for the blog and Love Stories: as someone types, the normal list (the slot) is
// swapped for matching story cards from every page. Searches names, venues, places, tags and
// the story text, from /blog/search.json, which is only fetched once someone uses the box.
interface Props {
  /** Only search posts in these categories (e.g. ['Wedding']); all posts when left out. */
  categories?: string[];
  placeholder?: string;
}
const { categories = [], placeholder = 'Search names, venues or places' } = Astro.props;
---
<blog-search data-categories={categories.join(',')}>
  <form class="search" role="search" onsubmit="return false">
    <label class="visually-hidden" for="blog-search-input">Search</label>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input id="blog-search-input" type="search" placeholder={placeholder} autocomplete="off" enterkeyhint="search" />
    <button type="button" class="clear" aria-label="Clear search" hidden>×</button>
  </form>
  <p class="found" aria-live="polite"></p>
  <ul class="results" hidden></ul>
  <div class="normal"><slot /></div>
</blog-search>

<script>
  type Post = { id: string; name: string; place: string; kind: string; cats: string[]; date: string; img: string; pos: string; text: string };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // Folds accents and curly apostrophes, so "maori" finds "Māori" and "jess's" finds "Jess’s".
  const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/’/g, "'");
  let index: Promise<Post[]> | undefined;
  const load = () => (index ??= fetch('/blog/search.json').then((r) => r.json()).then((list: Post[]) => list.map((p) => ({ ...p, text: fold(p.text) }))));

  class BlogSearch extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input')!;
      const clear = this.querySelector<HTMLButtonElement>('.clear')!;
      const found = this.querySelector('.found')!;
      const results = this.querySelector<HTMLUListElement>('.results')!;
      const normal = this.querySelector<HTMLElement>('.normal')!;
      const cats = (this.dataset.categories || '').split(',').filter(Boolean);
      const month = (d: string) => new Date(d).toLocaleDateString('en-NZ', { month: 'long', year: 'numeric', timeZone: 'Pacific/Auckland' });

      const run = async () => {
        const q = fold(input.value.trim());
        clear.hidden = !q;
        if (!q) { results.hidden = true; normal.hidden = false; found.textContent = ''; return; }
        const words = q.split(/\s+/).map((w) => w.replace(/&/g, ''));
        const posts = (await load()).filter((p) => (!cats.length || p.cats.some((c) => cats.includes(c))) && words.every((w) => p.text.includes(w)));
        if (fold(input.value.trim()) !== q) return; // a newer search has started
        // Names and places first, then newest.
        const head = (p: Post) => words.every((w) => fold(`${p.name} ${p.place}`).includes(w));
        posts.sort((a, b) => Number(head(b)) - Number(head(a)) || b.date.localeCompare(a.date));
        normal.hidden = true;
        results.hidden = false;
        found.textContent = posts.length ? `${posts.length} ${posts.length === 1 ? 'match' : 'matches'}` : 'Nothing matches that yet. Try a couple’s name, a venue or a place.';
        results.innerHTML = posts.slice(0, 48).map((p) => `
          <li><a class="card" href="/blog/${p.id}">
            <span class="frame">${p.img ? `<img src="${esc(p.img)}" alt="" loading="lazy" decoding="async" style="object-position:${esc(p.pos)}" />` : ''}</span>
            <span class="meta">${esc(p.kind)} · ${month(p.date)}</span>
            <span class="name">${esc(p.name)}</span>
            ${p.place ? `<span class="place">${esc(p.place)}</span>` : ''}
          </a></li>`).join('');
      };

      let timer = 0;
      input.addEventListener('focus', () => void load(), { once: true });
      input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
      input.addEventListener('keydown', (e) => { if (e.key === 'Escape') { input.value = ''; run(); } });
      clear.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
      // /blog?q=piha opens with that search.
      const q = new URLSearchParams(location.search).get('q');
      if (q) { input.value = q; run(); }
    }
  }
  customElements.define('blog-search', BlogSearch);
</script>

<style>
  blog-search { display: block; }
  .search { position: relative; max-width: 520px; margin: 0 auto 10px; }
  .search input {
    width: 100%; padding: 14px 44px 14px 48px; font: inherit; font-size: 16px; color: var(--ink);
    background: var(--white); border: 1px solid #ddd3c4; border-radius: 16px 0;
    transition: border-color 0.4s var(--ease), border-radius 0.5s var(--ease), box-shadow 0.4s var(--ease);
  }
  .search input::-webkit-search-cancel-button { display: none; }
  .search input:focus { outline: none; border-color: var(--green); border-radius: 0 16px; box-shadow: 0 10px 24px -18px rgb(0 0 0 / 0.45); }
  .icon { position: absolute; left: 17px; top: 50%; width: 20px; height: 20px; margin-top: -10px; fill: none; stroke: var(--green); stroke-width: 2; stroke-linecap: round; pointer-events: none; }
  .clear { position: absolute; right: 8px; top: 50%; width: 32px; height: 32px; margin-top: -16px; border: 0; border-radius: 50%; background: transparent; font-size: 22px; line-height: 1; color: #888; cursor: pointer; }
  .clear:hover { background: var(--champagne); color: var(--ink); }
  .found { min-height: 1.4em; margin: 0 0 28px; text-align: center; font-size: 14px; color: #777; }
  .found:empty { margin-bottom: 18px; }

  .results[hidden] { display: none; }
  .results { list-style: none; margin: 0; padding: 0; display: grid; gap: 44px 28px; grid-template-columns: minmax(0, 1fr); }
  .results :global(.card) { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .results :global(.card:hover) { opacity: 1; }
  .results :global(.frame) { display: block; overflow: hidden; aspect-ratio: 3 / 2; border-radius: 32px 0; background: var(--champagne); transition: border-radius 0.8s var(--ease), transform 0.8s var(--ease), box-shadow 0.8s var(--ease); }
  .results :global(.frame img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.6s var(--ease); }
  .results :global(.card:is(:hover, :focus-visible) .frame) { border-radius: 0 32px; transform: translateY(-4px); box-shadow: 0 22px 36px -26px rgb(0 0 0 / 0.55); }
  .results :global(.card:is(:hover, :focus-visible) .frame img) { transform: scale(1.06); }
  .results :global(.meta) { margin-top: 18px; font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); }
  .results :global(.name) { margin-top: 8px; font-size: 22px; font-weight: 300; line-height: 1.3; }
  .results :global(.place) { margin-top: 8px; font-size: 14px; letter-spacing: 0.04em; color: #666; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (min-width: 640px) { .results { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .results { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 32px; } }
  @media (prefers-reduced-motion: reduce) {
    .results :global(.frame), .results :global(.frame img) { transition: none; }
  }
</style>

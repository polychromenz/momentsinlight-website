---
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '@fontsource/raleway/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import { site } from '../data/site';
import { sized, responsive } from '../lib/images.mjs';
// Body text (400) and headings (500): fetched straight away, so they're usually ready before
// any text is drawn and the text doesn't jump when the font swaps in.
import raleway400 from '@fontsource/raleway/files/raleway-latin-400-normal.woff2?url';
import raleway500 from '@fontsource/raleway/files/raleway-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Page background: blog posts sit on Griseo Elegance throughout, like the live site. */
  background?: 'white' | 'alt';
  /** Keep the page out of Google (e.g. /newcontact while it's being tested). */
  noindex?: boolean;
  /** The page's first big photo: the browser starts fetching it before anything else
   *  (same sizes as the <img>, so it's the same file). */
  heroImage?: { src: string; sizes?: string };
}
const { title, description, image, type = 'website', jsonLd, background = 'white', noindex = false, heroImage } = Astro.props;
const hero = heroImage ? responsive(heroImage.src) : null;
// The page's public address. Pages are built as files (weddings.html) but served without
// the .html (/weddings), which is the address Google should index.
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/', site.url).href;
const ogImage = image ? sized(image, 1500) : undefined;
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Photos come from Cloudflare Images: connect to it straight away. */}
    <link rel="preconnect" href="https://imagedelivery.net" />
    {hero && <link rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={heroImage!.sizes ?? '100vw'} fetchpriority="high" />}
    <link rel="preload" href={raleway400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={raleway500} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Tracking />
  </head>
  <body class:list={{ 'bg-alt': background === 'alt' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Every other page gets the same motion automatically: photos and text blocks that start
      // below the first screen are tagged here (anything already on screen shows at once).
      // Pages tagged by hand (home, weddings) are left as they are.
      if (!document.querySelector('main [data-reveal], main [data-stagger]')) {
        const fold = window.innerHeight * 0.9;
        const below = (el: Element) => el.getBoundingClientRect().top > fold;
        const skip = (el: Element) => el.closest('.slideshow, [data-reviews], .mobile-menu, form, details');
        document.querySelectorAll('main img').forEach((img) => {
          const box = img.closest('li, figure, a') ?? img;
          if (!skip(box) && below(box) && !box.hasAttribute('data-reveal')) box.setAttribute('data-reveal', 'photo');
        });
        document.querySelectorAll('main :is(h1, h2, h3, h4, p, ul, ol, blockquote, .btn)').forEach((el) => {
          if (skip(el) || el.closest('[data-reveal]') || !below(el)) return;
          el.setAttribute('data-reveal', '');
        });
      }
      // Fade marked sections up into view as they scroll on screen (see global.css).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal], [data-stagger]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

---
// The studio's frame: private (no search engines), the site's fonts and colours, and a bar at
// the top with the studio menu (section = the one you're in) and the page's own buttons (slot
// "bar"). No site menu or footer.
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '../styles/global.css';

type Section = 'dashboard' | 'clients' | 'galleries' | 'calendar' | 'contacts' | 'blog' | 'pages' | 'reviews' | 'stats' | 'seo' | 'rankings' | 'payments' | 'mileage' | 'xero' | 'reports' | 'reconcile' | 'social' | 'settings';
interface Props { title: string; section?: Section }
const { title, section } = Astro.props;
// Which build this is (Cloudflare Pages gives the commit), shown at the bottom of every studio page.
import { areaOfPage } from '../../functions-lib/areas.js';
const built = new Date().toLocaleString('en-NZ', { timeZone: 'Pacific/Auckland', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
const version = `${built} · ${(process.env.CF_PAGES_COMMIT_SHA ?? 'local').slice(0, 7)}`;
type Item = [Section, string, string];
// Small menus that open: the website's content, and how it's found and seen (SEO).
const website: Item[] = [['blog', 'Blog', '/studio/blog'], ['pages', 'Pages', '/studio/pages']];
const money: Item[] = [['payments', 'Payments', '/studio/payments'], ['mileage', 'Mileage', '/studio/mileage'], ['xero', 'Xero', '/studio/xero'], ['reconcile', 'Reconcile', '/studio/reconcile'], ['reports', 'Booking reports', '/studio/reports']];
const seo: Item[] = [['seo', 'SEO', '/studio/seo'], ['rankings', 'Rankings', '/studio/rankings'], ['stats', 'Stats', '/studio/stats'], ['reviews', 'Reviews', '/studio/reviews']];
const menu: (Item | [string, string, Item[]])[] = [
  ['dashboard', 'Dashboard', '/studio'],
  ['clients', 'Clients', '/studio/crm'],
  ['galleries', 'Galleries', '/studio/galleries'],
  ['social', 'Social', '/studio/social'],
  ['calendar', 'Calendar', '/studio/calendar'],
  ['money-menu', 'Payments', money],
  ['contacts', 'Contacts', '/studio/contacts'],
  ['website', 'Website', website],
  ['seo-menu', 'SEO', seo],
  ['settings', 'Settings', '/studio/crm/settings'],
];
const inGroup = (items: Item[]) => items.some(([k]) => k === section);
// Breadcrumbs under the menu: Dashboard › (its menu group) › the section › this page. A page about one
// thing (a client, a gallery) names it in document.title once it loads; the last crumb follows that.
const groups: [Item[], string, string | null][] = [[money, 'Payments', '/studio/payments'], [seo, 'SEO', '/studio/seo'], [website, 'Website', null]];
const flat = menu.flatMap((m) => (Array.isArray(m[2]) ? (m[2] as Item[]) : [m as Item]));
const here = flat.find(([k]) => k === section);
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/studio'; // (built pages end .html)
const crumbs: [string, string | null][] = [['Dashboard', '/studio']];
if (here && section !== 'dashboard') {
  const g = groups.find(([items]) => items.some(([k]) => k === section));
  if (g && g[2] !== here[2]) crumbs.push([g[1], g[2]]);
  crumbs.push([here[1], here[2]]);
}
const onSection = here ? path === here[2] : path === '/studio';
if (!onSection) crumbs.push([title, null]);
const showCrumbs = crumbs.length > 1;
// Each menu link's area (functions-lib/areas.js), so a person's hidden areas drop out of their menu.
const areaAttr = (href: string) => areaOfPage(href) ?? undefined;
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Moments Studio</title>
    <link rel="icon" href="/studio-icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/studio-icon.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/studio-icon.png" />
  </head>
  <body class="studio-body">
    <header class="studio-bar">
      <a class="studio-brand" href="/studio">Moments <span>Studio</span></a>
      <nav class="studio-nav" aria-label="Studio">
        {menu.map(([key, label, target]) => Array.isArray(target)
          ? <details class="nav-group"><summary class={inGroup(target) ? 'current' : undefined}>{label} <span aria-hidden="true">▾</span></summary>
              <div class="nav-menu">{(target as Item[]).map(([k, l, h]) => <a href={h} data-area={areaAttr(h)} aria-current={k === section ? 'page' : undefined}>{l}</a>)}</div></details>
          : <a href={target as string} data-area={areaAttr(target as string)} aria-current={key === section ? 'page' : undefined}>{label}</a>)}
      </nav>
      <button type="button" class="studio-write" data-write-email data-area="clients" title="Write a one-off email in your design, with your signature">✉ Write email</button>
      <div class="studio-actions"><slot name="bar" /></div>
    </header>
    {showCrumbs && (
      <nav class="studio-crumbs" aria-label="Breadcrumb"><ol>
        {crumbs.map(([label, href], n) => (n === crumbs.length - 1
          ? <li><span class={onSection ? undefined : 'crumb-here'} aria-current="page">{label}</span></li>
          : <li><a href={href ?? undefined}>{label}</a></li>))}
      </ol></nav>
    )}
    <p class="studio-ro" hidden>You can look at this part of the studio but not change it. Ask Tony if you need to.</p>
    <p class="studio-ro studio-hidden-note" hidden>That part of the studio isn’t part of your access, so you’ve been brought back here.</p>
    <slot />
    <p class="studio-version">Moments Studio, updated {version}</p>
    <script>
      // Per-person access (Settings > People): hidden areas leave the menu; a note on look-only pages.
      import { areaOfPage, levelFor } from '../../functions-lib/areas.js';
      import '../studio/date-picker'; // the site-styled calendar for date boxes
      fetch('/api/studio/people').then((r) => (r.ok ? r.json() : null)).then((d) => {
        const me = d?.me;
        if (!me || me.access === 'owner') return;
        document.querySelectorAll<HTMLElement>('[data-area]').forEach((a) => { if (levelFor(me, a.dataset.area) === 'hidden') a.hidden = true; });
        document.querySelectorAll<HTMLElement>('.nav-group').forEach((g) => { if (![...g.querySelectorAll<HTMLElement>('a')].some((a) => !a.hidden)) g.hidden = true; });
        if (levelFor(me, areaOfPage(location.pathname)) === 'look') { document.body.classList.add('studio-read-only'); document.querySelector<HTMLElement>('.studio-ro')!.hidden = false; }
        if (new URLSearchParams(location.search).has('hidden')) document.querySelector<HTMLElement>('.studio-hidden-note')!.hidden = false;
      }).catch(() => {});
      // The last breadcrumb follows the page's title (a client's or gallery's name, once it loads).
      const crumb = document.querySelector<HTMLElement>('.crumb-here');
      const titleEl = document.querySelector('title');
      if (crumb && titleEl) {
        const sync = () => { const t = document.title.replace(/\s*·\s*Moments Studio$/, '').trim(); if (t) crumb.textContent = t; };
        sync();
        new MutationObserver(sync).observe(titleEl, { childList: true, characterData: true, subtree: true });
      }
      // "✉ Write email": the composer loads the first time it's opened (src/studio/compose.ts).
      document.querySelector('[data-write-email]')?.addEventListener('click', async () => {
        const { openCompose } = await import('../studio/compose');
        openCompose();
      });
      // The Website menu closes when you click elsewhere.
      document.addEventListener('click', (e) => {
        document.querySelectorAll<HTMLDetailsElement>('.nav-group[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
      });
    </script>
  </body>
</html>

<style is:global>
  .studio-body { background: var(--champagne); min-height: 100vh; }
  .studio-crumbs { padding: 9px clamp(14px, 3vw, 32px); background: var(--champagne); border-bottom: 1px solid #efe7db; font-size: 13px; }
  .studio-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; margin: 0; padding: 0; list-style: none; }
  .studio-crumbs li { display: flex; align-items: center; color: #777; }
  .studio-crumbs li + li::before { content: '›'; margin: 0 9px; color: #b5aa98; }
  .studio-crumbs a { color: var(--green); text-decoration: none; }
  .studio-crumbs a[href]:hover { text-decoration: underline; text-underline-offset: 3px; }
  .studio-crumbs a:not([href]) { color: #777; }
  .studio-crumbs [aria-current] { color: var(--ink); font-weight: 500; }
  .studio-ro { margin: 0; padding: 8px 16px; text-align: center; font-size: 14px; background: #fbf3df; color: #6b5310; }
  /* Motion, like the website (its --ease): cards rise in as a page shows them, a little
     staggered; tabs and dialogs ease in. Plain CSS, so it also works on content drawn later.
     Lists that redraw after every save don't animate, so working in the studio stays calm. */
  @keyframes s-rise { from { opacity: 0; transform: translateY(16px); } }
  @keyframes s-fade { from { opacity: 0; } }
  @keyframes s-pop { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  .studio-body main .card, .studio-body main .tile, .studio-body .posts > li { animation: s-rise 0.8s var(--ease) both; }
  .studio-body main :is(.cols, .tiles, .charts, .lists, .tpl-layout, .posts, .content, .cols > div) > :nth-child(2) { animation-delay: 0.06s; }
  .studio-body main :is(.cols, .tiles, .charts, .lists, .tpl-layout, .posts, .content, .cols > div) > :nth-child(3) { animation-delay: 0.12s; }
  .studio-body main :is(.cols, .tiles, .charts, .lists, .tpl-layout, .posts, .content, .cols > div) > :nth-child(4) { animation-delay: 0.18s; }
  .studio-body main :is(.cols, .tiles, .charts, .lists, .tpl-layout, .posts, .content, .cols > div) > :nth-child(n+5) { animation-delay: 0.24s; }
  .studio-body .pane:not([hidden]) { animation: s-rise 0.55s var(--ease) both; }
  .studio-body .pane .card { animation: none; }
  .studio-body dialog[open] { animation: s-pop 0.45s var(--ease) both; }
  .studio-body dialog[open]::backdrop { animation: s-fade 0.4s var(--ease) both; }
  .studio-nav a { transition: background-color 0.35s var(--ease), color 0.35s var(--ease); }
  @media (prefers-reduced-motion: reduce) {
    .studio-body *, .studio-body *::backdrop { animation: none !important; }
  }
  /* Anything switched off stays off, whatever its layout says. */
  .studio-body [hidden] { display: none !important; }
  .studio-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px clamp(14px, 3vw, 32px);
    background: var(--white);
    border-bottom: 1px solid #e8dfd2;
  }
  .studio-brand { font-size: 18px; font-weight: 300; color: var(--ink); text-decoration: none; letter-spacing: 0.02em; }
  .studio-nav { display: flex; flex-wrap: wrap; gap: 2px; align-items: center; }
  .nav-group { position: relative; }
  .nav-group summary { list-style: none; cursor: pointer; padding: 8px 12px; border-radius: 10px 0; font-size: 14px; font-weight: 500; color: #555; white-space: nowrap; }
  .nav-group summary::-webkit-details-marker { display: none; }
  .nav-group summary:hover { background: rgb(90 94 59 / 0.08); }
  .nav-group summary.current { background: var(--green); color: var(--white); }
  .nav-group summary span { font-size: 10px; }
  .nav-menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 60; min-width: 150px; display: flex; flex-direction: column; gap: 2px; padding: 6px; background: var(--white); border-radius: 14px 0; box-shadow: 0 16px 34px -18px rgb(0 0 0 / 0.45); animation: s-fade 0.25s var(--ease) both; }
  .nav-menu a { display: block; }
  .studio-nav a { padding: 8px 12px; border-radius: 10px 0; font-size: 14px; font-weight: 500; color: #555; text-decoration: none; white-space: nowrap; }
  .studio-nav a:hover { background: rgb(90 94 59 / 0.08); opacity: 1; }
  .studio-nav a[aria-current='page'] { background: var(--green); color: var(--white); }
  .studio-write { margin-left: auto; font: inherit; font-size: 14px; font-weight: 500; padding: 8px 14px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); color: var(--green); cursor: pointer; white-space: nowrap; transition: border-radius 0.35s, background 0.2s; }
  .studio-write:hover { background: rgb(90 94 59 / 0.08); border-radius: 0 10px; }
  .studio-write + .studio-actions { margin-left: 0; }
  .studio-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-left: auto; }
  .studio-version { text-align: center; color: #aaa; font-size: 12px; margin: 40px 0 20px; }
  .studio-actions:empty { display: none; }
  @media (max-width: 760px) { .studio-nav { order: 3; flex-basis: 100%; margin: 0 -6px; } .studio-nav { position: relative; } .nav-group { position: static; } .nav-menu { left: 6px; right: 6px; top: calc(100% + 4px); flex-direction: row; flex-wrap: wrap; } }
  .studio-brand span { font-weight: 600; color: var(--green); }
  .s-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 12px 0; border: 1px solid var(--green);
    background: var(--white); color: var(--green); font: inherit; font-size: 14px; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-radius 0.4s var(--ease);
  }
  .s-btn:hover { opacity: 1; border-radius: 0 12px; }
  .s-btn--solid { background: var(--green); color: var(--white); }
  .s-btn--solid:hover { background: var(--green-dark); }
  .s-btn--quiet { border-color: transparent; background: transparent; }
  .s-btn--quiet:hover { background: rgb(90 94 59 / 0.08); }
  .s-btn--danger { border-color: #b3261e; color: #b3261e; }
  .s-btn:disabled { opacity: 0.5; cursor: default; }
  .s-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; }
  .s-chip--draft { background: #efe4dc; color: #7a4b2a; }
  .s-chip--scheduled { background: #e3e7f6; color: #2f3f86; }
  .s-chip--live { background: #e6ecd9; color: #3e4229; }
  .s-toast {
    position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px); z-index: 100;
    max-width: min(560px, calc(100vw - 32px)); padding: 14px 20px; border-radius: 16px 0;
    background: var(--olive); color: var(--champagne); font-size: 15px; line-height: 1.5;
    box-shadow: 0 14px 30px -16px rgb(0 0 0 / 0.5); opacity: 0; pointer-events: none;
    transition: opacity 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .s-toast.show { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .s-toast.error { background: #8c1d18; }
  .s-toast a { color: var(--champagne); }
  /* Attachments picker (src/studio/attach-picker.ts). */
  .ap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: 14px; color: #444; }
  .ap-label { font-weight: 600; color: #555; font-size: 13px; }
  .ap-doc { display: inline-flex !important; flex-direction: row !important; align-items: center; gap: 6px !important; font-weight: 400 !important; font-size: 14px !important; color: #333 !important; }
  .ap-doc small { color: #888; }
  .ap-none { color: #999; }
  .ap .ap-add { width: auto !important; font-size: 13px !important; padding: 5px 8px !important; }
  .ap-warn { flex-basis: 100%; color: #8c1d18; font-size: 13px; }
  /* The CRM's rich text editor (src/studio/rich-editor.ts). */
  .rich { border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); font-weight: 400; color: var(--ink); }
  .rich-bar { display: flex; flex-wrap: wrap; gap: 3px; align-items: center; padding: 6px; border-bottom: 1px solid #ece4d7; background: #faf7f2; border-radius: 10px 0 0 0; position: sticky; top: 61px; z-index: 5; }
  .rich-bar button, .rich-bar select { font: inherit; font-size: 13px; padding: 5px 8px; border: 1px solid transparent; border-radius: 7px; background: transparent; cursor: pointer; color: #333; width: auto; }
  .rich .rich-bar select { border: 1px solid #e2dacd; background: var(--white); width: auto !important; min-width: 0; padding: 5px 6px; border-radius: 7px; font-size: 13px; }
  .rich .rich-pick input { padding: 0 !important; border: 0 !important; }
  .rich-bar button:hover { background: var(--champagne); }
  .rich-bar button.on { background: var(--green); color: var(--white); }
  .rich-colours { display: inline-flex; align-items: center; gap: 3px; padding: 0 4px; }
  .rich-colours [data-colour] { width: 18px; height: 18px; padding: 0; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #ccc; }
  .rich-pick { position: relative; cursor: pointer; font-size: 14px; }
  .rich-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .rich-area .ProseMirror { min-height: 220px; padding: 12px 14px; outline: none; font-size: 15px; line-height: 1.7; color: #333; }
  .rich-area .ProseMirror p { margin: 0 0 12px; }
  .rich-area .ProseMirror h2 { font-size: 21px; font-weight: 300; margin: 18px 0 8px; color: var(--ink); }
  .rich-area .ProseMirror h3 { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--green); margin: 18px 0 4px; }
  .rich-area .ProseMirror ul, .rich-area .ProseMirror ol { padding-left: 22px; margin: 0 0 12px; }
  .rich-area .ProseMirror li p { margin: 0 0 4px; }
  .rich-area .ProseMirror a { color: var(--green); }
  .rich-area .ProseMirror a.button { display: inline-block; padding: 8px 16px; background: var(--green); color: var(--white); border-radius: 10px 0; text-decoration: none; }
</style>

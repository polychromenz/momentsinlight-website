---
// The studio's frame: private (no search engines), the site's fonts and colours, a simple bar
// at the top. No site menu or footer.
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Moments Studio</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body class="studio-body">
    <header class="studio-bar">
      <a class="studio-brand" href="/studio">Moments <span>Studio</span></a>
      <slot name="bar" />
    </header>
    <slot />
  </body>
</html>

<style is:global>
  .studio-body { background: var(--champagne); min-height: 100vh; }
  /* Anything switched off stays off, whatever its layout says. */
  .studio-body [hidden] { display: none !important; }
  .studio-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px clamp(14px, 3vw, 32px);
    background: var(--white);
    border-bottom: 1px solid #e8dfd2;
  }
  .studio-brand { font-size: 18px; font-weight: 300; color: var(--ink); text-decoration: none; letter-spacing: 0.02em; margin-right: auto; }
  .studio-brand span { font-weight: 600; color: var(--green); }
  .s-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 12px 0; border: 1px solid var(--green);
    background: var(--white); color: var(--green); font: inherit; font-size: 14px; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-radius 0.4s var(--ease);
  }
  .s-btn:hover { opacity: 1; border-radius: 0 12px; }
  .s-btn--solid { background: var(--green); color: var(--white); }
  .s-btn--solid:hover { background: var(--green-dark); }
  .s-btn--quiet { border-color: transparent; background: transparent; }
  .s-btn--quiet:hover { background: rgb(90 94 59 / 0.08); }
  .s-btn--danger { border-color: #b3261e; color: #b3261e; }
  .s-btn:disabled { opacity: 0.5; cursor: default; }
  .s-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; }
  .s-chip--draft { background: #efe4dc; color: #7a4b2a; }
  .s-chip--scheduled { background: #e3e7f6; color: #2f3f86; }
  .s-chip--live { background: #e6ecd9; color: #3e4229; }
  .s-toast {
    position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px); z-index: 100;
    max-width: min(560px, calc(100vw - 32px)); padding: 14px 20px; border-radius: 16px 0;
    background: var(--olive); color: var(--champagne); font-size: 15px; line-height: 1.5;
    box-shadow: 0 14px 30px -16px rgb(0 0 0 / 0.5); opacity: 0; pointer-events: none;
    transition: opacity 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .s-toast.show { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .s-toast.error { background: #8c1d18; }
  .s-toast a { color: var(--champagne); }
  /* Attachments picker (src/studio/attach-picker.ts). */
  .ap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: 14px; color: #444; }
  .ap-label { font-weight: 600; color: #555; font-size: 13px; }
  .ap-doc { display: inline-flex !important; flex-direction: row !important; align-items: center; gap: 6px !important; font-weight: 400 !important; font-size: 14px !important; color: #333 !important; }
  .ap-doc small { color: #888; }
  .ap-none { color: #999; }
  .ap .ap-add { width: auto !important; font-size: 13px !important; padding: 5px 8px !important; }
  .ap-warn { flex-basis: 100%; color: #8c1d18; font-size: 13px; }
  /* The CRM's rich text editor (src/studio/rich-editor.ts). */
  .rich { border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); font-weight: 400; color: var(--ink); }
  .rich-bar { display: flex; flex-wrap: wrap; gap: 3px; align-items: center; padding: 6px; border-bottom: 1px solid #ece4d7; background: #faf7f2; border-radius: 10px 0 0 0; position: sticky; top: 61px; z-index: 5; }
  .rich-bar button, .rich-bar select { font: inherit; font-size: 13px; padding: 5px 8px; border: 1px solid transparent; border-radius: 7px; background: transparent; cursor: pointer; color: #333; width: auto; }
  .rich .rich-bar select { border: 1px solid #e2dacd; background: var(--white); width: auto !important; min-width: 0; padding: 5px 6px; border-radius: 7px; font-size: 13px; }
  .rich .rich-pick input { padding: 0 !important; border: 0 !important; }
  .rich-bar button:hover { background: var(--champagne); }
  .rich-bar button.on { background: var(--green); color: var(--white); }
  .rich-colours { display: inline-flex; align-items: center; gap: 3px; padding: 0 4px; }
  .rich-colours [data-colour] { width: 18px; height: 18px; padding: 0; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #ccc; }
  .rich-pick { position: relative; cursor: pointer; font-size: 14px; }
  .rich-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .rich-area .ProseMirror { min-height: 220px; padding: 12px 14px; outline: none; font-size: 15px; line-height: 1.7; color: #333; }
  .rich-area .ProseMirror p { margin: 0 0 12px; }
  .rich-area .ProseMirror h2 { font-size: 21px; font-weight: 300; margin: 18px 0 8px; color: var(--ink); }
  .rich-area .ProseMirror h3 { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--green); margin: 18px 0 4px; }
  .rich-area .ProseMirror ul, .rich-area .ProseMirror ol { padding-left: 22px; margin: 0 0 12px; }
  .rich-area .ProseMirror li p { margin: 0 0 4px; }
  .rich-area .ProseMirror a { color: var(--green); }
  .rich-area .ProseMirror a.button { display: inline-block; padding: 8px 16px; background: var(--green); color: var(--white); border-radius: 10px 0; text-decoration: none; }
</style>

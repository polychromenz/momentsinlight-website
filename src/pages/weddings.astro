const cf = (path: string) => `https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/${path}/public`;
const chapters = [
  { n: 'Chapter one', title: 'Getting ready', text: 'The nerves, the laughter, and the details you chose with care.', src: cf('2026-sofia-and-john/mono/_Q9A4352-Edit-Edit'), w: 2048, h: 1638, alt: 'Black and white photo of Sofia’s veil being placed in her hair' },
  { n: 'Chapter two', title: 'The ceremony', text: 'Quietly documented, so you can be fully present for it.', src: cf('2025-chiedza-and-foster/colour/_30A9368'), w: 2048, h: 1366, alt: 'Foster kisses Chiedza as the celebrant smiles' },
  { n: 'Chapter three', title: 'Just the two of you', text: 'A mixture of relaxed posed images and casual in-between moments, with a light touch of guidance.', src: cf('2026-tay-and-jesse/colour/_30A8103-Edit'), w: 2048, h: 1366, alt: 'Tay and Jesse sit together in long golden grass' },
  { n: 'Chapter four', title: 'Into the night', text: 'For the reception I move into stealth mode and let the moments unfold: speeches, first dance and the dance floor.', src: cf('2026-felicity-and-ronan/mono/_Q9A0098'), w: 2048, h: 1638, alt: 'Black and white photo of Ronan dipping Felicity during their first dance' },
];

// Short versions of answers on /wedding-faqs.
const faqs = [
  ['How many photos will we get?', 'Every image worth editing is supplied, and for a typical wedding that’s 400+ images. Every one is edited individually by hand, in colour and black and white, covering the whole time I’m there.'],
  ['When will we get our photos?', 'Allow up to 4 weeks, though usually you’ll have them within a couple of weeks.'],
  ['We’re not comfortable in front of the camera. Can you help?', 'We get it. We do a practice run, usually about a month before your wedding, and practise a few easy poses as something to fall back on.'],
  ['What are the payment terms?', 'Just 10% to confirm your booking, with the balance paid later. Card or internet banking.'],
  ['We’re getting married next year. Will the price change?', 'The price we agree when you book is the price you pay.'],
  ['Can we have something different, or a second photographer?', 'Absolutely. No two weddings are the same, and I’m happy to quote for a custom package or a second photographer.'],
];

---
<BaseLayout
  title="Auckland Wedding Photographers | Moments In Light"
  description="Capture the magic of your wedding day with stunning, heartfelt photography. Book your dream wedding photographer today!"
  image={slides[0][0]}
>
  <Slideshow
    hero
    first
    label="Wedding photographs"
    interval={6}
    images={slides.map(([path, w, h], i) => ({ src: path, alt: `Auckland wedding photograph ${i + 1} of ${slides.length}`, width: w, height: h }))}
  >
    <p class="hero-eyebrow">Auckland weddings</p>
    <h1 class="hero-title">Wedding Photography</h1>
  </Slideshow>

  <section class="intro wrap" data-reveal>
    <hr class="hairline" />
    <p class="lead">Every wedding is different, but my approach is to keep things simple, considered, and complete — so you can focus on enjoying the day without worrying about what’s included.</p>
    <p>I offer full-day wedding photography coverage, capturing everything from the preparations through to the evening celebrations. The focus is always on documenting the day naturally, with a calm and unobtrusive approach.</p>
    <p>My packages aim to avoid frustrating limitations, choose a plan and then choose how you use your time. I include everything needed to properly capture your wedding from start to finish.</p>
  </section>

  <section class="offers">
    <div class="wrap inner">
      <div class="head" data-reveal>
        <p class="eyebrow">Two experiences</p>
        <h2 class="display">Everything you need, all included</h2>
      </div>
      <div class="packages" data-stagger>
        {packages.map((p) => (
          <article class:list={['package', { 'package--dark': p.dark }]}>
            <h3>{p.name}</h3>
            <p class="pk-intro">{p.intro}</p>
            <ul>
              {p.items.map(([head, body]) => (
                <li><strong>{head}</strong><span set:html={body} /></li>
              ))}
            </ul>
            <div class="price-row">
              <p class="price"><span>All-inclusive price</span>{p.price} <span class="heart" aria-hidden="true">♥</span></p>
              <a class:list={['btn', p.dark ? 'btn--light' : 'btn--outline']} href="/contact">Enquire</a>
            </div>
          </article>
        ))}
      </div>
      <div class="note" data-reveal>
        <span class="heart" aria-hidden="true">♥</span>
        <p>I don’t watch the clock so if the time allowance is ending as you are cutting the cake, I’m not heading home. These are just a guide; you can always add extra time if needed. The only additional cost you have is that you need to arrange a meal for me, venues are all very used to this as it’s very normal. It’s a long day and vendors need to eat too.</p>
      </div>
    </div>
  </section>

  <section class="chapters wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">How the day unfolds</p>
      <h2 class="display">Your day, chapter by chapter</h2>
    </div>
    {chapters.map((c, i) => (
      <div class:list={['chapter', { 'chapter--flip': i % 2 === 1 }]}>
        <div class="chapter-img" data-reveal="photo"><Img src={c.src} alt={c.alt} width={c.w} height={c.h} sizes="(min-width: 768px) 52vw, 88vw" /></div>
        <div class="chapter-text" data-reveal>
          <p class="chapter-n">{c.n}</p>
          <h3 class="display">{c.title}</h3>
          <p>{c.text}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="review">
    <div class="wrap" data-reveal>
      <ReviewCarousel names={['Mikaela Ellwood', 'Josh Stewart', 'Cerise Brown', 'Tayla Johnson', 'Leah Doolan', 'Jade McQuoid', 'Julia Passmore']} />
    </div>
  </section>

  <section class="stories wrap">
    <div class="stories-head" data-reveal>
      <div>
        <p class="eyebrow">Real weddings with real couples</p>
        <h2 class="display">Love stories</h2>
        <p class="sub">When you contact me I can provide links to the full wedding so you can see what a whole gallery looks like.</p>
      </div>
      <a class="more" href="/wedding-galleries">All love stories →</a>
    </div>
    <LoveStories />
  </section>

  <section class="faq">
    <div class="wrap faq-inner">
      <div class="head" data-reveal>
        <p class="eyebrow">Good to know</p>
        <h2 class="display">Questions couples ask</h2>
      </div>
      <div class="faq-list" data-stagger>
      {faqs.map(([q, a], i) => (
        <details open={i === 0}>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
      </div>
      <p class="all-faqs"><a href="/wedding-faqs">See all questions →</a></p>
    </div>
  </section>

  <section class="cta">
    <div class="wrap" data-reveal>
      <h2 class="display">Is your date still free?</h2>
      <p>Tell me your date and venue, and I’ll let you know.</p>
      <div class="cta-buttons">
        <a class="btn btn--light" href="/contact">Check now to see if your date is available</a>
        <a class="btn btn--outline-light" href="/a-guide-to-your-wedding-photos">How I Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--green); }
  .hero-title { margin: 0; padding: 0; color: var(--ink); font-size: clamp(32px, 3vw + 14px, 60px); font-weight: 300; line-height: 1.08; }

  .intro { max-width: calc(880px + 2 * var(--pad)); margin: 0 auto; padding-block: 72px 64px; text-align: center; }
  .intro .lead { font-size: clamp(19px, 0.7vw + 15px, 26px); font-weight: 300; line-height: 1.55; color: var(--ink); margin-bottom: 1.1em; }
  .intro p { color: #444; line-height: 1.8; }

  .head { text-align: center; margin-bottom: 44px; }
  .head h2 { font-size: clamp(30px, 2.2vw + 18px, 48px); margin: 0; }

  .offers { background: var(--champagne); padding-block: 72px; }
  .inner { max-width: calc(1240px + 2 * var(--pad)); margin: 0 auto; }
  .packages { display: grid; gap: 24px; }
  .package {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 48px 0;
    padding: 36px 26px;
    --line: #eee5d9;
    --sub: #555;
  }
  .package--dark { background: var(--olive); color: var(--champagne); --line: rgb(246 241 234 / 0.16); --sub: #d9d6c6; }
  .package h3 { margin: 0 0 16px; font-size: 13px; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; color: var(--green); }
  .package--dark h3 { color: var(--pale-sage); }
  .pk-intro { line-height: 1.7; color: #444; }
  .package--dark .pk-intro { color: var(--cream); }
  .package ul { list-style: none; margin: 10px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .package li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .package li strong { display: block; font-weight: 600; margin-bottom: 4px; }
  .package li span { display: block; font-size: 15px; line-height: 1.6; color: var(--sub); }
  .package li span :global(strong) { display: inline; margin: 0; }
  .price-row { margin-top: auto; padding-top: 26px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .price { margin: 0; font-size: 46px; font-weight: 300; line-height: 1; }
  .price span:first-child { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #666; }
  .package--dark .price span:first-child { color: var(--pale-sage); }
  .heart { color: var(--sage); font-size: 0.45em; vertical-align: middle; }
  .note { max-width: 900px; margin: 40px auto 0; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; color: #444; line-height: 1.75; }
  .note .heart { font-size: 22px; line-height: 1.2; color: var(--green); }

  .chapters { max-width: calc(1180px + 2 * var(--pad)); margin: 0 auto; padding-block: 80px; display: grid; gap: 56px; }
  .chapters .head { margin-bottom: 0; }
  .chapter { display: grid; gap: 22px; align-items: center; }
  .chapter :global(img) { width: auto; max-width: 100%; height: auto; max-height: 560px; border-radius: 48px 0; margin-inline: auto; }
  .chapter--flip :global(img) { border-radius: 0 48px 0 48px; }
  .chapter-n { margin: 0 0 10px; font-size: 12px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--green); }
  .chapter h3 { font-size: clamp(28px, 1.6vw + 18px, 40px); margin: 0 0 12px; }
  .chapter-text p:last-child { color: #555; line-height: 1.8; }

  .review { background: var(--green); color: var(--champagne); padding-block: 88px; text-align: center; }
  .review .wrap { max-width: calc(1000px + 2 * var(--pad)); margin: 0 auto; }

  .stories { max-width: calc(1240px + 2 * var(--pad)); margin: 0 auto; padding-block: 80px; }
  .stories-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px; margin-bottom: 40px; }
  .stories-head h2 { font-size: clamp(32px, 2.4vw + 18px, 52px); margin: 0 0 14px; }
  .sub { max-width: 620px; color: #555; line-height: 1.7; }
  .more { font-size: 15px; letter-spacing: 0.04em; }

  .faq { background: var(--champagne); padding-block: 72px; }
  .faq-inner { max-width: calc(900px + 2 * var(--pad)); margin: 0 auto; display: grid; gap: 12px; }
  .faq .head { margin-bottom: 20px; }
  .faq-list { display: grid; gap: 12px; }
  details { background: var(--white); border-radius: 24px 0; padding: 22px 26px; transition: box-shadow 0.5s var(--ease), transform 0.5s var(--ease); }
  details:hover { box-shadow: 0 14px 28px -24px rgb(0 0 0 / 0.5); transform: translateY(-2px); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; font-size: 18px; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 24px; font-weight: 300; line-height: 1; color: var(--green); transition: transform 0.5s var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 14px 0 0; line-height: 1.75; color: #444; }
  .all-faqs { text-align: center; margin-top: 16px; }

  .cta { background: var(--olive); color: var(--champagne); padding-block: 88px; text-align: center; }
  .cta h2 { color: var(--champagne); font-size: clamp(30px, 2.4vw + 18px, 54px); margin: 0 0 16px; }
  .cta p { color: var(--cream); }
  .cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 28px; }

  @media (min-width: 768px) {
    .hero-eyebrow { font-size: 13px; margin-bottom: 16px; color: var(--white); }
    .hero-title { color: var(--white); font-size: clamp(26px, 7cqi, 68px); }
    .intro { padding-block: 120px 110px; }
    .offers { padding-block: 120px 100px; }
    .packages { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
    .package { padding: 52px 48px; }
    .price { font-size: 52px; }
    .chapters { padding-block: 130px; gap: 80px; }
    .chapter { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 64px; }
    .chapter--flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
    .chapter--flip .chapter-img { order: 2; }
    .review { padding-block: 130px; }
    .stories { padding-block: 120px; }
    .faq { padding-block: 110px; }
    .cta { padding-block: 120px; }
  }
</style>

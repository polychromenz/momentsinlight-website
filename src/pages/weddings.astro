  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-tay-and-jesse/colour/_30A8112-Edit/public', 2048, 1638],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2025-chiedza-and-foster/colour/_Q9A0630/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-kayla-and-scott/colour/_30A0232/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-mikaela-and-dylan/colour/_30A5527/public', 7807, 5207],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2025-feby-and-steven/colour/_30A8327-Edit/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/_from-website/colour/SOCIAL__MIL1319-Edit-website/public', 2048, 1365],

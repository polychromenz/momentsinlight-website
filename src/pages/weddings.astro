const packages = [
  {
    name: 'The Classic Experience',
    intro: 'You choose how you use the time, along with the support and preparation to feel relaxed and confident in front of the camera.',
    items: [
      ['Full wedding day coverage 6+ hours', 'For those who know exactly what they want. Some couples prioritise the evening and some prioritise getting ready and all those details.'],
      ['Pre-wedding consultation', 'So I understand your vision, I’ll listen to your plans and take that on board.'],
      ['Engagement / practice shoot', 'Get to know me and have professional images for invites and signage etc. (done near to booking). <strong>1 hour shoot</strong> at one of several locations that I know well.'],
      ['Professionally edited high-resolution images', 'In both colour and black and white, having both makes for more compelling galleries and albums.'],
      ['Beautiful curated online gallery for viewing and sharing', 'Easily accessible for you and your loved ones.'],
      ['Travel within Auckland', 'As long as your wedding is in Auckland you are good to go.'],
    ],
    price: '$2,995',
    dark: false,
  },
  {
    name: 'The Deluxe Experience',
    intro: 'This is designed to give you complete coverage of your day, along with the support and preparation to feel relaxed and confident in front of the camera.',
    items: [
      ['Full wedding day coverage 8+ hours', 'Covers from bridal prep, ceremony, bridal party photos and reception, right through to first dance and party time. No need to think about what’s included!'],
      ['Pre-wedding consultation', 'So I understand your vision, I’ll listen to your plans and take that on board.'],
      ['Engagement / practice shoot', 'Get to know me and have professional images for invites and signage etc. (done near to booking). <strong>2 hour shoot</strong> within Auckland.'],

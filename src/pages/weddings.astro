  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-felicity-and-ronan/colour/_Q9A9733/public', 2048, 1365],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/_from-website/colour/SOCIAL__ML26809-website/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-emma-and-corey/colour/_30A4401-Edit/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/_from-website/colour/_30A0762-Edit-website/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-mikaela-and-dylan/colour/_Q9A0973-Edit-2/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/2026-tay-and-jesse/colour/_30A8103-Edit/public', 2048, 1366],
  ['https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/_from-website/colour/_30A0489-website/public', 2048, 1366],

---
// Moments Studio: what visitors do on the site (the site's own visit log, functions/api/visit.js):
// pages, time on each, how far they scroll, where they leave, and the same for Google ad visits.
// Data from functions/api/studio/stats/visits.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
---
<StudioLayout title="Visits" section="visits">

  <main class="stats-page">
    <div class="head">
      <h1>What visitors do</h1>
      <div class="ranges" role="group" aria-label="Period">
        <button type="button" data-days="7">7 days</button>
        <button type="button" data-days="30" class="on">30 days</button>
        <button type="button" data-days="90">90 days</button>
      </div>
    </div>
    <div class="ranges who" role="group" aria-label="Which visitors">
      <button type="button" data-who="all" class="on">Everyone</button>
      <button type="button" data-who="ad">From Google ads</button>
      <button type="button" data-who="other">Everyone else</button>
    </div>
    <p class="status" aria-live="polite">Loading…</p>

    <div class="content" hidden>
      <p class="started note"></p>
      <div class="totals">
        <div class="total"><span class="n" data-total="visits">–</span><span class="l">Visits</span></div>
        <div class="total"><span class="n" data-total="pages">–</span><span class="l">Pages per visit</span></div>
        <div class="total"><span class="n" data-total="secs">–</span><span class="l">Time per visit</span></div>
        <div class="total"><span class="n" data-total="quick">–</span><span class="l">Left straight away</span></div>
      </div>

      <section class="card">
        <h2>Pages</h2>
        <p class="hint">“Left here” is how often this was the last page they looked at. A high number on a page that should lead somewhere (a gallery, Weddings) is where to look first.</p>
        <div class="scroll-x">
          <table class="table pages"><thead><tr><th>Page</th><th>Views</th><th>Landed here</th><th>Time on page</th><th>Scrolled</th><th>Left here</th></tr></thead><tbody></tbody></table>
        </div>
      </section>

      <section class="card">
        <h2>Where they go from the page they land on</h2>
        <table class="table journeys"><thead><tr><th>Landed on → went to</th><th>Visits</th></tr></thead><tbody></tbody></table>
      </section>

      <section class="card ads-card">
        <h2>Google ad visits by keyword</h2>
        <table class="table keywords"><thead><tr><th>Keyword</th><th>Visits</th><th>Pages</th><th>Time</th></tr></thead><tbody></tbody></table>
        <p class="hint">Keywords show once the ads’ Final URL suffix is set in Google Ads.</p>
      </section>
      <p class="note">From the site’s own visit log: no cookies, names or IP addresses; your own browsing (any browser you’ve opened the studio in) isn’t counted. Time on page is time it was on screen. For recordings of real visits, see Microsoft Clarity.</p>
    </div>
  </main>
</StudioLayout>

<script>
  type Page = { path: string; views: number; visits: number; landed: number; exits: number; secs: number | null; scroll: number | null };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const num = (n: number) => Math.round(n).toLocaleString('en-NZ');
  const time = (s: number | null) => (s == null ? '–' : s < 60 ? `${Math.round(s)}s` : `${Math.floor(s / 60)}m ${String(Math.round(s % 60)).padStart(2, '0')}s`);
  const pct = (a: number, b: number) => (b ? `${Math.round((a / b) * 100)}%` : '–');
  let titles: Record<string, string> = {};
  let days = 30, who = 'all';

  const pageNames: Record<string, string> = {
    '/': 'Home', '/weddings': 'Weddings', '/wedding-galleries': 'Love Stories', '/about': 'About', '/contact': 'Contact', '/testimonials': 'Testimonials',
    '/wedding-faqs': 'FAQs', '/wedding-photo-guide': 'Wedding photo guide', '/a-guide-to-your-wedding-photos': 'How I work', '/wedding-resources': 'Wedding resources',
    '/west-auckland-wedding-venues': 'West Auckland venues', '/blog': 'Blog', '/thanks': 'Thank you (enquiry sent)', '/book': 'Book a time', '(left the site)': '(left the site)',
  };
  const name = (path: string) => {
    const p = path.replace(/\/$/, '') || '/';
    if (pageNames[p]) return pageNames[p];
    const m = p.match(/^\/blog\/(?!page\/|category\/|tag\/)([^/]+)$/);
    return (m && titles[m[1]]) || p;
  };
  const link = (p: string) => (p.startsWith('/') ? `<a href="${esc(p)}" target="_blank" rel="noopener">${esc(name(p))}</a>` : esc(name(p)));
  const rows = (sel: string, html: string[], cols: number) => {
    $(`${sel} tbody`).innerHTML = html.length ? html.join('') : `<tr><td colspan="${cols}" class="empty">Nothing yet</td></tr>`;
  };

  async function load() {
    $('.status').textContent = 'Loading…';
    $('.status').hidden = false;
    try {
      const r = await fetch(`/api/studio/stats/visits?days=${days}&who=${who}`);
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || `Something went wrong (${r.status}).`);
      const t = d.totals;
      $('.started').textContent = d.started ? `Counting since ${new Date(d.started).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' })}.` : 'Nothing counted yet: visits appear here as people use the site.';
      $('[data-total="visits"]').textContent = num(t.visits);
      $('[data-total="pages"]').textContent = t.visits ? (Math.round(t.pages * 10) / 10).toString() : '–';
      $('[data-total="secs"]').textContent = t.visits ? time(t.secs) : '–';
      $('[data-total="quick"]').textContent = pct(t.quick, t.visits);
      const max = Math.max(1, ...d.pages.map((p: Page) => p.views));
      rows('.pages', d.pages.map((p: Page) => `<tr><td><span class="bar" style="width:${(p.views / max) * 100}%"></span><span class="label">${link(p.path)}</span></td><td>${num(p.views)}</td><td>${num(p.landed)}</td><td>${time(p.secs)}</td><td>${p.scroll == null ? '–' : `${p.scroll}%`}</td><td${p.views >= 5 && p.exits / p.views > 0.6 ? ' class="high"' : ''}>${pct(p.exits, p.views)}</td></tr>`), 6);
      rows('.journeys', d.journeys.map((j: { landing: string; next: string; n: number }) => `<tr><td>${link(j.landing)} → ${link(j.next)}</td><td>${num(j.n)}</td></tr>`), 2);
      $('.ads-card').hidden = who === 'other';
      rows('.keywords', d.keywords.map((k: { term: string; visits: number; pages: number; secs: number }) => `<tr><td>${esc(k.term)}</td><td>${num(k.visits)}</td><td>${k.pages}</td><td>${time(k.secs)}</td></tr>`), 4);
      $('.content').hidden = false;
      $('.status').hidden = true;
    } catch (err) {
      $('.status').textContent = (err as Error).message;
    }
  }

  const group = (sel: string, set: (b: HTMLButtonElement) => void) => document.querySelectorAll<HTMLButtonElement>(`${sel} button`).forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll(`${sel} button`).forEach((x) => x.classList.toggle('on', x === b));
      set(b);
      load();
    }));
  group('.head .ranges', (b) => { days = Number(b.dataset.days); });
  group('.who', (b) => { who = b.dataset.who!; });

  fetch('/studio/posts.json').then((r) => r.json()).then((d) => {
    titles = Object.fromEntries(d.posts.map((p: { id: string; title: string }) => [p.id, p.title]));
  }).catch(() => {}).finally(load);
</script>

<style>
  .stats-page { max-width: 1100px; margin: 0 auto; padding: 28px clamp(14px, 3vw, 32px) 80px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .head h1 { margin: 0; padding: 0; font-weight: 300; font-size: 32px; color: var(--ink); }
  .ranges { display: flex; gap: 6px; flex-wrap: wrap; }
  .who { margin-bottom: 18px; }
  .ranges button { padding: 8px 14px; border: 1px solid #ddd3c4; border-radius: 999px; background: var(--white); font: inherit; font-size: 14px; cursor: pointer; color: #444; }
  .ranges button.on { background: var(--green); border-color: var(--green); color: var(--white); }
  .status { color: #666; }
  .totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 16px; }
  .total { background: var(--white); border-radius: 24px 0; padding: 18px 22px; display: flex; flex-direction: column; gap: 4px; }
  .total .n { font-size: 32px; font-weight: 300; color: var(--ink); }
  .total .l { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green); font-weight: 500; }
  .card { background: var(--white); border-radius: 24px 0; padding: 18px 22px; margin-bottom: 16px; }
  .card h2 { margin: 0 0 8px; font-weight: 400; font-size: 20px; color: var(--ink); }
  .hint { margin: 0 0 12px; font-size: 13px; color: #888; line-height: 1.5; }
  .scroll-x { overflow-x: auto; }
  .table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .table th { text-align: left; font-weight: 600; color: #777; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; padding: 6px 8px; border-bottom: 1px solid #eee6d9; }
  .table th:not(:first-child), .table :global(td:not(:first-child)) { text-align: right; width: 90px; white-space: nowrap; }
  .table :global(td) { padding: 7px 8px; border-bottom: 1px solid #f3eee6; }
  .table :global(td:first-child) { position: relative; }
  .table :global(td.high) { color: #a8432a; font-weight: 600; }
  .table :global(.bar) { position: absolute; left: 0; top: 4px; bottom: 4px; background: #eef1e4; border-radius: 4px; z-index: 0; }
  .table :global(.label) { position: relative; z-index: 1; }
  .table :global(.empty) { color: #999; text-align: center !important; }
  .note { font-size: 13px; color: #888; line-height: 1.6; }
</style>

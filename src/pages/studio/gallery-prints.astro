---
// Moments Studio > Galleries > Prints (MIL Galleries 3a; functions/api/studio/galleries/prints.js,
// functions-lib/prints.js): print orders from the client galleries (check the crops, download the lab
// files, mark ordered and shipped), the product list from Pic-Time with NZ$ prices, and the settings
// (freight, hold days, and the switch that shows the shop to clients).
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Prints" section="galleries">
  <a slot="bar" class="s-btn s-btn--quiet" href="/studio/galleries">All galleries</a>
  <main class="pr">
    <div class="pr-head">
      <h1>Prints</h1>
      <div class="pr-tabs" role="tablist">
        <button type="button" data-tab="orders" class="on">Orders</button>
        <button type="button" data-tab="products">Products</button>
        <button type="button" data-tab="settings">Settings</button>
      </div>
    </div>
    <p class="pr-live"></p>
    <section data-pane="orders">
      <div class="pr-filter" role="group" aria-label="Show">
        <button type="button" data-show="todo" class="on">To do</button>
        <button type="button" data-show="shipped">Shipped</button>
        <button type="button" data-show="all">All</button>
      </div>
      <div class="pr-orders card"><p class="muted">Loading…</p></div>
      <div class="pr-order card" hidden></div>
    </section>
    <section data-pane="products" hidden>
      <div class="card pr-import">
        <h2>Import from Pic-Time</h2>
        <p class="hint">In Pic-Time: Shop &amp; Automation › Pricing › your price list › Download. Its prices are in A$ (Pic-Time’s “Lab Currency”), already your markup on the lab’s cost. They become tidy NZ$ prices at the rate below; you can change any price afterwards.</p>
        <div class="pr-import-row">
          <label>Price list (CSV) <input type="file" accept=".csv,text/csv" data-csv /></label>
          <label>NZ$ per A$ <input type="number" step="0.0001" min="0.6" max="2" data-rate /></label>
          <label class="check" data-replace-wrap hidden><input type="checkbox" data-replace /> Replace my NZ$ prices too</label>
          <button type="button" class="s-btn s-btn--solid" data-import>Import</button>
        </div>
        <p class="hint rate-note"></p>
      </div>
      <div class="pr-products"></div>
    </section>
    <section data-pane="settings" hidden>
      <form class="card pr-settings" data-settings>
        <label class="pr-switch"><input type="checkbox" name="live" /> <span><strong>Show prints to clients</strong><br />Off: only you see the shop, when you open a gallery with “Open as client” (and you can place test orders there without paying). On: everyone with a gallery link can buy, except galleries with prints switched off on their Details tab.</span></label>
        <div class="three">
          <label>In house prints, tracked post (NZ$) <input name="freight_inhouse" type="number" min="0" step="0.5" /></label>
          <label>In house minimum order (NZ$) <input name="min_inhouse" type="number" min="0" step="1" /></label>
          <label>Free delivery over (NZ$, 0 = never) <input name="free_over" type="number" min="0" step="1" /></label>
        </div>
        <label>Return address on labels <textarea name="return_address" rows="3" placeholder="Moments in Light&#10;Street address&#10;Town postcode"></textarea></label>
        <p class="hint">In house: prints you make on your PRO-10 (lab “In house”, up to A3+), posted by you within New Zealand. When an order’s in-house prints come to less than the minimum, the cart asks the couple to add more before checking out. The return address goes on the 100 × 100 mm address labels (each order’s “Print address label”).</p>
        <p class="hint"><strong>Seldex items</strong> use Seldex’s own published rates at cost, converted at the NZ$ per A$ rate below (from <a href="https://seldex.com.au/shipping-international" target="_blank" rel="noopener">international</a> and <a href="https://seldex.com.au/shipping-australia" target="_blank" rel="noopener">Australian</a> shipping, 19 Nov 2026). New Zealand: A$25, or A$50 once Seldex’s cost for the order is A$500+, plus A$15 for a remote postcode. Australia: Standard A$15 / Express A$25, or A$25 / A$35 over A$100; remote postcodes aren’t charged, you’re told instead. Plus A$15 once per order with a frame or canvas bigger than 20×24″. An order with in-house prints and Seldex items pays both (two parcels). The couple picks the country and postcode in the cart.</p>
        <div class="three">
          <label>Hold orders for (days) <input name="hold_days" type="number" min="0" max="60" /></label>
          <label>NZ$ per A$ (for costs and margins) <input name="rate" type="number" step="0.0001" min="0.6" max="2" /></label>
        </div>
        <p class="hint">Every order waits for you to check it. The hold date is kept so that, once a lab can take orders directly, held orders can go to it automatically when the hold ends.</p>
        <label>Words under the shop <textarea name="intro" rows="3"></textarea></label>
        <p class="hint">The confirmation and “on its way” emails are in Settings › Templates (“Prints order confirmation”, “Prints order on its way”).</p>
        <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save</button></div>
      </form>
    </section>
  </main>
  <dialog class="pr-dlg" data-crop-dlg><div class="pr-crop-body"></div></dialog>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  import { ask, askFields } from '../../studio/dialogs';
  import { mockup, cropEditor, styleMockups, type Product } from '../../prints/mockup';
  import { labFiles } from '../../prints/lab-files';
  import { ratioOf, dpi, money } from '../../../functions-lib/print-pricing.js';
  styleMockups();
  const $ = <T extends HTMLElement = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const day = (d: string) => new Date(d.length > 10 ? d : `${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: d.length > 10 ? 'Pacific/Auckland' : 'UTC' });
  function toast(msg: string, error = false) {
    const t = $('.s-toast'); t.textContent = msg; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4500);
  }
  async function api(url: string, method = 'GET', body?: unknown) {
    const r = await fetch(url, { method, cache: 'no-store', headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Something went wrong.', true); return null; }
    return d;
  }
  const params = new URLSearchParams(location.search);
  let settings: any = {};
  let products: any[] = [];
  let rate: number | null = null;

  // ---- Tabs ----
  function tab(name: string) {
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.classList.toggle('on', b.dataset.tab === name));
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== name));
  }

  // ---- Settings and products ----
  async function loadSetup() {
    const d = await api('/api/studio/galleries/prints?what=setup');
    if (!d) return;
    settings = d.settings; products = d.products; rate = d.rate;
    $('.pr-live').innerHTML = settings.live
      ? '<strong>Prints are on</strong>: clients can buy from their galleries.'
      : '<strong>Only you can see prints for now.</strong> Open a gallery with “Open as client” to try the shop (Settings to switch it on for clients).';
    $('.pr-live').classList.toggle('on', !!settings.live);
    const f = $<HTMLFormElement>('[data-settings]');
    (f.elements.namedItem('live') as HTMLInputElement).checked = !!settings.live;
    for (const k of ['free_over', 'freight_inhouse', 'min_inhouse']) (f.elements.namedItem(k) as HTMLInputElement).value = String((settings[k] ?? 0) / 100);
    (f.elements.namedItem('return_address') as HTMLTextAreaElement).value = settings.return_address ?? '';
    (f.elements.namedItem('hold_days') as HTMLInputElement).value = settings.hold_days;
    (f.elements.namedItem('rate') as HTMLInputElement).value = settings.rate;
    (f.elements.namedItem('intro') as HTMLTextAreaElement).value = settings.intro;
    $<HTMLInputElement>('[data-rate]').value = String(rate ?? settings.rate);
    $('.rate-note').textContent = rate ? `Today’s rate is ${rate.toFixed(4)} (European Central Bank).` : 'Couldn’t get today’s rate: check it before importing.';
    $('[data-replace-wrap]').hidden = !products.length;
    drawProducts();
  }

  const GST = 1.15;
  const margin = (p: any) => {
    if (!p.cost || !p.price) return '';
    const ex = p.price / 100 / GST, cost = p.cost * (p.cost_currency === 'NZD' ? 1 : settings.rate);
    return `${Math.round(((ex - cost) / ex) * 100)}%`;
  };
  const tierText = (p: any) => {
    const t = p.tiers ? JSON.parse(p.tiers) : null;
    return t && t.length > 1 ? t.filter((x: any) => x.q > 1).map((x: any) => `${x.q}+: ${money(x.base)} then ${money(x.add)}`).join(' · ') : '';
  };
  let openCats = new Set<string>(['Prints']);
  function drawProducts() {
    const cats = [...new Set(products.map((p) => p.category))];
    if (!products.length) { $('.pr-products').innerHTML = '<p class="muted card">No products yet. Import your Pic-Time price list above.</p>'; return; }
    $('.pr-products').innerHTML = cats.map((c) => {
      const list = products.filter((p) => p.category === c);
      const on = list.filter((p) => p.active).length;
      const sold = list[0].kind !== 'other';
      return `<details class="card pr-cat" data-cat="${esc(c)}"${openCats.has(c) ? ' open' : ''}>
        <summary><strong>${esc(c)}</strong> <span>${on} of ${list.length} on${sold ? '' : ' · not sold online yet (albums, boxes and sets need more than one photo)'}</span>
          ${sold ? `<span class="pr-cat-btns"><button type="button" class="s-btn s-btn--quiet" data-all="${esc(c)}" data-on="1">All on</button><button type="button" class="s-btn s-btn--quiet" data-all="${esc(c)}" data-on="0">All off</button></span>` : ''}</summary>
        <table class="pr-table"><thead><tr><th>On</th><th>${c === 'Prints' ? 'Paper' : 'Type'}</th><th>Product</th><th>Lab</th><th>Lab cost</th><th>Price NZ$</th><th>Margin</th><th>Bulk prices</th></tr></thead><tbody>
        ${list.map((p) => `<tr data-id="${p.id}">
          <td><input type="checkbox" data-active${p.active ? ' checked' : ''}${sold && p.w_cm ? '' : ' disabled'} aria-label="On" /></td>
          <td>${esc(p.type)}</td><td>${esc(p.name)}</td><td>${esc(p.lab)}</td>
          <td>${p.cost ? `${p.cost_currency === 'AUD' ? 'A$' : p.cost_currency + ' '}${Number(p.cost).toFixed(2)}` : ''}</td>
          <td><input type="number" min="0" step="0.5" value="${(p.price / 100).toFixed(2).replace(/\.00$/, '')}" data-price aria-label="Price" /></td>
          <td>${margin(p)}</td><td class="pr-tiers">${esc(tierText(p))}</td></tr>`).join('')}
        </tbody></table></details>`;
    }).join('');
  }
  $('.pr-products').addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (d.dataset?.cat) d.open ? openCats.add(d.dataset.cat) : openCats.delete(d.dataset.cat);
  }, true);
  $('.pr-products').addEventListener('change', async (e) => {
    const t = e.target as HTMLInputElement;
    const id = Number(t.closest<HTMLElement>('tr')?.dataset.id);
    const p = products.find((x) => x.id === id);
    if (!p) return;
    if (t.matches('[data-active]')) {
      if (await api('/api/studio/galleries/prints', 'PATCH', { products: [id], set: { active: t.checked } })) { p.active = t.checked ? 1 : 0; drawProducts(); }
    }
    if (t.matches('[data-price]')) {
      const price = Math.round(Number(t.value) * 100);
      // The bulk prices keep their later steps; the first step is the new single price.
      const tiers = p.tiers ? JSON.parse(p.tiers) : null;
      if (tiers?.length) { tiers[0].base = price; tiers[0].add = price; }
      if (await api('/api/studio/galleries/prints', 'PATCH', { products: [id], set: { price, keep_tiers: true, ...(tiers ? { tiers } : {}) } })) {
        p.price = price; if (tiers) p.tiers = JSON.stringify(tiers); drawProducts(); toast('Price saved.');
      }
    }
  });
  $('.pr-products').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-all]');
    if (!b) return;
    e.preventDefault();
    const ids = products.filter((p) => p.category === b.dataset.all && p.w_cm).map((p) => p.id);
    const on = b.dataset.on === '1';
    if (await api('/api/studio/galleries/prints', 'PATCH', { products: ids, set: { active: on } })) {
      products.forEach((p) => { if (ids.includes(p.id)) p.active = on ? 1 : 0; });
      drawProducts();
    }
  });

  // A CSV line → fields (quotes, commas inside quotes, "" for a quote).
  function csv(text: string): Record<string, string>[] {
    const rows: string[][] = [];
    let row: string[] = [], f = '', q = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (q) { if (c === '"' && text[i + 1] === '"') { f += '"'; i++; } else if (c === '"') q = false; else f += c; }
      else if (c === '"') q = true;
      else if (c === ',') { row.push(f); f = ''; }
      else if (c === '\n' || c === '\r') { if (c === '\r' && text[i + 1] === '\n') i++; row.push(f); rows.push(row); row = []; f = ''; }
      else f += c;
    }
    if (f || row.length) { row.push(f); rows.push(row); }
    const head = rows.shift()?.map((h) => h.replace(/^﻿/, '').trim()) ?? [];
    return rows.filter((r) => r.length > 2).map((r) => Object.fromEntries(head.map((h, k) => [h, r[k] ?? ''])));
  }
  $('[data-import]').addEventListener('click', async () => {
    const file = $<HTMLInputElement>('[data-csv]').files?.[0];
    if (!file) return toast('Choose the price list file first.', true);
    const rows = csv(await file.text());
    if (!rows.length || !('Product' in rows[0]) || !('Option' in rows[0])) return toast('That doesn’t look like a Pic-Time price list.', true);
    const r = Number($<HTMLInputElement>('[data-rate]').value);
    const replace = $<HTMLInputElement>('[data-replace]').checked;
    if (replace && !await ask('Replace your NZ$ prices with ones worked out from this file? Prices you changed by hand will be overwritten.')) return;
    const btn = $<HTMLButtonElement>('[data-import]');
    btn.disabled = true; btn.textContent = 'Importing…';
    const d = await api('/api/studio/galleries/prints', 'POST', { action: 'import', rows, rate: r, replace_prices: replace });
    btn.disabled = false; btn.textContent = 'Import';
    if (d) { toast(`Imported: ${d.added} new, ${d.updated} updated.`); loadSetup(); }
  });

  $('[data-settings]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const live = !!f.get('live');
    if (live && !settings.live && !await ask('Show prints to clients? Everyone with a gallery link will be able to order and pay from now on.')) return;
    const d = await api('/api/studio/galleries/prints', 'PUT', { settings: {
      live, freight_inhouse: Math.round(Number(f.get('freight_inhouse')) * 100), min_inhouse: Math.round(Number(f.get('min_inhouse')) * 100), return_address: f.get('return_address'),
      free_over: Math.round(Number(f.get('free_over')) * 100), hold_days: f.get('hold_days'), rate: f.get('rate'), intro: f.get('intro'),
    } });
    if (d) { toast('Saved.'); loadSetup(); }
  });

  // ---- Orders ----
  const STATUS: Record<string, string> = { pending: 'Not paid', paid: 'To check', approved: 'Checked', ordered: 'At the lab', shipped: 'Shipped', cancelled: 'Cancelled' };
  let orders: any[] = [];
  let show = 'todo';
  let current: any = null;
  async function loadOrders() {
    const d = await api('/api/studio/galleries/prints?what=orders');
    if (!d) return;
    orders = d.orders;
    drawOrders();
  }
  function drawOrders() {
    const list = orders.filter((o) => show === 'all' || (show === 'shipped' ? ['shipped', 'cancelled'].includes(o.status) : ['paid', 'approved', 'ordered'].includes(o.status)));
    $('.pr-orders').innerHTML = list.length ? `<table class="pr-table pr-olist"><thead><tr><th>Order</th><th>Date</th><th>Gallery</th><th>From</th><th>Prints</th><th>Total</th><th>Status</th></tr></thead><tbody>
      ${list.map((o) => `<tr data-order="${o.id}" class="${current?.order.id === o.id ? 'on' : ''}"><td><strong>${esc(o.number)}</strong>${o.test ? ' <span class="pill pill--test">Test</span>' : ''}</td><td>${day(o.paid_at || o.created_at)}</td>
        <td>${esc(o.gallery)}</td><td>${esc(o.name || o.email || '')}<small>${o.buyer_kind === 'main_client' ? 'the couple' : o.buyer_kind === 'studio' ? 'you' : o.buyer_kind ?? ''}</small></td>
        <td>${o.prints}</td><td>${money(o.total)}</td><td><span class="pill pill--${o.status}">${STATUS[o.status] ?? o.status}</span>${o.status === 'paid' && o.hold_until ? `<small>hold until ${day(o.hold_until)}</small>` : ''}</td></tr>`).join('')}
      </tbody></table>` : `<p class="muted">${show === 'todo' ? 'No orders waiting.' : 'No orders here yet.'}</p>`;
  }
  async function openOrder(id: number) {
    const d = await api(`/api/studio/galleries/prints?order=${id}`);
    if (!d) return;
    current = d;
    history.replaceState(null, '', `?order=${id}`);
    drawOrder();
    drawOrders();
    $('.pr-order').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  const sizeOf = (p: any, land: boolean) => (land ? `${p.h_cm} × ${p.w_cm} cm` : `${p.w_cm} × ${p.h_cm} cm`);
  function drawOrder() {
    const { order: o, items, gallery: g } = current;
    const a = o.address ?? {};
    const el = $('.pr-order');
    el.hidden = false;
    const labs = [...new Set(items.map((i: any) => i.product.lab))];
    el.innerHTML = `<div class="po-head"><h2>${esc(o.number)} ${o.test ? '<span class="pill pill--test">Test order</span>' : ''}<span class="pill pill--${o.status}">${STATUS[o.status]}</span></h2>
        <button type="button" class="s-btn s-btn--quiet" data-close-order>Close</button></div>
      <div class="po-grid">
        <div><h3>Deliver to</h3><p>${esc(a.name || o.name)}<br />${[a.line1, a.line2, a.city, a.state, a.postal_code].filter(Boolean).map(esc).join('<br />')}${a.country && a.country !== 'NZ' ? `<br />${esc(a.country)}` : ''}</p>
          <p>${o.email ? `<a href="mailto:${esc(o.email)}">${esc(o.email)}</a>` : ''}${o.phone ? `<br />${esc(o.phone)}` : ''}</p></div>
        <div><h3>Order</h3><p>From <a href="/studio/gallery?id=${esc(g?.id)}">${esc(g?.name)}</a> (${o.buyer_kind === 'main_client' ? 'the couple' : o.buyer_kind === 'studio' ? 'you, testing' : esc(o.buyer_kind)})<br />
          Paid ${o.paid_at ? day(o.paid_at) : '—'} · ${money(o.total)}${o.freight ? ` incl. ${money(o.freight)} delivery` : ''}<br />
          ${o.hold_until && o.status === 'paid' ? `On hold until ${day(o.hold_until)}<br />` : ''}${o.invoice_id ? 'Invoice made (receipt and Xero).' : o.test ? 'Test: no payment or invoice.' : 'No invoice (not the couple’s own link): record it in Xero yourself.'}</p>
          ${o.note ? `<p class="po-note"><strong>Their note:</strong> ${esc(o.note)}</p>` : ''}</div>
        <div><h3>Lab</h3><p>${labs.map(esc).join(', ')}${o.lab_ref ? `<br />Lab order: ${esc(o.lab_ref)}` : ''}${o.tracking ? `<br />Tracking: ${esc(o.tracking)}` : ''}</p>
          ${o.delivery ? `<p>${(o.delivery.parts ?? []).map((x: any) => `${esc(x.lab)} delivery: ${esc(x.label)} ${money(x.amount)}`).join('<br />')}${o.delivery.dest ? `<br /><span class="muted">Worked out for ${o.delivery.dest.country === 'AU' ? 'Australia' : 'New Zealand'} ${esc(o.delivery.dest.postcode)}</span>` : ''}</p>${(o.delivery.notes ?? []).map((n: string) => `<p class="po-note"><strong>Check:</strong> ${esc(n)}</p>`).join('')}` : ''}</div>
      </div>
      <ul class="po-items">${items.map((i: any) => {
        const land = !!i.crop?.landscape;
        const d = i.w && i.crop ? dpi(i.w, i.crop, i.product, land) : 0;
        return `<li data-item="${i.id}"><div class="po-mk" data-mk="${i.id}"></div><div class="po-what"><strong>${i.qty} × ${esc(i.product.category)} · ${esc(i.product.type)}</strong>
          <span>${esc(sizeOf(i.product, land))} · ${esc(i.product.lab)} · ${money(i.amount)}</span>${i.product.lab_item ? `<span class="po-file">Order: ${esc(i.product.lab_item)}</span>` : ''}<span class="po-file">${esc(i.filename ?? '')}${d ? ` · about ${Math.round(d)} dpi${d < 150 ? ' <b class="po-low">low</b>' : ''}` : ''}</span>
          <button type="button" class="s-btn s-btn--quiet" data-recrop="${i.id}">Adjust crop</button></div></li>`;
      }).join('')}</ul>
      <label class="po-tony">Your note (only you see it) <textarea rows="2" data-tony-note>${esc(o.tony_note ?? '')}</textarea></label>
      <div class="po-actions">
        <button type="button" class="s-btn" data-lab>Download lab files</button>
        <button type="button" class="s-btn" data-label>Print address label</button>
        ${o.status === 'paid' ? '<button type="button" class="s-btn s-btn--solid" data-step="approved">Crops checked</button>' : ''}
        ${['paid', 'approved'].includes(o.status) ? '<button type="button" class="s-btn s-btn--solid" data-step="ordered">Ordered from the lab</button>' : ''}
        ${['paid', 'approved', 'ordered'].includes(o.status) ? '<button type="button" class="s-btn s-btn--solid" data-step="shipped">Shipped</button>' : ''}
        ${!['cancelled', 'shipped'].includes(o.status) ? '<button type="button" class="s-btn s-btn--quiet" data-step="cancelled">Cancel order</button>' : ''}
        <span class="po-progress"></span>
      </div>`;
    requestAnimationFrame(() => el.querySelectorAll<HTMLElement>('[data-mk]').forEach((m) => {
      const i = items.find((x: any) => String(x.id) === m.dataset.mk);
      if (i?.crop) m.innerHTML = mockup(i.product as Product, i.web, i.crop, !!i.crop.landscape, 150, 150);
    }));
  }
  /** The address label for the Zebra GC420t (100 × 100 mm roll): opens a page sized to the label
   *  and the print dialog; choose the Zebra there. */
  function printLabel() {
    const { order: o } = current;
    const a = o.address ?? {};
    const lines = [a.line1, a.line2, [a.city, a.postal_code].filter(Boolean).join(' '), a.state, a.country && a.country !== 'NZ' ? (a.country === 'AU' ? 'AUSTRALIA' : a.country) : ''].filter(Boolean);
    const from = String(settings.return_address ?? '').trim();
    const w = window.open('', '_blank', 'width=480,height=520');
    if (!w) { alert('Your browser blocked the label window. Allow pop-ups for this site and try again.'); return; }
    w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(o.number)} label</title><style>
      @page { size: 100mm 100mm; margin: 0 }
      html, body { margin: 0; padding: 0 }
      body { width: 100mm; height: 100mm; box-sizing: border-box; padding: 6mm 6mm 5mm; font-family: Arial, Helvetica, sans-serif; color: #000; display: flex; flex-direction: column }
      .top { display: flex; justify-content: space-between; align-items: baseline; border-bottom: .4mm solid #000; padding-bottom: 2mm; font-size: 9pt; letter-spacing: .08em }
      .top b { font-size: 11pt; letter-spacing: .12em }
      .to { flex: 1; padding-top: 4mm }
      .to small { display: block; font-size: 8pt; letter-spacing: .1em; margin-bottom: 1.5mm }
      .name { font-size: 15pt; font-weight: bold; line-height: 1.15 }
      .addr { font-size: 13pt; line-height: 1.25; margin-top: 1mm }
      .phone { font-size: 10pt; margin-top: 2mm }
      .from { border-top: .3mm solid #000; padding-top: 2mm; font-size: 8pt; line-height: 1.3; white-space: pre-line }
      .from b { letter-spacing: .1em }
      @media screen { body { margin: 10px auto; outline: 1px dashed #999 } }
    </style></head><body>
      <div class="top"><b>MOMENTS IN LIGHT</b><span>${esc(o.number)}</span></div>
      <div class="to"><small>DELIVER TO</small><div class="name">${esc(a.name || o.name || '')}</div><div class="addr">${lines.map(esc).join('<br>')}</div>${o.phone ? `<div class="phone">${esc(o.phone)}</div>` : ''}</div>
      ${from ? `<div class="from"><b>IF UNDELIVERED, RETURN TO</b>\n${esc(from)}</div>` : ''}
      <script>window.onload = () => { window.print(); };<\/script></body></html>`);
    w.document.close();
  }
  function sheet() {
    const { order: o, items, gallery: g } = current;
    const a = o.address ?? {};
    return [`Moments in Light print order ${o.number}`, `Gallery: ${g?.name ?? ''}`, '', 'Deliver to:', a.name || o.name, a.line1, a.line2, [a.city, a.postal_code].filter(Boolean).join(' '), a.country, o.phone ? `Phone: ${o.phone}` : '', o.email ? `Email: ${o.email}` : '', '',
      'Prints:', ...items.map((i: any, k: number) => `${String(k + 1).padStart(2, '0')}. ${i.qty} x ${i.product.lab}: ${i.product.category} ${i.product.type} ${sizeOf(i.product, !!i.crop?.landscape)} (${i.product.name})${i.product.lab_item ? `\n    Order: ${i.product.lab_item}` : ''}`),
      '', o.note ? `Their note: ${o.note}` : ''].filter((x) => x !== undefined && x !== null).join('\n');
  }
  async function step(next: string) {
    const o = current.order;
    let extra: any = {};
    if (next === 'ordered') {
      const r = await askFields('Ordered from the lab', [{ name: 'lab_ref', label: 'Lab order number (optional)', value: o.lab_ref ?? '' }]);
      if (!r) return; extra = r;
    }
    if (next === 'shipped') {
      const r = await askFields('Mark as shipped: an email tells them it’s on its way.', [{ name: 'tracking', label: 'Tracking number or link (optional)', value: o.tracking ?? '' }, { name: 'email', label: 'Send the “on its way” email? (yes or no)', value: 'yes' }]);
      if (!r) return; extra = { tracking: r.tracking, email: !/^n/i.test(r.email || '') };
    }
    if (next === 'cancelled' && !await ask(`Cancel ${o.number}? This doesn’t refund the payment: refund it in Stripe (Payments › the payment › Refund)${o.invoice_id ? ', and credit the invoice in Xero' : ''}.`)) return;
    const d = await api('/api/studio/galleries/prints', 'POST', { action: 'order', id: o.id, status: next, tony_note: $<HTMLTextAreaElement>('[data-tony-note]').value, ...extra });
    if (!d) return;
    current.order = d.order;
    toast(next === 'shipped' ? (d.emailed ? 'Marked shipped, and the email has gone.' : 'Marked shipped.') : 'Saved.');
    drawOrder(); loadOrders();
  }
  async function recrop(itemId: number) {
    const i = current.items.find((x: any) => x.id === itemId);
    const land = !!i.crop?.landscape;
    const dlg = $<HTMLDialogElement>('[data-crop-dlg]');
    let c = i.crop;
    $('.pr-crop-body', dlg).innerHTML = `<h2>Adjust the crop</h2><p class="hint">${esc(i.product.category)} · ${esc(sizeOf(i.product, land))}. Drag the box; zoom with the slider.</p>
      <div class="pr-crop-stage"></div><label class="pr-zoom">Zoom <input type="range" min="0" max="1" step="0.01" data-z /></label>
      <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-crop-cancel>Cancel</button><button type="button" class="s-btn s-btn--solid" data-crop-save>Save crop</button></div>`;
    dlg.showModal();
    const ed = cropEditor($('.pr-crop-stage', dlg), i.web, i.w / i.h, ratioOf(i.product, land), i.crop, (nc) => (c = nc), i.product.kind === 'circle');
    const z = $<HTMLInputElement>('[data-z]', dlg); z.value = String(ed.zoomOf()); z.oninput = () => ed.zoom(Number(z.value));
    $('[data-crop-cancel]', dlg).onclick = () => dlg.close();
    $('[data-crop-save]', dlg).onclick = async () => {
      const d = await api('/api/studio/galleries/prints', 'POST', { action: 'crop', item_id: i.id, crop: c, landscape: land });
      if (d) { i.crop = d.item.crop; dlg.close(); drawOrder(); toast('Crop saved.'); }
    };
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const b = (s: string) => t.closest<HTMLElement>(s);
    let x: HTMLElement | null;
    if ((x = b('[data-tab]'))) { tab(x.dataset.tab!); return; }
    if ((x = b('[data-show]'))) { show = x.dataset.show!; document.querySelectorAll('[data-show]').forEach((y) => y.classList.toggle('on', y === x)); drawOrders(); return; }
    if ((x = b('[data-order]'))) { openOrder(Number(x.dataset.order)); return; }
    if (b('[data-label]')) return printLabel();
    if (b('[data-close-order]')) { current = null; $('.pr-order').hidden = true; history.replaceState(null, '', location.pathname); drawOrders(); return; }
    if ((x = b('[data-step]'))) { step(x.dataset.step!); return; }
    if ((x = b('[data-recrop]'))) { recrop(Number(x.dataset.recrop)); return; }
    if (b('[data-lab]')) {
      const btn = b('[data-lab]') as HTMLButtonElement;
      btn.disabled = true;
      try {
        await labFiles(current.order, current.items, sheet(), (n, of) => ($('.po-progress').textContent = n < of ? `Making the lab files: ${n} of ${of}…` : 'Done: the ZIP is downloading.'));
      } catch (err) { toast((err as Error).message, true); $('.po-progress').textContent = ''; }
      btn.disabled = false;
    }
  });
  addEventListener('focusout', async (e) => {
    const t = e.target as HTMLElement;
    if (t.matches?.('[data-tony-note]') && current && (t as HTMLTextAreaElement).value !== (current.order.tony_note ?? '')) {
      const d = await api('/api/studio/galleries/prints', 'POST', { action: 'order', id: current.order.id, tony_note: (t as HTMLTextAreaElement).value });
      if (d) { current.order = d.order; toast('Note saved.'); }
    }
  });

  loadSetup();
  loadOrders().then(() => { if (params.get('order')) openOrder(Number(params.get('order'))); });
  if (params.get('tab')) tab(params.get('tab')!);
</script>


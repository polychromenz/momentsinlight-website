---
// Moments Studio home: the dashboard. Totals for a date range (compared with a year earlier),
// leads vs booked by month, where leads came from, and the lists to act on: upcoming shoots,
// recent leads, payments, tasks. Data from functions/api/studio/crm/dashboard.js.
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Dashboard" section="dashboard">
  <button slot="bar" type="button" class="s-btn s-btn--quiet" data-digest>✉ Email me today’s summary</button>
  <div class="test-banner" hidden><strong>TEST MODE</strong>: client emails are redirected to you, nothing reaches a client. It switches to live only when you set CRM_SEND_MODE to “live” in Cloudflare.</div>
  <main class="dash">
    <div class="dash-tools">
      <select class="dash-type" aria-label="Job type"><option value="">All job types</option></select>
      <div class="dash-ranges" role="group" aria-label="Date range">
        <button type="button" data-range="7">7 days</button>
        <button type="button" data-range="30" class="on">30 days</button>
        <button type="button" data-range="mtd">This month</button>
        <button type="button" data-range="ytd">This year</button>
        <button type="button" data-range="custom">Choose dates</button>
      </div>
      <div class="dash-custom" hidden>
        <input type="date" class="dash-from" aria-label="From" /> to <input type="date" class="dash-to" aria-label="To" />
      </div>
    </div>
    <p class="status" aria-live="polite">Loading…</p>

    <div class="content" hidden>
      <div class="tiles">
        <a class="tile" href="/studio/crm"><span class="tile-label">New leads</span><strong class="t-leads"></strong><small class="c-leads"></small></a>
        <a class="tile" href="/studio/crm"><span class="tile-label">Won (booked)</span><strong class="t-booked"></strong><small class="c-booked"></small></a>
        <div class="tile"><span class="tile-label">Lost</span><strong class="t-lost"></strong><small class="c-lost"></small></div>
        <div class="tile"><span class="tile-label">Conversion</span><strong class="t-conv"></strong><small class="c-conv"></small></div>
        <div class="tile"><span class="tile-label">Payments received</span><strong class="t-payments"></strong><small class="c-payments"></small></div>
        <div class="tile"><span class="tile-label">Value booked</span><strong class="t-value"></strong><small class="c-value"></small></div>
      </div>

      <section class="card ads-home" hidden></section>
      <section class="card gi-home"></section>

      <div class="charts">
        <section class="card">
          <h2>Leads and bookings</h2>
          <p class="legend"><span class="key key--leads"></span>Leads <span class="key key--booked"></span>Booked</p>
          <div class="line-chart"></div>
        </section>
        <section class="card">
          <h2>Where leads came from</h2>
          <div class="pie-wrap"><div class="pie"></div><ul class="pie-legend"></ul></div>
        </section>
      </div>

      <section class="card perf">
        <h2>Month by month</h2>
        <p class="hint">By the month they enquired: how many enquiries came in, and what became of them. The last 12 months.</p>
        <div class="perf-wrap"><table class="perf-table"><thead><tr><th>Month</th><th>Enquiries</th><th>Won</th><th>Lost</th><th>Still deciding</th><th>Conversion</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
      </section>
      <div class="charts">
        <section class="card"><h2>How soon they book</h2><p class="hint">Time from enquiry to booking, last 12 months.</p><div class="bars speed"></div></section>
        <section class="card"><h2>How far ahead they book</h2><p class="hint">Time from booking to their date, last 12 months.</p><div class="bars ahead"></div></section>
      </div>

      <div class="lists">
        <section class="card" data-list="shoots"><div class="card-head"><h2>Upcoming weddings and shoots</h2></div><ul></ul><div class="pager"></div></section>
        <section class="card" data-list="leads"><div class="card-head"><h2>Recent leads</h2><a class="s-btn s-btn--quiet" href="/studio/crm?add=1">+ Add client</a></div><ul></ul><div class="pager"></div></section>
        <section class="card" data-list="payments"><div class="card-head"><h2>Payments due</h2></div><ul></ul><div class="pager"></div></section>
        <section class="card" data-list="tasks"><div class="card-head"><h2>Tasks</h2><button type="button" class="s-btn s-btn--quiet" data-add-task>+ Add task</button></div><ul></ul><div class="pager"></div></section>
      </div>
      <p class="note">Counts cover enquiries made through the new system. Your Studio Ninja history will show here once it's brought across.</p>
    </div>
  </main>
</StudioLayout>

<script>
  import { askText, askFields } from '../../studio/dialogs';
  import { drawGalleryInsights } from '../../studio/gallery-insights';
  drawGalleryInsights(document.querySelector<HTMLElement>('.gi-home')!);
  // Google Ads at a glance (functions-lib/ads-summary.js); hidden for anyone without the Ads area.
  fetch('/api/studio/crm/ads-summary').then((r) => (r.ok ? r.json() : null)).then((s) => {
    if (!s) return;
    const el = document.querySelector<HTMLElement>('.ads-home')!;
    const m = (c: number) => `$${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const each = (cost: number, conv: number) => (conv >= 1 ? `${m(cost / conv)} each` : 'no enquiries yet');
    const y = s.yesterday, w = s.week, mo = s.month;
    el.innerHTML = `<div class="card-head"><h2>Google Ads</h2><a class="s-btn s-btn--quiet" href="/studio/seo/ads">Details</a></div>
      ${s.warnings.map((x: string) => `<p class="ads-warn">${x.replace(/[&<>]/g, '')}</p>`).join('')}
      <div class="ads-tiles">
        <div><span>Yesterday</span><strong>${y.has ? y.impr : '–'}</strong><small>impressions · ${y.has ? `${y.clicks} clicks · ${m(y.cost)}` : 'no data'}</small></div>
        <div><span>A usual day (last 7)</span><strong>${w.days ? Math.round(w.avg.impr) : '–'}</strong><small>impressions · ${m(w.avg.cost)} a day</small></div>
        <div><span>This month</span><strong>${m(mo.cost)}</strong><small>${Math.round(mo.conv * 10) / 10} enquiries · ${each(mo.cost, mo.conv)}</small></div>
      </div>`;
    el.hidden = false;
  }).catch(() => {});
  const $ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (c: number) => `$${Math.round(c / 100).toLocaleString('en-NZ')}`;
  const day = (d: string) => new Date(`${d.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  const ago = (iso: string) => {
    const days = Math.round((new Date().setHours(0, 0, 0, 0) - new Date(iso).setHours(0, 0, 0, 0)) / 86400_000);
    return days === 0 ? 'today' : days === 1 ? 'yesterday' : days > 0 ? `${days} days ago` : days === -1 ? 'tomorrow' : `in ${-days} days`;
  };
  const PAGE = 5;

  let range = '30';
  let type = '';
  const pages: Record<string, number> = { shoots: 0, leads: 0, payments: 0, tasks: 0 };
  let rows: Record<string, string[]> = {};

  // The range's start and end, as moments in NZ time (Tony's computer is in NZ).
  function bounds() {
    const now = new Date();
    const start = new Date(now); start.setHours(0, 0, 0, 0);
    let from: Date, to = new Date(start.valueOf() + 86400_000);
    if (range === '7' || range === '30') from = new Date(start.valueOf() - (Number(range) - 1) * 86400_000);
    else if (range === 'mtd') from = new Date(now.getFullYear(), now.getMonth(), 1);
    else if (range === 'ytd') from = new Date(now.getFullYear(), 0, 1);
    else {
      const f = $<HTMLInputElement>('.dash-from').value, t = $<HTMLInputElement>('.dash-to').value;
      from = f ? new Date(`${f}T00:00:00`) : new Date(start.valueOf() - 29 * 86400_000);
      if (t) to = new Date(new Date(`${t}T00:00:00`).valueOf() + 86400_000);
    }
    return { from: from.toISOString(), to: to.toISOString() };
  }

  const compare = (now: number, before: number, fmt = (n: number) => String(n)) =>
    before === 0 && now === 0 ? 'Same as a year ago' : before === 0 ? `Up from 0 a year ago` : `${now >= before ? '▲' : '▼'} ${Math.abs(Math.round(((now - before) / before) * 100))}% on a year ago (${fmt(before)})`;

  function lineChart(data: { month: string; leads: number; booked: number }[]) {
    const W = 640, H = 220, L = 30, B = 26, T = 10, R = 10;
    const max = Math.max(4, ...data.map((d) => Math.max(d.leads, d.booked)));
    const top = Math.ceil(max / 4) * 4;
    const x = (i: number) => L + (i * (W - L - R)) / (data.length - 1);
    const y = (v: number) => T + (H - T - B) * (1 - v / top);
    const path = (k: 'leads' | 'booked') => data.map((d, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(d[k]).toFixed(1)}`).join('');
    const area = (k: 'leads' | 'booked') => `${path(k)}L${x(data.length - 1)},${y(0)}L${x(0)},${y(0)}Z`;
    const grid = [0, 1, 2, 3, 4].map((i) => { const v = (top / 4) * i; return `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" class="g"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v}</text>`; }).join('');
    const labels = data.map((d, i) => `<text x="${x(i)}" y="${H - 6}" text-anchor="middle">${new Date(`${d.month}-15T12:00:00Z`).toLocaleDateString('en-NZ', { month: 'short', timeZone: 'UTC' })}</text>`).join('');
    const dots = (k: 'leads' | 'booked') => data.map((d, i) => `<circle cx="${x(i)}" cy="${y(d[k])}" r="3" class="d-${k}"><title>${d.month}: ${d[k]} ${k}</title></circle>`).join('');
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Leads and bookings by month">${grid}${labels}
      <path d="${area('leads')}" class="a-leads"/><path d="${path('leads')}" class="l-leads" pathLength="1"/>
      <path d="${area('booked')}" class="a-booked"/><path d="${path('booked')}" class="l-booked" pathLength="1"/>${dots('leads')}${dots('booked')}</svg>`;
  }

  const COLOURS = ['#5a5e3b', '#b9a27a', '#8c9a6b', '#d7c3a1', '#3e4229', '#a8432a', '#7d8ca8', '#c9b8d8'];
  function pie(data: { source: string; n: number }[]) {
    const total = data.reduce((a, d) => a + d.n, 0);
    if (!total) return ['<p class="empty">No leads in this range.</p>', ''];
    let a0 = -Math.PI / 2;
    const slices = data.map((d, i) => {
      const a1 = a0 + (d.n / total) * Math.PI * 2;
      const big = a1 - a0 > Math.PI ? 1 : 0;
      const p = (a: number, r: number) => `${(100 + r * Math.cos(a)).toFixed(2)},${(100 + r * Math.sin(a)).toFixed(2)}`;
      const shape = d.n === total ? `<circle cx="100" cy="100" r="90" fill="${COLOURS[i % 8]}"/>` : `<path d="M${p(a0, 90)}A90,90 0 ${big} 1 ${p(a1, 90)}L100,100Z" fill="${COLOURS[i % 8]}"><title>${esc(d.source)}: ${d.n}</title></path>`;
      a0 = a1;
      return shape;
    }).join('');
    return [`<svg viewBox="0 0 200 200" role="img" aria-label="Lead sources">${slices}<circle cx="100" cy="100" r="48" fill="#fff"/><text x="100" y="98" text-anchor="middle" class="pie-n">${total}</text><text x="100" y="116" text-anchor="middle" class="pie-l">leads</text></svg>`,
      data.map((d, i) => `<li><span class="key" style="background:${COLOURS[i % 8]}"></span>${esc(d.source)} <small>${d.n} (${Math.round((d.n / total) * 100)}%)</small></li>`).join('')];
  }

  function renderList(name: string) {
    const sec = $(`[data-list="${name}"]`);
    const all = rows[name] ?? [];
    const pages_ = Math.max(1, Math.ceil(all.length / PAGE));
    pages[name] = Math.min(pages[name], pages_ - 1);
    $('ul', sec).innerHTML = all.length ? all.slice(pages[name] * PAGE, pages[name] * PAGE + PAGE).join('') : `<li class="empty">${({ shoots: 'Nothing booked coming up.', leads: 'No open leads.', payments: 'Nothing owing.', tasks: 'Nothing to do. Nice!' } as Record<string, string>)[name]}</li>`;
    $('.pager', sec).innerHTML = pages_ > 1 ? `<button type="button" data-page="-1" ${pages[name] === 0 ? 'disabled' : ''} aria-label="Previous">‹</button><span>${pages[name] + 1} of ${pages_}</span><button type="button" data-page="1" ${pages[name] >= pages_ - 1 ? 'disabled' : ''} aria-label="Next">›</button>` : '';
  }

  async function load() {
    const { from, to } = bounds();
    const r = await fetch(`/api/studio/crm/dashboard?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}&type=${encodeURIComponent(type)}`);
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { $('.status').textContent = d.error || `Something went wrong (${r.status}).`; $('.status').hidden = false; return; }
    $('.test-banner').hidden = d.mode === 'live';
    const sel = $<HTMLSelectElement>('.dash-type');
    if (sel.options.length === 1) sel.append(...d.types.map((t: string) => new Option(t, t)));

    const t = d.totals, b = d.before;
    $('.t-leads').textContent = t.leads; $('.c-leads').textContent = compare(t.leads, b.leads);
    $('.t-booked').textContent = t.booked; $('.c-booked').textContent = compare(t.booked, b.booked);
    $('.t-lost').textContent = t.lost; $('.c-lost').textContent = compare(t.lost, b.lost);
    // Conversion: of the enquiries in this period, how many booked.
    const conv = (x: any) => (x.leads ? Math.round((x.cohort_won / x.leads) * 100) : null);
    const cNow = conv(t), cBefore = conv(b);
    $('.t-conv').textContent = cNow === null ? '–' : `${cNow}%`;
    $('.c-conv').textContent = t.leads ? `${t.cohort_won} of ${t.leads} enquiries booked${t.cohort_open ? ` · ${t.cohort_open} still deciding` : ''}${cBefore !== null ? ` · a year ago ${cBefore}%` : ''}` : 'No enquiries in this period';

    // Month by month.
    const pct = (won: number, n: number) => (n ? `${Math.round((won / n) * 100)}%` : '–');
    const mrows = d.monthly.slice().reverse();
    $('.perf-table tbody').innerHTML = mrows.map((r: any) => `<tr><td>${new Date(`${r.month}-15T12:00:00Z`).toLocaleDateString('en-NZ', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</td><td>${r.enquiries || '–'}</td><td>${r.won || '–'}</td><td>${r.lost || '–'}</td><td>${r.open || '–'}</td><td><span class="conv-bar" style="--w:${r.enquiries ? Math.round((r.won / r.enquiries) * 100) : 0}%"></span>${pct(r.won, r.enquiries)}</td></tr>`).join('');
    const sum = (k: string) => d.monthly.reduce((a: number, r: any) => a + r[k], 0);
    $('.perf-table tfoot').innerHTML = `<tr><td>12 months</td><td>${sum('enquiries')}</td><td>${sum('won')}</td><td>${sum('lost')}</td><td>${sum('open')}</td><td>${pct(sum('won'), sum('enquiries'))}</td></tr>`;
    const bars = (el: string, data: Record<string, number>, labels: [string, string][]) => {
      const total = labels.reduce((a, [k]) => a + (data[k] || 0), 0);
      const max = Math.max(1, ...labels.map(([k]) => data[k] || 0));
      $(el).innerHTML = total ? labels.map(([k, label]) => `<div class="bar"><span class="bar-l">${label}</span><span class="bar-t"><span class="bar-f" style="--w:${((data[k] || 0) / max) * 100}%"></span></span><span class="bar-n">${data[k] || 0}<small> ${Math.round(((data[k] || 0) / total) * 100)}%</small></span></div>`).join('') : '<p class="empty">No bookings in the last 12 months yet.</p>';
    };
    bars('.speed', d.speed, [['week', 'Within a week'], ['month', 'Within a month'], ['quarter', '1–3 months'], ['longer', 'Longer']]);
    bars('.ahead', d.ahead, [['u3', 'Under 3 months'], ['u6', '3–6 months'], ['u12', '6–12 months'], ['u18', '12–18 months'], ['o18', 'Over 18 months']]);
    $('.t-payments').textContent = money(t.payments); $('.c-payments').textContent = compare(t.payments, b.payments, money);
    $('.t-value').textContent = money(t.booked_value); $('.c-value').textContent = compare(t.booked_value, b.booked_value, money);

    $('.line-chart').innerHTML = lineChart(d.chart);
    const [svg, legend] = pie(d.sources);
    $('.pie').innerHTML = svg; $('.pie-legend').innerHTML = legend;

    const job = (id: number, text: string) => `<a href="/studio/crm/job?id=${id}">${esc(text)}</a>`;
    rows = {
      shoots: d.shoots.map((j: any) => `<li><span class="when">${day(j.event_date)}</span><span class="what">${job(j.id, j.title)}<small>${esc(j.job_type)}${j.venue ? ` · ${esc(j.venue)}` : ''} · ${ago(`${j.event_date}T12:00:00`)}</small></span></li>`),
      leads: d.leads.map((j: any) => {
        const [dir, subject, at] = (j.last_email || '').split('|');
        const [step, due, kind] = (j.next_step || '').split('|');
        const mail = j.replied_at ? '<span class="chip chip--in">Replied</span>' : dir ? `<span class="chip">${dir === 'in' ? 'From them' : 'Emailed'} ${ago(at)}</span>` : '<span class="chip chip--none">No email yet</span>';
        return `<li><span class="when">${ago(j.created_at)}</span><span class="what">${job(j.id, j.title)} ${mail}<small>${esc(j.job_type)}${j.event_date ? ` · ${day(j.event_date)}` : ''}${step ? ` · Next: ${esc(step)} ${kind === 'auto_email' ? '(automatic) ' : ''}${due < d.now ? 'due ' : ''}${ago(due)}` : ''}${subject && !step ? ` · Last: ${esc(subject)}` : ''}</small></span></li>`;
      }),
      payments: d.payments.map((i: any) => {
        const late = i.status === 'sent' && i.due_date < d.today;
        return `<li class="${late ? 'late' : ''}"><span class="when">${day(i.due_date)}</span><span class="what">${job(i.job_id, i.title)} <strong class="amt">${money(i.amount)}</strong><small>${esc(i.number)} · ${esc(i.label)} · ${late ? '<b>Overdue</b>' : i.status === 'sent' ? 'Sent, not paid yet' : `Sends ${day(i.send_at)}`}</small></span></li>`;
      }),
      tasks: [
        // Your own tasks (not about a client), soonest first; then the clients' to-dos and emails.
        ...(d.own || []).map((t: any) => {
          const late = t.due_date && t.due_date < d.today;
          return `<li class="${late ? 'late' : ''}"><button type="button" class="when when-btn" data-due-task="${t.id}" data-due="${t.due_date ?? ''}" title="Change the due date">${t.due_date ? (late ? `Due ${ago(`${t.due_date}T12:00:00`)}` : ago(`${t.due_date}T12:00:00`)) : 'Any time'}</button><span class="what">${t.contact_id ? `<a href="/studio/contacts/contact?id=${t.contact_id}">${esc(t.title)}</a>` : `<strong class="own">${esc(t.title)}</strong>`}<small>${t.business ? esc(t.business) : 'Your task'}</small></span><button type="button" class="tick" data-done-task="${t.id}" title="Done" aria-label="Mark done">✓</button></li>`;
        }),
        ...d.tasks.map((s: any) => {
          const overdue = s.due_at < d.now;
          return `<li class="${s.status === 'failed' ? 'late' : ''}"><span class="when">${s.status === 'failed' ? 'Didn’t send' : overdue ? `Due ${ago(s.due_at)}` : ago(s.due_at)}</span><span class="what"><a href="/studio/crm/job?id=${s.job_id}#step-${s.id}">${esc(s.title)}</a><small>${esc(s.job_title)} · ${s.kind === 'todo' ? 'To-do' : 'Email to send'}</small></span></li>`;
        }),
      ],
    };
    Object.keys(rows).forEach(renderList);
    $('.content').hidden = false; $('.status').hidden = true;
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const rb = t.closest<HTMLButtonElement>('[data-range]');
    if (rb) {
      range = rb.dataset.range!;
      document.querySelectorAll('[data-range]').forEach((b) => b.classList.toggle('on', b === rb));
      $('.dash-custom').hidden = range !== 'custom';
      if (range === 'custom' && !$<HTMLInputElement>('.dash-from').value) {
        const today = new Date().toLocaleDateString('en-CA');
        $<HTMLInputElement>('.dash-to').value = today;
        $<HTMLInputElement>('.dash-from').value = new Date(Date.now() - 29 * 86400_000).toLocaleDateString('en-CA');
      }
      load();
      return;
    }
    const pb = t.closest<HTMLButtonElement>('[data-page]');
    if (pb) { const name = pb.closest<HTMLElement>('[data-list]')!.dataset.list!; pages[name] += Number(pb.dataset.page); renderList(name); }
    const du = t.closest<HTMLButtonElement>('[data-due-task]');
    if (du) {
      const due = await askText('When is it due? (clear the date for “any time”)', du.dataset.due || new Date().toLocaleDateString('en-CA'), { type: 'date', ok: 'Save' });
      if (due === null) return;
      await fetch('/api/studio/crm/tasks', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(du.dataset.dueTask), due_date: due.trim() || null }) });
      return load();
    }
    const dt = t.closest<HTMLButtonElement>('[data-done-task]');
    if (dt) {
      dt.disabled = true;
      fetch('/api/studio/crm/tasks', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(dt.dataset.doneTask), action: 'done' }) }).then(() => load());
    }
    if (t.closest('[data-add-task]')) {
      const f = await askFields('', [
        { name: 'title', label: 'What’s the task?', placeholder: 'e.g. Write a blog post about Kumeu Valley' },
        { name: 'due', label: 'Due date (clear it for “any time”)', type: 'date', value: new Date(Date.now() + 7 * 86400_000).toLocaleDateString('en-CA') },
      ], { title: 'Add a task', ok: 'Add task' });
      const title = f?.title.trim();
      if (!title) return;
      const due = f!.due;
      fetch('/api/studio/crm/tasks', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title, due_date: due.trim() }) }).then(() => load());
    }
  });
  document.querySelector('[data-digest]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true; const label = b.textContent; b.textContent = 'Sending…';
    const r = await fetch('/api/studio/crm/digest', { method: 'POST' });
    const d = await r.json().catch(() => ({}));
    b.textContent = r.ok ? 'Sent ✓ check your inbox' : (d.error || 'Didn’t send, try again');

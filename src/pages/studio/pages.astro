---
// Moments Studio > Website > Pages: every page on the site (not blog posts), to edit in the page
// editor. Pages built into the site's code are listed too, with what can and can't be changed.
import StudioLayout from '../../layouts/StudioLayout.astro';
import home from '../../data/home.json';

const files = import.meta.glob<any>('../../data/pages/*.json', { eager: true });
// Pages whose content is built in code (only their Google title and description come from here).
const codeContent = new Set(['wedding-galleries']);
const pages = Object.entries(files)
  .map(([f, m]) => ({ id: f.split('/').pop()!.replace(/\.json$/, ''), path: m.default.path as string, title: m.default.title as string }))
  .filter((p) => !['/thanks'].includes(p.path))
  .sort((a, b) => a.path.localeCompare(b.path));
const strip = (t: string) => t.replace(/\s*\|\s*Moments In Light\s*$/i, '');
---
<StudioLayout title="Pages" section="pages">
  <main class="pages">
    <h1>Pages</h1>
    <p class="intro">Your website’s pages (blog posts are under Blog). Change the words, photos and photo descriptions, and how each page appears on Google. Saving updates the website in about 2 minutes.</p>
    <input class="pg-search" type="search" placeholder="Search pages…" aria-label="Search pages" />
    <div class="card">
      <ul class="pg-list">
        <li data-q="home page /"><a class="what" href="/studio/page-edit?id=home"><strong>Home page</strong><small>/ · {strip(home.title)}</small></a><a class="s-btn s-btn--quiet" href="/" target="_blank" rel="noopener">View ↗</a><a class="s-btn" href="/studio/page-edit?id=home">Edit</a></li>
        {pages.map((p) => (
          <li data-q={`${p.path} ${p.title}`.toLowerCase()}>
            <a class="what" href={`/studio/page-edit?id=${p.id}`}><strong>{strip(p.title)}</strong><small>{p.path}{codeContent.has(p.id) ? ' · only its Google title and description are here; the rest is built into the site' : ''}</small></a>
            <a class="s-btn s-btn--quiet" href={p.path} target="_blank" rel="noopener">View ↗</a>
            <a class="s-btn" href={`/studio/page-edit?id=${p.id}`}>Edit</a>
          </li>
        ))}
      </ul>
    </div>
    <p class="hint">Built into the site’s code, so ask Claude to change them: Weddings (/weddings), the blog’s list pages, and the contact form itself.</p>
  </main>
</StudioLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('.pg-search')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.pg-list li').forEach((li) => { li.hidden = !!q && !li.dataset.q!.includes(q); });
  });
</script>

<style>
  .pages { max-width: 1000px; margin: 0 auto; padding: 24px clamp(14px, 3vw, 32px) 80px; }
  h1 { margin: 0 0 4px; font-weight: 300; font-size: 32px; color: var(--ink); }
  .intro { margin: 0 0 16px; color: #666; font-size: 15px; }
  .pg-search { font: inherit; font-size: 14px; padding: 9px 12px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); width: min(360px, 100%); margin-bottom: 12px; }
  .card { background: var(--white); border-radius: 24px 0; padding: 6px 18px; animation: s-rise 0.6s var(--ease) both; }
  .pg-list { list-style: none; margin: 0; padding: 0; }
  .pg-list li { display: flex; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid #f1ebe1; }
  .pg-list li:last-child { border-bottom: 0; }
  .what { flex: 1; display: flex; flex-direction: column; color: var(--ink); text-decoration: none; min-width: 0; }
  .what small { color: #888; font-size: 13px; }
  .hint { font-size: 13px; color: #888; margin-top: 12px; }
</style>

---
// Moments Studio > Website > SEO > Google Ads (docs/MIL-Ads-SEO-Command-Centre-Spec.md).
// Phase 1: setting up the Ads Script (scripts/google-ads/sync.js, copied from here with the key
// filled in) and checking what's come in. Data from functions/api/studio/crm/ads.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
import SeoTabs from '../../../components/studio/SeoTabs.astro';
import script from '../../../../scripts/google-ads/sync.js?raw';
---
<StudioLayout title="Google Ads" section="seo">
  <main class="ads">
    <h1>Google Ads</h1>
    <p class="intro">Where your ad money goes, side by side with how you rank for free, so you only pay where Google won’t show you anyway.</p>
    <SeoTabs current="ads" />

    <section class="card status-card"><div class="status"><p class="muted">Loading…</p></div></section>

    <section class="card block-card" hidden>
      <h2>Block searches</h2>
      <p class="muted">Searches in the last 30 days that cost money and brought no enquiry, not yet blocked. Approve a block and the script adds it as a negative keyword on its next hourly run. Nothing changes in Google Ads until you approve it.</p>
      <form class="neg-form" autocomplete="off">
        <input name="text" placeholder="Word or search to block, e.g. affordable" aria-label="Negative keyword" maxlength="80" required />
        <select name="match" aria-label="Match type">
          <option value="BROAD">Any search with all these words</option>
          <option value="PHRASE" selected>Searches containing this phrase</option>
          <option value="EXACT">Only this exact search</option>
        </select>
        <select name="campaign_id" aria-label="Campaign"></select>
        <button type="submit" class="s-btn s-btn--solid">Approve block</button>
      </form>
      <div class="tbl-wrap"><table class="tbl block-tbl"><thead><tr><th>Search</th><th>Campaign</th><th class="r">Cost</th><th class="r">Clicks</th><th></th></tr></thead><tbody></tbody></table></div>
      <h3>Approved blocks</h3>
      <ul class="neg-list"></ul>
    </section>

    <section class="card picks-card">
      <h2>Ad picks</h2>
      <p class="muted">Photos you’ve marked <strong>Ad</strong> in your galleries. Check the suggested crop (move it with the arrows, or zoom), add a square one if you want, then <strong>Approve</strong>: the script adds them to <span class="pk-camp">your Search campaign</span> on its next hourly run.</p>
      <p class="pk-count muted"></p>
      <div class="pk-list"><p class="muted">Loading…</p></div>
    </section>

    <section class="card setup">
      <h2>Connect Google Ads</h2>
      <ol>
        <li><button type="button" class="s-btn s-btn--solid" data-key>Make the script</button> <span class="muted">(this makes a new private key, so an old copy of the script stops working)</span>
          <span class="update" hidden> or, already set up: <button type="button" class="s-btn" data-current>Copy the latest script</button> <span class="muted">(same key; paste over the old one in Google Ads and Save)</span></span></li>
        <li class="after" hidden>Copy it: <button type="button" class="s-btn" data-copy-script>Copy the script</button></li>
        <li>Open <a href="https://ads.google.com" target="_blank" rel="noopener">Google Ads</a>, then in the left menu <strong>Tools</strong> (the wrench) › <strong>Bulk actions</strong> › <strong>Scripts</strong>. Click the blue <strong>+</strong> and choose <strong>New script</strong>.</li>
        <li>Delete what’s in the box, paste, and name it <code>Moments Studio sync</code>.</li>
        <li>Click <strong>Authorise</strong> (it asks to see your Google Ads account and talk to an outside site: that’s the studio).</li>
        <li>Click <strong>Run</strong>, then <strong>Run</strong> again to confirm. The first run sends 90 days and takes a minute or two.</li>
        <li>Back on the Scripts list, set its <strong>Frequency</strong> to <strong>Hourly</strong>.</li>
      </ol>
      <p class="muted">It reads your account. The only change it makes is adding negative keywords you approve above; it never removes anything or touches bids, budgets or ads.</p>
      <textarea class="script" readonly hidden></textarea>
    </section>
  </main>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script define:vars={{ script }}>
  window.__adsScript = script;
</script>
<script>
  import '../../../studio/ad-picks.ts';
</script>
<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (c: number) => `$${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const when = (d: string) => new Date(d).toLocaleString('en-NZ', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Pacific/Auckland' });
  function toast(msg: string, error = false) {
    const t = $('.s-toast'); t.textContent = msg; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  }
  const MATCH: Record<string, string> = { BROAD: 'all these words', PHRASE: 'phrase', EXACT: 'exact search' };
  const STATUS: Record<string, string> = { pending: 'waiting for the next run', done: 'added', failed: 'couldn’t be added', cancelled: 'cancelled' };
  function renderBlocks(d: any) {
    const card = $('.block-card');
    const search = d.campaigns.filter((c: any) => c.channel_type === 'SEARCH');
    card.hidden = !search.length;
    if (!search.length) return;
    const sel = $<HTMLSelectElement>('.neg-form select[name="campaign_id"]');
    const was = sel.value;
    sel.innerHTML = search.map((c: any) => `<option value="${esc(c.campaign_id)}">${esc(c.name)}${c.status === 'ENABLED' ? '' : ' (' + esc(String(c.status).toLowerCase()) + ')'}</option>`).join('');
    if (was) sel.value = was;
    $('.block-tbl tbody').innerHTML = d.block.length ? d.block.map((t: any) => `<tr><td>${esc(t.search_term)}</td><td>${esc(t.campaign ?? '')}</td><td class="r">${money(t.cost)}</td><td class="r">${t.clicks}</td>
      <td class="r"><button type="button" class="s-btn s-btn--quiet" data-block="${esc(t.search_term)}" data-campaign="${esc(t.campaign_id)}">Block…</button></td></tr>`).join('')
      : '<tr><td colspan="5" class="muted">None: every search that cost $2 or more brought an enquiry or is already blocked.</td></tr>';
    $('.neg-list').innerHTML = d.negatives.length ? d.negatives.map((a: any) => `<li><strong>${esc(a.payload.text)}</strong> <span class="muted">(${MATCH[a.payload.match] ?? a.payload.match}) in ${esc(a.payload.campaign)} · approved ${when(a.created_at)}${a.payload.by && a.payload.by !== 'local' ? ' by ' + esc(a.payload.by) : ''}</span>
      · <span class="st-${a.status}">${STATUS[a.status] ?? a.status}${a.applied_at ? ' ' + when(a.applied_at) : ''}</span>${a.error ? ` <small class="warn">${esc(a.error)}</small>` : ''}
      ${a.status === 'pending' ? ` <button type="button" class="s-btn s-btn--quiet" data-cancel="${a.id}">Cancel</button>` : ''}</li>`).join('') : '<li class="muted">None yet.</li>';
  }
  async function approve(body: Record<string, unknown>) {
    const r = await fetch('/api/studio/crm/ads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'negative', ...body }) });
    const d = await r.json().catch(() => ({}));
    if (r.status === 409 && confirm(`${d.error} Block it anyway?`)) return approve({ ...body, anyway: true });
    if (!r.ok) { toast(d.error || 'Couldn’t approve that.', true); return false; }
    toast('Approved. The script adds it on its next run (within the hour).');
    return true;
  }
  $<HTMLFormElement>('.neg-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const body = Object.fromEntries(new FormData(f));
    if (await approve(body)) { f.reset(); load(); }
  });
  const NICE: Record<string, string> = { SEARCH: 'Search', DISPLAY: 'Display', PERFORMANCE_MAX: 'Performance Max', SMART: 'Smart', VIDEO: 'Video', MULTI_CHANNEL: 'App', DEMAND_GEN: 'Demand Gen' };
  async function load() {
    const d = await (await fetch('/api/studio/crm/ads')).json();
    const s = $('.status');
    document.querySelector<HTMLElement>('.update')!.hidden = !d.connected;
    if (!d.last) {
      s.innerHTML = `<h2>Not connected yet</h2><p class="muted">${d.connected ? 'The script has been made but hasn’t sent anything yet. Paste it into Google Ads and click Run (steps below).' : 'Follow the steps below to connect your Google Ads account.'}</p>`;
      return;
    }
    renderBlocks(d);
    s.innerHTML = `<div class="head"><h2>Connected</h2><span class="muted">Last data ${when(d.last)} · ${d.totals.first} to ${d.totals.last} · ${d.search_terms.toLocaleString('en-NZ')} search terms · Search Console ${d.gsc.n ? `${d.gsc.first} to ${d.gsc.last}` : 'starting'}</span></div>
      <p class="muted">Last 30 days by campaign (check these against Google Ads; they should match to the cent):</p>
      <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Campaign</th><th>Type</th><th>Bidding</th><th class="r">Budget/day</th><th class="r">Cost</th><th class="r">Clicks</th><th class="r">Conversions</th></tr></thead><tbody>
      ${d.campaigns.map((c: any) => `<tr><td>${esc(c.name)} <small class="muted">${esc(String(c.status ?? '').toLowerCase())}</small></td><td>${esc(NICE[c.channel_type] ?? c.channel_type)}${c.partner_network ? ' <small class="warn">+ search partners</small>' : ''}${c.display_network && c.channel_type === 'SEARCH' ? ' <small class="warn">+ display</small>' : ''}</td>
        <td>${esc(String(c.bidding ?? '').replace(/_/g, ' ').toLowerCase())}</td><td class="r">${money(c.budget_cents ?? 0)}</td><td class="r">${money(c.cost)}</td><td class="r">${c.clicks}</td><td class="r">${Number(c.conversions).toFixed(1)}</td></tr>`).join('')}
      </tbody></table></div>
      <p class="muted"><button type="button" class="s-btn s-btn--quiet" data-refresh>Send everything on the next run</button> (after updating the script; then click Run in Google Ads)</p>`;
  }
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-key]')) {
      if (!confirm('Make the script with a new key? Any copy already in Google Ads will stop working until you paste the new one.')) return;
      const d = await (await fetch('/api/studio/crm/ads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'key' }) })).json();
      if (!d.secret) return toast(d.error || 'Couldn’t make the key.', true);
      const ta = $<HTMLTextAreaElement>('.script');
      ta.value = (window as any).__adsScript.replace('__PASTE_KEY__', d.secret);
      ta.hidden = false;
      document.querySelector<HTMLElement>('.after')!.hidden = false;
      toast('Made. Now copy it.');
      load();
    }
    const blk = t.closest<HTMLElement>('[data-block]');
    if (blk) {
      const f = $<HTMLFormElement>('.neg-form');
      (f.elements.namedItem('text') as HTMLInputElement).value = blk.dataset.block!;
      (f.elements.namedItem('campaign_id') as HTMLSelectElement).value = blk.dataset.campaign!;
      (f.elements.namedItem('match') as HTMLSelectElement).value = 'EXACT';
      f.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (f.elements.namedItem('text') as HTMLInputElement).focus();
      toast('Trim it to the word that makes it wrong (e.g. “affordable”) for a wider block, then Approve.');
      return;
    }
    const cancel = t.closest<HTMLElement>('[data-cancel]');
    if (cancel) {
      const r = await fetch('/api/studio/crm/ads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'cancel', id: Number(cancel.dataset.cancel) }) });
      const d = await r.json().catch(() => ({}));
      toast(r.ok ? 'Cancelled.' : d.error || 'Couldn’t cancel.', !r.ok);
      load();
      return;
    }
    if (t.closest('[data-refresh]')) {
      await fetch('/api/studio/crm/ads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'refresh' }) });
      toast('Done. The next run sends everything: click Run in Google Ads.');
      return;
    }
    if (t.closest('[data-current]')) {
      const d = await (await fetch('/api/studio/crm/ads', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'current' }) })).json();
      if (!d.secret) return toast(d.error || 'Couldn’t get the key.', true);
      await navigator.clipboard.writeText((window as any).__adsScript.replace('__PASTE_KEY__', d.secret));
      toast('Copied. In Google Ads, open Moments Studio sync, select everything in the box, paste, then Save.');
      return;
    }
    if (t.closest('[data-copy-script]')) {
      await navigator.clipboard.writeText($<HTMLTextAreaElement>('.script').value);
      toast('Copied. Paste it into Google Ads.');
    }
  });
  load();
</script>

<style is:global>
  .ads { max-width: 1100px; margin: 0 auto; padding: 24px clamp(14px, 3vw, 32px) 80px; }
  .ads h1 { margin: 0; font-weight: 300; font-size: 32px; color: var(--ink); }
  .ads .intro { color: #666; margin: 4px 0 14px; }
  .ads .card { background: var(--white); border-radius: 24px 0; padding: 18px 22px; margin-bottom: 16px; }
  .ads h2 { margin: 0 0 8px; font-weight: 300; font-size: 22px; }
  .ads .head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: baseline; }
  .ads .muted { color: #888; font-size: 14px; }
  .ads .warn { color: #a8432a; font-weight: 600; }
  .ads ol { padding-left: 20px; line-height: 2.1; }
  .ads code { background: var(--champagne); padding: 2px 7px; border-radius: 6px; }
  .ads .script { width: 100%; height: 220px; font: 12px/1.4 ui-monospace, Consolas, monospace; border: 1px solid #ddd3c4; border-radius: 10px 0; padding: 10px; }
  .ads .tbl-wrap { overflow-x: auto; }
  .ads .tbl { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 700px; }
  .ads .tbl th { text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); padding: 8px; border-bottom: 1px solid #ece4d7; }
  .ads .tbl td { padding: 8px; border-bottom: 1px solid #f3eee6; }
  .ads .tbl .r { text-align: right; }
  .ads h3 { margin: 18px 0 6px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); font-weight: 600; }
  .ads .neg-form { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 14px; }
  .ads .neg-form input, .ads .neg-form select { font: inherit; font-size: 14px; padding: 8px 10px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); }
  .ads .neg-form input { flex: 1 1 220px; min-width: 0; }
  .ads .neg-form select { flex: 0 1 auto; max-width: 100%; }
  .ads .neg-list { list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 1.6; }
  .ads .neg-list li { padding: 6px 0; border-bottom: 1px solid #f3eee6; }
  .ads .st-done, .ads .st-added { color: var(--green); font-weight: 600; }
  .ads .pk-list { display: grid; gap: 16px; }
  .ads .pk { display: grid; grid-template-columns: minmax(0, 340px) 1fr; gap: 16px; align-items: start; border-top: 1px solid #f3eee6; padding-top: 14px; }
  .ads .pk-img { position: relative; overflow: hidden; border-radius: 6px; background: #eee; }
  .ads .pk-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ads .pk-frame { position: absolute; border: 2px solid #fff; pointer-events: none; }
  .ads .pk-wide { box-shadow: 0 0 0 999px rgb(0 0 0 / 0.45); }
  .ads .pk-square { border-style: dashed; border-color: #ffd54f; }
  .ads .pk-frame span { position: absolute; left: 4px; top: 2px; font-size: 11px; color: #fff; text-shadow: 0 1px 2px #000; }
  .ads .pk-tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 8px; }
  .ads .pk-tools .nudge { display: inline-flex; gap: 4px; }
  .ads .pk-tools .nudge button, .ads .pk-tools .seg button { min-width: 34px; height: 34px; border: 1px solid #ddd3c4; background: var(--white); border-radius: 8px; cursor: pointer; font-size: 16px; }
  .ads .pk-tools .seg button { padding: 0 12px; font-size: 13px; }
  .ads .pk-tools .seg button.on { background: var(--green); color: #fff; border-color: var(--green); }
  .ads .pk-act { margin-left: auto; }
  .ads .pk-st { margin: 6px 0; font-size: 14px; }
  @media (max-width: 640px) { .ads .pk { grid-template-columns: 1fr; } .ads .pk-act { margin-left: 0; } }
  .ads .st-failed { color: #a8432a; font-weight: 600; }
</style>

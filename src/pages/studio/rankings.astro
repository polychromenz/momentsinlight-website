---
// Moments Studio > Website > Rankings: each tracked search, where you are on Google (phone and
// desktop, from Auckland), who is above you, and the fix list for the page that should rank.
// Most important first. Data from functions/api/studio/crm/rankings.js.
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Rankings" section="rankings">
  <button slot="bar" type="button" class="s-btn s-btn--solid" data-check>Check rankings now</button>
  <main class="rk">
    <h1>Rankings and fixes</h1>
    <p class="intro">Your searches, most worth working on first. For each one: where you are on Google, who is above you, and what to change. Fix something, and next week's check shows whether it moved.</p>
    <section class="card setup" hidden>
      <h2>Set up Google rankings</h2>
      <p>The fix lists below work already. For your real positions on Google (and who's above you), the studio uses DataForSEO: pay as you go, about 10 US cents a month for your searches.</p>
      <ol>
        <li>Go to <a href="https://app.dataforseo.com/register" target="_blank" rel="noopener">dataforseo.com</a> and sign up with your email, then confirm it from the email they send.</li>
        <li>In their dashboard, open <b>API Access</b>. It shows an <b>API login</b> (your email) and an <b>API password</b> (made for you; not your account password). Don't paste them anywhere but Cloudflare.</li>
        <li>New accounts get US$1 of free credit, enough for weeks of checks. When it runs low, use <b>Add funds</b> (US$50 minimum, which lasts years at this rate).</li>
        <li>In Cloudflare: <b>Workers &amp; Pages</b> → <b>momentsinlight-website</b> → <b>Settings</b> → <b>Variables and secrets</b> → <b>Add</b>. Choose type <b>Secret</b>, environment <b>Production</b>, and add these two names with their values:
          <code>DATAFORSEO_LOGIN</code>
          <code>DATAFORSEO_PASSWORD</code>
        </li>
        <li>Save, then go to <b>Deployments</b>, open the ⋯ menu on the top (Production) one and choose <b>Retry deployment</b> so the site picks them up (or just tell me).</li>
        <li>Come back here and click <b>Check rankings now</b>. Results arrive in about 5 minutes.</li>
      </ol>
    </section>
    <p class="rk-status"></p>
    <div class="rk-list"><p class="muted">Loading…</p></div>
  </main>
  <dialog class="sugg" aria-label="Suggested fix">
    <div class="sugg-in">
      <h2 class="sugg-title">Suggested fix</h2>
      <p class="sugg-note" hidden></p>
      <div class="sugg-items"></div>
      <div class="pv" hidden>
        <div class="pv-head"><span class="lbl">On the page</span><span class="pv-what muted"></span>
          <div class="pv-mode" role="group" aria-label="Show"><button type="button" data-pv="before">Now</button><button type="button" data-pv="after" class="on">Suggested</button></div>
          <a class="pv-open" target="_blank" rel="noopener">Open the page ↗</a></div>
        <iframe class="pv-frame" title="Page preview"></iframe>
      </div>
      <div class="sugg-actions"><button type="button" class="s-btn s-btn--quiet" data-sugg-close>Cancel</button><button type="button" class="s-btn s-btn--quiet" data-sugg-again>✨ Suggest again</button><button type="button" class="s-btn s-btn--solid" data-sugg-apply>Apply fix</button></div>
    </div>
  </dialog>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const toast = (text: string, error = false) => { const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 5000); };
  const post = async (body: any) => { const r = await fetch('/api/studio/crm/rankings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); return { ok: r.ok, d: await r.json().catch(() => ({})) }; };
  const day = (iso: string) => new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  let data: any = null;
  // Fixes that can be suggested and applied from here.
  const SUGGEST = ['title', 'desc', 'h1', 'intro', 'alt', 'compete', 'inlinks'];
  const applied = new Set<string>();
  let sugg: { keyword: string; key: string; items: any[] } | null = null;
  const dlg = () => document.querySelector<HTMLDialogElement>('dialog.sugg')!;
  const limits: Record<string, [number, number]> = { title: [30, 60], description: [120, 155] };
  const counter = (type: string, v: string) => { const l = limits[type]; if (!l) return ''; const n = v.trim().length; return `<small class="${n >= l[0] && n <= l[1] ? 'up' : 'down'}">${n} characters (aim for ${l[0]}–${l[1]})</small>`; };
  const labelOf = (i: any) => i.label ?? ({ title: 'Google title', description: 'Google description', h1: 'Main heading', text: 'Paragraph', photo: 'Photo description', append: 'Add a link' } as any)[i.type];
  // ---- Previews ----
  const md = (t: string) => esc(t).replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  const serp = (path: string, title: string, desc: string) => `<div class="serp"><span class="serp-site">Moments In Light</span><span class="serp-url">momentsinlight.co.nz${path === '/' ? '' : esc(path.replace(/\//g, ' › ').replace(/^ › /, ' › '))}</span><span class="serp-title">${esc(title.length > 62 ? title.slice(0, 60) + '…' : title)}</span><span class="serp-desc">${esc(desc.length > 160 ? desc.slice(0, 158) + '…' : desc)}</span></div>`;
  function googlePreview(i: any) {
    if (!i.ctx) return '';
    const t = (v: string) => (i.type === 'title' ? v : i.ctx.title), dsc = (v: string) => (i.type === 'description' ? v : i.ctx.description);
    return `<div class="g-preview"><span class="lbl">How it looks on Google</span><div class="g-cols"><div><small class="muted">Now</small>${serp(i.path, t(i.before), dsc(i.before))}</div><div><small class="muted">Suggested</small><div data-g-after>${serp(i.path, t(i.after), dsc(i.after))}</div></div></div></div>`;
  }
  let pvItem = -1;
  let pvMode: 'before' | 'after' = 'after';
  const onPage = (i: any) => ['h1', 'text', 'photo', 'append'].includes(i.type);
  const norm = (t: string) => String(t ?? '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_#>`]/g, '').replace(/[’']/g, "'").replace(/\s+/g, ' ').trim().toLowerCase();
  function showPreview(n: number) {
    const i = sugg!.items[n];
    const pv = document.querySelector<HTMLElement>('.pv')!;
    if (!i || !onPage(i)) return;
    pv.hidden = false;
    document.querySelectorAll('.sugg-item').forEach((x) => x.classList.toggle('previewing', Number((x as HTMLElement).dataset.n) === n));
    document.querySelector('.pv-what')!.textContent = `${labelOf(i)} · ${i.path}`;
    document.querySelector<HTMLAnchorElement>('.pv-open')!.href = i.path;
    const frame = document.querySelector<HTMLIFrameElement>('.pv-frame')!;
    if (pvItem !== -1 && sugg!.items[pvItem]?.path === i.path && frame.contentDocument?.readyState === 'complete') { pvItem = n; applyPreview(); return; }
    pvItem = n;
    frame.onload = () => [300, 1200, 2500].forEach((ms) => setTimeout(applyPreview, ms));
    frame.src = i.path;
  }
  function applyPreview() {
    const i = sugg?.items[pvItem];
    const doc = document.querySelector<HTMLIFrameElement>('.pv-frame')!.contentDocument;
    if (!i || !doc?.body) return;
    doc.querySelectorAll('[data-pv-mark]').forEach((el) => { const o = (el as HTMLElement).dataset.pvOrig; if (o !== undefined) el.innerHTML = o; (el as HTMLElement).removeAttribute('style'); el.removeAttribute('data-pv-mark'); });
    doc.querySelectorAll('[data-pv-added], [data-pv-caption]').forEach((el) => el.remove());
    if (!doc.getElementById('pv-style')) { const st = doc.createElement('style'); st.id = 'pv-style'; st.textContent = '[data-reveal]{opacity:1!important;transform:none!important}[data-pv-mark]{outline:3px solid #c9a24a!important;outline-offset:6px;background:rgba(201,162,74,.12)!important}.pv-cap{position:absolute;left:8px;right:8px;bottom:8px;background:rgba(0,0,0,.75);color:#fff;font:14px/1.4 Arial,sans-serif;padding:6px 10px;border-radius:8px 0;z-index:9}'; doc.head.append(st); }
    const after = pvMode === 'after';
    let target: HTMLElement | null = null;
    const mark = (el: HTMLElement, html?: string) => { el.dataset.pvOrig = el.innerHTML; el.dataset.pvMark = ''; if (html !== undefined) el.innerHTML = html; target = el; };
    if (i.type === 'h1') { const el = doc.querySelector<HTMLElement>('main h1, h1'); if (el) mark(el, after ? esc(i.after) : undefined); }
    if (i.type === 'text') {
      const want = norm(i.show ?? i.before).slice(0, 40);
      const el = [...doc.querySelectorAll<HTMLElement>('main p, p')].find((p) => norm(p.textContent ?? '').startsWith(want));
      if (el) mark(el, after ? md(i.after) : undefined);
    }
    if (i.type === 'photo') {
      const key = i.src.replace(/\/(public(\.webp)?|w=[^/]*)$/, '');
      const img = [...doc.querySelectorAll<HTMLImageElement>('img')].find((m) => (m.getAttribute('src') ?? m.getAttribute('data-src') ?? '').includes(key));
      if (img) {
        if (img.dataset.src && !img.getAttribute('src')) img.src = img.dataset.src;
        const box = (img.closest('figure, li, a, div') as HTMLElement) ?? img.parentElement!;
        if (getComputedStyle(box).position === 'static') box.style.position = 'relative';
        mark(box);
        const cap = doc.createElement('div'); cap.className = 'pv-cap'; cap.dataset.pvCaption = '';
        cap.textContent = `Photo description: ${after ? i.after || '(none)' : i.before || '(none yet)'}`;
        box.append(cap);
      }
    }
    if (i.type === 'append') {
      const ps = [...doc.querySelectorAll<HTMLElement>('main article p, main .story p, main p')].filter((p) => (p.textContent ?? '').trim().split(' ').length > 6);
      const last = ps.at(-1);
      if (last && after) { const p = doc.createElement('p'); p.dataset.pvAdded = ''; p.innerHTML = md(i.after); last.after(p); mark(p); } else if (last) mark(last);
    }
    (target as HTMLElement | null)?.scrollIntoView({ block: 'center' });
  }

  function drawSugg() {
    const box = document.querySelector('.sugg-items')!;
    box.innerHTML = sugg!.items.map((i, n) => `<div class="sugg-item" data-n="${n}">
      <p class="sugg-label"><label><input type="checkbox" data-use checked> ${esc(labelOf(i))}</label> <small class="muted">${esc(i.path)}</small></p>
      ${i.type === 'photo' ? `<img src="${esc(i.src.replace(/\/(public|w=[^/]*)$/, '/w=360'))}" alt="" class="sugg-img">` : ''}
      <div class="sugg-cols"><div><span class="lbl">Now</span><div class="before">${esc(i.show ?? i.before) || '<span class="muted">(nothing)</span>'}</div></div>
      <div><span class="lbl">Suggested</span><textarea data-after rows="${i.type === 'text' ? 6 : i.type === 'description' || i.type === 'append' ? 3 : 2}">${esc(i.after)}</textarea><span class="cnt">${counter(i.type, i.after)}</span>${onPage(i) ? `<button type="button" class="pv-btn" data-preview="${n}">👁 Preview on the page</button>` : ''}${i.options?.length > 1 ? `<div class="opts"><span class="lbl">Or choose</span>${i.options.map((o: string, m: number) => `<button type="button" class="opt${o === i.after ? ' on' : ''}" data-opt="${m}">${esc(o)}</button>`).join('')}</div>` : ''}</div></div>${googlePreview(i)}</div>`).join('');
    document.querySelector<HTMLElement>('.pv')!.hidden = true;
    pvItem = -1;
    const first = sugg!.items.findIndex(onPage);
    if (first !== -1) showPreview(first);
  }
  function refreshItem(n: number) {
    const i = sugg!.items[n];
    const g = document.querySelector(`.sugg-item[data-n="${n}"] [data-g-after]`);
    if (g && i.ctx) g.innerHTML = serp(i.path, i.type === 'title' ? i.after : i.ctx.title, i.type === 'description' ? i.after : i.ctx.description);
    if (n === pvItem && pvMode === 'after') applyPreview();
  }
  async function openSuggest(keyword: string, key: string) {
    const k = data.keywords.find((x: any) => x.keyword === keyword);
    const fix = k.fixes.find((x: any) => x.key === key);
    const d = dlg();
    sugg = { keyword, key, items: [] };
    document.querySelector('.sugg-title')!.textContent = `${fix.title.replace(/ \(.*\)$/, '')}: “${keyword}”`;
    document.querySelector('.sugg-items')!.innerHTML = '<p class="muted">Thinking of a suggestion…</p>';
    const note = document.querySelector<HTMLElement>('.sugg-note')!; note.hidden = true;
    document.querySelector<HTMLButtonElement>('[data-sugg-apply]')!.hidden = true;
    if (!d.open) d.showModal();
    const { ok, d: r } = await post({ action: 'suggest', keyword, key, target: k.target, pages: fix.pages ?? [] });
    if (!ok) { document.querySelector('.sugg-items')!.innerHTML = `<p class="note">${esc(r.error || 'No suggestion came back. Try again.')}</p>`; return; }
    sugg.items = r.items ?? [];
    if (r.note) { note.textContent = r.note; note.hidden = false; }
    document.querySelector<HTMLButtonElement>('[data-sugg-apply]')!.hidden = !sugg.items.length;
    drawSugg();
  }
  const open = new Set<string>();

  const place = (p: number | null | undefined) => (p == null ? '<span class="pos none">not in top 20</span>' : `<span class="pos ${p <= 3 ? 'top' : p <= 10 ? 'p1' : 'p2'}">#${p}</span>`);
  const move = (now: number | null, before: number | null) => (before === undefined || now === before ? '' : now == null ? '<small class="down">dropped out</small>' : before == null ? '<small class="up">new</small>' : now < before ? `<small class="up">▲ ${before - now}</small>` : `<small class="down">▼ ${now - before}</small>`);
  function spark(h: any[], device: string) {
    const pts = h.filter((x) => x.device === device);
    if (pts.length < 2) return '';
    const y = (p: number | null) => ((p ?? 21) / 21) * 26 + 1;
    return `<svg viewBox="0 0 100 28" class="spark" aria-hidden="true"><polyline points="${pts.map((x, i) => `${(i / (pts.length - 1)) * 100},${y(x.position)}`).join(' ')}"/></svg>`;
  }

  function card(k: any, i: number) {
    const r = k.rank;
    const rankHtml = r.run ? `<div class="ranks">
        <div><span class="lbl">Phone</span>${r.mobile ? `${place(r.mobile.position)} ${move(r.mobile.position, r.mobile.before)}` : '–'}${spark(k.history, 'mobile')}</div>
        <div><span class="lbl">Desktop</span>${r.desktop ? `${place(r.desktop.position)} ${move(r.desktop.position, r.desktop.before)}` : '–'}${spark(k.history, 'desktop')}</div>
        ${(r.mobile ?? r.desktop)?.has_map ? `<div><span class="lbl">Map</span>${(r.mobile ?? r.desktop).map != null ? `<span class="pos top">#${(r.mobile ?? r.desktop).map}</span>` : '<span class="pos none">not in it</span>'}</div>` : ''}
      </div>` : `<div class="ranks"><div><span class="lbl">Google</span><span class="muted">${data.ready ? 'after the first check' : 'once set up'}</span></div></div>`;
    const g = k.gsc ? `<span class="gsc">Search Console: about #${k.gsc.position?.toFixed?.(1) ?? '–'}, shown ${k.gsc.impressions} times, ${k.gsc.clicks} clicks (week of ${day(k.gsc.week)})</span>` : '';
    const fixes = k.fixes.filter((f: any) => !f.ok);
    const done = k.fixes.filter((f: any) => f.ok);
    const fixHtml = (f: any) => `<li class="fix ${f.ok ? 'ok' : 'todo'}"><span class="mark">${f.ok ? '✓' : '✗'}</span><div><strong>${esc(f.title)}</strong><p>${esc(f.detail)}</p>
      ${f.contacts?.length ? `<p class="links">${f.contacts.map((c: any) => `<a href="/studio/contacts/contact?id=${c.id}">${esc(c.business)}</a>`).join(' · ')}</p>` : ''}
      ${f.map?.length ? `<p class="links">In the map now: ${f.map.map((m: any) => `${esc(m.title)}${m.rating ? ` (${m.rating}★, ${m.votes ?? 0} reviews)` : ''}`).join(' · ')}</p>` : ''}
      ${f.ok ? (f.task === 'closed' ? '<small class="up">Task closed: fixed</small>' : '') : f.task === 'open' ? '<small class="muted">In your tasks</small>' : `${SUGGEST.includes(f.key) && !applied.has(`${k.keyword}|${f.key}`) ? `<button type="button" class="s-btn s-btn--quiet" data-suggest="${esc(f.key)}" data-kw="${esc(k.keyword)}">✨ Suggest fix</button>` : ''}${applied.has(`${k.keyword}|${f.key}`) ? '<small class="up">Applied: the website updates in about 2 minutes, and this ticks off at the next check.</small>' : ''}<button type="button" class="s-btn s-btn--quiet" data-task="${esc(f.key)}" data-kw="${esc(k.keyword)}">+ Add to my tasks</button>`}</div></li>`;
    const top = k.top?.organic?.length ? `<details class="above"><summary>Who's on Google for this (${esc(day(r.run))}, ${r.mobile ? 'phone' : 'desktop'})</summary>
      <ol>${k.top.organic.map((x: any) => `<li class="${(x.domain || '').endsWith('momentsinlight.co.nz') ? 'you' : ''}"><span class="n">${x.rank}</span><a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.title || x.domain)}</a> <small>${esc(x.domain)}${/easyweddings|weddingwire|bridebook|facebook|instagram|pinterest|directory|nzweddings|theknot|hitched/.test(x.domain) ? ' · directory' : ''}</small></li>`).join('')}</ol>
      <button type="button" class="s-btn s-btn--quiet" data-compare="${esc(k.keyword)}">Compare with the top 3</button>
      ${k.compare ? `<table class="cmp"><thead><tr><th>Page</th><th>Words</th><th>Photos</th><th>Main heading</th></tr></thead><tbody>${k.compare.pages.map((p: any) => `<tr><td><a href="${esc(p.url)}" target="_blank" rel="noopener">#${p.rank} ${esc(p.domain)}</a></td><td>${p.words}</td><td>${p.imgs}</td><td>${esc(p.h1)}</td></tr>`).join('')}</tbody></table><small class="muted">Compared ${day(k.compare.at)}</small>` : ''}</details>` : '';
    return `<article class="card kw${open.has(k.keyword) || (i === 0 && !open.size) ? ' open' : ''}" data-kw-card="${esc(k.keyword)}">
      <button type="button" class="kw-head" data-toggle="${esc(k.keyword)}">
        <span class="kw-name">${i < 3 && k.todo ? '<span class="first">Work on this</span>' : ''}${esc(k.keyword)}</span>
        <span class="kw-sum">${r.run && r.mobile ? place(r.mobile.position) : ''} ${k.todo ? `<span class="todo-n">${k.todo} to fix</span>` : '<span class="up">All checks pass</span>'}</span>
      </button>
      <div class="kw-body">
        ${rankHtml}${g}
        <label class="target">The page for this search <select data-target="${esc(k.keyword)}"><option value="">${k.target_how === 'chosen' ? 'Choose automatically' : `Automatic: ${esc(k.target)}${k.target_how === 'google' ? ' (the one Google shows)' : ' (best match)'}`}</option>${data.pages.map((p: string) => `<option value="${esc(p)}"${k.target_how === 'chosen' && p === k.target ? ' selected' : ''}>${esc(p)}</option>`).join('')}</select>
          <a href="https://www.momentsinlight.co.nz${esc(k.target)}" target="_blank" rel="noopener">Open ↗</a></label>
        <ul class="fixes">${fixes.map(fixHtml).join('') || '<li class="muted">Nothing to fix on this page. Links from other sites and fresh blog posts are what move it now.</li>'}</ul>
        ${done.length ? `<details class="passed"><summary>${done.length} checks pass</summary><ul class="fixes">${done.map(fixHtml).join('')}</ul></details>` : ''}
        ${top}
      </div></article>`;
  }

  async function load() {
    const r = await fetch('/api/studio/crm/rankings');
    data = await r.json().catch(() => null);
    if (!r.ok || !data) { $('.rk-list').innerHTML = `<p class="note">${esc(data?.error || 'Couldn’t load.')}</p>`; return; }
    $('.setup').hidden = data.ready;
    $<HTMLButtonElement>('[data-check]').hidden = !data.ready;
    const bits = [];
    if (data.pending) bits.push(`Waiting for ${data.pending} results from Google…`);
    if (data.error) bits.push(`<span class="down">Last check: ${esc(data.error)}</span>`);
    if (data.spend) bits.push(`DataForSEO spend: US$${data.spend.cost.toFixed(3)} this month`);
    $('.rk-status').innerHTML = bits.join(' · ');
    $('.rk-list').innerHTML = data.keywords.map(card).join('') || '<p class="muted">No searches tracked yet. Add them on the SEO page (Searches you’re tracking).</p>';
    if (data.pending) setTimeout(async () => { const { d } = await post({ action: 'collect' }); if (d.collected) load(); else setTimeout(load, 30000); }, 30000);
  }

  document.addEventListener('input', (e) => {
    const ta = (e.target as HTMLElement).closest<HTMLTextAreaElement>('.sugg [data-after]');
    if (!ta || !sugg) return;
    const n = Number(ta.closest<HTMLElement>('.sugg-item')!.dataset.n);
    sugg.items[n].after = ta.value;
    ta.parentElement!.querySelector('.cnt')!.innerHTML = counter(sugg.items[n].type, ta.value);
    refreshItem(n);
  });
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const sb = t.closest<HTMLButtonElement>('[data-suggest]');
    if (sb) { open.add(sb.dataset.kw!); await openSuggest(sb.dataset.kw!, sb.dataset.suggest!); return; }
    if (t.closest('[data-sugg-close]')) { dlg().close(); return; }
    const ob = t.closest<HTMLButtonElement>('[data-opt]');
    if (ob && sugg) {
      const item = ob.closest<HTMLElement>('.sugg-item')!;
      const n = Number(item.dataset.n);
      sugg.items[n].after = sugg.items[n].options[Number(ob.dataset.opt)];
      const ta = item.querySelector<HTMLTextAreaElement>('[data-after]')!;
      ta.value = sugg.items[n].after;
      item.querySelector('.cnt')!.innerHTML = counter(sugg.items[n].type, ta.value);
      item.querySelectorAll('.opt').forEach((x) => x.classList.toggle('on', x === ob));
      refreshItem(n);
      return;
    }
    const pb = t.closest<HTMLButtonElement>('[data-preview]');
    if (pb) { showPreview(Number(pb.dataset.preview)); document.querySelector('.pv')!.scrollIntoView({ block: 'nearest' }); return; }
    const pm = t.closest<HTMLButtonElement>('[data-pv]');
    if (pm) { pvMode = pm.dataset.pv as 'before' | 'after'; document.querySelectorAll('[data-pv]').forEach((x) => x.classList.toggle('on', x === pm)); applyPreview(); return; }
    if (t.closest('[data-sugg-again]') && sugg) { await openSuggest(sugg.keyword, sugg.key); return; }
    const ap = t.closest<HTMLButtonElement>('[data-sugg-apply]');
    if (ap && sugg) {
      const items = sugg.items.filter((_, n) => document.querySelector<HTMLInputElement>(`.sugg-item[data-n="${n}"] [data-use]`)?.checked);
      if (!items.length) { toast('Tick at least one change.', true); return; }
      ap.disabled = true; ap.textContent = 'Applying…';
      const { ok, d } = await post({ action: 'apply', items });
      ap.disabled = false; ap.textContent = 'Apply fix';
      if (!ok) { toast(d.error || 'Couldn’t apply it.', true); return; }
      applied.add(`${sugg.keyword}|${sugg.key}`);
      dlg().close();
      toast('Applied. The website updates in about 2 minutes.');
      load(); return;
    }
    const tg = t.closest<HTMLButtonElement>('[data-toggle]');
    if (tg) { const c = tg.closest('.kw')!; c.classList.toggle('open'); c.classList.contains('open') ? open.add(tg.dataset.toggle!) : open.delete(tg.dataset.toggle!); return; }
    const tk = t.closest<HTMLButtonElement>('[data-task]');
    if (tk) {
      const k = data.keywords.find((x: any) => x.keyword === tk.dataset.kw); const f = k.fixes.find((x: any) => x.key === tk.dataset.task);
      tk.disabled = true;
      const { ok, d } = await post({ action: 'task', keyword: k.keyword, key: f.key, title: f.title.replace(/ \(.*\)$/, ''), detail: f.detail });
      if (!ok) { toast(d.error || 'Couldn’t add it.', true); tk.disabled = false; return; }
      open.add(k.keyword); toast('Added to your tasks. It closes itself when the check passes.'); load(); return;
    }
    const cm = t.closest<HTMLButtonElement>('[data-compare]');
    if (cm) { cm.disabled = true; cm.textContent = 'Reading their pages…'; const { ok, d } = await post({ action: 'compare', keyword: cm.dataset.compare }); if (!ok) toast(d.error || 'Couldn’t compare.', true); open.add(cm.dataset.compare!); load(); return; }
    if (t.closest('[data-check]')) {
      const b = t.closest<HTMLButtonElement>('[data-check]')!; b.disabled = true;
      const { ok, d } = await post({ action: 'check' }); b.disabled = false;
      toast(d.message || d.error || 'Done.', !ok); load();
    }
  });
  document.addEventListener('change', async (e) => {
    const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-target]');
    if (!s) return;
    open.add(s.dataset.target!);
    await post({ action: 'target', keyword: s.dataset.target, page: s.value });
    toast('Saved. The checks are now for that page.'); load();
  });
  load();
</script>


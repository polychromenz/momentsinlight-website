---
// Moments Studio > Website > SEO: Google searches and rankings (Search Console), tracked
// searches over time, keyword ideas, venue page ideas from enquiries, content (posts this month,
// weddings not yet blogged) and the monthly site health check. Data from functions/api/studio/crm/seo.js.
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="SEO" section="seo">
  <main class="seo">
    <h1>SEO</h1>
    <p class="intro">How people find you on Google, and what to do next. Free: your own Google data, Google's suggestions and your studio's enquiries.</p>

    <section class="card" id="search">
      <div class="card-head"><h2>Google searches</h2><small class="range"></small></div>
      <div class="search-body"><p class="muted">Loading…</p></div>
    </section>

    <section class="card" id="tracked">
      <div class="card-head"><h2>Searches you're tracking</h2><button type="button" class="s-btn s-btn--quiet" data-track-add>+ Track a search</button></div>
      <p class="hint">Your average position on Google each week (1 = top of page 1; 11+ = page 2). Saved every Monday.</p>
      <table class="tbl tracked-table"><thead><tr><th>Search</th><th>Now</th><th>4 weeks ago</th><th>Trend</th><th>Clicks (week)</th><th></th></tr></thead><tbody></tbody></table>
    </section>

    <section class="card" id="ideas">
      <h2>Keyword ideas</h2>
      <p class="hint">What people type into Google, from Google's own suggestions. Add the ones that fit to your tracked searches, and use them in titles and blog posts.</p>
      <form class="ideas-form"><input name="seeds" value="wedding photographer west auckland, kumeu wedding, auckland wedding venues, elopement auckland" aria-label="Start from" /><button type="submit" class="s-btn">Get ideas</button></form>
      <ul class="ideas"></ul>
    </section>

    <div class="two-col">
      <section class="card" id="venues">
        <h2>Venue page ideas</h2>
        <p class="hint">Venues couples mention in enquiries. The ones without a page on your site are your best new pages.</p>
        <ul class="list venues"><li class="muted">Loading…</li></ul>
      </section>
      <section class="card" id="content">
        <div class="card-head"><h2>Blog</h2><button type="button" class="s-btn s-btn--quiet" data-goal>Change goal</button></div>
        <div class="content-body"><p class="muted">Loading…</p></div>
      </section>
    </div>

    <section class="card" id="competitors">
      <div class="card-head"><h2>Competitors</h2><span><button type="button" class="s-btn s-btn--quiet" data-comp-kw-all>Get everyone's keywords</button> <a class="s-btn s-btn--quiet" href="/studio/contacts?add=Competitor">+ Add a competitor</a></span></div>
      <p class="hint">Other photographers you want to keep an eye on. Every Monday the studio reads the list of pages their site gives Google, and shows what's new: blog posts, venue pages, new services.</p>
      <div class="comp-body"><p class="muted">Loading…</p></div>
    </section>

    <section class="card" id="health">
      <div class="card-head"><h2>Site health check</h2><button type="button" class="s-btn s-btn--quiet" data-health>Run it now</button></div>
      <p class="hint">Every page checked for Google titles and descriptions, photos without descriptions, headings and broken links. Runs by itself on the 2nd of each month.</p>
      <div class="health-body"><p class="muted">Loading…</p></div>
    </section>
  </main>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const num = (n: number) => Number(n).toLocaleString('en-NZ');
  const toast = (text: string, error = false) => { const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 4000); };
  const api = async (part: string) => { const r = await fetch(`/api/studio/crm/seo?part=${part}`); return { ok: r.ok, d: await r.json().catch(() => ({})) }; };
  const post = async (body: any) => { const r = await fetch('/api/studio/crm/seo', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }); return { ok: r.ok, d: await r.json().catch(() => ({})) }; };
  let settings: any = { keywords: [] };
  let tracked: Set<string> = new Set();
  const pos = (p: number | null) => (p == null ? '<span class="muted">not ranking</span>' : `<b class="${p <= 3 ? 'top' : p <= 10 ? 'p1' : 'p2'}">${p.toFixed(1)}</b>`);
  const change = (now: number | null, before: number | null) => (now == null || before == null || Math.abs(now - before) < 0.5 ? '' : now < before ? `<span class="up">▲ ${(before - now).toFixed(1)}</span>` : `<span class="down">▼ ${(now - before).toFixed(1)}</span>`);

  async function loadSearch() {
    const { ok, d } = await api('search');
    const body = $('.search-body');
    if (d.connect === 'gmail') { body.innerHTML = '<p>Connect Gmail on the Clients page first; Search Console connects at the same time.</p>'; return; }
    if (d.connect === 'reconnect') { body.innerHTML = '<p class="note">To see your Google searches, the studio needs read-only access to Google Search Console. <a href="/api/studio/crm/gmail-connect">Reconnect Google</a> and allow it (you may also need to switch on the “Google Search Console API” in your Google Cloud project, like the Calendar one).</p>'; return; }
    if (!ok) { body.innerHTML = `<p class="note">${esc(d.error)}</p>`; return; }
    $('.range').textContent = `${d.range.start} to ${d.range.end}, compared with the 4 weeks before`;
    const tile = (label: string, now: number, before: number, fmt = num, lowerBetter = false) => {
      const diff = before ? Math.round(((now - before) / before) * 100) : 0;
      const good = lowerBetter ? diff < 0 : diff > 0;
      return `<div class="tile"><span>${label}</span><strong>${fmt(now)}</strong>${before ? `<small class="${good ? 'up' : diff ? 'down' : ''}">${diff > 0 ? '▲' : diff < 0 ? '▼' : '='} ${Math.abs(diff)}%</small>` : ''}</div>`;
    };
    const row = (q: any) => `<tr><td>${esc(q.query)} ${tracked.has(q.query) ? '' : `<button type="button" class="add" data-track="${esc(q.query)}" title="Track this search">+</button>`}</td><td>${num(q.clicks)}</td><td>${num(q.impressions)}</td><td>${pos(q.position)} ${change(q.position, q.before)}</td></tr>`;
    body.innerHTML = `<div class="tiles">${tile('Clicks from Google', d.totals.clicks, d.before.clicks)}${tile('Times shown', d.totals.impressions, d.before.impressions)}${tile('Average position', +d.totals.position.toFixed(1), +d.before.position.toFixed(1), (n) => n.toFixed(1), true)}</div>
      <h3>Almost on page 1</h3><p class="hint">Searches where you show on page 2 (positions 8–20) and people are looking. A little work on the page that ranks (its title, a blog post, a link from a venue) can move these onto page 1.</p>
      <table class="tbl"><thead><tr><th>Search</th><th>Clicks</th><th>Shown</th><th>Position</th></tr></thead><tbody>${d.opportunities.map(row).join('') || '<tr><td colspan="4" class="muted">None right now.</td></tr>'}</tbody></table>
      <h3>Top searches</h3>
      <table class="tbl"><thead><tr><th>Search</th><th>Clicks</th><th>Shown</th><th>Position</th></tr></thead><tbody>${d.queries.slice(0, 25).map(row).join('')}</tbody></table>
      <h3>Top pages</h3>
      <table class="tbl"><thead><tr><th>Page</th><th>Clicks</th><th>Shown</th><th>Position</th></tr></thead><tbody>${d.pages.slice(0, 15).map((p: any) => `<tr><td><a href="https://www.momentsinlight.co.nz${esc(p.page)}" target="_blank" rel="noopener">${esc(p.page)}</a></td><td>${num(p.clicks)}</td><td>${num(p.impressions)}</td><td>${pos(p.position)}</td></tr>`).join('')}</tbody></table>`;
  }

  async function loadTracked() {
    const { d } = await api('tracked');
    tracked = new Set(d.keywords.map((k: any) => k.keyword));
    $('.tracked-table tbody').innerHTML = d.keywords.map((k: any) => {
      const h = k.history; const now = h.at(-1); const ago = h.length > 4 ? h[h.length - 5] : h[0];
      const pts = h.filter((x: any) => x.position != null);
      const max = Math.max(20, ...pts.map((x: any) => x.position));
      const spark = pts.length > 1 ? `<svg viewBox="0 0 100 24" class="spark"><polyline points="${pts.map((x: any, i: number) => `${(i / (pts.length - 1)) * 100},${(x.position / max) * 22 + 1}`).join(' ')}"/></svg>` : '<span class="muted">from Monday</span>';
      return `<tr><td>${esc(k.keyword)}</td><td>${now ? pos(now.position) : '<span class="muted">–</span>'}</td><td>${ago && h.length > 1 ? pos(ago.position) : '–'}</td><td>${spark}</td><td>${now ? num(now.clicks) : '–'}</td><td><button type="button" class="rm" data-untrack="${esc(k.keyword)}" title="Stop tracking">✕</button></td></tr>`;
    }).join('') || '<tr><td colspan="6" class="muted">None yet.</td></tr>';
  }

  async function saveKeywords(keywords: string[]) {
    const { ok, d } = await post({ action: 'settings', keywords });
    if (!ok) { toast(d.error || 'Couldn’t save.', true); return; }
    settings.keywords = keywords; await loadTracked(); loadSearch();
  }

  async function loadVenues() {
    const { d } = await api('venues');
    $('.venues').innerHTML = (d.venues ?? []).map((v: any) => `<li><span class="what"><strong>${esc(v.name)}</strong><br><small>${v.count} enquiries · last ${new Date(v.last).toLocaleDateString('en-NZ', { month: 'short', year: 'numeric' })}</small></span>${v.hasPage ? '<span class="chip ok">Has a page</span>' : '<span class="chip idea">Page idea</span>'}</li>`).join('') || '<li class="muted">Not enough enquiries yet.</li>';
  }

  async function loadContent() {
    const { d } = await api('content');
    settings.posts_goal = d.posts_goal;
    const pct = d.posts_goal ? Math.min(100, Math.round((d.this_month / d.posts_goal) * 100)) : 100;
    $('.content-body').innerHTML = `<p class="goal"><strong>${d.this_month}</strong> of ${d.posts_goal} posts this month</p><div class="bar"><span style="width:${pct}%"></span></div>
      <h3>Weddings not on the blog yet</h3>
      <ul class="list">${(d.not_blogged ?? []).map((j: any) => `<li><span class="what"><a href="/studio/crm/job?id=${j.id}">${esc(j.couple)}</a><br><small>Wedding ${new Date(`${j.event_date}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</small></span><a class="s-btn s-btn--quiet" href="/studio/edit?new=1">Write it</a></li>`).join('') || '<li class="muted">All caught up.</li>'}</ul>`;
  }

  async function loadHealth() {
    const { d } = await api('health');
    const b = $('.health-body');
    if (d.none) { b.innerHTML = '<p class="muted">Not run yet. Click “Run it now”.</p>'; return; }
    if (!d.finished) { b.innerHTML = `<p>Checking… ${d.done} of ${d.pages.length} pages.</p>`; return; }
    const s = d.summary;
    const sec = (title: string, items: string[], good: string) => `<details${items.length ? ' open' : ''}><summary>${items.length ? `<b class="down">${items.length}</b>` : '<b class="up">✓</b>'} ${title}</summary>${items.length ? `<ul>${items.slice(0, 40).map((i) => `<li>${i}</li>`).join('')}</ul>` : `<p class="muted">${good}</p>`}</details>`;
    const link = (p: string) => `<a href="https://www.momentsinlight.co.nz${esc(p)}" target="_blank" rel="noopener">${esc(p)}</a>`;
    b.innerHTML = `<p class="hint">${s.pages} pages checked, ${new Date(d.started).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long' })}.</p>
      ${sec('Broken links', s.broken.map((x: any) => `${esc(x.link)} <small>(on ${x.from.map(link).join(', ')})</small>`), 'No broken links.')}
      ${sec('Pages without a good Google description', s.noDesc.map(link), 'Every page has one.')}
      ${sec('Google titles too short or too long', s.shortTitles.map((x: any) => `${link(x.path)} <small>“${esc(x.title)}” (${x.title.length})</small>`), 'All good.')}
      ${sec('Same title on more than one page', s.dupTitles.map((x: any) => `“${esc(x.title)}” <small>${x.pages.map(link).join(', ')}</small>`), 'All different.')}
      ${sec('Photos without a description', s.noAlt.map((x: any) => `${link(x.path)} <small>${x.count} of ${x.of}</small>`), 'Every photo has one.')}
      ${sec('Pages without exactly one main heading', s.h1.map((x: any) => `${link(x.path)} <small>${x.h1} headings</small>`), 'All good.')}`;
  }

  async function loadCompetitors() {
    const { d } = await api('competitors');
    const b = $('.comp-body');
    const list = d.competitors ?? [];
    if (!list.length) { b.innerHTML = '<p class="muted">None yet. Add a competitor as a contact (type Competitor) with their website.</p>'; return; }
    const names = Object.fromEntries(list.map((c: any) => [c.id, c.business]));
    const short = (u: string) => { try { return decodeURIComponent(new URL(u).pathname); } catch { return u; } };
    const gaps = d.venue_gaps ?? [];
    const tracked = new Set(d.tracked ?? []);
    const vol = (v: number | null) => (v == null ? '–' : num(v));
    const trackBtn = (k: string) => (tracked.has(k) ? '<small class="up">tracking</small>' : `<button type="button" class="add" data-track="${esc(k)}" title="Track this search">+</button>`);
    const kg = d.keyword_gaps ?? [];
    const gapHtml = kg.length ? `<h3>Searches your competitors rank for</h3><p class="hint">From the competitors whose keywords you've fetched; the ones several of them are on page 1–2 for come first. Their own business names are left out. + adds a search to the ones you track (and to your Rankings fix lists).</p>
      <table class="tbl"><thead><tr><th>Search</th><th>Searches a month</th><th>Competitors</th><th>Best position</th><th></th></tr></thead><tbody>${kg.map((g: any) => `<tr><td>${esc(g.keyword)}</td><td>${vol(g.volume)}</td><td title="${esc(g.who.map((w: any) => `${w.business} #${w.position}`).join(', '))}">${g.who.length}</td><td>#${Math.min(...g.who.map((w: any) => w.position ?? 99))}</td><td>${trackBtn(g.keyword)}</td></tr>`).join('')}</tbody></table>
      <button type="button" class="s-btn s-btn--quiet" data-track-all>Track the top 10 of these</button>` : '';
    const kwHtml = (c: any) => c.keywords?.length ? `<details class="ckw"><summary>${c.keywords.length} searches they rank for (${new Date(c.keywords[0].fetched_at).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })})</summary><table class="tbl"><thead><tr><th>Search</th><th>Searches a month</th><th>Their position</th><th></th></tr></thead><tbody>${c.keywords.map((k: any) => `<tr><td>${esc(k.keyword)}${k.brand ? ' <small class="muted">(their name)</small>' : ''}</td><td>${vol(k.volume)}</td><td><a href="${esc(k.url)}" target="_blank" rel="noopener">#${k.position}</a></td><td>${k.brand ? '' : trackBtn(k.keyword)}</td></tr>`).join('')}</tbody></table></details>` : '';
    b.innerHTML = gapHtml + `${gaps.length ? `<h3>Venues they have pages about and you don't</h3><ul class="list">${gaps.map((g: any) => `<li><span class="what"><strong>${esc(g.name)}</strong>${g.enquiries ? ` <small>· ${g.enquiries} of your enquiries</small>` : ''}<br><small>${g.pages.map((p: any) => `<a href="${esc(p.url)}" target="_blank" rel="noopener">${esc(names[p.contact_id])}</a>`).join(', ')}</small></span><span class="chip idea">Page idea</span></li>`).join('')}</ul>` : ''}
      ${list.map((c: any) => `<details class="comp"${c.new_pages.length ? ' open' : ''}><summary><strong>${esc(c.business)}</strong> <small>${c.watch_error ? `<span class="down">${esc(c.watch_error)}</span>` : c.watch_checked_at ? `${num(c.pages)} pages · ${c.new_pages.length ? `<b class="down">${c.new_pages.length} new</b> in 3 months` : 'nothing new'} · checked ${new Date(c.watch_checked_at).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })}` : 'not checked yet'}</small>
        <button type="button" class="s-btn s-btn--quiet" data-comp="${c.id}">Check pages</button> <button type="button" class="s-btn s-btn--quiet" data-comp-kw="${c.id}">${c.keywords?.length ? 'Refresh keywords' : 'Keywords they rank for'}</button></summary>
        ${kwHtml(c)}
        ${c.new_pages.length ? `<ul>${c.new_pages.map((p: any) => `<li><a href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.name)}</a> <small>${esc(short(p.url))} · found ${new Date(p.first_seen).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })}</small></li>`).join('')}</ul>` : `<p class="muted">${c.website ? (c.watch_checked_at ? 'No new pages lately. (The first check just notes what is there.)' : 'Click Check pages for the first look.') : `<a href="/studio/contacts/contact?id=${c.id}">Add their website</a> first.`}</p>`}</details>`).join('')}`;
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const kb = t.closest<HTMLButtonElement>('[data-comp-kw]');
    if (kb) {
      e.preventDefault(); kb.disabled = true; kb.textContent = 'Asking DataForSEO…';
      const { ok, d } = await post({ action: 'competitor_keywords', id: Number(kb.dataset.compKw) });
      toast(ok ? `Found ${d.count} searches.` : d.error || 'Couldn’t get them.', !ok);
      await loadCompetitors(); return;
    }
    const ka = t.closest<HTMLButtonElement>('[data-comp-kw-all]');
    if (ka) {
      const ids = [...document.querySelectorAll<HTMLButtonElement>('[data-comp-kw]')].map((x) => Number(x.dataset.compKw));
      if (!confirm(`Fetch the keywords for all ${ids.length} competitors? About US${(ids.length * 0.02).toFixed(2)} from your DataForSEO credit.`)) return;
      ka.disabled = true;
      for (const [i, id] of ids.entries()) {
        ka.textContent = `Fetching ${i + 1} of ${ids.length}…`;
        const { ok, d } = await post({ action: 'competitor_keywords', id });
        if (!ok && /set up|login/i.test(d.error || '')) { toast(d.error, true); break; }
      }
      ka.disabled = false; ka.textContent = "Get everyone's keywords";
      await loadCompetitors(); return;
    }
    if (t.closest('[data-track-all]')) {
      const { d } = await api('competitors');
      const top = (d.keyword_gaps ?? []).slice(0, 10).map((g: any) => g.keyword);
      const r = await post({ action: 'track', keywords: top });
      toast(r.ok ? `Tracking ${top.length} more searches.` : r.d.error || 'Couldn’t add them.', !r.ok);
      await loadTracked(); loadCompetitors(); return;
    }
    const cb = t.closest<HTMLButtonElement>('[data-comp]');
    if (cb) {
      e.preventDefault(); cb.disabled = true; cb.textContent = 'Checking…';
      const { ok, d } = await post({ action: 'competitor', id: Number(cb.dataset.comp) });
      toast(ok ? (d.first ? `Found ${d.pages} pages. From now on, new ones show here.` : `Checked ${d.pages} pages.`) : d.error || 'Couldn’t check it.', !ok);
      await loadCompetitors(); return;
    }
    const tr = t.closest<HTMLButtonElement>('[data-track]');
    if (tr) { e.preventDefault(); const r = await post({ action: 'track', keywords: [tr.dataset.track] }); if (!r.ok) { toast(r.d.error || 'Couldn’t add it.', true); return; } tr.outerHTML = '<small class="up">tracking</small>'; toast('Tracking it. It’s on your Rankings page too.'); await loadTracked(); return; }
    const un = t.closest<HTMLButtonElement>('[data-untrack]');
    if (un) { if (confirm(`Stop tracking “${un.dataset.untrack}”?`)) await saveKeywords([...tracked].filter((k) => k !== un.dataset.untrack)); return; }
    if (t.closest('[data-track-add]')) { const k = prompt('The search to track, as people type it (e.g. kumeu wedding photographer):'); if (k) await saveKeywords([...tracked, k]); return; }
    if (t.closest('[data-goal]')) { const g = prompt('How many blog posts a month?', String(settings.posts_goal ?? 2)); if (g !== null) { await post({ action: 'settings', posts_goal: Number(g) }); loadContent(); } return; }
    const hb = t.closest<HTMLButtonElement>('[data-health]');
    if (hb) {
      hb.disabled = true;
      let { d } = await post({ action: 'health', start: true });
      while (d.result && !/finished|error/.test(d.result)) { hb.textContent = d.result.replace('checked', 'Checked'); ({ d } = await post({ action: 'health' })); }
      hb.disabled = false; hb.textContent = 'Run it now';
      await loadHealth();
    }
  });
  $<HTMLFormElement>('.ideas-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const seeds = (($<HTMLFormElement>('.ideas-form').elements.namedItem('seeds') as HTMLInputElement).value).split(',').map((s) => s.trim()).filter(Boolean);
    $('.ideas').innerHTML = '<li class="muted">Asking Google…</li>';
    const { d } = await post({ action: 'ideas', seeds });
    $('.ideas').innerHTML = (d.ideas ?? []).map((i: any) => `<li>${esc(i.idea)} ${tracked.has(i.idea) ? '<small class="up">tracking</small>' : `<button type="button" class="add" data-track="${esc(i.idea)}" title="Track this search">+</button>`}</li>`).join('') || '<li class="muted">No ideas came back.</li>';
  });
  loadTracked().then(loadSearch);
  loadVenues(); loadContent(); loadHealth(); loadCompetitors();
</script>

<style is:global>
  .seo { max-width: 1150px; margin: 0 auto; padding: 24px clamp(14px, 3vw, 32px) 80px; }
  .seo h1 { margin: 0 0 4px; font-weight: 300; font-size: 32px; color: var(--ink); }
  .seo .intro { margin: 0 0 18px; color: #666; font-size: 15px; }
  .seo .card { background: var(--white); border-radius: 24px 0; padding: 20px 24px; margin-bottom: 16px; min-width: 0; overflow-x: auto; }
  @media (max-width: 600px) { .seo .card { padding: 16px 14px; } .seo .tbl { font-size: 13px; } .seo .tbl th, .seo .tbl td { padding: 6px 5px; } }
  .seo details.comp summary { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .seo details.comp summary small { flex: 1; color: #888; }
  .seo details.ckw { margin: 4px 0 8px; } .seo details.ckw summary { font-size: 13px; color: var(--green); }
  .seo .card-head > span { display: flex; gap: 6px; flex-wrap: wrap; }
  .seo .card h2 { margin: 0 0 8px; font-weight: 300; font-size: 22px; color: var(--ink); }
  .seo .card h3 { margin: 22px 0 6px; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green); }
  .seo .card-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .seo .card-head small { color: #888; }
  .seo .hint { margin: 0 0 10px; font-size: 13px; color: #777; }
  .seo .muted { color: #999; }
  .seo .note { padding: 12px 14px; background: #fff4d6; color: #5c4400; border-radius: 12px 0; font-size: 14px; }

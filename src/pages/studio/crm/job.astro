---
// Moments Studio CRM: one lead or job (/studio/crm/job?id=12). Their details (editable), Tony's
// notes, the planned steps (to-dos and emails) and the email history.
// Data from functions/api/studio/crm/job.js and step.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { FORM_CSS } from '../../../../functions-lib/questionnaire-form.js';
---
<StudioLayout title="Client" section="clients">
  <a slot="bar" class="s-btn s-btn--quiet portal-open" href="#" target="_blank" rel="noopener" hidden>Open their portal ↗</a>
  <span slot="bar" class="save-state" aria-live="polite"></span>
  <button slot="bar" type="button" class="s-btn s-btn--solid" data-act="save" disabled>Save</button>

<div class="test-banner" hidden><strong>TEST MODE</strong>: client emails are redirected to you, nothing reaches a client. It switches to live only when you set CRM_SEND_MODE to “live” in Cloudflare.</div>
  <main class="job-page">
    <p class="status" aria-live="polite">Loading…</p>
    <div class="content" hidden>
      <header class="head">
        <p class="eyebrow-line"></p>
        <h1 class="title"></h1>
        <p class="clash" role="alert" hidden></p>
        <p class="hold-note" hidden>Imported from Studio Ninja. Automatic emails, invoices and reminders are off for this job until switch-over day.</p>
        <div class="stage" role="group" aria-label="Where they're at">
        </div>
      </header>

      <div class="cols">
        <div>
          <section class="card">
            <h2>Steps</h2>
            <ul class="steps"></ul>
          </section>
          <section class="card appts-card">
            <div class="card-head"><h2>Appointments</h2><button type="button" class="s-btn s-btn--quiet" data-appt-new>+ Add</button></div>
            <ul class="quotes appts"></ul>
            <form class="appt-form" autocomplete="off" hidden>
              <input name="title" placeholder="e.g. Practice shoot" aria-label="What" list="appt-kinds" required />
              <datalist id="appt-kinds"><option>Practice shoot</option><option>Planning meeting</option><option>Discovery call</option><option>Engagement shoot</option></datalist>
              <input name="date" type="date" aria-label="Date" required />
              <input name="start_time" type="time" aria-label="Start time (optional)" />
              <input name="end_time" type="time" aria-label="End time (optional)" />
              <input name="location" placeholder="Where (optional)" aria-label="Where" />
              <div class="appt-btns"><button type="submit" class="s-btn s-btn--solid">Save</button><button type="button" class="s-btn s-btn--quiet" data-appt-cancel>Cancel</button></div>
            </form>
            <p class="hint gcal-note" hidden></p>
          </section>
          <section class="card">
            <div class="card-head"><h2>Quotes</h2><button type="button" class="s-btn" data-act="new-quote">+ New quote</button></div>
            <ul class="quotes"></ul>
          </section>
          <section class="card">
            <h2>Contracts</h2>
            <ul class="quotes contracts"></ul>
          </section>
          <section class="card">
            <h2>Questionnaire</h2>
            <ul class="quotes questionnaires"></ul>
          </section>
          <section class="card">
            <h2>Invoices</h2>
            <ul class="quotes invoices"></ul>
          </section>
          <section class="card portal-card">
            <div class="card-head"><h2>Client portal</h2><span class="portal-actions"><a class="s-btn portal-open" href="#" target="_blank" rel="noopener">Open their portal ↗</a><button type="button" class="s-btn s-btn--quiet" data-portal-copy>Copy link</button></span></div>
            <p class="hint">What they see: their booking, quote, contract, questionnaire, payments, plus the files and galleries below.</p>
            <h3 class="sub">Galleries</h3>
            <ul class="quotes portal-galleries"></ul>
            <form class="portal-add" autocomplete="off"><input name="title" placeholder="Name, e.g. Your practice shoot" aria-label="Gallery name" /><input name="url" placeholder="Pic-Time link" aria-label="Gallery link" /><button type="submit" class="s-btn s-btn--quiet">+ Add gallery</button></form>
            <h3 class="sub">Files from you <small>(tick to share from your Documents)</small></h3>
            <div class="portal-docs"></div>
            <h3 class="sub">Files from them</h3>
            <ul class="quotes portal-uploads"></ul>
          </section>
          <section class="card">
            <h2>Their enquiry</h2>
            <p class="message"></p>
          </section>
          <section class="card">
            <div class="card-head"><h2>Emails</h2><button type="button" class="s-btn" data-compose>✉ Write email</button></div>
            <ul class="messages"></ul>
          </section>
        </div>

        <form class="card details" autocomplete="off">
          <h2>Details</h2>
          <div class="two">
            <label>First name<input name="first_name" /></label>
            <label>Last name<input name="last_name" /></label>
          </div>
          <label>Partner's name<input name="partner_name" /></label>
          <label>Email<input name="email" type="email" /></label>
          <label>Phone<input name="phone" type="tel" /></label>
          <label>Postal address<textarea name="address" rows="3" placeholder="Added when they accept a quote"></textarea></label>
          <div class="two">
            <label>Type
              <select name="job_type">
                <option>Wedding</option><option>Portraits</option><option>Family</option><option>Headshots</option><option>Lifestyle</option><option>Event</option><option>Commercial / Advertising</option>
              </select>
            </label>
            <label>Date<input name="event_date" type="date" /></label>
          </div>
          <label>Time <small>(for a shoot; optional)</small><input name="event_time" type="time" /></label>
          <label>Venue<input name="venue" /></label>
          <label>Heard about you via<input name="lead_source" list="lead-sources" /><datalist id="lead-sources"></datalist></label>
          <label>Your notes<textarea name="notes" rows="6" placeholder="Anything to remember about them or their day"></textarea></label>
          <p class="other-jobs" hidden></p>
        </form>
      </div>
    </div>
  </main>
  <dialog class="review" aria-label="Review and send">
    <form method="dialog" class="review-form">
      <h2 class="review-title">Review and send</h2>
      <p class="review-to"></p>
      <p class="review-missing" hidden></p>
      <label class="review-gallery" hidden>Gallery link <small>(Pic-Time; it goes into the email and onto their portal)</small><input name="gallery_link" type="url" placeholder="https://…" /></label>
      <label>Subject<input name="subject" /></label>
      <div class="review-cols">
        <label>Email<textarea name="body" rows="18"></textarea></label>
        <div class="review-preview"><span>Preview</span><iframe title="Email preview"></iframe></div>
      </div>
      <div class="review-attach"></div>
      <div class="review-actions">
        <button type="button" class="s-btn s-btn--quiet" data-review="cancel">Cancel</button>
        <button type="button" class="s-btn s-btn--solid" data-review="send">Send</button>
      </div>
    </form>
  </dialog>
  <dialog class="review compose" aria-label="Write an email">
    <form method="dialog" class="review-form compose-form">
      <h2 class="review-title compose-title">Write an email</h2>
      <p class="review-to compose-to"></p>
      <label class="compose-start">Start from <select name="template"><option value="">A blank email</option></select></label>
      <p class="review-missing compose-missing" hidden></p>
      <label>Subject<input name="subject" /></label>
      <div class="review-cols">
        <label>Email<textarea name="body" rows="16"></textarea></label>
        <div class="review-preview"><span>What they see</span><iframe title="Email preview"></iframe></div>
      </div>
      <div class="review-attach compose-attach"></div>
      <div class="review-actions">
        <button type="button" class="s-btn s-btn--quiet" data-compose="cancel">Cancel</button>
        <button type="button" class="s-btn s-btn--solid" data-compose="send">Send</button>
      </div>
    </form>
  </dialog>
  <dialog class="review msg-view" aria-label="Email">
    <div class="review-form">
      <h2 class="review-title msg-title"></h2>
      <p class="review-to msg-meta"></p>
      <p class="review-attach msg-files" hidden></p>
      <iframe class="msg-frame" title="The email" sandbox="allow-popups allow-popups-to-escape-sandbox"></iframe>
      <div class="review-actions"><a class="s-btn s-btn--quiet msg-gmail" target="_blank" rel="noopener">Open in Gmail</a><button type="button" class="s-btn s-btn--quiet" data-msg-close>Close</button><button type="button" class="s-btn s-btn--solid" data-msg-reply>Reply</button></div>
    </div>
  </dialog>
  <dialog class="review q-view" aria-label="Questionnaire answers">
    <div class="review-form">
      <h2 class="review-title q-view-title"></h2>
      <p class="review-to q-view-meta"></p>
      <div class="qf q-view-body"></div>
      <div class="review-actions"><button type="button" class="s-btn s-btn--solid" data-q-close>Close</button></div>
    </div>
  </dialog>
  <div class="s-toast" role="status"></div>
</StudioLayout>
<style is:inline set:html={FORM_CSS}></style>

<script>
  import { emailHtml } from '../../../../functions-lib/email-render.js';
  import { formHtml } from '../../../../functions-lib/questionnaire-form.js';
  import { attachRich } from '../../../studio/rich-editor';
  import { attachPicker } from '../../../studio/attach-picker';
  type Step = { id: number; kind: string; title: string; due_at: string; status: string; note: string; done_at: string | null; stop_on: string; config: string | null };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const id = Number(new URLSearchParams(location.search).get('id'));
  const form = $<HTMLFormElement>('form.details');
  const saveBtn = $<HTMLButtonElement>('[data-act="save"]');
  const kindLabel: Record<string, string> = { auto_email: 'Automatic email', ready_email: 'Email to send', todo: 'To-do' };
  const statusLabel: Record<string, string> = { scheduled: 'Planned', due: 'Due', done: 'Done', skipped: 'Skipped', failed: 'Didn’t send' };
  const dateTime = (iso: string) => new Date(iso).toLocaleString('en-NZ', { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
  const toast = (text: string, error = false) => {
    const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  };
  let stage = 'lead';
  let dirty = false;
  const markDirty = () => { dirty = true; saveBtn.disabled = false; $('.save-state').textContent = 'Unsaved changes'; };

  let listsLoaded = false;
  async function loadLists() {
    if (listsLoaded) return;
    const r = await fetch('/api/studio/crm/settings');
    if (!r.ok) return;
    const s = await r.json();
    const sel = form.elements.namedItem('job_type') as HTMLSelectElement;
    sel.replaceChildren(...s.job_type.map((t: { value: string }) => new Option(t.value, t.value)));
    $('#lead-sources').replaceChildren(...s.lead_source.map((t: { value: string }) => new Option(t.value, t.value)));
    listsLoaded = true;
  }
  type Invoice = { id: number; number: string; label: string; amount: number; due_date: string; send_at: string; status: string; sent_at: string | null; reminders: number; paid_at: string | null; paid_method: string | null; paid_note: string; token: string };
  let invoices: Invoice[] = [];
  type Message = { id: number; direction: string; subject: string; body: string; sent_at: string; attachments: string; gmail_message_id: string | null };
  let messages: Message[] = [];
  // ---- Portal ----
  let portal: { link: string; path: string; galleries: { id: number; title: string; url: string }[]; documents: { id: number; name: string; size: number; shared: boolean }[]; uploads: { id: number; name: string; size: number; created_at: string; questionnaire_id: number | null }[] };
  const kb = (n: number) => (n > 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`);
  async function loadPortal() {
    const r = await fetch(`/api/studio/crm/portal?job=${id}`);
    const p = await r.json().catch(() => ({}));
    if (!r.ok) return;
    portal = p;
    document.querySelectorAll<HTMLAnchorElement>('.portal-open').forEach((a) => { a.href = p.path; a.hidden = false; });
    $('.portal-galleries').innerHTML = p.galleries.map((g: any) => `<li class="inv"><span class="what"><a href="${esc(g.url)}" target="_blank" rel="noopener"><strong>${esc(g.title)}</strong></a><br><small>${esc(g.url)}</small></span><button type="button" class="s-btn s-btn--quiet" data-gallery-remove="${g.id}">Remove</button></li>`).join('') || '<li class="empty">None yet. Add the Pic-Time link when their gallery is ready.</li>';
    $('.portal-docs').innerHTML = p.documents.length ? p.documents.map((x: any) => `<label class="pdoc"><input type="checkbox" value="${x.id}"${x.shared ? ' checked' : ''} /> ${esc(x.name)} <small>${kb(x.size)}</small></label>${x.own ? ` <a class="pdoc-open" href="/api/studio/crm/documents?id=${x.id}" target="_blank" rel="noopener">open</a>` : ''}`).join('') : '<p class="empty">Upload files in Settings &gt; Documents first.</p>';
    $('.portal-uploads').innerHTML = p.uploads.map((u: any) => `<li class="inv"><span class="what"><a href="/api/studio/crm/portal?job=${id}&upload=${u.id}" target="_blank" rel="noopener">${esc(u.name)}</a><br><small>${kb(u.size)} · ${u.questionnaire_id ? 'from their questionnaire' : 'added in their portal'} · ${dateTime(u.created_at)}</small></span>${u.questionnaire_id ? '' : `<button type="button" class="s-btn s-btn--quiet" data-upload-remove="${u.id}">Remove</button>`}</li>`).join('') || '<li class="empty">Nothing yet.</li>';
  }
  async function portalPost(body: Record<string, unknown>) {
    const r = await fetch('/api/studio/crm/portal', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ job_id: id, ...body }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save that.', true); return false; }
    await loadPortal();
    return true;
  }
  $<HTMLFormElement>('.portal-add').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fm = e.target as HTMLFormElement;
    const v = (n: string) => (fm.elements.namedItem(n) as HTMLInputElement).value;
    if (await portalPost({ action: 'gallery', title: v('title'), url: v('url') })) { fm.reset(); toast('Gallery added to their portal.'); }
  });
  $('.portal-docs').addEventListener('change', async () => {
    const ids = [...document.querySelectorAll<HTMLInputElement>('.portal-docs input:checked')].map((i) => Number(i.value));
    if (await portalPost({ action: 'share', document_ids: ids })) toast('Their portal’s files updated.');
  });

  let clashList: any[] = [];
  let appts: any[] = [];
  let editingAppt = 0;
  const apptForm = $<HTMLFormElement>('.appt-form');
  function openAppt(a: any | null) {
    editingAppt = a?.id ?? 0;
    apptForm.reset();
    if (a) for (const k of ['title', 'date', 'start_time', 'end_time', 'location']) (apptForm.elements.namedItem(k) as HTMLInputElement).value = a[k] ?? '';
    apptForm.hidden = false;
    (apptForm.elements.namedItem('title') as HTMLInputElement).focus();
  }
  apptForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = { ...Object.fromEntries(new FormData(apptForm)), ...(editingAppt ? { id: editingAppt } : { job_id: id }) };
    const r = await fetch('/api/studio/crm/appointment', { method: editingAppt ? 'PUT' : 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save it.', true); return; }
    apptForm.hidden = true;
    toast('Saved. It’s in the calendar.');
    await load();
  });

  async function load() {
    await loadLists();
    const r = await fetch(`/api/studio/crm/job?id=${id}`);
    const d = await r.json();
    if (!r.ok) { $('.status').textContent = d.error || `Something went wrong (${r.status}).`; return; }
    $('.test-banner').hidden = d.mode === 'live';
    const j = d.job;
    document.title = `${j.title} · Moments Studio`;
    $('.title').textContent = j.title;
    $('.hold-note').hidden = !j.hold;
    $('.eyebrow-line').textContent = [j.job_type, j.event_date && new Date(`${j.event_date}T12:00:00Z`).toLocaleDateString('en-NZ', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }), j.venue].filter(Boolean).join(' · ');
    stage = j.stage;
    // Where they're at, and only the next sensible actions (no Lost on a booked job).
    const STAGE: Record<string, [string, [string, string][]]> = {
      lead: ['Lead', [['booked', 'Mark as booked'], ['lost', 'Not going ahead']]],
      booked: ['Booked', [['completed', 'Mark as completed']]],
      completed: ['Completed', [['booked', 'Undo']]],
      lost: ['Not going ahead', [['lead', 'Undo']]],
    };
    const [now, acts] = STAGE[stage] ?? STAGE.lead;
    $('.stage').innerHTML = `<span class="stage-now stage-now--${stage}">${now}</span>${acts.map(([to, label]) => `<button type="button" data-stage="${to}" class="${label === 'Undo' ? 'undo' : ''}">${label}</button>`).join('')}`;
    const typeSel = form.elements.namedItem('job_type') as HTMLSelectElement;
    if (j.job_type && ![...typeSel.options].some((o) => o.value === j.job_type)) typeSel.add(new Option(j.job_type, j.job_type));
    for (const el of Array.from(form.elements) as HTMLInputElement[]) if (el.name) el.value = j[el.name] ?? '';
    $('.message').textContent = j.message || 'No message.';
    const enquired = new Date(j.created_at).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' });
    $('.message').dataset.when = `Enquired ${enquired}`;

    $('.steps').innerHTML = d.steps.length ? d.steps.map((s: Step) => {
      if (s.status === 'skipped' && /^Stopped:/.test(s.note)) {
        return `<li id="step-${s.id}" class="step step--unneeded">
        <span class="kind kind--unneeded">Not needed</span>
        <span class="what"><strong>${esc(s.title)}</strong><br><small>${esc(s.note.replace(/^Stopped: /, 'Stopped because '))}</small></span>
      </li>`;
      }
      const open = s.status === 'scheduled' || s.status === 'due' || s.status === 'failed';
      return `<li id="step-${s.id}" class="step step--${s.status}">
        <span class="kind kind--${s.kind}">${kindLabel[s.kind] ?? s.kind}</span>
        <span class="what"><strong>${esc(s.title)}</strong><br><small>${s.due_at >= '9000' && !s.done_at ? 'When you’re ready' : `${statusLabel[s.status] ?? s.status} · ${s.done_at ? dateTime(s.done_at) : dateTime(s.due_at)}`}${s.note ? ` · ${esc(s.note)}` : ''}${s.stop_on && open ? ' · stops if they reply or book' : ''}</small></span>
        ${open && s.kind !== 'todo' ? `<button type="button" class="s-btn" data-review-step="${s.id}">${s.due_at >= '9000' ? (JSON.parse(s.config || '{}').gallery ? 'Add the gallery link and send' : 'Review and send') : s.kind === 'auto_email' && s.status !== 'failed' ? 'Send now' : 'Review and send'}</button>` : ''}
        ${open && s.kind !== 'auto_email' ? `<button type="button" class="s-btn s-btn--quiet" data-step="${s.id}" data-action="done">✓ Done</button>` : ''}
        ${open ? `<button type="button" class="s-btn s-btn--quiet" data-step="${s.id}" data-action="skip">Skip</button>` : `<button type="button" class="s-btn s-btn--quiet" data-step="${s.id}" data-action="reopen">Undo</button>`}
      </li>`;
    }).join('') : '<li class="empty">No steps planned.</li>';

    messages = d.messages;
    $('.messages').innerHTML = d.messages.length ? d.messages.map((m: Message, i: number) =>
      `<li><button type="button" class="msg-open" data-msg="${i}"><span class="dir">${m.direction === 'in' ? 'From them' : 'Sent'}</span> <strong>${esc(m.subject)}</strong> <small>${dateTime(m.sent_at)}${m.attachments ? ' · 📎' : ''}</small></button></li>`).join('')
      : '<li class="empty">No emails yet. Once Gmail is connected, everything sent from the studio shows here.</li>';

    const qs: Record<string, string> = { draft: 'Draft', sent: 'Sent', accepted: 'Accepted', withdrawn: 'Withdrawn', declined: 'Declined' };
    $('.quotes').innerHTML = d.quotes.length ? d.quotes.map((q: { id: number; status: string; total: number | null; sent_at: string | null; viewed_at: string | null; accepted_at: string | null; created_at: string }) =>
      `<li><a href="/studio/crm/quote?id=${q.id}"><strong>${qs[q.status] ?? q.status}</strong></a> <a class="pdf" href="/api/studio/crm/contract?quote=${q.id}&pdf=1" target="_blank" rel="noopener">PDF</a> <small>${q.accepted_at ? `accepted ${dateTime(q.accepted_at)}${q.total ? ` · ${(q.total / 100).toLocaleString('en-NZ')}` : ''}` : q.sent_at ? `sent ${dateTime(q.sent_at)}${q.viewed_at ? ' · opened' : ' · not opened yet'}` : `made ${dateTime(q.created_at)}`}</small></li>`).join('')
      : '<li class="empty">No quotes yet.</li>';
    const cs: Record<string, string> = { sent: 'Sent, not signed yet', signed: 'Signed', void: 'Cancelled' };
    $('.contracts').innerHTML = d.contracts.length ? d.contracts.map((c: { id: number; name: string; status: string; sent_at: string | null; viewed_at: string | null; signed_name: string | null; signed_at: string | null }) =>
      `<li><a href="/api/studio/crm/contract?id=${c.id}&pdf=1" target="_blank" rel="noopener"><strong>${esc(c.name)}</strong></a> <small>${cs[c.status] ?? c.status}${c.status === 'signed' ? ` by ${esc(c.signed_name)} · ${dateTime(c.signed_at!)}` : c.sent_at ? ` · sent ${dateTime(c.sent_at)}${c.viewed_at ? ' · opened' : ''}` : ''}</small></li>`).join('')
      : '<li class="empty">No contracts yet. One is sent automatically when they accept a quote.</li>';
    const money = (c: number) => `${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const day = (x: string) => new Date(`${x.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Pacific/Auckland' });
    const signed = d.contracts.filter((c: { status: string }) => c.status === 'signed');
    invoices = d.invoices;
    // Date clash: another open lead or a booking on the same date.
    clashList = d.clashes;
    const cl = $('.clash');
    cl.hidden = !d.clashes.length;
    cl.innerHTML = d.clashes.length ? `⚠ ${d.clashes.some((c: any) => c.stage === 'booked') ? 'This date is already booked' : 'Another lead wants this date'}: ${d.clashes.map((c: any) => `<a href="/studio/crm/job?id=${c.id}">${esc(c.title)}</a> (${c.stage === 'booked' ? 'booked' : 'lead'}, ${esc(c.job_type)})`).join(', ')}` : '';
    // Appointments.
    appts = d.appointments;
    const tm = (t: string | null) => (t ? new Date(`2000-01-01T${t}:00`).toLocaleTimeString('en-NZ', { hour: 'numeric', minute: '2-digit' }) : '');
    $('.appts').innerHTML = d.appointments.map((a: any, i: number) => `<li class="inv"><span class="what"><strong>${esc(a.title)}</strong><br><small>${new Date(`${a.date}T12:00:00Z`).toLocaleDateString('en-NZ', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}${a.start_time ? ` · ${tm(a.start_time)}${a.end_time ? `–${tm(a.end_time)}` : ''}` : ' · all day'}${a.location ? ` · ${esc(a.location)}` : ''}</small></span>
      <button type="button" class="s-btn s-btn--quiet" data-appt-edit="${i}">Change</button><button type="button" class="s-btn s-btn--quiet" data-appt-delete="${a.id}">Remove</button></li>`).join('') || '<li class="empty">None yet: practice shoot, planning meeting…</li>';
    const gn = $('.gcal-note');
    gn.hidden = d.googleCalendar;
    gn.textContent = 'These and the wedding date go into your Google Calendar once it’s connected (Clients page).';
    const qStatus = (q: { status: string; submitted_at: string | null; created_at: string; updated_at: string }) => q.status === 'submitted'
      ? `<b class="ok">Sent in</b> ${dateTime(q.submitted_at!)}${q.updated_at > q.submitted_at! ? ' · changed since' : ''}`
      : q.updated_at > q.created_at ? `Started, not sent in yet · last saved ${dateTime(q.updated_at)}` : 'Not started yet';
    const choose = `<select class="q-pick" aria-label="Which questionnaire">${d.questionnaireTemplates.map((t: { key: string; name: string }) => `<option value="${esc(t.key)}"${t.key === d.defaultQuestionnaire ? ' selected' : ''}>${esc(t.name)}</option>`).join('')}</select>`;
    $('.questionnaires').innerHTML = (d.questionnaires.length ? d.questionnaires.map((q: any) =>
      `<li class="inv"><span class="what"><strong>${esc(q.name)}</strong><br><small>${qStatus(q)}</small></span>
        <button type="button" class="s-btn" data-q="${q.id}" data-q-act="view">See answers</button>
        <a class="s-btn s-btn--quiet" href="/api/studio/crm/questionnaire?id=${q.id}&pdf=1" target="_blank" rel="noopener">PDF</a>
        <button type="button" class="s-btn s-btn--quiet" data-q-link="/questionnaire?t=${q.token}">Copy link</button>
        <a class="s-btn s-btn--quiet" href="/questionnaire?t=${q.token}" target="_blank" rel="noopener">Their page ↗</a>
        <button type="button" class="s-btn s-btn--quiet" data-q="${q.id}" data-q-act="delete">Remove</button></li>`).join('') : '')
      + (d.questionnaireTemplates.length ? `<li class="inv q-make">${d.questionnaires.length ? '<span class="what"><small>Another one:</small></span>' : '<span class="what"><small>None yet. The planning email will send it; or make it now and copy the link.</small></span>'}${choose}<button type="button" class="s-btn s-btn--quiet" data-q-act="make">Make questionnaire</button></li>` : '<li class="empty">Make a questionnaire in Settings first.</li>');
    $('.invoices').innerHTML = invoices.length ? invoices.map((i) => {
      const late = i.status === 'sent' && i.due_date < today;
      const how = i.paid_method === 'card' ? 'card' : i.paid_method === 'bank' ? 'bank transfer' : esc(i.paid_method || '');
      const state = i.status === 'paid' ? `Paid ${day(i.paid_at!)} (${how})${i.paid_note ? ` · ${esc(i.paid_note)}` : ''}`
        : i.status === 'sent' ? `${late ? '<b class="late">Overdue</b> · ' : ''}Sent ${day(i.sent_at!)} · due ${day(i.due_date)}${i.reminders ? ` · ${i.reminders} reminder${i.reminders > 1 ? 's' : ''} sent` : ''}`
        : i.status === 'scheduled' ? `Sends ${day(i.send_at)} · due ${day(i.due_date)}` : 'Cancelled';
      const open = i.status === 'sent' || i.status === 'scheduled';
      return `<li class="inv inv--${i.status}"><span class="what"><a href="/api/studio/crm/invoice?id=${i.id}&pdf=1" target="_blank" rel="noopener"><strong>${esc(i.number)}</strong></a> ${esc(i.label)} · <strong>${money(i.amount)}</strong><br><small>${state}</small></span>
        ${open ? `<button type="button" class="s-btn" data-inv="${i.id}" data-inv-act="paid">Mark paid</button><button type="button" class="s-btn s-btn--quiet" data-inv="${i.id}" data-inv-act="send">${i.status === 'sent' ? 'Send again' : 'Send now'}</button><button type="button" class="s-btn s-btn--quiet" data-inv="${i.id}" data-inv-act="edit">Change</button><button type="button" class="s-btn s-btn--quiet" data-inv="${i.id}" data-inv-act="void">Cancel</button>` : ''}
        ${i.status !== 'void' ? `<a class="pdf" href="/invoice?t=${i.token}" target="_blank" rel="noopener">Their page</a>` : ''}</li>`;
    }).join('')
      : signed.length ? `<li class="empty">No invoices. <button type="button" class="s-btn s-btn--quiet" data-make-invoices="${signed[0].id}">Make the invoices</button></li>`
      : '<li class="empty">No invoices yet. They’re made when the contract is signed, and the deposit invoice goes straight away.</li>';
    const other = $('.other-jobs');
    other.hidden = !d.otherJobs.length;
    other.innerHTML = d.otherJobs.length ? `Also: ${d.otherJobs.map((o: { id: number; title: string; job_type: string }) => `<a href="/studio/crm/job?id=${o.id}">${esc(o.job_type)}</a>`).join(', ')}` : '';

    dirty = false; saveBtn.disabled = true; $('.save-state').textContent = '';
    $('.content').hidden = false; $('.status').hidden = true;
    if (location.hash) document.querySelector(location.hash)?.scrollIntoView({ block: 'center' });
  }

  async function save(extra: Record<string, unknown> = {}) {
    const body: Record<string, unknown> = { id, stage, ...Object.fromEntries(new FormData(form)), ...extra };
    saveBtn.disabled = true;
    $('.save-state').textContent = 'Saving…';
    const r = await fetch('/api/studio/crm/job', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); saveBtn.disabled = false; $('.save-state').textContent = 'Not saved'; return; }
    toast('Saved.');
    await load();
  }

  // ---- Review and send ----
  const dlg = $<HTMLDialogElement>('dialog.review');
  const rf = $<HTMLFormElement>('.review-form');
  const preview = dlg.querySelector('iframe')!;
  let reviewStep = 0;
  const showPreview = () => {
    const subject = (rf.elements.namedItem('subject') as HTMLInputElement).value;
    const body = (rf.elements.namedItem('body') as HTMLTextAreaElement).value;
    preview.srcdoc = emailHtml({ subject, body });
  };
  const reviewRich = attachRich(rf.elements.namedItem('body') as HTMLTextAreaElement, { minHeight: 380 });
  const reviewDocs = attachPicker($('.review-attach'));
  rf.addEventListener('input', showPreview);
  async function openReview(stepId: number) {
    const r = await fetch(`/api/studio/crm/send?step=${stepId}`);
    const d = await r.json();
    if (!r.ok) { toast(d.error || 'Couldn’t open that email.', true); return; }
    if (!d.gmail) { toast('Connect Gmail first (on the Clients page).', true); return; }
    reviewStep = stepId;
    $('.review-title').textContent = d.step.title;
    $('.review-to').innerHTML = d.mode === 'live'
      ? `To: <strong>${esc(d.to)}</strong>`
      : `To: ${esc(d.to)} · <strong>test mode: it will go to ${esc(d.deliversTo)}</strong>`;
    const miss = $('.review-missing');
    miss.hidden = !d.missing.length;
    miss.textContent = d.missing.length ? `Fill in the gaps in [square brackets]: ${d.missing.join(', ')}` : '';
    $('.review-gallery').hidden = !d.gallery;
    (rf.elements.namedItem('gallery_link') as HTMLInputElement).value = '';
    reviewDocs.set(d.documents, d.attachments);
    (rf.elements.namedItem('subject') as HTMLInputElement).value = d.subject;
    reviewRich.set(d.body);
    showPreview();
    dlg.showModal();
  }
  // ---- Write an email ----
  const cf = $<HTMLFormElement>('.compose-form');
  const composePreview = cf.querySelector('iframe')!;
  const composeRich = attachRich(cf.elements.namedItem('body') as HTMLTextAreaElement, { minHeight: 340 });
  const composeDocs = attachPicker($('.compose-attach'));
  let replyingTo: number | null = null;
  let viewing: Message | null = null;
  const showComposePreview = () => { composePreview.srcdoc = emailHtml({ subject: (cf.elements.namedItem('subject') as HTMLInputElement).value, body: (cf.elements.namedItem('body') as HTMLTextAreaElement).value }); };
  cf.addEventListener('input', showComposePreview);
  async function loadDraft(template: string) {
    const r = await fetch(`/api/studio/crm/email?job=${id}${template ? `&template=${encodeURIComponent(template)}` : ''}${replyingTo ? `&reply=${replyingTo}` : ''}`);
    const d = await r.json();
    if (!r.ok) { toast(d.error || 'Couldn’t start the email.', true); return null; }
    (cf.elements.namedItem('subject') as HTMLInputElement).value = d.subject;
    composeRich.set(d.body);
    composeDocs.set(d.documents, d.attachments);
    const miss = $('.compose-missing');
    miss.hidden = !d.missing.length;
    miss.textContent = d.missing.length ? `Fill in the gaps in [square brackets]: ${d.missing.join(', ')}` : '';
    showComposePreview();
    return d;
  }
  async function openCompose(reply: number | null) {
    replyingTo = reply;
    const d = await loadDraft('');
    if (!d) return;
    if (!d.gmail) { toast('Connect Gmail first (on the Clients page).', true); return; }
    const sel = cf.elements.namedItem('template') as HTMLSelectElement;
    sel.replaceChildren(new Option('A blank email', ''), ...d.templates.map((x: { key: string; name: string }) => new Option(x.name, x.key)));
    $('.compose-title').textContent = reply ? 'Reply' : 'Write an email';
    $('.compose-to').innerHTML = d.mode === 'live' ? `To: <strong>${esc(d.to)}</strong>${reply ? ' · in the same conversation' : ''}` : `To: ${esc(d.to)} · <strong>test mode: it will go to ${esc(d.deliversTo)}</strong>`;
    $<HTMLDialogElement>('dialog.compose').showModal();
  }
  (cf.elements.namedItem('template') as HTMLSelectElement).addEventListener('change', async (e) => {
    const subjectNow = (cf.elements.namedItem('subject') as HTMLInputElement).value;
    await loadDraft((e.target as HTMLSelectElement).value);
    if (replyingTo && subjectNow) (cf.elements.namedItem('subject') as HTMLInputElement).value = subjectNow; // keep "Re: …" on a reply
  });

  dlg.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-review]');
    if (!b) return;
    if (b.dataset.review === 'cancel') { dlg.close(); return; }
    if (reviewDocs.over()) { toast('The attachments are over Gmail’s 25 MB limit. Untick one.', true); return; }
    b.disabled = true;
    b.textContent = 'Sending…';
    const r = await fetch('/api/studio/crm/send', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
      step: reviewStep,
      attachments: reviewDocs.get(),
      gallery_link: (rf.elements.namedItem('gallery_link') as HTMLInputElement).value.trim(),
      subject: (rf.elements.namedItem('subject') as HTMLInputElement).value,
      body: (rf.elements.namedItem('body') as HTMLTextAreaElement).value,
    }) });
    const d = await r.json().catch(() => ({}));
    b.disabled = false;
    b.textContent = 'Send';
    if (!r.ok) { toast(d.error || 'Couldn’t send.', true); return; }
    dlg.close();
    toast(d.redirected ? `Test mode: sent to ${d.to} (not ${d.intended}).` : `Sent to ${d.to}.`);
    await load();
  });

  form.addEventListener('input', markDirty);
  saveBtn.addEventListener('click', () => save());
  addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const st = t.closest<HTMLButtonElement>('.stage button');
    if (st && st.dataset.stage !== stage) {
      const next = st.dataset.stage!;
      if (next === 'lost' && !confirm('Mark as not going ahead? Any follow-ups waiting will stop.')) return;
      const taken = clashList.filter((c) => c.stage === 'booked');
      if (next === 'booked' && taken.length && !confirm(`This date is already booked: ${taken.map((c) => c.title).join(', ')}. Mark this one booked as well?`)) return;
      stage = next;
      await save();
      return;
    }
    if (t.closest('[data-act="new-quote"]')) {
      const r = await fetch('/api/studio/crm/quote', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ job_id: id }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t make a quote.', true); return; }
      location.href = `/studio/crm/quote?id=${d.id}`;
      return;
    }
    if (t.closest('[data-appt-new]')) { openAppt(null); return; }
    if (t.closest('[data-appt-cancel]')) { apptForm.hidden = true; return; }
    const ae = t.closest<HTMLButtonElement>('[data-appt-edit]');
    if (ae) { openAppt(appts[Number(ae.dataset.apptEdit)]); return; }
    const ad = t.closest<HTMLButtonElement>('[data-appt-delete]');
    if (ad) { if (confirm('Remove this appointment?')) { await fetch(`/api/studio/crm/appointment?id=${ad.dataset.apptDelete}`, { method: 'DELETE' }); await load(); } return; }
    if (t.closest('[data-portal-copy]') && portal) { await navigator.clipboard.writeText(portal.link); toast('Portal link copied.'); return; }
    const gr = t.closest<HTMLButtonElement>('[data-gallery-remove]');
    if (gr) { if (confirm('Remove this gallery from their portal?')) await portalPost({ action: 'gallery-remove', id: Number(gr.dataset.galleryRemove) }); return; }
    const ur = t.closest<HTMLButtonElement>('[data-upload-remove]');
    if (ur) { if (confirm('Delete this file they uploaded?')) await portalPost({ action: 'upload-remove', id: Number(ur.dataset.uploadRemove) }); return; }
    const ql = t.closest<HTMLButtonElement>('[data-q-link]');
    if (ql) { await navigator.clipboard.writeText(location.origin.replace(/localhost:\d+/, 'www.momentsinlight.co.nz') + ql.dataset.qLink); toast('Link copied. Paste it into an email to them.'); return; }
    if (t.closest('[data-q-close]')) { $<HTMLDialogElement>('dialog.q-view').close(); return; }
    const qa = t.closest<HTMLButtonElement>('[data-q-act]');
    if (qa) {
      const act = qa.dataset.qAct!;
      if (act === 'make') {
        qa.disabled = true;
        const r = await fetch('/api/studio/crm/questionnaire', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ job_id: id, key: $<HTMLSelectElement>('.q-pick').value }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { toast(d.error || 'Couldn’t make it.', true); qa.disabled = false; return; }
        toast('Made. Use Copy link to send it to them, or see their page.');
        await load();
      } else if (act === 'delete') {
        if (!confirm('Remove this questionnaire, with any answers and photos they’ve added? This can’t be undone.')) return;
        await fetch(`/api/studio/crm/questionnaire?id=${qa.dataset.q}`, { method: 'DELETE' });
        await load();
      } else if (act === 'view') {
        const r = await fetch(`/api/studio/crm/questionnaire?id=${qa.dataset.q}`);
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { toast(d.error || 'Couldn’t open it.', true); return; }
        $('.q-view-title').textContent = d.name;
        $('.q-view-meta').textContent = d.status === 'submitted' ? `Sent in ${dateTime(d.submitted_at)}` : 'Not sent in yet; these are the answers saved so far.';
        $('.q-view-body').innerHTML = formHtml(d.questions, d.answers, { readonly: true, uploads: d.uploads, fileUrl: (u: number) => `/api/studio/crm/questionnaire?id=${d.id}&file=${u}` });
        $<HTMLDialogElement>('dialog.q-view').showModal();
      }
      return;
    }
    const mk = t.closest<HTMLButtonElement>('[data-make-invoices]');
    if (mk) {
      mk.disabled = true;
      const r = await fetch('/api/studio/crm/invoice', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create', contract_id: Number(mk.dataset.makeInvoices) }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t make them.', true); mk.disabled = false; return; }
      toast(`${d.made} invoices made. Each sends on its date; use Send now for one that’s due.`);
      await load();
      return;
    }
    const ib = t.closest<HTMLButtonElement>('[data-inv-act]');
    if (ib) {
      const inv = invoices.find((i) => i.id === Number(ib.dataset.inv))!;
      const act = ib.dataset.invAct!;
      const body: Record<string, unknown> = { id: inv.id, action: act };
      if (act === 'paid') {
        const how = prompt(`Mark ${inv.number} (${(inv.amount / 100).toFixed(2)}) as paid. They'll be emailed a receipt.\n\nHow was it paid? bank, card or other, then a note if you like (e.g. "bank paid 12 Nov").`, 'bank');
        if (how === null) return;
        const [m, ...note] = how.trim().split(/\s+/);
        const known = ['bank', 'card', 'other'].includes((m || '').toLowerCase());
        body.method = known ? m.toLowerCase() : 'other';
        body.note = known ? note.join(' ') : how.trim();
      } else if (act === 'send') {
        if (!confirm(`Email ${inv.number} to them now?`)) return;
      } else if (act === 'void') {
        if (!confirm(`Cancel ${inv.number}? It won't be sent, reminded or payable after this.`)) return;
      } else if (act === 'edit') {
        const amt = prompt(`Amount for ${inv.number} (NZ$, including GST):`, (inv.amount / 100).toFixed(2));
        if (amt === null) return;
        const due = prompt('Due date (YYYY-MM-DD):', inv.due_date);
        if (due === null) return;
        body.amount = Math.round(Number(amt.replace(/[$,\s]/g, '')) * 100);
        body.due_date = due.trim();
      }
      ib.disabled = true;
      const r = await fetch('/api/studio/crm/invoice', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t do that.', true); ib.disabled = false; return; }
      toast(act === 'paid' ? 'Marked paid. Receipt emailed.' : act === 'send' ? (d.redirected ? `Test mode: sent to ${d.to} (not ${d.intended}).` : `Sent to ${d.to}.`) : act === 'void' ? 'Cancelled.' : 'Changed.');
      await load();
      return;
    }
    const mo = t.closest<HTMLButtonElement>('[data-msg]');
    if (mo) {
      const m = messages[Number(mo.dataset.msg)];
      viewing = m;
      const v = $<HTMLDialogElement>('dialog.msg-view');
      $('.msg-title').textContent = m.subject;
      $('.msg-meta').textContent = `${m.direction === 'in' ? 'From them' : 'Sent'} · ${dateTime(m.sent_at)}`;
      const files = $('.msg-files');
      files.hidden = !m.attachments;
      files.textContent = m.attachments ? `Attached: ${m.attachments.split('\n').join(', ')}` : '';
      const frame = $<HTMLIFrameElement>('.msg-frame');
      const wrap = (html: string) => `<base target="_blank"><body style="font:15px/1.7 Raleway,Arial,sans-serif;color:#333;padding:16px 20px;background:#fff;margin:0">${html}</body>`;
      // Sent from the studio: as it was sent. Otherwise (their emails, or sent from Gmail): the whole email from Gmail.
      frame.srcdoc = m.direction === 'out' && m.body && m.body.length > 200 ? emailHtml({ subject: m.subject, body: m.body }) : wrap('<p style="color:#888">Opening the email…</p>');
      const g = $<HTMLAnchorElement>('.msg-gmail');
      g.hidden = !m.gmail_message_id;
      if (m.gmail_message_id) g.href = `https://mail.google.com/mail/u/0/#all/${m.gmail_message_id}`;
      v.showModal();
      if (m.gmail_message_id && !(m.direction === 'out' && m.body && m.body.length > 200)) {
        const r = await fetch(`/api/studio/crm/email?message=${m.id}`);
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { frame.srcdoc = wrap(`<p>${esc(m.body)}</p><p style="color:#a8432a">Couldn’t open the whole email: ${esc(d.error || r.status)}. Use Open in Gmail.</p>`); return; }
        if (d.files?.length) { files.hidden = false; files.textContent = `Attached: ${d.files.join(', ')}`; }
        frame.srcdoc = d.html ? d.html.replace(/<head>/i, '<head><base target="_blank">') : wrap(`<div style="white-space:pre-wrap">${esc(d.text)}</div>`);
      }
      return;
    }
    if (t.closest('[data-msg-close]')) { $<HTMLDialogElement>('dialog.msg-view').close(); return; }
    if (t.closest('[data-msg-reply]') && viewing) { $<HTMLDialogElement>('dialog.msg-view').close(); openCompose(viewing.id); return; }
    const cb = t.closest<HTMLButtonElement>('[data-compose]');
    if (cb && !cb.dataset.compose) { openCompose(null); return; }
    if (cb?.dataset.compose === 'cancel') { $<HTMLDialogElement>('dialog.compose').close(); return; }
    if (cb?.dataset.compose === 'send') {
      if (composeDocs.over()) { toast('The attachments are over Gmail’s 25 MB limit. Untick one.', true); return; }
      cb.disabled = true; cb.textContent = 'Sending…';
      const r = await fetch('/api/studio/crm/email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
        job_id: id, reply: replyingTo, attachments: composeDocs.get(),
        subject: (cf.elements.namedItem('subject') as HTMLInputElement).value, body: (cf.elements.namedItem('body') as HTMLTextAreaElement).value,
      }) });
      const d = await r.json().catch(() => ({}));
      cb.disabled = false; cb.textContent = 'Send';
      if (!r.ok) { toast(d.error || 'Couldn’t send.', true); return; }
      $<HTMLDialogElement>('dialog.compose').close();
      toast(d.redirected ? `Test mode: sent to ${d.to} (not ${d.intended}).` : `Sent to ${d.to}.`);
      await load();
      return;
    }
    const rv = t.closest<HTMLButtonElement>('[data-review-step]');
    if (rv) { openReview(Number(rv.dataset.reviewStep)); return; }
    const b = t.closest<HTMLButtonElement>('[data-step]');
    if (b) {
      b.disabled = true;
      const r = await fetch('/api/studio/crm/step', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(b.dataset.step), action: b.dataset.action }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t save that.', true); b.disabled = false; return; }
      await load();
    }
  });

  if (!id) $('.status').textContent = 'Which client? Open one from the Clients page.';
  else { load(); loadPortal(); }
</script>

<style is:global>
  .test-banner { background: #fff4d6; color: #5c4400; border-bottom: 1px solid #e0c46c; padding: 10px clamp(14px, 3vw, 32px); font-size: 14px; line-height: 1.5; }
  .studio-bar .save-state { font-size: 13px; color: #888; }
  .job-page { max-width: 1100px; margin: 0 auto; padding: 28px clamp(14px, 3vw, 32px) 80px; }
  .job-page .status { color: #666; }
  .job-page .head { margin-bottom: 18px; }

---
// Moments Studio CRM home: today's to-dos and emails to send, what's coming up, and the leads
// and booked jobs. Data from functions/api/studio/crm/today.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
---
<StudioLayout title="Clients" section="clients">
  <button slot="bar" type="button" class="s-btn s-btn--solid" data-add-client>+ Add client</button>

<div class="test-banner" hidden><strong>TEST MODE</strong>: client emails are redirected to you, nothing reaches a client. It switches to live only when you set CRM_SEND_MODE to “live” in Cloudflare.</div>
  <main class="crm">
    <p class="status" aria-live="polite">Loading…</p>
    <div class="content" hidden>
      <div class="gmail card">
        <span class="gmail-state"></span>
        <a class="s-btn" href="/api/studio/crm/gmail-connect" data-connect>Connect Gmail</a>
        <button type="button" class="s-btn s-btn--quiet" data-gmail-test hidden>Send me a test email</button>
      </div>
      <section class="card">
        <h1>Today</h1>
        <ul class="steps today"></ul>
      </section>
      <section class="card">
        <h2>Coming up</h2>
        <p class="hint">The next two weeks. Automatic emails go by themselves; the rest will appear under Today when they're due.</p>
        <ul class="steps upcoming"></ul>
      </section>
      <section class="card">
        <div class="list-head">
          <h2>Leads and jobs</h2>
          <div class="tabs" role="group" aria-label="Show">
            <button type="button" data-stage="lead" class="on">Leads</button>
            <button type="button" data-stage="booked">Booked</button>
            <a class="spam-link" href="/studio/crm/spam" hidden>Spam</a>
          </div>
        </div>
        <table class="jobs"><thead><tr><th>Name</th><th>Type</th><th>Date</th><th>Venue</th><th>Enquired</th></tr></thead><tbody></tbody></table>
      </section>
    </div>
  </main>
  <dialog class="add-client" aria-labelledby="add-title">
    <form class="add-form" autocomplete="off" novalidate>
      <h2 id="add-title">Add a client</h2>
      <p class="hint">For an enquiry by phone, Facebook or in person. Nothing is sent unless you tick the workflow box.</p>
      <div class="two"><label>First name *<input name="first_name" required /></label><label>Last name<input name="last_name" /></label></div>
      <div class="two"><label>Email *<input name="email" type="email" required /></label><label>Phone<input name="phone" type="tel" /></label></div>
      <label>Partner's name<input name="partner_name" placeholder="For a couple" /></label>
      <div class="two"><label>Type<select name="job_type"></select></label><label>Heard about you via<input name="lead_source" list="add-sources" /><datalist id="add-sources"></datalist></label></div>
      <div class="three"><label>Date<input name="event_date" type="date" /></label><label>Time<input name="event_time" type="time" title="Optional" /></label><label>Venue / location<input name="venue" /></label></div>
      <label>Notes<textarea name="notes" rows="3" placeholder="What they told you"></textarea></label>
      <fieldset class="add-stage"><legend>They are</legend>
        <label><input type="radio" name="stage" value="lead" checked /> A lead (enquiring)</label>
        <label><input type="radio" name="stage" value="booked" /> Booked</label>
      </fieldset>
      <label class="add-wf"><input type="checkbox" name="workflow" /> <span class="add-wf-text"></span></label>
      <p class="add-msg" role="alert" hidden></p>
      <div class="add-actions"><button type="button" class="s-btn s-btn--quiet" data-add-cancel>Cancel</button><button type="submit" class="s-btn s-btn--solid">Add client</button></div>
    </form>
  </dialog>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  type Step = { id: number; job_id: number; kind: string; title: string; due_at: string; status: string; note: string; job_title: string; job_type: string; event_date: string | null };
  type Job = { id: number; title: string; job_type: string; stage: string; event_date: string | null; venue: string; created_at: string };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const nzDate = (d: string | null) => (d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '–');
  const when = (iso: string) => {
    const d = new Date(iso);
    const days = Math.round((d.setHours(0, 0, 0, 0) - new Date().setHours(0, 0, 0, 0)) / 86400_000);
    return days === 0 ? 'today' : days === 1 ? 'tomorrow' : days === -1 ? 'yesterday' : days < 0 ? `${-days} days ago` : `in ${days} days`;
  };
  const kindLabel: Record<string, string> = { auto_email: 'Automatic email', ready_email: 'Email to send', todo: 'To-do' };

  // ---- Add a client by hand ----
  const addDlg = $<HTMLDialogElement>('dialog.add-client');
  const addForm = $<HTMLFormElement>('.add-form');
  let addLists: { job_type: { value: string; workflow: string | null }[]; lead_source: { value: string }[]; workflows: { key: string; name: string }[] } | null = null;
  const af = (n: string) => addForm.elements.namedItem(n) as HTMLInputElement;
  function wfText() {
    const t = addLists?.job_type.find((x) => x.value === af('job_type').value);
    const wf = addLists?.workflows.find((w) => w.key === t?.workflow);
    const booked = (addForm.querySelector('input[name="stage"]:checked') as HTMLInputElement).value === 'booked';
    const box = af('workflow');
    box.disabled = !wf;
    if (!wf) box.checked = false;
    $('.add-wf-text').textContent = !wf ? `${t?.value ?? 'This type'} has no workflow (Settings > Workflows), so nothing will be planned.`
      : booked ? `Start the ${wf.name} workflow's booking and planning steps (emails and to-dos timed from their date).`
      : `Start the ${wf.name} workflow's enquiry emails (the enquiry response and follow-ups). Leave unticked if you've already replied.`;
  }
  async function openAdd() {
    if (!addLists) {
      const r = await fetch('/api/studio/crm/settings');
      if (!r.ok) { toast('Couldn’t load the job types.', true); return; }
      addLists = await r.json();
      (addForm.elements.namedItem('job_type') as HTMLSelectElement).replaceChildren(...addLists!.job_type.map((t) => new Option(t.value, t.value)));
      $('#add-sources').replaceChildren(...addLists!.lead_source.map((t) => new Option(t.value, t.value)));
    }
    addForm.reset();
    $('.add-msg').hidden = true;
    wfText();
    addDlg.showModal();
    af('first_name').focus();
  }
  addForm.addEventListener('change', (e) => {
    const n = (e.target as HTMLInputElement).name;
    if (n === 'stage') af('workflow').checked = (e.target as HTMLInputElement).value === 'booked' && !af('workflow').disabled;
    if (n === 'stage' || n === 'job_type') wfText();
  });
  addForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = { ...Object.fromEntries(new FormData(addForm)), workflow: af('workflow').checked };
    const btn = addForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    const r = await fetch('/api/studio/crm/job', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    btn.disabled = false;
    if (!r.ok) { const m = $('.add-msg'); m.textContent = d.error || 'Couldn’t add them.'; m.hidden = false; return; }
    location.href = `/studio/crm/job?id=${d.id}`;
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-add-client]')) openAdd();
    if (t.closest('[data-add-cancel]')) addDlg.close();
  });
  if (new URLSearchParams(location.search).has('add')) openAdd();
  const toast = (text: string, error = false) => {
    const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  };
  let jobs: Job[] = [];
  let stage = 'lead';

  const stepRow = (s: Step, actions: boolean) => `<li class="${s.status === 'failed' ? 'failed' : ''}">
    <span class="kind kind--${s.kind}">${kindLabel[s.kind] ?? s.kind}</span>
    <a class="what" href="/studio/crm/job?id=${s.job_id}"><strong>${esc(s.title)}</strong> · ${esc(s.job_title)}</a>
    <span class="due">${s.status === 'failed' ? `Didn’t send: ${esc(s.note)}` : `due ${when(s.due_at)}`}</span>
    ${actions && s.kind === 'todo' ? `<button type="button" class="s-btn s-btn--quiet" data-done="${s.id}">✓ Done</button>` : ''}
    ${actions && s.kind !== 'todo' ? `<a class="s-btn" href="/studio/crm/job?id=${s.job_id}#step-${s.id}">Review</a>` : ''}
  </li>`;

  const renderJobs = () => {
    const list = jobs.filter((j) => j.stage === stage);
    $('.jobs tbody').innerHTML = list.length
      ? list.map((j) => `<tr><td><a href="/studio/crm/job?id=${j.id}">${esc(j.title)}</a></td><td>${esc(j.job_type)}</td><td>${nzDate(j.event_date)}</td><td>${esc(j.venue)}</td><td>${when(j.created_at)}</td></tr>`).join('')
      : `<tr><td colspan="5" class="empty">No ${stage === 'lead' ? 'open leads' : 'booked jobs'} yet.</td></tr>`;
  };

  async function load() {
    try {
      const r = await fetch('/api/studio/crm/today');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || `Something went wrong (${r.status}).`);
      $('.today').innerHTML = d.today.length ? d.today.map((s: Step) => stepRow(s, true)).join('') : '<li class="empty">Nothing due. Enjoy your day!</li>';
      $('.upcoming').innerHTML = d.upcoming.length ? d.upcoming.map((s: Step) => stepRow(s, false)).join('') : '<li class="empty">Nothing planned in the next two weeks.</li>';
      $('.test-banner').hidden = d.mode === 'live';
      $('.gmail-state').innerHTML = d.gmail ? `Gmail: <strong>connected</strong> as ${esc(d.gmail.email || 'your account')} · Google Calendar: ${d.gmail.calendar ? '<strong>connected</strong>' : '<strong>not yet</strong> (press Reconnect and allow the calendar)'}` : 'Gmail: <strong>not connected</strong>. Connect it so the studio can send emails from your address (and fill your Google Calendar).';
      $('[data-connect]').textContent = d.gmail ? 'Reconnect' : 'Connect Gmail';
      $<HTMLButtonElement>('[data-gmail-test]').hidden = !d.gmail;
      jobs = d.jobs;
      renderJobs();
      $('.content').hidden = false;
      $('.status').hidden = true;
    } catch (err) {
      $('.status').textContent = (err as Error).message;
    }
  }

  const gmailResult: Record<string, [string, boolean]> = {
    connected: ['Gmail connected. Try “Send me a test email”.', false],
    cancelled: ['Gmail wasn’t connected (cancelled on Google’s page).', true],
    expired: ['That took a little long. Please click Connect Gmail again.', true],
    failed: ['Google didn’t complete the connection. Please try again.', true],
  };
  const g = new URLSearchParams(location.search).get('gmail');
  if (g && gmailResult[g]) { toast(...gmailResult[g]); history.replaceState(null, '', location.pathname); }

  document.addEventListener('click', async (e) => {
    const test = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-gmail-test]');
    if (test) {
      test.disabled = true;
      const r = await fetch('/api/studio/crm/gmail-test', { method: 'POST' });
      const d = await r.json().catch(() => ({}));
      toast(r.ok ? `Sent to ${d.to}. Check your inbox.` : d.error || 'Couldn’t send.', !r.ok);
      test.disabled = false;
      return;
    }
    const done = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-done]');
    if (done) {
      done.disabled = true;
      const r = await fetch('/api/studio/crm/step', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(done.dataset.done), action: 'done' }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t save that.', true); done.disabled = false; return; }
      toast('Done.');
      load();
    }
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-stage]');
    if (tab) {
      stage = tab.dataset.stage!;
      document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('on', b === tab));
      renderJobs();
    }
  });
  load();
  // Enquiries the spam check caught in the last 30 days (the link shows once there are any).
  fetch('/api/studio/crm/spam').then((r) => r.json()).then((d) => {
    const since = new Date(Date.now() - 30 * 86400000).toISOString();
    const n = (d.spam ?? []).filter((s: any) => !s.released_at && s.created_at > since).length;
    const a = document.querySelector<HTMLAnchorElement>('.spam-link')!;
    a.hidden = !(d.spam ?? []).length;
    a.textContent = n ? `Spam (${n})` : 'Spam';
  }).catch(() => {});
</script>

<style is:global>
  .add-client { width: min(640px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); border: 0; border-radius: 28px 0; padding: 0; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5); }
  .add-client::backdrop { background: rgb(30 32 20 / 0.45); }
  .add-form { display: flex; flex-direction: column; gap: 12px; padding: 22px 24px; }
  .add-form h2 { margin: 0; font-weight: 300; font-size: 26px; color: var(--ink); }
  .add-form .hint { margin: 0; font-size: 14px; color: #666; }
  .add-form label { display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 600; color: #555; min-width: 0; }
  .add-form label small { font-weight: 400; color: #999; }
  .add-form input:not([type=radio]):not([type=checkbox]), .add-form select, .add-form textarea { font: inherit; font-weight: 400; font-size: 15px; padding: 9px 11px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); color: var(--ink); min-width: 0; }
  .add-form .two, .add-form .three { display: grid; gap: 10px; }
  @media (min-width: 560px) { .add-form .two { grid-template-columns: 1fr 1fr; } .add-form .three { grid-template-columns: 1fr 0.7fr 1.3fr; } }
  .add-stage { border: 0; padding: 0; margin: 0; display: flex; gap: 6px 20px; flex-wrap: wrap; align-items: center; font-size: 14px; }
  .add-stage legend { font-size: 13px; font-weight: 600; color: #555; padding: 0; margin-bottom: 6px; }
  .add-stage label, .add-form .add-wf { flex-direction: row !important; align-items: center; gap: 8px !important; font-weight: 400 !important; font-size: 14px !important; color: #333 !important; }
  .add-form .add-wf { align-items: flex-start; }
  .add-form .add-wf input { margin-top: 3px; }
  .add-msg { margin: 0; padding: 10px 14px; background: #fbeee8; color: #8a3b1e; border-radius: 12px 0; font-size: 14px; }
  .add-actions { display: flex; justify-content: flex-end; gap: 8px; }
  .test-banner { background: #fff4d6; color: #5c4400; border-bottom: 1px solid #e0c46c; padding: 10px clamp(14px, 3vw, 32px); font-size: 14px; line-height: 1.5; }
  .crm { max-width: 1100px; margin: 0 auto; padding: 28px clamp(14px, 3vw, 32px) 80px; }
  .crm .status { color: #666; }
  .crm .gmail { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; padding: 14px 20px; }
  .crm .gmail-state { flex: 1; min-width: 220px; font-size: 14px; color: #555; }
  .crm .card { background: var(--white); border-radius: 24px 0; padding: 20px 24px; margin-bottom: 16px; }
  .crm .card h1, .crm .card h2 { margin: 0 0 12px; font-weight: 300; color: var(--ink); }
  .crm .card h1 { font-size: 30px; }
  .crm .card h2 { font-size: 22px; }
  .crm .hint { margin: -6px 0 12px; font-size: 13px; color: #888; }
  .crm .steps { list-style: none; margin: 0; padding: 0; }
  .crm .steps li { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid #f1ebe1; }
  .crm .steps li:last-child { border-bottom: 0; }
  .crm .steps li.failed { background: #fbeee8; padding-inline: 10px; border-radius: 10px 0; }
  .crm .steps .empty { color: #888; }
  .crm .kind { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: #eef1e4; color: var(--olive); }
  .crm .kind--ready_email { background: #e3e7f6; color: #2f3f86; }
  .crm .kind--todo { background: #f6ecd6; color: #7a5a14; }
  .crm .what { flex: 1; min-width: 200px; color: var(--ink); text-decoration: none; }
  .crm .what strong { font-weight: 600; }
  .crm .due { font-size: 13px; color: #777; }
  .crm .list-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .crm .list-head h2 { margin: 0; }
  .crm .tabs { display: flex; gap: 6px; align-items: center; }
  .crm .spam-link { margin-left: 6px; font-size: 13px; color: #888; }
  .crm .tabs button { padding: 7px 14px; border: 1px solid #ddd3c4; border-radius: 999px; background: var(--white); font: inherit; font-size: 14px; cursor: pointer; }
  .crm .tabs button.on { background: var(--green); border-color: var(--green); color: var(--white); }
  .crm .jobs { width: 100%; border-collapse: collapse; font-size: 14px; }
  .crm .jobs th { text-align: left; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #777; font-weight: 600; padding: 8px; border-bottom: 1px solid #eee6d9; }
  .crm .jobs td { padding: 10px 8px; border-bottom: 1px solid #f3eee6; }
  .crm .jobs td a { color: var(--ink); font-weight: 600; }
  .crm .jobs .empty { color: #888; text-align: center; }
  @media (max-width: 640px) { .crm .jobs th:nth-child(4), .crm .jobs td:nth-child(4) { display: none; } }
</style>

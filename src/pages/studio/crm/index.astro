---
// Moments Studio CRM home: today's to-dos and emails to send, what's coming up, and the leads
// and booked jobs. Data from functions/api/studio/crm/today.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
---
<StudioLayout title="Clients">
  <a slot="bar" class="s-btn s-btn--quiet" href="/studio">Posts</a>
  <a slot="bar" class="s-btn s-btn--quiet" href="/studio/reviews">★ Reviews</a>
  <a slot="bar" class="s-btn s-btn--quiet" href="/studio/stats">📈 Stats</a>

<div class="test-banner" hidden><strong>TEST MODE</strong>: client emails are redirected to you, nothing reaches a client. It switches to live only when you set CRM_SEND_MODE to “live” in Cloudflare.</div>
  <main class="crm">
    <p class="status" aria-live="polite">Loading…</p>
    <div class="content" hidden>
      <section class="card">
        <h1>Today</h1>
        <ul class="steps today"></ul>
      </section>
      <section class="card">
        <h2>Coming up</h2>
        <p class="hint">The next two weeks. Automatic emails go by themselves; the rest will appear under Today when they're due.</p>
        <ul class="steps upcoming"></ul>
      </section>
      <section class="card">
        <div class="list-head">
          <h2>Leads and jobs</h2>
          <div class="tabs" role="group" aria-label="Show">
            <button type="button" data-stage="lead" class="on">Leads</button>
            <button type="button" data-stage="booked">Booked</button>
          </div>
        </div>
        <table class="jobs"><thead><tr><th>Name</th><th>Type</th><th>Date</th><th>Venue</th><th>Enquired</th></tr></thead><tbody></tbody></table>
      </section>
    </div>
  </main>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  type Step = { id: number; job_id: number; kind: string; title: string; due_at: string; status: string; note: string; job_title: string; job_type: string; event_date: string | null };
  type Job = { id: number; title: string; job_type: string; stage: string; event_date: string | null; venue: string; created_at: string };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const nzDate = (d: string | null) => (d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric' }) : '–');
  const when = (iso: string) => {
    const d = new Date(iso);
    const days = Math.round((d.setHours(0, 0, 0, 0) - new Date().setHours(0, 0, 0, 0)) / 86400_000);
    return days === 0 ? 'today' : days === 1 ? 'tomorrow' : days === -1 ? 'yesterday' : days < 0 ? `${-days} days ago` : `in ${days} days`;
  };
  const kindLabel: Record<string, string> = { auto_email: 'Automatic email', ready_email: 'Email to send', todo: 'To-do' };
  const toast = (text: string, error = false) => {
    const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  };
  let jobs: Job[] = [];
  let stage = 'lead';

  const stepRow = (s: Step, actions: boolean) => `<li class="${s.status === 'failed' ? 'failed' : ''}">
    <span class="kind kind--${s.kind}">${kindLabel[s.kind] ?? s.kind}</span>
    <a class="what" href="/studio/crm/job?id=${s.job_id}"><strong>${esc(s.title)}</strong> · ${esc(s.job_title)}</a>
    <span class="due">${s.status === 'failed' ? `Didn’t send: ${esc(s.note)}` : `due ${when(s.due_at)}`}</span>
    ${actions && s.kind === 'todo' ? `<button type="button" class="s-btn s-btn--quiet" data-done="${s.id}">✓ Done</button>` : ''}
    ${actions && s.kind !== 'todo' ? `<a class="s-btn" href="/studio/crm/job?id=${s.job_id}#step-${s.id}">Review</a>` : ''}
  </li>`;

  const renderJobs = () => {
    const list = jobs.filter((j) => j.stage === stage);
    $('.jobs tbody').innerHTML = list.length
      ? list.map((j) => `<tr><td><a href="/studio/crm/job?id=${j.id}">${esc(j.title)}</a></td><td>${esc(j.job_type)}</td><td>${nzDate(j.event_date)}</td><td>${esc(j.venue)}</td><td>${when(j.created_at)}</td></tr>`).join('')
      : `<tr><td colspan="5" class="empty">No ${stage === 'lead' ? 'open leads' : 'booked jobs'} yet.</td></tr>`;
  };

  async function load() {
    try {
      const r = await fetch('/api/studio/crm/today');
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || `Something went wrong (${r.status}).`);
      $('.today').innerHTML = d.today.length ? d.today.map((s: Step) => stepRow(s, true)).join('') : '<li class="empty">Nothing due. Enjoy your day!</li>';
      $('.upcoming').innerHTML = d.upcoming.length ? d.upcoming.map((s: Step) => stepRow(s, false)).join('') : '<li class="empty">Nothing planned in the next two weeks.</li>';
      $('.test-banner').hidden = d.mode === 'live';
      jobs = d.jobs;
      renderJobs();
      $('.content').hidden = false;
      $('.status').hidden = true;
    } catch (err) {
      $('.status').textContent = (err as Error).message;
    }
  }

  document.addEventListener('click', async (e) => {
    const done = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-done]');
    if (done) {
      done.disabled = true;
      const r = await fetch('/api/studio/crm/step', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(done.dataset.done), action: 'done' }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t save that.', true); done.disabled = false; return; }
      toast('Done.');
      load();
    }
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-stage]');
    if (tab) {
      stage = tab.dataset.stage!;
      document.querySelectorAll('.tabs button').forEach((b) => b.classList.toggle('on', b === tab));
      renderJobs();
    }
  });
  load();
</script>

<style is:global>
  .test-banner { background: #fff4d6; color: #5c4400; border-bottom: 1px solid #e0c46c; padding: 10px clamp(14px, 3vw, 32px); font-size: 14px; line-height: 1.5; }
  .crm { max-width: 1100px; margin: 0 auto; padding: 28px clamp(14px, 3vw, 32px) 80px; }
  .crm .status { color: #666; }
  .crm .card { background: var(--white); border-radius: 24px 0; padding: 20px 24px; margin-bottom: 16px; }
  .crm .card h1, .crm .card h2 { margin: 0 0 12px; font-weight: 300; color: var(--ink); }
  .crm .card h1 { font-size: 30px; }
  .crm .card h2 { font-size: 22px; }
  .crm .hint { margin: -6px 0 12px; font-size: 13px; color: #888; }
  .crm .steps { list-style: none; margin: 0; padding: 0; }
  .crm .steps li { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid #f1ebe1; }
  .crm .steps li:last-child { border-bottom: 0; }
  .crm .steps li.failed { background: #fbeee8; padding-inline: 10px; border-radius: 10px 0; }
  .crm .steps .empty { color: #888; }
  .crm .kind { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: #eef1e4; color: var(--olive); }
  .crm .kind--ready_email { background: #e3e7f6; color: #2f3f86; }
  .crm .kind--todo { background: #f6ecd6; color: #7a5a14; }
  .crm .what { flex: 1; min-width: 200px; color: var(--ink); text-decoration: none; }
  .crm .what strong { font-weight: 600; }
  .crm .due { font-size: 13px; color: #777; }
  .crm .list-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .crm .list-head h2 { margin: 0; }
  .crm .tabs { display: flex; gap: 6px; }
  .crm .tabs button { padding: 7px 14px; border: 1px solid #ddd3c4; border-radius: 999px; background: var(--white); font: inherit; font-size: 14px; cursor: pointer; }
  .crm .tabs button.on { background: var(--green); border-color: var(--green); color: var(--white); }
  .crm .jobs { width: 100%; border-collapse: collapse; font-size: 14px; }
  .crm .jobs th { text-align: left; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #777; font-weight: 600; padding: 8px; border-bottom: 1px solid #eee6d9; }
  .crm .jobs td { padding: 10px 8px; border-bottom: 1px solid #f3eee6; }
  .crm .jobs td a { color: var(--ink); font-weight: 600; }
  .crm .jobs .empty { color: #888; text-align: center; }
  @media (max-width: 640px) { .crm .jobs th:nth-child(4), .crm .jobs td:nth-child(4) { display: none; } }
</style>

  // ---- Workflows ----
  const wf = $<HTMLFormElement>('.wf-editor');
  let currentWf: Wf | null = null;
  const opt = (pairs: [string, string][], v?: string) => pairs.map(([k, l]) => `<option value="${esc(k)}"${k === v ? ' selected' : ''}>${esc(l)}</option>`).join('');
  const stepRow = (x: WfStep, all: WfStep[]) => {
    const email = x.kind !== 'todo';
    const days = x.when !== 'manual';
    return `<li class="qn-q wf-step" data-id="${esc(x.id)}">
      <span class="drag" title="Drag to reorder" aria-hidden="true">⠿</span>
      <div class="qn-q-body">
        <div class="qn-q-top"><input data-s="title" value="${esc(x.title)}" placeholder="Step name" aria-label="Step name" /><button type="button" class="qn-x" data-wf-remove aria-label="Remove this step">✕</button></div>
        <div class="wf-row">
          <select data-s="kind" aria-label="What it is">${opt(Object.entries(KINDS) as [string, string][], x.kind)}</select>
          ${email ? `<select data-s="template" aria-label="Email template"><option value="">Choose the email…</option>${opt(data.templates.map((t) => [t.key, t.name]), x.template)}</select>` : ''}
        </div>
        <div class="wf-row">
          <select data-s="when" aria-label="When">${opt(Object.entries(WHEN) as [string, string][], x.when)}</select>
          ${days ? `<label class="wf-num"><input data-s="days" type="number" min="0" max="730" value="${x.days ?? 0}" /> days</label>` : ''}
          ${x.when === 'enquiry' ? `<label class="wf-num"><input data-s="hours" type="number" min="0" max="72" value="${x.hours ?? 0}" /> hours</label>` : ''}
          ${x.when === 'step' ? `<select data-s="after_step" aria-label="After which step">${opt(all.filter((o) => o.id !== x.id).map((o) => [o.id, o.title]), x.after_step)}</select>` : ''}
        </div>
        <div class="qn-flags">
          <label><input type="checkbox" data-s="stop_reply"${String(x.stop_on || '').includes('reply') ? ' checked' : ''} /> Stop if they reply</label>
          ${x.when === 'enquiry'
            ? '<label title="Every “After the enquiry” step stops once they book or you mark them lost"><input type="checkbox" data-s="stop_booked" checked disabled /> Stops if they book (always, before booking)</label>'
            : `<label><input type="checkbox" data-s="stop_booked"${String(x.stop_on || '').includes('booked') ? ' checked' : ''} /> Stop if they book</label>`}
          <label><input type="checkbox" data-s="stop_reviewed"${String(x.stop_on || '').includes('reviewed') ? ' checked' : ''} /> Stop if they’ve left a Google review</label>
          ${email ? `<label><input type="checkbox" data-s="gallery"${x.gallery ? ' checked' : ''} /> Asks for a gallery link</label>
          <label>Sends questionnaire <select data-s="questionnaire"><option value="">None</option>${opt(data.questionnaires.map((q) => [q.key, q.name]), x.questionnaire)}</select></label>` : ''}
        </div>
      </div></li>`;
  };
  const readSteps = (): WfStep[] => [...wf.querySelectorAll<HTMLElement>('.wf-step')].map((li) => {
    const g = (k: string) => li.querySelector<HTMLInputElement>(`[data-s="${k}"]`);
    const x: WfStep = { id: li.dataset.id!, title: g('title')!.value, kind: g('kind')!.value, when: g('when')!.value };
    if (g('template')) x.template = g('template')!.value;
    if (g('days')) x.days = Number(g('days')!.value) || 0;
    if (g('hours')) x.hours = Number(g('hours')!.value) || 0;
    if (g('after_step')) x.after_step = g('after_step')!.value;
    x.stop_on = [g('stop_reply')?.checked && 'reply', g('stop_booked')?.checked && 'booked', g('stop_reviewed')?.checked && 'reviewed'].filter(Boolean).join(',');
    if (g('gallery')?.checked) x.gallery = true;
    if (g('questionnaire')?.value) x.questionnaire = g('questionnaire')!.value;
    return x;
  });
  const wfDraw = (steps: WfStep[]) => { $('.wf-steps').innerHTML = steps.map((x) => stepRow(x, steps)).join(''); };
  function openWf(x: Wf | null) {

  function renderDocs() {
    $('.docs-table tbody').innerHTML = data.documents.length ? data.documents.map((d) => `<tr data-doc-id="${d.id}">
      <td><a href="/api/studio/crm/documents?id=${d.id}" target="_blank" rel="noopener">${esc(d.name)}</a></td>

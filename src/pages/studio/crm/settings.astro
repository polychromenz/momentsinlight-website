  });
  wf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ workflow: { key: currentWf?.key, name: (wf.elements.namedItem('wf_name') as HTMLInputElement).value, steps: readSteps() } }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Workflow saved. New steps are planned this way from now on.');

    qnRich.set(x?.intro || '<p></p>');
    qnDraw(x?.questions ?? []);
    document.querySelectorAll<HTMLElement>('.qn-list li').forEach((li) => li.classList.toggle('on', li.dataset.key === x?.key));
  }
  function renderQns() {
    $('.qn-list').innerHTML = data.questionnaires.map((x) => `<li data-key="${esc(x.key)}"><button type="button">${esc(x.name)}<small>${x.questions.filter((q) => !['heading', 'text'].includes(q.type)).length} questions · Used by: ${esc(data.job_type.filter((t) => t.questionnaire_key === x.key).map((t) => t.value).join(', ') || 'no job type')}</small></button></li>`).join('');
  }
  Sortable.create($('.qn-qs'), { handle: '.drag', animation: 150, onEnd: qnPreview });
  qn.addEventListener('input', qnPreview);
  qn.addEventListener('change', (e) => {
    // A new type changes which settings a question has: redraw it, keeping what's typed.
    if ((e.target as HTMLElement).dataset.q === 'type') qnDraw(readQs()); else qnPreview();
  });
  qn.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ questionnaire: { key: currentQn?.key, name: (qn.elements.namedItem('qn_name') as HTMLInputElement).value, intro: qnRich.get(), questions: readQs() } }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Questionnaire saved. New questionnaires use it; ones already made keep theirs.');
    await load(current?.key, undefined, undefined, d.key);
  });
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLElement>('.qn-list li');
    if (li) { openQn(data.questionnaires.find((x) => x.key === li.dataset.key) ?? null); return; }
    if (t.closest('[data-act="new-qn"]')) { openQn(null); (qn.elements.namedItem('qn_name') as HTMLInputElement).focus(); return; }
    if (t.closest('[data-act="qn-add"]')) {
      const type = $<HTMLSelectElement>('.qn-type').value;
      const qs = readQs();
      qs.push({ id: `q${Math.random().toString(36).slice(2, 8)}`, type, label: '', ...(CHOICES.includes(type) ? { options: ['Yes', 'No'] } : {}) });

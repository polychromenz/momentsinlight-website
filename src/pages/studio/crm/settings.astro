  const partRow = (p: Part) => `<tr>
    <td><input data-p="label" value="${esc(p.label)}" /></td>
    <td class="pct"><input data-p="percent" type="number" min="1" max="100" step="0.5" value="${p.percent}" /></td>
    <td class="due"><select data-p="when"><option value="accept"${p.when === 'accept' ? ' selected' : ''}>On acceptance, plus</option><option value="before"${p.when === 'before' ? ' selected' : ''}>Before the wedding</option><option value="after"${p.when === 'after' ? ' selected' : ''}>After the wedding</option></select>
      <input data-p="amount" type="number" min="0" step="1" value="${p.months ?? p.days ?? 0}" />
      <select data-p="unit"><option value="days"${p.months ? '' : ' selected'}>days</option><option value="months"${p.months ? ' selected' : ''}>months</option></select></td>
    <td class="row-btns"><button type="button" data-part-remove aria-label="Remove">✕</button></td>
  </tr>`;
  const readParts = () => [...sch.querySelectorAll<HTMLTableRowElement>('.sch-parts tbody tr')].map((tr) => {
    const v = (k: string) => (tr.querySelector(`[data-p="${k}"]`) as HTMLInputElement).value;
    return { label: v('label'), percent: Number(v('percent')), when: v('when'), amount: Number(v('amount')), unit: v('unit') };
  });
  function schExample() {
    const parts = readParts();
    const total = parts.reduce((a, p) => a + (p.percent || 0), 0);
    const t = $('.sch-total'); t.textContent = `Total: ${Math.round(total * 100) / 100}%${total === 100 ? ' ✓' : ' (needs to be 100%)'}`; t.classList.toggle('bad', total !== 100);
    // An example: a $3,995 wedding six months from today, accepted today.
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Pacific/Auckland' });
    const d = new Date(`${today}T12:00:00Z`); d.setUTCMonth(d.getUTCMonth() + 6);
    const wedding = d.toISOString().slice(0, 10);
    const asParts = parts.map((p) => ({ percent: p.percent, label: p.label, when: p.when, ...(p.amount ? { [p.unit === 'months' && p.when !== 'accept' ? 'months' : 'days']: p.amount } : {}) }));
    const rows = total === 100 ? payments(asParts, 399500, wedding, today) : [];
    $('.sch-example').innerHTML = rows.length ? `<p class="ex-head">Example: a $3,995 wedding on ${longDate(wedding)}, accepted today</p><ul>${rows.map((r: { label: string; amount: number; onAccept: boolean; due: string }) => `<li>${esc(r.label)}: ${money(r.amount)} ${r.onAccept ? 'on acceptance' : `by ${longDate(r.due)}`}</li>`).join('')}</ul>` : '';
  }
  function openSchedule(x: Schedule | null) {
    currentSch = x;
    (sch.elements.namedItem('sch_name') as HTMLInputElement).value = x?.name ?? '';
    $('.sch-parts tbody').innerHTML = (x?.parts ?? [{ percent: 100, label: 'Payment', when: 'accept', days: 7 }]).map(partRow).join('');
    document.querySelectorAll<HTMLElement>('.sch-list li').forEach((li) => li.classList.toggle('on', li.dataset.key === x?.key));

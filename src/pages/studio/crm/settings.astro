      (qn.querySelector('.qn-q:last-child [data-q="label"]') as HTMLInputElement)?.focus();
      return;
    }
    if (t.closest('[data-qn-remove]')) { t.closest('.qn-q')!.remove(); qnPreview(); return; }
    if (t.closest('[data-act="qn-delete"]')) {
      if (!currentQn) { openQn(data.questionnaires[0] ?? null); return; }
      if (!await ask(`Delete “${currentQn.name}”? Questionnaires already made from it keep their questions and answers.`)) return;
      const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ delete_questionnaire: currentQn.key }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t delete it.', true); return; }
      currentQn = null;
      toast('Deleted.');
      await load(current?.key);
    }

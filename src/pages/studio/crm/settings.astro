      openWf(null);
      if (base && await ask(`Start from a copy of “${base.name}”?`, { ok: 'Copy it', cancel: 'Start empty' })) wfDraw(base.steps.map((x) => ({ ...x })));
      (wf.elements.namedItem('wf_name') as HTMLInputElement).focus();
      return;
    }
    if (t.closest('[data-act="wf-add"]')) {
      const steps = readSteps();
      steps.push({ id: `s${Math.random().toString(36).slice(2, 7)}`, title: '', kind: 'ready_email', when: 'enquiry', days: 1 });

---
// Moments Studio CRM settings: email templates (edit with a live preview, add new), job types
// and lead sources (add, rename, reorder, remove, choose which show on the enquiry form), and the
// documents library that templates attach (upload, download, rename, replace, delete), payment
// schedules, contracts, questionnaires, payments and the workflows view.
// Data from functions/api/studio/crm/settings.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
import { FORM_CSS } from '../../../../functions-lib/questionnaire-form.js';
---
<StudioLayout title="Settings" section="settings">
  <span slot="bar" class="save-state" aria-live="polite"></span>

  <main class="settings">
    <h1>Settings</h1>
    <nav class="tabs" role="tablist" aria-label="Settings">
      <p class="tab-group">Emails</p>
      <button type="button" role="tab" data-tab="templates">Email templates</button>
      <button type="button" role="tab" data-tab="links">Your links</button>
      <p class="tab-group">How you work</p>
      <button type="button" role="tab" data-tab="workflows">Workflows</button>
      <button type="button" role="tab" data-tab="job_type">Job types</button>
      <button type="button" role="tab" data-tab="lead_source">Lead sources</button>
      <button type="button" role="tab" data-tab="questionnaires">Questionnaires</button>
      <p class="tab-group">Money</p>
      <button type="button" role="tab" data-tab="catalogue">Packages &amp; products</button>
      <button type="button" role="tab" data-tab="schedules">Payment schedules</button>
      <button type="button" role="tab" data-tab="payments">Payments</button>
      <button type="button" role="tab" data-tab="contracts">Contracts</button>
      <p class="tab-group">Clients</p>
      <button type="button" role="tab" data-tab="booking">Online booking</button>
      <button type="button" role="tab" data-tab="portal">Client portal</button>
      <button type="button" role="tab" data-tab="documents">Documents</button>
      <p class="tab-group">Import</p>
      <button type="button" role="tab" data-tab="sn">Studio Ninja</button>
      <p class="tab-group">Access</p>
      <button type="button" role="tab" data-tab="people">People</button>
    </nav>
    <select class="tabs-select" aria-label="Settings section">
      <option value="home">Choose a section…</option>
      <optgroup label="Emails"><option value="templates">Email templates</option><option value="links">Your links</option></optgroup>
      <optgroup label="How you work"><option value="workflows">Workflows</option><option value="job_type">Job types</option><option value="lead_source">Lead sources</option><option value="questionnaires">Questionnaires</option></optgroup>
      <optgroup label="Money"><option value="catalogue">Packages &amp; products</option><option value="schedules">Payment schedules</option><option value="payments">Payments</option><option value="contracts">Contracts</option></optgroup>
      <optgroup label="Clients"><option value="booking">Online booking</option><option value="portal">Client portal</option><option value="documents">Documents</option></optgroup>
      <optgroup label="Import"><option value="sn">Studio Ninja</option></optgroup>
      <optgroup label="Access"><option value="people">People</option></optgroup>
    </select>
    <p class="status" aria-live="polite">Loading…</p>

    <section class="pane card settings-home" data-pane="home" hidden>
      <h2>Settings</h2>
      <p>Choose a section on the left (or from the list above on a phone). Nothing opens for editing until you do.</p>
    </section>

    <section class="pane" data-pane="templates" hidden>
      <div class="card send-mode">
        <p class="sm-state">Loading…</p>
        <label class="sm-new"><input type="checkbox" data-new-live /> <strong>Reply to new enquiries for real</strong>: people who first enquire from now on get the studio’s emails themselves. Anyone already in your records or the Studio Ninja import still comes to you.</label>
      </div>
      <div class="tpl-layout">
        <div class="card tpl-list-card">
          <ul class="tpl-list email-list"></ul>
          <button type="button" class="s-btn s-btn--quiet" data-act="new-template">+ New template</button>
        </div>
        <form class="card tpl-editor" autocomplete="off">
          <label>Name<input name="name" required /></label>
          <label>Subject<input name="subject" required /></label>
          <div class="tpl-cols">
            <label>Email
              <textarea name="body" rows="20" required></textarea>
              <small class="fields-help" hidden>{"Fill-ins: {{first_name}} {{last_name}} {{partner_name}} {{couple}} {{event_date}} {{venue}} {{quote_link}} {{quote_valid_until}} {{portal_link}} {{gallery_link}} {{contract_link}} {{payment_amount}} {{payment_due_date}}"}</small>
            </label>
            <div class="preview"><span>Preview (sample couple)</span><iframe title="Email preview"></iframe></div>
          </div>
          <div class="attach"></div>
          <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save template</button></div>
        </form>
      </div>
    </section>

    <section class="pane card" data-pane="job_type" hidden>
      <p class="hint">The services people can choose on the enquiry form, and which workflow each one follows.</p>
      <table class="list-table"><thead><tr><th></th><th>Job type</th><th>Workflow</th><th>Default contract</th><th>Questionnaire</th><th>On the form</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add">+ Add</button><button type="button" class="s-btn s-btn--solid" data-act="save-list">Save</button></div>
    </section>

    <section class="pane card" data-pane="lead_source" hidden>
      <p class="hint">“How did you hear about me?” on the enquiry form. The name is what's recorded (and matches Studio Ninja's); the wording is what visitors see.</p>
      <table class="list-table"><thead><tr><th></th><th>Name</th><th>Wording on the form</th><th>On the form</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add">+ Add</button><button type="button" class="s-btn s-btn--solid" data-act="save-list">Save</button></div>
    </section>
    <section class="pane" data-pane="catalogue" hidden>
      <p class="hint">Your packages and add-on products, to build quotes from. On a quote, swap a package for one of these or add products (second shooter, prints…). A quote keeps its own copy, so changing these never alters a quote you’ve sent. Prices include GST.</p>
      <div class="tpl-layout">
        <div class="card">
          <h3 class="cat-h">Packages</h3><ul class="tpl-list cat-list" data-kind="package"></ul><button type="button" class="s-btn s-btn--quiet" data-cat-new="package">+ New package</button>
          <h3 class="cat-h">Products <small>(add-ons)</small></h3><ul class="tpl-list cat-list" data-kind="product"></ul><button type="button" class="s-btn s-btn--quiet" data-cat-new="product">+ New product</button>
        </div>
        <form class="card cat-editor" autocomplete="off" hidden>
          <h3 class="cat-kind"></h3>
          <div class="row"><label>Name<input name="cat_name" required /></label><label class="cat-pkg">Subtitle<input name="cat_subtitle" placeholder="e.g. 8+ hours" /></label><label>Price ($, incl. GST)<input name="cat_price" type="number" min="0" step="0.01" /></label></div>
          <label>Description <small class="cat-desc-hint"></small><textarea name="cat_description" rows="8"></textarea></label>
          <label class="check cat-pkg"><input type="checkbox" name="cat_recommended" /> Recommended (shown with a ♥ on the quote)</label>
          <div class="actions"><button type="button" class="s-btn s-btn--danger" data-cat-delete>Delete</button><button type="submit" class="s-btn s-btn--solid">Save</button></div>
        </form>
      </div>
    </section>

    <section class="pane" data-pane="schedules" hidden>
      <div class="tpl-layout">
        <div class="card"><ul class="tpl-list sch-list"></ul><button type="button" class="s-btn s-btn--quiet" data-act="new-schedule">+ New schedule</button></div>
        <form class="card sch-editor" autocomplete="off">
          <label>Name<input name="sch_name" required /></label>
          <table class="list-table sch-parts"><thead><tr><th>Payment</th><th>%</th><th>Due</th><th></th></tr></thead><tbody></tbody></table>
          <p class="sch-total"></p>
          <div class="sch-example"></div>
          <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add-part">+ Add payment</button><button type="button" class="s-btn s-btn--danger" data-act="delete-schedule">Delete</button><button type="submit" class="s-btn s-btn--solid">Save schedule</button></div>
          <p class="hint">Sent quotes keep the schedule they were sent with; changes apply to new quotes.</p>
        </form>
      </div>
    </section>

    <section class="pane card" data-pane="sn" hidden>
      <p class="hint">Bringing your history across from Studio Ninja. Step 1 searches your Gmail for the emails Studio Ninja sent you (new enquiries, bookings…) and counts them by kind and year, so we can see what can be read from them. It only reads; nothing in Gmail changes. It takes up to a minute.</p>
      <div class="actions" style="justify-content:flex-start"><button type="button" class="s-btn s-btn--solid" data-sn-survey>Search my Gmail for Studio Ninja emails</button></div>
      <div class="sn-result"></div>
      <h3 class="sn-h">Step 4: switch over from Studio Ninja</h3>
      <div class="sn-switch"><p class="hint">Loading…</p></div>
    </section>

    <section class="pane" data-pane="links" hidden>
      <form class="card links-form pay-form" autocomplete="off">
        <p class="hint">Links you use in lots of emails. Put them in a template with the merge field shown, and every email fills it in, so if a link changes you only change it here.</p>
        <label>Book a chat with me <small>(your Google booking page)</small><input name="booking_link" type="url" placeholder="https://calendar.app.google/…" /></label>
        <p class="hint">In a template: <code>{'{{booking_link}}'}</code>, or as a button: select some text, click Link and type <code>{'{{booking_link}}'}</code>. <a class="links-test" href="#" target="_blank" rel="noopener" hidden>Open it to check ↗</a></p>
        <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save</button></div>
      </form>
    </section>

    <section class="pane" data-pane="portal" hidden>
      <form class="card portal-form pay-form" autocomplete="off">
        <p class="hint">What every couple's portal says. {'{{first_name}}'} becomes their first name.</p>
        <label>Welcome<textarea name="welcome" rows="5"></textarea></label>
        <label>Gallery introduction <small>(shown above their gallery links)</small><textarea name="gallery_intro" rows="7"></textarea></label>
        <label>Banner photo <small>(a link to one of your photos; it's shown whole, never cropped)</small><input name="banner" /></label>
        <img class="portal-banner-preview" alt="Banner preview" />
        <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save</button></div>
      </form>
    </section>

    <section class="pane" data-pane="payments" hidden>
      <form class="card pay-form payments-form" autocomplete="off">
        <p class="hint">How clients pay their invoices. These details show on every invoice (the page and the PDF).</p>
        <p class="pay-stripe"></p>
        <div class="two"><label>Account name<input name="account_name" /></label><label>Bank<input name="bank_name" placeholder="e.g. ANZ" /></label></div>
        <div class="two"><label>Account number<input name="account_number" placeholder="12-3456-0123456-00" /></label><label>GST number <small>(leave empty if you’re not GST registered; with one, invoices become tax invoices)</small><input name="gst_number" placeholder="123-456-789" /></label></div>
        <label>Anything else for bank transfers <small>(optional)</small><textarea name="instructions" rows="2" placeholder="e.g. Please use your invoice number as the reference."></textarea></label>
        <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save</button></div>
      </form>
    </section>

    <section class="pane" data-pane="questionnaires" hidden>
      <div class="tpl-layout">
        <div class="card"><ul class="tpl-list qn-list"></ul><button type="button" class="s-btn s-btn--quiet" data-act="new-qn">+ New questionnaire</button></div>
        <form class="card qn-editor" autocomplete="off">
          <label>Name<input name="qn_name" required /></label>
          <label>Introduction <small>(shown above the questions)</small><textarea name="qn_intro" rows="5"></textarea></label>
          <div class="qn-cols">
            <div>
              <p class="qn-head">Questions <small>drag ⠿ to reorder</small></p>
              <ol class="qn-qs"></ol>
              <div class="qn-add"><select class="qn-type" aria-label="Type of question"></select><button type="button" class="s-btn s-btn--quiet" data-act="qn-add">+ Add question</button></div>
            </div>
            <div class="qn-preview"><p class="qn-head">What they see</p><div class="qn-preview-box"><div class="qn-preview-intro"></div><div class="qf"></div></div></div>
          </div>
          <div class="actions"><button type="button" class="s-btn s-btn--danger" data-act="qn-delete">Delete</button><button type="submit" class="s-btn s-btn--solid">Save questionnaire</button></div>
          <p class="hint">Couples' questionnaires keep the questions they were given, so changes apply to new ones. Choose each job type's default questionnaire under Job types.</p>
        </form>
      </div>
    </section>

    <section class="pane" data-pane="contracts" hidden>
      <div class="tpl-layout">
        <div class="card"><ul class="tpl-list con-list"></ul><button type="button" class="s-btn s-btn--quiet" data-act="new-contract">+ New contract</button></div>
        <form class="card con-editor" autocomplete="off">
          <label>Name<input name="con_name" required /></label>
          <label>Note under the title (optional)<input name="con_note" placeholder="e.g. Based on the NZIPP Standard Photographic Terms &amp; Conditions of Engagement" /></label>
          <label>Wording<textarea name="con_body" rows="20"></textarea></label>
          <p class="hint">The couple's names, address, wedding date, venue, package, total and payment schedule are shown above the wording automatically ("the Event specified above"). Contracts already sent keep the wording they were sent with. Choose each job type's default contract under Job types; each quote can choose another.</p>
          <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save contract</button></div>
        </form>
      </div>
    </section>

    <section class="pane" data-pane="workflows" hidden>
      <div class="tpl-layout">
        <div class="card"><ul class="tpl-list wf-list"></ul><button type="button" class="s-btn s-btn--quiet" data-act="new-wf">+ New workflow</button></div>
        <form class="card wf-editor" autocomplete="off">
          <label>Name<input name="wf_name" required /></label>
          <p class="hint">Built in for every booking: the quote, then the contract when they accept, then the invoices when they sign (Payment schedules), with reminders and receipts. The steps below are the emails and to-dos around those. Choose which job types use this workflow under Job types.</p>
          <p class="qn-head">Steps <small>drag ⠿ to reorder</small></p>
          <ol class="wf-steps"></ol>
          <div class="qn-add"><button type="button" class="s-btn s-btn--quiet" data-act="wf-add">+ Add step</button></div>
          <div class="actions"><button type="button" class="s-btn s-btn--danger" data-act="wf-delete">Delete</button><button type="submit" class="s-btn s-btn--solid">Save workflow</button></div>
          <p class="hint">Changes apply to steps planned from now on; jobs already under way keep the steps they have. An email with a “[check: …]” note in it can’t be sent until it’s filled in.</p>
        </form>
      </div>
    </section>

    <section class="pane card booking-pane" data-pane="booking" hidden>
      <h2>Online booking</h2>
      <p class="muted">People pick a free time at <a href="https://www.momentsinlight.co.nz/book" target="_blank" rel="noopener">momentsinlight.co.nz/book</a>. Free times leave out your Google Calendar’s busy times (after you reconnect Google on the Clients page once, to allow “see when you’re free or busy”), the studio’s appointments and wedding days. To use it in your emails, set it as your booking link in Settings › Your links.</p>
      <form class="booking-form" autocomplete="off">
        <label class="tick"><input type="checkbox" name="on" /> <strong>Booking page is open</strong></label>
        <h3>Your hours</h3>
        <div class="bk-hours"></div>
        <div class="bk-nums">
          <label>Notice needed (hours)<input name="notice_hours" inputmode="numeric" /></label>
          <label>Bookable this many days ahead<input name="ahead_days" inputmode="numeric" /></label>
          <label>Gap between bookings (minutes)<input name="gap_min" inputmode="numeric" /></label>
        </div>
        <h3>Kinds of booking</h3>
        <div class="bk-types"></div>
        <p><button type="button" class="s-btn s-btn--quiet" data-bk-add>+ Another kind</button></p>
        <p class="bk-stripe muted" hidden></p>
        <button type="submit" class="s-btn s-btn--solid">Save</button>
      </form>
      <h3>Recent bookings</h3>
      <ul class="bk-recent"></ul>
    </section>

    <section class="pane card people-pane" data-pane="people" hidden>
      <h2>People</h2>
      <p class="muted">Who else can use the studio, and what they can do in each part of it. First add their email to the studio’s sign-in list in <a href="https://one.dash.cloudflare.com/ba83c09be6ee9fa1e0ae58f61811a3db/access/apps" target="_blank" rel="noopener">Cloudflare Zero Trust › Access › Applications</a> (they sign in with a code sent to that email). Then add them here. Anyone signed in who isn’t listed here can do everything, as you can.</p>
      <ul class="people-list"></ul>
      <form class="people-add" autocomplete="off">
        <input name="name" placeholder="Name, e.g. Mel" aria-label="Name" />
        <input name="email" type="email" placeholder="Their email" aria-label="Email" required />
        <button type="submit" class="s-btn s-btn--solid">Add</button>
      </form>
      <p class="muted">For each area: <strong>Hidden</strong> (not in their menu, and its pages and data are refused), <strong>Look only</strong> (they can open it but not save, send or change anything) or <strong>Can change</strong>. New people start as Look only everywhere. Only you can change this list.</p>
    </section>

    <section class="pane card" data-pane="documents" hidden>
      <p class="hint">Files your emails can attach: the wedding guide, price lists, posing guides… Up to 10 MB each. Stored privately (never public on the website). Choose which ones a template attaches under its Attachments.</p>
      <table class="list-table docs-table"><thead><tr><th>Document</th><th>Size</th><th>Updated</th><th>Attached by</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><label class="s-btn s-btn--solid upload">+ Upload documents<input type="file" multiple hidden data-upload /></label></div>
      <input type="file" hidden data-replace />
    </section>
  </main>
  <div class="s-toast" role="status"></div>
</StudioLayout>
<style is:inline set:html={FORM_CSS}></style>

<script>
  import { ask, askText, tell } from '../../../studio/dialogs';
  import { renderTemplate } from '../../../../functions-lib/email-render.js';
  import { attachRich } from '../../../studio/rich-editor';
  import Sortable from 'sortablejs';
  import { attachPicker, type Doc } from '../../../studio/attach-picker';
  import { payments, money, longDate } from '../../../../functions-lib/quotes.js';
  import { WHEN, KINDS } from '../../../../functions-lib/workflows.js';
  import { TYPES, FILLS, formHtml } from '../../../../functions-lib/questionnaire-form.js';
  type Item = { value: string; label: string; workflow: string | null; on_form: boolean; contract_key?: string | null; questionnaire_key?: string | null };
  type Question = { id: string; type: string; label: string; placeholder?: string; options?: string[]; required?: boolean; half?: boolean; fill?: string };
  type WfStep = { id: string; title: string; kind: string; template?: string; when: string; days?: number; hours?: number; after_step?: string; stop_on?: string; questionnaire?: string; gallery?: boolean };
  type Wf = { key: string; name: string; steps: WfStep[] };
  type Qn = { key: string; name: string; intro: string; questions: Question[] };
  type ContractT = { key: string; name: string; note: string; body: string };
  type Template = { key: string; name: string; subject: string; body: string; attachments: number[] };
  type LibraryDoc = Doc & { type: string; updated_at: string; used_by: string[] };
  const $ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const toast = (text: string, error = false) => {
    const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  };
  const sample = { first_name: 'Emma', last_name: 'Smith', partner_name: 'Liam', couple: 'Emma & Liam', event_date: 'Saturday, 20 February 2027', venue: 'Tui Hills', quote_link: 'https://www.momentsinlight.co.nz/quote', quote_valid_until: '16 November 2026', portal_link: 'https://www.momentsinlight.co.nz/', gallery_link: 'https://www.momentsinlight.co.nz/', contract_link: 'https://www.momentsinlight.co.nz/', payment_amount: '$299.50', payment_due_date: '24 October 2026', invoice_number: 'MIL-2026-0001', invoice_label: 'Deposit (10%)', invoice_link: 'https://www.momentsinlight.co.nz/invoice', booking_link: 'https://calendar.app.google/', questionnaire_link: 'https://www.momentsinlight.co.nz/questionnaire', shoot_date: 'Saturday, 20 February', shoot_time: '2:00 pm', location: 'Tui Hills' };

  type Part = { percent: number; label: string; when: string; days?: number; months?: number };
  type Schedule = { key: string; name: string; parts: Part[] };
  let data: { job_type: Item[]; lead_source: Item[]; templates: Template[]; workflows: Wf[]; documents: LibraryDoc[]; schedules: Schedule[]; contracts: ContractT[]; payments: Record<string, string>; stripe: { ok: boolean; test?: boolean; why?: string }; questionnaires: Qn[]; portal: Record<string, string>; links: Record<string, string> };
  let current: Template | null = null;
  let tab = 'home'; // a start page, so nothing editable is open by accident
  const editor = $<HTMLFormElement>('.tpl-editor');
  const field = (n: string) => editor.elements.namedItem(n) as HTMLInputElement;

  function showTab(t: string) {
    tab = t;
    ($('.tabs-select') as HTMLSelectElement).value = t;
    if (location.hash !== `#${t}`) history.replaceState(null, '', `#${t}`);
    document.querySelectorAll<HTMLElement>('.tabs button').forEach((b) => b.classList.toggle('on', b.dataset.tab === t));
    document.querySelectorAll<HTMLElement>('.pane').forEach((p) => (p.hidden = p.dataset.pane !== t));
  }

  // ---- Templates ----
  const samplePlan = '<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;"><tr><td style="padding:6px 0;border-bottom:1px solid #eee;">Deposit (10%)</td><td style="padding:6px 0;border-bottom:1px solid #eee;text-align:right;">$399.50 on acceptance</td></tr><tr><td style="padding:6px 0;">…</td><td></td></tr></table>';
  let rich: ReturnType<typeof attachRich>;
  function preview() {
    $<HTMLIFrameElement>('.preview iframe').srcdoc = renderTemplate({ subject: field('subject').value, body: field('body').value }, { ...sample, payment_plan: samplePlan }).html;
  }
  function openTemplate(t: Template | null) {
    current = t;
    field('name').value = t?.name ?? '';
    field('subject').value = t?.subject ?? '';
    rich.set(t?.body ?? '<p>Hi {{first_name}},</p><p></p><p>Cheers,</p>');
    picker.set(data.documents, t?.attachments ?? []);
    document.querySelectorAll<HTMLElement>('.tpl-list li').forEach((li) => li.classList.toggle('on', li.dataset.key === t?.key));
    preview();
  }
  function renderTemplates() {
    $('.email-list').innerHTML = data.templates.map((t) => `<li data-key="${esc(t.key)}"><button type="button">${esc(t.name)}<small>${esc(t.subject)}</small></button></li>`).join('');
  }
  rich = attachRich(field('body') as unknown as HTMLTextAreaElement, { minHeight: 420 });
  const picker = attachPicker($('.attach'));
  editor.addEventListener('input', preview);
  editor.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ template: { key: current?.key, name: field('name').value, subject: field('subject').value, body: field('body').value, attachments: picker.get() } }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Template saved.');
    await load(d.key);
  });

  // ---- Lists ----
  function renderList(kind: 'job_type' | 'lead_source') {
    const tbody = $(`[data-pane="${kind}"] tbody`);

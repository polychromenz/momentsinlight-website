---
// Moments Studio CRM settings: email templates (edit with a live preview, add new), job types
// and lead sources (add, rename, reorder, remove, choose which show on the enquiry form), and the
// documents library that templates attach (upload, download, rename, replace, delete).
// Data from functions/api/studio/crm/settings.js.
import StudioLayout from '../../../layouts/StudioLayout.astro';
---
<StudioLayout title="Settings">
  <a slot="bar" class="s-btn s-btn--quiet" href="/studio/crm">← Clients</a>
  <span slot="bar" class="save-state" aria-live="polite"></span>

  <main class="settings">
    <h1>Settings</h1>
    <div class="tabs" role="tablist">
      <button type="button" role="tab" data-tab="templates" class="on">Email templates</button>
      <button type="button" role="tab" data-tab="job_type">Job types</button>
      <button type="button" role="tab" data-tab="lead_source">Lead sources</button>
      <button type="button" role="tab" data-tab="documents">Documents</button>
      <button type="button" role="tab" data-tab="schedules">Payment schedules</button>
    </div>
    <p class="status" aria-live="polite">Loading…</p>

    <section class="pane" data-pane="templates" hidden>
      <div class="tpl-layout">
        <div class="card tpl-list-card">
          <ul class="tpl-list"></ul>
          <button type="button" class="s-btn s-btn--quiet" data-act="new-template">+ New template</button>
        </div>
        <form class="card tpl-editor" autocomplete="off">
          <label>Name<input name="name" required /></label>
          <label>Subject<input name="subject" required /></label>
          <div class="tpl-cols">
            <label>Email
              <textarea name="body" rows="20" required></textarea>
              <small class="fields-help" hidden>{"Fill-ins: {{first_name}} {{last_name}} {{partner_name}} {{couple}} {{event_date}} {{venue}} {{quote_link}} {{quote_valid_until}} {{portal_link}} {{gallery_link}} {{contract_link}} {{payment_amount}} {{payment_due_date}}"}</small>
            </label>
            <div class="preview"><span>Preview (sample couple)</span><iframe title="Email preview"></iframe></div>
          </div>
          <div class="attach"></div>
          <div class="actions"><button type="submit" class="s-btn s-btn--solid">Save template</button></div>
        </form>
      </div>
    </section>

    <section class="pane card" data-pane="job_type" hidden>
      <p class="hint">The services people can choose on the enquiry form, and which workflow each one follows.</p>
      <table class="list-table"><thead><tr><th></th><th>Job type</th><th>Workflow</th><th>On the form</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add">+ Add</button><button type="button" class="s-btn s-btn--solid" data-act="save-list">Save</button></div>
    </section>

    <section class="pane card" data-pane="lead_source" hidden>
      <p class="hint">“How did you hear about me?” on the enquiry form. The name is what's recorded (and matches Studio Ninja's); the wording is what visitors see.</p>
      <table class="list-table"><thead><tr><th></th><th>Name</th><th>Wording on the form</th><th>On the form</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add">+ Add</button><button type="button" class="s-btn s-btn--solid" data-act="save-list">Save</button></div>
    </section>
    <section class="pane" data-pane="schedules" hidden>
      <div class="tpl-layout">
        <div class="card"><ul class="tpl-list sch-list"></ul><button type="button" class="s-btn s-btn--quiet" data-act="new-schedule">+ New schedule</button></div>
        <form class="card sch-editor" autocomplete="off">
          <label>Name<input name="sch_name" required /></label>
          <table class="list-table sch-parts"><thead><tr><th>Payment</th><th>%</th><th>Due</th><th></th></tr></thead><tbody></tbody></table>
          <p class="sch-total"></p>
          <div class="sch-example"></div>
          <div class="actions"><button type="button" class="s-btn s-btn--quiet" data-act="add-part">+ Add payment</button><button type="button" class="s-btn s-btn--danger" data-act="delete-schedule">Delete</button><button type="submit" class="s-btn s-btn--solid">Save schedule</button></div>
          <p class="hint">Sent quotes keep the schedule they were sent with; changes apply to new quotes.</p>
        </form>
      </div>
    </section>

    <section class="pane card" data-pane="documents" hidden>
      <p class="hint">Files your emails can attach: the wedding guide, price lists, posing guides… Up to 10 MB each. Stored privately (never public on the website). Choose which ones a template attaches under its Attachments.</p>
      <table class="list-table docs-table"><thead><tr><th>Document</th><th>Size</th><th>Updated</th><th>Attached by</th><th></th></tr></thead><tbody></tbody></table>
      <div class="actions"><label class="s-btn s-btn--solid upload">+ Upload documents<input type="file" multiple hidden data-upload /></label></div>
      <input type="file" hidden data-replace />
    </section>
  </main>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  import { renderTemplate } from '../../../../functions-lib/email-render.js';
  import { attachRich } from '../../../studio/rich-editor';
  import Sortable from 'sortablejs';
  import { attachPicker, type Doc } from '../../../studio/attach-picker';
  import { payments, money, longDate } from '../../../../functions-lib/quotes.js';
  type Item = { value: string; label: string; workflow: string | null; on_form: boolean };
  type Template = { key: string; name: string; subject: string; body: string; attachments: number[] };
  type LibraryDoc = Doc & { type: string; updated_at: string; used_by: string[] };
  const $ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const toast = (text: string, error = false) => {
    const t = $('.s-toast'); t.textContent = text; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  };
  const sample = { first_name: 'Emma', last_name: 'Smith', partner_name: 'Liam', couple: 'Emma & Liam', event_date: 'Saturday, 20 February 2027', venue: 'Tui Hills', quote_link: 'https://www.momentsinlight.co.nz/quote', quote_valid_until: '16 November 2026', portal_link: 'https://www.momentsinlight.co.nz/', gallery_link: 'https://www.momentsinlight.co.nz/', contract_link: 'https://www.momentsinlight.co.nz/', payment_amount: '$299.50', payment_due_date: '24 October 2026' };

  type Part = { percent: number; label: string; when: string; days?: number; months?: number };
  type Schedule = { key: string; name: string; parts: Part[] };
  let data: { job_type: Item[]; lead_source: Item[]; templates: Template[]; workflows: string[]; documents: LibraryDoc[]; schedules: Schedule[] };
  let current: Template | null = null;
  let tab = 'templates';
  const editor = $<HTMLFormElement>('.tpl-editor');
  const field = (n: string) => editor.elements.namedItem(n) as HTMLInputElement;

  function showTab(t: string) {
    tab = t;
    document.querySelectorAll<HTMLElement>('.tabs button').forEach((b) => b.classList.toggle('on', b.dataset.tab === t));
    document.querySelectorAll<HTMLElement>('.pane').forEach((p) => (p.hidden = p.dataset.pane !== t));
  }

  // ---- Templates ----
  const samplePlan = '<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;"><tr><td style="padding:6px 0;border-bottom:1px solid #eee;">Deposit (10%)</td><td style="padding:6px 0;border-bottom:1px solid #eee;text-align:right;">$399.50 on acceptance</td></tr><tr><td style="padding:6px 0;">…</td><td></td></tr></table>';
  let rich: ReturnType<typeof attachRich>;
  function preview() {
    $<HTMLIFrameElement>('.preview iframe').srcdoc = renderTemplate({ subject: field('subject').value, body: field('body').value }, { ...sample, payment_plan: samplePlan }).html;
  }
  function openTemplate(t: Template | null) {
    current = t;
    field('name').value = t?.name ?? '';
    field('subject').value = t?.subject ?? '';
    rich.set(t?.body ?? '<p>Hi {{first_name}},</p><p></p><p>Cheers,</p>');
    picker.set(data.documents, t?.attachments ?? []);
    document.querySelectorAll<HTMLElement>('.tpl-list li').forEach((li) => li.classList.toggle('on', li.dataset.key === t?.key));
    preview();
  }
  function renderTemplates() {
    $('.tpl-list').innerHTML = data.templates.map((t) => `<li data-key="${esc(t.key)}"><button type="button">${esc(t.name)}<small>${esc(t.subject)}</small></button></li>`).join('');
  }
  rich = attachRich(field('body') as unknown as HTMLTextAreaElement, { minHeight: 420 });
  const picker = attachPicker($('.attach'));
  editor.addEventListener('input', preview);
  editor.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ template: { key: current?.key, name: field('name').value, subject: field('subject').value, body: field('body').value, attachments: picker.get() } }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Template saved.');
    await load(d.key);
  });

  // ---- Lists ----
  function renderList(kind: 'job_type' | 'lead_source') {
    const tbody = $(`[data-pane="${kind}"] tbody`);
    tbody.innerHTML = data[kind].map((it, i) => `<tr data-i="${i}">
      <td class="drag" title="Drag to reorder" aria-hidden="true">⠿</td>
      <td><input data-k="value" value="${esc(it.value)}" /></td>
      ${kind === 'job_type'
        ? `<td><select data-k="workflow"><option value="">None (a “reply” to-do)</option>${data.workflows.map((w) => `<option value="${w}"${it.workflow === w ? ' selected' : ''}>${w[0].toUpperCase() + w.slice(1)}</option>`).join('')}</select></td>`
        : `<td><input data-k="label" value="${esc(it.label)}" /></td>`}
      <td class="c"><input type="checkbox" data-k="on_form"${it.on_form ? ' checked' : ''} aria-label="Show on the form" /></td>
      <td class="row-btns"><button type="button" data-move="-1" aria-label="Move up">↑</button><button type="button" data-move="1" aria-label="Move down">↓</button><button type="button" data-remove aria-label="Remove">✕</button></td>
    </tr>`).join('');
  }
  for (const kind of ['job_type', 'lead_source'] as const) {
    Sortable.create(document.querySelector(`[data-pane="${kind}"] tbody`) as HTMLElement, { handle: '.drag', animation: 150, onEnd: () => { data[kind] = readList(kind); renderList(kind); } });
  }
  function readList(kind: 'job_type' | 'lead_source'): Item[] {
    return [...document.querySelectorAll<HTMLTableRowElement>(`[data-pane="${kind}"] tbody tr`)].map((tr) => {
      const v = (k: string) => tr.querySelector<HTMLInputElement>(`[data-k="${k}"]`);
      return { value: v('value')!.value, label: kind === 'job_type' ? v('value')!.value : v('label')!.value, workflow: kind === 'job_type' ? v('workflow')!.value || null : null, on_form: v('on_form')!.checked };
    });
  }

  // ---- Payment schedules ----
  const sch = $<HTMLFormElement>('.sch-editor');
  let currentSch: Schedule | null = null;
  const partRow = (p: Part) => `<tr>
    <td><input data-p="label" value="${esc(p.label)}" /></td>
    <td class="pct"><input data-p="percent" type="number" min="1" max="100" step="0.5" value="${p.percent}" /></td>
    <td class="due"><select data-p="when"><option value="accept"${p.when === 'accept' ? ' selected' : ''}>On acceptance, plus</option><option value="before"${p.when === 'before' ? ' selected' : ''}>Before the wedding</option><option value="after"${p.when === 'after' ? ' selected' : ''}>After the wedding</option></select>
      <input data-p="amount" type="number" min="0" step="1" value="${p.months ?? p.days ?? 0}" />
      <select data-p="unit"><option value="days"${p.months ? '' : ' selected'}>days</option><option value="months"${p.months ? ' selected' : ''}>months</option></select></td>
    <td class="row-btns"><button type="button" data-part-remove aria-label="Remove">✕</button></td>
  </tr>`;
  const readParts = () => [...sch.querySelectorAll<HTMLTableRowElement>('.sch-parts tbody tr')].map((tr) => {
    const v = (k: string) => (tr.querySelector(`[data-p="${k}"]`) as HTMLInputElement).value;
    return { label: v('label'), percent: Number(v('percent')), when: v('when'), amount: Number(v('amount')), unit: v('unit') };
  });
  function schExample() {
    const parts = readParts();
    const total = parts.reduce((a, p) => a + (p.percent || 0), 0);
    const t = $('.sch-total'); t.textContent = `Total: ${Math.round(total * 100) / 100}%${total === 100 ? ' ✓' : ' (needs to be 100%)'}`; t.classList.toggle('bad', total !== 100);
    // An example: a $3,995 wedding six months from today, accepted today.
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Pacific/Auckland' });
    const d = new Date(`${today}T12:00:00Z`); d.setUTCMonth(d.getUTCMonth() + 6);
    const wedding = d.toISOString().slice(0, 10);
    const asParts = parts.map((p) => ({ percent: p.percent, label: p.label, when: p.when, ...(p.amount ? { [p.unit === 'months' && p.when !== 'accept' ? 'months' : 'days']: p.amount } : {}) }));
    const rows = total === 100 ? payments(asParts, 399500, wedding, today) : [];
    $('.sch-example').innerHTML = rows.length ? `<p class="ex-head">Example: a $3,995 wedding on ${longDate(wedding)}, accepted today</p><ul>${rows.map((r: { label: string; amount: number; onAccept: boolean; due: string }) => `<li>${esc(r.label)}: ${money(r.amount)} ${r.onAccept ? 'on acceptance' : `by ${longDate(r.due)}`}</li>`).join('')}</ul>` : '';
  }
  function openSchedule(x: Schedule | null) {
    currentSch = x;
    (sch.elements.namedItem('sch_name') as HTMLInputElement).value = x?.name ?? '';
    $('.sch-parts tbody').innerHTML = (x?.parts ?? [{ percent: 100, label: 'Payment', when: 'accept', days: 7 }]).map(partRow).join('');
    document.querySelectorAll<HTMLElement>('.sch-list li').forEach((li) => li.classList.toggle('on', li.dataset.key === x?.key));
    $<HTMLButtonElement>('[data-act="delete-schedule"]').hidden = !x;
    schExample();
  }
  function renderSchedules() {
    $('.sch-list').innerHTML = data.schedules.map((x) => `<li data-key="${esc(x.key)}"><button type="button">${esc(x.name)}<small>${x.parts.map((p) => p.percent + '%').join(' / ')}</small></button></li>`).join('');
  }
  sch.addEventListener('input', schExample);
  sch.addEventListener('change', schExample);
  sch.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ schedule: { key: currentSch?.key, name: (sch.elements.namedItem('sch_name') as HTMLInputElement).value, parts: readParts() } }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Payment schedule saved.');
    await load(current?.key, d.key);
  });
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLElement>('.sch-list li');
    if (li) { openSchedule(data.schedules.find((x) => x.key === li.dataset.key) ?? null); return; }
    if (t.closest('[data-act="new-schedule"]')) { openSchedule(null); (sch.elements.namedItem('sch_name') as HTMLInputElement).focus(); return; }
    if (t.closest('[data-act="add-part"]')) { $('.sch-parts tbody').insertAdjacentHTML('beforeend', partRow({ percent: 0, label: 'Payment', when: 'before', months: 1 })); schExample(); return; }
    if (t.closest('[data-part-remove]')) { t.closest('tr')!.remove(); schExample(); return; }
    if (t.closest('[data-act="delete-schedule"]') && currentSch) {
      if (!confirm(`Delete “${currentSch.name}”?`)) return;
      const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ delete_schedule: currentSch.key }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t delete.', true); return; }
      toast('Deleted.'); currentSch = null; await load(current?.key);
    }
  });

  // ---- Documents ----
  const size = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);
  function renderDocs() {
    $('.docs-table tbody').innerHTML = data.documents.length ? data.documents.map((d) => `<tr data-doc-id="${d.id}">
      <td><a href="/api/studio/crm/documents?id=${d.id}" target="_blank" rel="noopener">${esc(d.name)}</a></td>
      <td>${size(d.size)}</td><td>${new Date(d.updated_at).toLocaleDateString('en-NZ')}</td>
      <td>${d.used_by.length ? esc(d.used_by.join(', ')) : '<span class="muted">–</span>'}</td>
      <td class="row-btns"><button type="button" data-doc-act="rename">Rename</button><button type="button" data-doc-act="replace">Replace</button><button type="button" data-doc-act="delete">Delete</button></td>
    </tr>`).join('') : '<tr><td colspan="5" class="muted">No documents yet. Upload one below.</td></tr>';
  }
  const readFile = (file: File) => new Promise<string>((ok, fail) => { const r = new FileReader(); r.onload = () => ok(String(r.result).split(',')[1] ?? ''); r.onerror = () => fail(r.error); r.readAsDataURL(file); });
  const docApi = async (method: string, body?: unknown, q = '') => {
    const r = await fetch(`/api/studio/crm/documents${q}`, { method, headers: { 'content-type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Something went wrong.');
    return d;
  };
  $('[data-upload]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    for (const file of Array.from(input.files ?? [])) {
      if (file.size > 10 * 1048576) { toast(`${file.name} is over 10 MB.`, true); continue; }
      toast(`Uploading ${file.name}…`);
      try { await docApi('POST', { name: file.name, type: file.type || 'application/octet-stream', base64: await readFile(file) }); toast(`${file.name} uploaded.`); }
      catch (err) { toast((err as Error).message, true); }
    }
    input.value = '';
    await load(current?.key);
  });
  let replacing = 0;
  $('[data-replace]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file || !replacing) return;
    if (file.size > 10 * 1048576) { toast('That file is over 10 MB.', true); return; }
    try { await docApi('PUT', { id: replacing, type: file.type || 'application/octet-stream', base64: await readFile(file) }); toast('Replaced. Templates attaching it now send the new file.'); }
    catch (err) { toast((err as Error).message, true); }
    input.value = ''; replacing = 0;
    await load(current?.key);
  });
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-doc-act]');
    if (!b) return;
    const id = Number(b.closest<HTMLElement>('[data-doc-id]')!.dataset.docId);
    const doc = data.documents.find((d) => d.id === id)!;
    try {
      if (b.dataset.docAct === 'rename') {
        const name = prompt('New name (this is the file name clients see):', doc.name);
        if (!name || name === doc.name) return;
        await docApi('PUT', { id, name }); toast('Renamed.');
      } else if (b.dataset.docAct === 'replace') {
        replacing = id; ($('[data-replace]') as HTMLInputElement).click(); return;
      } else if (b.dataset.docAct === 'delete') {
        if (!confirm(`Delete “${doc.name}”? This can’t be undone.`)) return;
        await docApi('DELETE', undefined, `?id=${id}`); toast('Deleted.');
      }
      await load(current?.key);
    } catch (err) { toast((err as Error).message, true); }
  });

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const tb = t.closest<HTMLButtonElement>('.tabs button');
    if (tb) { showTab(tb.dataset.tab!); return; }
    const li = t.closest<HTMLElement>('.tpl-list li');
    if (li) { openTemplate(data.templates.find((x) => x.key === li.dataset.key) ?? null); return; }
    if (t.closest('[data-act="new-template"]')) { openTemplate(null); field('name').focus(); return; }
    const pane = t.closest<HTMLElement>('[data-pane]');
    const kind = pane?.dataset.pane as 'job_type' | 'lead_source';
    if (!pane || ['templates', 'documents', 'schedules'].includes(kind as string)) return;
    if (t.closest('[data-act="add"]')) {
      data[kind] = [...readList(kind), { value: '', label: '', workflow: null, on_form: true }];
      renderList(kind);
      (pane.querySelector('tbody tr:last-child input') as HTMLInputElement)?.focus();
      return;
    }
    const tr = t.closest<HTMLTableRowElement>('tr[data-i]');
    if (tr && (t.closest('[data-move]') || t.closest('[data-remove]'))) {
      const items = readList(kind); const i = Number(tr.dataset.i);
      if (t.closest('[data-remove]')) items.splice(i, 1);
      else { const j = i + Number(t.closest<HTMLElement>('[data-move]')!.dataset.move); if (j >= 0 && j < items.length) [items[i], items[j]] = [items[j], items[i]]; }
      data[kind] = items; renderList(kind); return;
    }
    if (t.closest('[data-act="save-list"]')) {
      const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ list: kind, items: readList(kind) }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
      toast('Saved. The enquiry form uses the new list within a few minutes.');
      await load(current?.key);
    }
  });

  async function load(openKey?: string, openSchedule_?: string) {
    const r = await fetch('/api/studio/crm/settings');
    const d = await r.json();
    if (!r.ok) { $('.status').textContent = d.error || `Something went wrong (${r.status}).`; return; }
    data = d;
    renderTemplates(); renderList('job_type'); renderList('lead_source'); renderDocs(); renderSchedules();
    openSchedule(data.schedules.find((x) => x.key === (openSchedule_ ?? currentSch?.key)) ?? data.schedules[0] ?? null);
    openTemplate(data.templates.find((x) => x.key === openKey) ?? data.templates.find((x) => x.key.startsWith('wedding-01')) ?? data.templates[0] ?? null);
    $('.status').hidden = true;
    showTab(tab);
  }
  load();
</script>

<style is:global>
  .studio-bar .save-state { font-size: 13px; color: #888; }
  .settings { max-width: 1240px; margin: 0 auto; padding: 28px clamp(14px, 3vw, 32px) 80px; }
  .settings h1 { margin: 0 0 14px; font-weight: 300; font-size: 32px; color: var(--ink); }
  .settings .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
  .settings .tabs button { padding: 8px 16px; border: 1px solid #ddd3c4; border-radius: 999px; background: var(--white); font: inherit; font-size: 14px; cursor: pointer; }
  .settings .tabs button.on { background: var(--green); border-color: var(--green); color: var(--white); }

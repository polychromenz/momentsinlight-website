  const linksForm = $<HTMLFormElement>('.links-form');
  const linkTest = () => { const v = (linksForm.elements.namedItem('booking_link') as HTMLInputElement).value.trim(); const a = $<HTMLAnchorElement>('.links-test'); a.hidden = !/^https:\/\//.test(v); a.href = v; };
  function renderLinks() { (linksForm.elements.namedItem('booking_link') as HTMLInputElement).value = data.links.booking_link || ''; linkTest(); }
  linksForm.addEventListener('input', linkTest);
  linksForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ links: Object.fromEntries(new FormData(linksForm)) }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Saved. Emails with {{booking_link}} use it from now on.');
    await load(current?.key);
  });

  // ---- Client portal ----
  const portalForm = $<HTMLFormElement>('.portal-form');
  const bannerPreview = () => { $<HTMLImageElement>('.portal-banner-preview').src = (portalForm.elements.namedItem('banner') as HTMLInputElement).value; };
  function renderPortal() {
    for (const [k, v] of Object.entries(data.portal)) (portalForm.elements.namedItem(k) as HTMLInputElement).value = v;
    bannerPreview();
  }
  portalForm.addEventListener('input', bannerPreview);
  portalForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ portal: Object.fromEntries(new FormData(portalForm)) }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Saved. Every portal shows it straight away.');
    await load(current?.key);
  });

  async function load(openKey?: string, openSchedule_?: string, openContract_?: string, openQn_?: string, openWf_?: string) {
    const r = await fetch('/api/studio/crm/settings');
    const d = await r.json();
    if (!r.ok) { $('.status').textContent = d.error || `Something went wrong (${r.status}).`; return; }
    data = d;
    renderTemplates(); renderList('job_type'); renderList('lead_source'); renderDocs(); renderSchedules(); renderContracts(); renderPayments(); renderQns(); renderPortal(); renderWfs(); renderLinks();
    openWf(data.workflows.find((x) => x.key === (openWf_ ?? currentWf?.key)) ?? data.workflows[0] ?? null);
    openQn(data.questionnaires.find((x) => x.key === (openQn_ ?? currentQn?.key)) ?? data.questionnaires[0] ?? null);
    openContract(data.contracts.find((x) => x.key === (openContract_ ?? currentCon?.key)) ?? data.contracts[0] ?? null);
    openSchedule(data.schedules.find((x) => x.key === (openSchedule_ ?? currentSch?.key)) ?? data.schedules[0] ?? null);
    openTemplate(data.templates.find((x) => x.key === openKey) ?? data.templates.find((x) => x.key.startsWith('wedding-01')) ?? data.templates[0] ?? null);
    $('.status').hidden = true;
    showTab(tab);
  }
  load();
</script>


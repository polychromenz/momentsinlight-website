  });
  let replacing = 0;
  $('[data-replace]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file || !replacing) return;
    if (file.size > 10 * 1048576) { toast('That file is over 10 MB.', true); return; }
    try { await docApi('PUT', { id: replacing, type: file.type || 'application/octet-stream', base64: await readFile(file) }); toast('Replaced. Templates attaching it now send the new file.'); }

  function renderSchedules() {
    $('.sch-list').innerHTML = data.schedules.map((x) => `<li data-key="${esc(x.key)}"><button type="button">${esc(x.name)}<small>${x.parts.map((p) => p.percent + '%').join(' / ')}</small></button></li>`).join('');
  }
  // ---- Packages & products (functions/api/studio/crm/catalogue.js) ----
  type Cat = { id: number; kind: string; name: string; subtitle: string; description: string; price: number; recommended: number };
  let cat: { packages: Cat[]; products: Cat[] } = { packages: [], products: [] };
  let catOpen: Cat | null = null, catKind = 'package';
  const catForm = $<HTMLFormElement>('.cat-editor');
  const cf = (n: string) => catForm.elements.namedItem(n) as HTMLInputElement;
  const catRich = attachRich(cf('cat_description') as unknown as HTMLTextAreaElement, { minHeight: 200 });
  const catMoney = (c: number) => `$${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: c % 100 ? 2 : 0 })}`;
  function drawCat() {
    for (const [kind, list] of [['package', cat.packages], ['product', cat.products]] as const)
      $(`.cat-list[data-kind="${kind}"]`).innerHTML = list.map((x) => `<li data-cat="${x.id}" class="${catOpen?.id === x.id ? 'on' : ''}"><button type="button">${esc(x.name)}${x.subtitle ? ` · ${esc(x.subtitle)}` : ''}<small>${catMoney(x.price)}${x.recommended ? ' · ♥' : ''}</small></button></li>`).join('') || '<li class="muted">None yet.</li>';
  }
  function openCat(x: Cat | null, kind = x?.kind ?? 'package') {
    catOpen = x; catKind = kind;
    catForm.hidden = false;

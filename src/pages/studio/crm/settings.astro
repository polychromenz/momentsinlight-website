  // ---- Studio Ninja (import) ----
  function showSurvey(d: any) {
    if (!d || d.none) { $('.sn-result').innerHTML = '<p class="hint">Not run yet.</p>'; return; }
    if (d.error) { $('.sn-result').innerHTML = `<p class="hint" style="color:#a8432a">${esc(d.error)}</p>`; return; }
    $('.sn-result').innerHTML = `<p class="hint">Found ${d.total_found} Studio Ninja emails (searched ${new Date(d.at).toLocaleString('en-NZ', { dateStyle: 'medium', timeStyle: 'short' })}). Claude can read these results from here; the examples have the details hidden.</p>
      <table class="list-table sn-table"><thead><tr><th>Kind of email</th><th>How many</th><th>Readable</th></tr></thead><tbody>
      ${d.kinds.map((k: any) => `<tr><td><strong>${esc(k.subject)}</strong><br><small>${esc(k.from)}</small></td><td>${k.count ?? '–'}</td></tr>`).join('')}
      </tbody></table>
      <h3 class="sn-h">Step 2: read the enquiries and bookings</h3>
      <p class="hint">Reads the "New lead", "quote accepted" and "contract" emails into a holding area (35 at a time, it keeps going by itself). Nothing is added to your clients yet; that's the import, after you've checked the report. You can remove what was read at any time.</p>
      <p class="sn-progress">${snProgress(d.progress)}</p>
      <div class="actions" style="justify-content:flex-start"><button type="button" class="s-btn s-btn--solid" data-sn-read>Read the Studio Ninja emails</button><button type="button" class="s-btn s-btn--quiet" data-sn-clear>Remove what was read</button></div>
      <h3 class="sn-h">Step 3: signed contracts</h3>
      <p class="hint">After the import: files the signed contract PDF from each “contract signed” email on the couple’s job (and in their portal). Safe to run again; it skips ones already filed.</p>
      <div class="actions" style="justify-content:flex-start"><button type="button" class="s-btn s-btn--solid" data-sn-contracts>Attach signed contracts</button></div>`;
  }
  const SN_KINDS: Record<string, string> = { lead: 'Enquiries', quote_accepted: 'Quotes accepted', contract_signed: 'Contracts' };
  const snProgress = (p: any) => (p ? Object.entries(SN_KINDS).map(([k, label]) => `${label}: <strong>${p[k]?.n ?? 0}</strong>${p[k]?.first ? ` <small>(${p[k].first.slice(0, 10)} to ${p[k].last.slice(0, 10)})</small>` : ''}`).join(' · ') : '');
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const rb = t.closest<HTMLButtonElement>('[data-sn-read]');
    if (rb) {
      rb.disabled = true;
      for (const kind of Object.keys(SN_KINDS)) {
        for (let i = 0; i < 20; i++) {
          rb.textContent = `Reading ${SN_KINDS[kind].toLowerCase()}…`;
          const r = await fetch('/api/studio/crm/sn-gmail', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'read', kind }) });
          const d = await r.json().catch(() => ({ error: `Something went wrong (${r.status}).` }));
          if (!r.ok) { toast(d.error, true); rb.disabled = false; rb.textContent = 'Read the Studio Ninja emails'; return; }
          rb.textContent = `${SN_KINDS[kind]}: ${d.read} of ${d.total}`;
          if (!d.left) break;
        }
      }
      const g = await (await fetch('/api/studio/crm/sn-gmail')).json();
      $('.sn-progress').innerHTML = snProgress(g.progress);
      rb.disabled = false; rb.textContent = 'Read the Studio Ninja emails';
      toast('Done. Tell Claude, and it will add them to the dry-run report.');
      return;
    }
    const cb = t.closest<HTMLButtonElement>('[data-sn-contracts]');
    if (cb) {
      cb.disabled = true;
      let total = 0; const failed: string[] = [];
      for (let i = 0; i < 20; i++) {
        cb.textContent = `Attaching… ${total} so far`;
        const r = await fetch('/api/studio/crm/sn-gmail', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'contracts' }) });
        const d = await r.json().catch(() => ({ error: `Something went wrong (${r.status}).` }));
        if (!r.ok) { toast(d.error, true); break; }
        total += d.done; failed.push(...(d.failed ?? []));
        if (d.note) { toast(d.note); break; }
        if (!d.left || !d.done) break;
      }
      cb.disabled = false; cb.textContent = 'Attach signed contracts';
      toast(failed.length ? `Attached ${total}; ${failed.length} didn’t: ${failed.slice(0, 3).join('; ')}` : `Attached ${total} signed contract${total === 1 ? '' : 's'}.`, !!failed.length);
      return;
    }
    if (t.closest('[data-sn-clear]')) {
      if (!await ask('Remove everything read from the Studio Ninja emails? (Your Gmail isn’t touched; you can read them again any time.)')) return;
      await fetch('/api/studio/crm/sn-gmail', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'clear' }) });
      const g = await (await fetch('/api/studio/crm/sn-gmail')).json();
      $('.sn-progress').innerHTML = snProgress(g.progress);
      toast('Removed.');
    }
  });
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sn-survey]');
    if (!b) return;
    b.disabled = true; const label = b.textContent; b.textContent = 'Searching your Gmail… (up to a minute)';
    const r = await fetch('/api/studio/crm/sn-gmail', { method: 'POST' });
    const d = await r.json().catch(() => ({ error: `Something went wrong (${r.status}).` }));
    b.disabled = false; b.textContent = label;
    showSurvey(d);
  });
  fetch('/api/studio/crm/sn-gmail').then((r) => r.json()).then(showSurvey).catch(() => {});

  // ---- Step 4: the switch-over (functions/api/studio/crm/sn-switch.js) ----
  const nzd = (d: string | null) => (d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '');
  async function drawSwitch() {
    const box = $('.sn-switch');
    const d = await fetch('/api/studio/crm/sn-switch').then((r) => r.json()).catch(() => null);
    if (!d) { box.innerHTML = '<p class="hint">Couldn’t load.</p>'; return; }
    const heldN = d.held.reduce((a: number, h: any) => a + h.n, 0);
    if (d.done && !heldN) { box.innerHTML = `<p class="hint">Switched over on ${new Date(d.done.at).toLocaleString('en-NZ', { dateStyle: 'medium', timeStyle: 'short' })}: ${d.done.jobs} jobs taken off hold, ${d.done.planned} upcoming workflow steps planned. The studio handles reminders and emails now.</p>`; return; }
    box.innerHTML = `<p class="hint">The ${heldN} imported jobs are on hold, so Studio Ninja still handles their reminders and emails. Switching over takes them off hold and the studio takes over. <strong>Do it the same day you turn off Studio Ninja’s automatic emails and payment reminders</strong>, so couples don’t get both.</p>
      <h4 class="sn-sub">Invoice reminders that will come from the studio</h4>
      ${d.invoices.length ? `<table class="list-table"><thead><tr><th>Couple</th><th>Invoice</th><th>Amount</th><th>What happens</th></tr></thead><tbody>${d.invoices.map((i: any) => `<tr><td>${esc(i.title)}</td><td>${esc(i.number)} <small>${esc(i.label)}</small></td><td>${money(i.amount)}</td><td>${i.reminder ? `Reminder ${nzd(i.reminder)}; again ${nzd(i.late)} if still unpaid` : `Sent by the studio ${nzd(i.send)}`}</td></tr>`).join('')}</tbody></table>` : '<p class="hint">No unpaid invoices.</p>'}
      <h4 class="sn-sub">Wedding emails for booked couples (only the ones still ahead)</h4>
      ${d.couples.map((c: any) => `<details class="sn-couple"><summary><strong>${esc(c.title)}</strong> · ${nzd(c.event_date)} · ${c.steps.filter((x: any) => x.kind !== 'todo').length} emails, ${c.steps.filter((x: any) => x.kind === 'todo').length} to-dos${c.skipped ? ` (${c.skipped} already past, skipped)` : ''}</summary><ul>${c.steps.map((x: any) => `<li>${esc(x.title)} <small>${x.due ? nzd(x.due) : 'when you’re ready'} · ${x.kind === 'auto_email' ? 'automatic email' : x.kind === 'ready_email' ? 'you review and send' : 'to-do'}</small></li>`).join('')}</ul></details>`).join('') || '<p class="hint">No booked couples.</p>'}
      <p class="hint">Automatic emails go on their dates; you can skip or change any of them on the couple’s page first. Past weddings and lost enquiries stay as records only.</p>
      <div class="actions" style="justify-content:flex-start"><button type="button" class="s-btn s-btn--solid" data-sn-switch>Switch over to the studio</button></div>`;
  }
  drawSwitch();
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sn-switch]');
    if (!b) return;
    if (!await ask('Switch over now? The studio starts sending reminders and wedding emails for the imported couples. Make sure Studio Ninja’s automatic emails and payment reminders are off.', { title: 'Switch over from Studio Ninja', ok: 'Switch over' })) return;
    b.disabled = true; b.textContent = 'Switching…';
    const r = await fetch('/api/studio/crm/sn-switch', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'switch' }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'That didn’t work.', true); b.disabled = false; b.textContent = 'Switch over to the studio'; return; }
    toast(`Switched over: ${d.jobs} jobs, ${d.planned} upcoming steps planned.`);
    drawSwitch();
  });

  // ---- Your links ----
  const linksForm = $<HTMLFormElement>('.links-form');
  const linkTest = () => { const v = (linksForm.elements.namedItem('booking_link') as HTMLInputElement).value.trim(); const a = $<HTMLAnchorElement>('.links-test'); a.hidden = !/^https:\/\//.test(v); a.href = v; };
  function renderLinks() { (linksForm.elements.namedItem('booking_link') as HTMLInputElement).value = data.links.booking_link || ''; linkTest(); }
  linksForm.addEventListener('input', linkTest);
  linksForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ links: Object.fromEntries(new FormData(linksForm)) }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Saved. Emails with {{booking_link}} use it from now on.');
    await load(current?.key);
  });

  // ---- Client portal ----
  const portalForm = $<HTMLFormElement>('.portal-form');
  const bannerPreview = () => { $<HTMLImageElement>('.portal-banner-preview').src = (portalForm.elements.namedItem('banner') as HTMLInputElement).value; };
  function renderPortal() {
    for (const [k, v] of Object.entries(data.portal)) (portalForm.elements.namedItem(k) as HTMLInputElement).value = v;
    bannerPreview();
  }
  portalForm.addEventListener('input', bannerPreview);
  portalForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await fetch('/api/studio/crm/settings', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ portal: Object.fromEntries(new FormData(portalForm)) }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { toast(d.error || 'Couldn’t save.', true); return; }
    toast('Saved. Every portal shows it straight away.');
    await load(current?.key);
  });

  $<HTMLSelectElement>('.tabs-select').addEventListener('change', (e) => showTab((e.target as HTMLSelectElement).value));
  // Open the section in the address (e.g. /studio/crm/settings#workflows).
  if (location.hash && document.querySelector(`[data-pane="${location.hash.slice(1)}"]`)) tab = location.hash.slice(1);

  async function load(openKey?: string, openSchedule_?: string, openContract_?: string, openQn_?: string, openWf_?: string) {
    const r = await fetch('/api/studio/crm/settings');
    const d = await r.json();
    if (!r.ok) { $('.status').textContent = d.error || `Something went wrong (${r.status}).`; return; }
    data = d;
    renderTemplates(); renderList('job_type'); renderList('lead_source'); renderDocs(); renderSchedules(); renderContracts(); renderPayments(); renderQns(); renderPortal(); renderWfs(); renderLinks();
    openWf(data.workflows.find((x) => x.key === (openWf_ ?? currentWf?.key)) ?? data.workflows[0] ?? null);
    openQn(data.questionnaires.find((x) => x.key === (openQn_ ?? currentQn?.key)) ?? data.questionnaires[0] ?? null);
    openContract(data.contracts.find((x) => x.key === (openContract_ ?? currentCon?.key)) ?? data.contracts[0] ?? null);
    openSchedule(data.schedules.find((x) => x.key === (openSchedule_ ?? currentSch?.key)) ?? data.schedules[0] ?? null);
    openTemplate(data.templates.find((x) => x.key === openKey) ?? data.templates.find((x) => x.key.startsWith('wedding-01')) ?? data.templates[0] ?? null);
    $('.status').hidden = true;
    showTab(tab);
  }
  load();
</script>


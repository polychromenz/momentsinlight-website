  // ---- Online booking (functions/api/studio/booking.js) ----
  {
    const DAYS: [string, string][] = [['mon', 'Monday'], ['tue', 'Tuesday'], ['wed', 'Wednesday'], ['thu', 'Thursday'], ['fri', 'Friday'], ['sat', 'Saturday'], ['sun', 'Sunday']];
    const f = document.querySelector<HTMLFormElement>('.booking-form')!;
    let jobTypes: string[] = [];
    const typeRow = (t: any) => `<fieldset class="bk-type"><legend><label class="tick"><input type="checkbox" data-k="on" ${t.on ? 'checked' : ''} /> On</label></legend>
      <input type="hidden" data-k="key" value="${esc(t.key)}" />
      <label>Name<input data-k="name" value="${esc(t.name)}" /></label>
      <label>Minutes<input data-k="minutes" inputmode="numeric" value="${t.minutes}" /></label>
      <label>Price <small>($, 0 = free)</small><input data-k="price" inputmode="decimal" value="${t.price / 100}" /></label>
      <label>Makes a job of type<select data-k="job_type">${jobTypes.map((j) => `<option${j === t.job_type ? ' selected' : ''}>${esc(j)}</option>`).join('')}</select></label>
      <label class="wide">Where<input data-k="where" value="${esc(t.where)}" placeholder="e.g. Video call (I’ll send the link)" /></label>
      <label class="wide">About it<textarea data-k="description" rows="2">${esc(t.description)}</textarea></label>
      <button type="button" class="s-btn s-btn--quiet" data-bk-remove>Remove</button></fieldset>`;
    const read = () => ({
      on: (f.elements.namedItem('on') as HTMLInputElement).checked,
      hours: Object.fromEntries(DAYS.map(([k]) => [k, (f.querySelector<HTMLInputElement>(`[data-day="${k}"]`)!.value || '').trim()])),
      notice_hours: (f.elements.namedItem('notice_hours') as HTMLInputElement).value,
      ahead_days: (f.elements.namedItem('ahead_days') as HTMLInputElement).value,
      gap_min: (f.elements.namedItem('gap_min') as HTMLInputElement).value,
      types: [...f.querySelectorAll<HTMLElement>('.bk-type')].map((el) => {
        const v = (k: string) => el.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
        return { key: v('key').value || v('name').value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), name: v('name').value, minutes: v('minutes').value, price: Math.round(Number(v('price').value || 0) * 100), job_type: v('job_type').value, where: v('where').value, description: v('description').value, on: v('on').checked };
      }),
    });
    const draw = (d: any) => {
      const s = d.settings;
      jobTypes = d.job_types;
      (f.elements.namedItem('on') as HTMLInputElement).checked = s.on;
      f.querySelector('.bk-hours')!.innerHTML = DAYS.map(([k, n]) => `<label>${n}<input data-day="${k}" value="${esc(s.hours[k] || '')}" placeholder="Closed, or e.g. 09:00-17:00" /></label>`).join('');
      for (const k of ['notice_hours', 'ahead_days', 'gap_min']) (f.elements.namedItem(k) as HTMLInputElement).value = String(s[k]);
      f.querySelector('.bk-types')!.innerHTML = s.types.map(typeRow).join('');
      const st = f.querySelector<HTMLElement>('.bk-stripe')!;
      st.hidden = d.stripe.ok;
      st.textContent = d.stripe.ok ? '' : `Paid bookings need card payments: ${d.stripe.why}`;
      document.querySelector('.bk-recent')!.innerHTML = d.recent.length ? d.recent.map((b: any) => `<li>${esc(b.date)} ${esc(b.time)} · <a href="/studio/crm/job?id=${b.job_id}">${esc(`${b.first_name} ${b.last_name}`)}</a> · ${esc(b.type_name)} · ${esc(b.status)}</li>`).join('') : '<li class="muted">None yet.</li>';
    };
    fetch('/api/studio/booking').then((r) => r.json()).then(draw).catch(() => {});
    f.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-bk-add]')) f.querySelector('.bk-types')!.insertAdjacentHTML('beforeend', typeRow({ key: '', name: '', minutes: 30, price: 0, job_type: jobTypes[0] ?? 'Wedding', where: '', description: '', on: true }));
      if (t.closest('[data-bk-remove]') && await ask('Remove this kind of booking?')) t.closest('.bk-type')!.remove();
    });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch('/api/studio/booking', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(read()) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { tell(d.error || 'That didn’t save.'); return; }
      const fresh = await (await fetch('/api/studio/booking')).json();
      draw(fresh);
      tell('Saved.');
    });
  }

  // ---- People: who else can use the studio (functions/api/studio/people.js) ----
  {
    type Sig = { name: string; role: string; phone: string; photo: string };
    let people: { email: string; name: string; areas: Record<string, string>; send_email?: boolean; signature?: Sig }[] = [];
    let AREAS: Record<string, string> = {}, LEVELS: Record<string, string> = {};
    const list = document.querySelector<HTMLElement>('.people-list')!;
    const save = async (next: typeof people) => {
      const r = await fetch('/api/studio/people', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ people: next }) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { tell(d.error || 'That didn’t save.'); return; }
      people = d.people; drawPeople();
    };
    const drawPeople = () => {
      list.innerHTML = people.length ? people.map((p, n) => `<li data-n="${n}" class="person"><div class="person-head"><span><strong>${esc(p.name || p.email)}</strong> <small>${esc(p.email)}</small></span>
        <button type="button" class="s-btn s-btn--quiet" data-remove>Remove</button></div>
        <div class="person-areas">${Object.entries(AREAS).map(([a, label]) => `<label>${esc(label)}<select data-area="${a}">${Object.entries(LEVELS).map(([v, l]) => `<option value="${v}"${p.areas[a] === v ? ' selected' : ''}>${esc(l)}</option>`).join('')}</select></label>`).join('')}</div>
        <label class="person-send"><input type="checkbox" data-send${p.send_email ? ' checked' : ''} /> Can send one-off emails (✉ Write email), from ${esc(p.email)} with their own signature</label>
        <div class="person-sig">
          <div class="sig-photo">${p.signature?.photo ? `<img src="${esc(p.signature.photo)}" alt="" />` : '<span>No photo</span>'}<label class="s-btn s-btn--quiet">Choose photo<input type="file" accept="image/*" data-sig-photo hidden /></label></div>
          <div class="sig-fields"><label>Name in signature<input data-sig="name" value="${esc(p.signature?.name ?? p.name)}" /></label><label>Role<input data-sig="role" value="${esc(p.signature?.role ?? '')}" placeholder="e.g. Studio manager" /></label><label>Phone <small>(optional)</small><input data-sig="phone" value="${esc(p.signature?.phone ?? '')}" /></label></div>
        </div></li>`).join('') : '<li class="muted">Nobody else yet.</li>';
    };
    fetch('/api/studio/people').then((r) => r.json()).then((d) => {
      if (d.me?.access !== 'owner') { list.innerHTML = '<li class="muted">Only Tony can see and change this list.</li>'; document.querySelector<HTMLElement>('.people-add')!.hidden = true; return; }
      AREAS = d.areas; LEVELS = d.levels;
      people = d.people; drawPeople();
    });
    // The email switch, signature fields and photo.
    const sigOf = (n: number): Sig => ({ name: '', role: '', phone: '', photo: '', ...(people[n].signature ?? {}) });
    list.addEventListener('change', async (e) => {
      const t = e.target as HTMLInputElement;
      const li = t.closest<HTMLElement>('[data-n]');
      if (!li) return;
      const n = Number(li.dataset.n);
      if (t.matches('[data-send]')) { save(people.map((p, i) => (i === n ? { ...p, send_email: t.checked } : p))); return; }
      if (t.matches('[data-sig]')) { save(people.map((p, i) => (i === n ? { ...p, signature: { ...sigOf(n), [t.dataset.sig!]: t.value } } : p))); return; }
      if (t.matches('[data-sig-photo]') && t.files?.[0]) {
        // Square-ish, 288px wide JPEG: plenty for the 72px signature photo on sharp screens.
        const img = new Image(); img.src = URL.createObjectURL(t.files[0]); await img.decode();
        const k = 288 / img.naturalWidth; const cv = document.createElement('canvas');
        cv.width = 288; cv.height = Math.round(img.naturalHeight * k);
        cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
        const blob: Blob = await new Promise((r) => cv.toBlob((b) => r(b!), 'image/jpeg', 0.9));
        const fd = new FormData(); fd.append('file', blob, 'photo.jpg');
        const r = await fetch('/api/studio/people/photo', { method: 'POST', body: fd });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { tell(d.error || 'The photo didn’t upload.'); return; }
        save(people.map((p, i) => (i === n ? { ...p, signature: { ...sigOf(n), photo: d.url } } : p)));
      }
    });
    list.addEventListener('change', (e) => {
      const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-area]');
      if (!sel) return;
      const n = Number(sel.closest<HTMLElement>('[data-n]')!.dataset.n);
      save(people.map((p, i) => (i === n ? { ...p, areas: { ...p.areas, [sel.dataset.area!]: sel.value } } : p)));
    });
    list.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest('[data-remove]');
      if (!b) return;
      const n = Number(b.closest<HTMLElement>('[data-n]')!.dataset.n);
      if (await ask(`Remove ${people[n].name || people[n].email}? (Also take them off the Cloudflare sign-in list.)`)) save(people.filter((_, i) => i !== n));
    });
    document.querySelector<HTMLFormElement>('.people-add')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      if (people.some((p) => p.email === d.email.trim().toLowerCase())) { tell('They’re already on the list.'); return; }
      save([...people, { email: d.email, name: d.name, areas: Object.fromEntries(Object.keys(AREAS).map((a) => [a, 'look'])) }]).then(() => f.reset());
    });
  }

  // ---- Where client emails go (send-mode.js) ----

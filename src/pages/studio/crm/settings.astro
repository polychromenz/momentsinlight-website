  };
  $('[data-upload]').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    for (const file of Array.from(input.files ?? [])) {
      if (file.size > 10 * 1048576) { toast(`${file.name} is over 10 MB.`, true); continue; }
      toast(`Uploading ${file.name}…`);
      try { await docApi('POST', { name: file.name, type: file.type || 'application/octet-stream', base64: await readFile(file) }); toast(`${file.name} uploaded.`); }
      catch (err) { toast((err as Error).message, true); }
    }
    input.value = '';

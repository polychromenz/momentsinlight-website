  let currentQn: Qn | null = null;
  const CHOICES = ['select', 'radio', 'checks'];
  $('.qn-type').innerHTML = Object.entries(TYPES).map(([k, v]) => `<option value="${k}"${k === 'short' ? ' selected' : ''}>${v}</option>`).join('');
  const qRow = (q: Question) => {
    const asks = !['heading', 'text'].includes(q.type);
    return `<li class="qn-q" data-id="${esc(q.id)}">
      <span class="drag" title="Drag to reorder" aria-hidden="true">⠿</span>
      <div class="qn-q-body">
        <div class="qn-q-top"><select data-q="type" aria-label="Type">${Object.entries(TYPES).map(([k, v]) => `<option value="${k}"${k === q.type ? ' selected' : ''}>${v}</option>`).join('')}</select>
          <button type="button" class="qn-x" data-qn-remove aria-label="Remove this question">✕</button></div>
        ${q.type === 'text' ? `<textarea data-q="label" rows="3" aria-label="Text">${esc(q.label)}</textarea>` : `<input data-q="label" value="${esc(q.label)}" aria-label="${q.type === 'heading' ? 'Heading' : 'Question'}" placeholder="${q.type === 'heading' ? 'Heading' : 'The question'}" />`}
        ${CHOICES.includes(q.type) ? `<label class="qn-small">Choices, one per line<textarea data-q="options" rows="3">${esc((q.options || []).join('\n'))}</textarea></label>` : ''}
        ${q.type === 'short' || q.type === 'long' ? `<label class="qn-small">Hint in the box (optional)<input data-q="placeholder" value="${esc(q.placeholder ?? '')}" /></label>` : ''}
        ${asks ? `<div class="qn-flags">
          <label><input type="checkbox" data-q="required"${q.required ? ' checked' : ''} /> Needed</label>
          <label><input type="checkbox" data-q="half"${q.half ? ' checked' : ''} /> Half width</label>
          ${q.type === 'short' ? `<label>Fill in from <select data-q="fill"><option value="">Nothing</option>${Object.entries(FILLS).map(([k, v]) => `<option value="${k}"${q.fill === k ? ' selected' : ''}>${v}</option>`).join('')}</select></label>` : ''}
        </div>` : ''}
      </div></li>`;
  };
  const readQs = (): Question[] => [...qn.querySelectorAll<HTMLElement>('.qn-q')].map((li) => {
    const g = (k: string) => li.querySelector<HTMLInputElement>(`[data-q="${k}"]`);
    const q: Question = { id: li.dataset.id!, type: g('type')!.value, label: g('label')?.value ?? '' };
    if (g('options')) q.options = g('options')!.value.split('\n').map((o) => o.trim()).filter(Boolean);
    if (g('placeholder')?.value.trim()) q.placeholder = g('placeholder')!.value.trim();
    if (g('required')?.checked) q.required = true;
    if (g('half')?.checked) q.half = true;
    if (g('fill')?.value) q.fill = g('fill')!.value;
    return q;
  });
  function qnDraw(qs: Question[]) { $('.qn-qs').innerHTML = qs.map(qRow).join(''); qnPreview(); }
  function qnPreview() {
    $('.qn-preview-intro').innerHTML = qnRich.get();
    $('.qn-preview .qf').innerHTML = formHtml(readQs().filter((q) => q.label), {});
  }
  function openQn(x: Qn | null) {
    currentQn = x;

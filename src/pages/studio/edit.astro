---
// Moments Studio editor: the post as it will look (cover, title, story, photos), edited in
// place, with every setting in the side panel. The work is done in src/studio/editor.ts.
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Edit post">
  <span slot="bar" class="save-state" aria-live="polite"></span>
  <a slot="bar" class="s-btn s-btn--quiet view-live" href="#" target="_blank" rel="noopener" hidden>View on site ↗</a>
  <button slot="bar" type="button" class="s-btn s-btn--quiet" data-act="panel" aria-expanded="true">Settings</button>
  <button slot="bar" type="button" class="s-btn" data-act="draft">Save draft</button>
  <button slot="bar" type="button" class="s-btn s-btn--solid" data-act="publish">Publish</button>

  <div class="editor-wrap">
    <main class="canvas">
      <p class="loading">Opening…</p>

      <section class="cover">
        <div class="cover-frame" hidden>
          <img class="cover-img" alt="" />
          <span class="focus-dot" aria-hidden="true"></span>
        </div>
        <p class="cover-hint">Your cover photo. <strong>Click on the faces</strong> to set where it crops on the post cards. Choose a different cover with the ☆ on any photo below.</p>
        <p class="cover-empty">Add photos below, then click ☆ on one to make it the cover.</p>
      </section>

      <div class="head">
        <p class="eyebrow-preview"></p>
        <textarea class="title-input" rows="1" placeholder="Title, e.g. Ellie & Ryan | Tui Hills" aria-label="Title"></textarea>
      </div>

      <div class="toolbar" role="toolbar" aria-label="Text formatting">
        <button type="button" data-cmd="h2" title="Heading">H2</button>
        <button type="button" data-cmd="h3" title="Smaller heading">H3</button>
        <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
        <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
        <button type="button" data-cmd="link" title="Link">🔗 Link</button>
        <button type="button" data-cmd="bullet" title="Bullet list">• List</button>
        <button type="button" data-cmd="ordered" title="Numbered list">1. List</button>
        <button type="button" data-cmd="quote" title="Quote">❝ Quote</button>
        <button type="button" data-cmd="image" title="Insert a photo into the text">🖼 Photo</button>
        <button type="button" data-cmd="undo" title="Undo">↶</button>
        <button type="button" data-cmd="redo" title="Redo">↷</button>
      </div>
      <p class="raw-note" hidden>This post has a table or some special formatting, so its text is edited as plain text (Markdown) to keep it safe. The preview underneath shows how it will look.</p>
      <div class="story prose"></div>
      <textarea class="story-raw" hidden aria-label="Story (Markdown)"></textarea>
      <div class="raw-preview prose" hidden></div>
      <input class="inline-file" type="file" accept="image/*" hidden />

      <section class="photos">
        <div class="photos-head">
          <h2>Photos</h2>
          <button type="button" class="s-btn s-btn--quiet" data-act="describe-all">✨ Suggest missing descriptions</button>
        </div>
        <label class="drop">
          <input class="file" type="file" accept="image/*" multiple hidden />
          <span><strong>Drag photos or a whole folder here</strong>, or click to choose. They upload straight to your photo library.</span>
        </label>
        <ul class="photo-grid"></ul>
      </section>
    </main>

    <aside class="panel" aria-label="Post settings">
      <div class="panel-status"></div>

      <label>Type
        <select name="kind">
          <option value="Wedding">Love story (wedding)</option>
          <option value="Portrait">Portrait session</option>
          <option value="Family">Family session</option>
          <option value="Info">Article</option>
        </select>
      </label>
      <label>Post date
        <input type="date" name="date" />
        <small>A future date schedules the post: it appears on that day.</small>
      </label>
      <label>Venue
        <select name="venueChoice"></select>
      </label>
      <label class="venue-other" hidden>Venue name
        <input type="text" name="venueOther" placeholder="e.g. Hamilton Gardens" />
      </label>
      <label>Venue website (optional)
        <input type="url" name="venueUrl" placeholder="https://" />
      </label>
      <label>Their Google review (optional)
        <select name="review"></select>
      </label>
      <label>Opening
        <select name="opening">
          <option value="">Usual for this type</option>
          <option value="photo">Photo: cover full width, title over it</option>
          <option value="text">Text: centred heading</option>
        </select>
      </label>
      <label>Gallery style
        <select name="galleryStyle">
          <option value="">Usual (story flow)</option>
          <option value="story">Story flow: large photo, then pairs</option>
          <option value="columns">Columns: every photo whole</option>
          <option value="slideshow">Slideshow</option>
        </select>
      </label>

      <fieldset>
        <legend>Google</legend>
        <label>Google title <span class="count" data-for="seoTitle"></span>
          <input type="text" name="seoTitle" />
        </label>
        <label>Google description <span class="count" data-for="description"></span>
          <textarea name="description" rows="4"></textarea>
        </label>
        <button type="button" class="s-btn s-btn--quiet" data-act="seo">✨ Suggest from the post</button>
        <div class="serp" aria-hidden="true"><p class="serp-title"></p><p class="serp-url"></p><p class="serp-desc"></p></div>
      </fieldset>

      <details>
        <summary>More settings</summary>
        <label>Web address
          <span class="slug-row">/blog/<input type="text" name="slug" /></span>
          <small class="slug-note">Set when the post is first saved.</small>
        </label>
        <label>Tags (comma separated)
          <input type="text" name="tags" />
        </label>
        <label>Author
          <input type="text" name="author" />
        </label>
        <label>Last updated (optional)
          <input type="date" name="updated" />
        </label>
      </details>

      <div class="panel-actions">
        <button type="button" class="s-btn" data-act="unpublish" hidden>Unpublish</button>
        <button type="button" class="s-btn s-btn--danger" data-act="delete" hidden>Delete post</button>
      </div>
    </aside>
  </div>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  import '../../studio/editor';
</script>

<style>
  .save-state { font-size: 13px; color: #888; }
  .editor-wrap { display: grid; grid-template-columns: minmax(0, 1fr); }
  .canvas { background: var(--white); min-height: calc(100vh - 60px); padding-bottom: 120px; }
  .loading { padding: 40px; text-align: center; color: #888; }

  .cover { background: var(--champagne); padding: 18px clamp(14px, 3vw, 32px) 14px; text-align: center; }
  .cover-frame { position: relative; display: inline-block; max-width: 100%; cursor: crosshair; }
  .cover-img { display: block; max-width: 100%; max-height: 62vh; width: auto; height: auto; }
  .focus-dot { position: absolute; width: 26px; height: 26px; margin: -13px 0 0 -13px; border: 3px solid var(--white); border-radius: 50%; box-shadow: 0 0 0 2px var(--green), 0 2px 10px rgb(0 0 0 / 0.4); pointer-events: none; }
  .cover-hint, .cover-empty { margin: 10px auto 0; max-width: 640px; font-size: 13px; color: #6d6d6d; }

  .head { max-width: 760px; margin: 0 auto; padding: 36px clamp(14px, 3vw, 32px) 8px; text-align: center; }
  .eyebrow-preview { margin: 0 0 12px; font-size: 12px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: var(--green); }
  .title-input { width: 100%; border: 0; resize: none; overflow: hidden; text-align: center; font: inherit; font-size: clamp(30px, 2.6vw + 16px, 52px); font-weight: 300; line-height: 1.15; color: var(--ink); background: transparent; padding: 4px; border-radius: 12px 0; }
  .title-input:focus { outline: 2px dashed var(--sage); }

  .toolbar {
    position: sticky; top: 61px; z-index: 30;
    display: flex; flex-wrap: wrap; gap: 4px; justify-content: center;
    max-width: 760px; margin: 18px auto 0; padding: 8px; background: rgb(255 255 255 / 0.96);
    border: 1px solid #ece4d7; border-radius: 16px 0; box-shadow: 0 8px 20px -18px rgb(0 0 0 / 0.5);
  }
  .toolbar button { padding: 7px 11px; border: 0; border-radius: 8px; background: transparent; font: inherit; font-size: 14px; cursor: pointer; color: #333; }
  .toolbar button:hover { background: var(--champagne); }
  .toolbar button.on { background: var(--green); color: var(--white); }
  .raw-note { max-width: 760px; margin: 14px auto 0; padding: 12px 16px; background: #fff7e8; border-radius: 12px 0; font-size: 14px; color: #6b4e16; }

  .story, .story-raw, .raw-preview { max-width: 760px; margin: 16px auto 0; padding: 0 clamp(14px, 3vw, 32px); }
  .story :global(.ProseMirror) { min-height: 280px; outline: none; padding: 8px 0 40px; }
  .story :global(.ProseMirror p.is-editor-empty:first-child::before) { content: attr(data-placeholder); color: #aaa; float: left; height: 0; pointer-events: none; }
  .story-raw { display: block; width: calc(100% - 2 * clamp(14px, 3vw, 32px)); min-height: 420px; font: 15px/1.7 ui-monospace, Consolas, monospace; border: 1px solid #e3dccf; border-radius: 12px 0; padding: 16px; }
  .story-raw[hidden], .raw-preview[hidden] { display: none; }

  /* The post's reading style, as on the site. */
  .prose :global(p) { color: #333; line-height: 1.9; font-size: 17px; }
  .prose :global(h2) { font-weight: 300; color: var(--ink); font-size: 30px; line-height: 1.2; margin: 1.4em 0 0.5em; }
  .prose :global(h3) { font-weight: 500; color: var(--ink); font-size: 21px; margin: 1.2em 0 0.4em; }
  .prose :global(strong) { font-weight: 600; color: var(--ink); }
  .prose :global(a) { color: var(--green); text-decoration-color: var(--sage); }
  .prose :global(ul) { padding-left: 1.3em; }
  .prose :global(li) { line-height: 1.8; }
  .prose :global(blockquote) { margin: 1.4em 0; padding-left: 20px; border-left: 2px solid var(--sage); }
  .prose :global(img) { width: 100%; height: auto; border-radius: 32px 0; margin: 1.2em 0; }
  .prose :global(img.ProseMirror-selectednode) { outline: 3px solid var(--sage); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid #ece6db; padding: 8px; text-align: left; }

  .photos { max-width: 1240px; margin: 48px auto 0; padding: 0 clamp(14px, 3vw, 32px); }
  .photos-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .photos-head h2 { margin: 0; font-weight: 300; font-size: 28px; color: var(--ink); }
  .drop { display: block; margin: 16px 0 20px; padding: 28px; border: 2px dashed #d8cdb9; border-radius: 24px 0; text-align: center; color: #666; cursor: pointer; background: #fcfaf6; transition: background-color 0.3s, border-color 0.3s; }
  .drop.over { background: #f1f4e8; border-color: var(--sage); }
  .photo-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .photo-grid :global(li) { background: #faf8f4; border: 1px solid #eee6d9; border-radius: 16px 0; padding: 8px; display: flex; flex-direction: column; gap: 6px; }
  .photo-grid :global(.ph) { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; background: #f0ebe2; border-radius: 10px 0; overflow: hidden; cursor: grab; }
  .photo-grid :global(.ph img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  .photo-grid :global(.ph .bar) { position: absolute; left: 0; bottom: 0; height: 4px; background: var(--green); transition: width 0.2s; }
  .photo-grid :global(.ph-actions) { position: absolute; top: 6px; right: 6px; display: flex; gap: 4px; }
  .photo-grid :global(.ph-actions button) { width: 30px; height: 30px; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.92); cursor: pointer; font-size: 15px; line-height: 1; }
  .photo-grid :global(.ph-actions .star.on) { background: var(--gold); color: var(--white); }
  .photo-grid :global(textarea) { width: 100%; min-height: 56px; resize: vertical; border: 1px solid #e3dccf; border-radius: 8px; padding: 6px 8px; font: inherit; font-size: 13px; }
  .photo-grid :global(.ph-row) { display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 12px; color: #888; }
  .photo-grid :global(.suggest) { border: 0; background: none; color: var(--green); font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; padding: 2px 0; }
  .photo-grid :global(.sortable-ghost) { opacity: 0.4; }

  .panel { background: var(--white); border-left: 1px solid #e8dfd2; padding: 20px; display: flex; flex-direction: column; gap: 14px; font-size: 14px; }
  .panel label { display: flex; flex-direction: column; gap: 5px; font-weight: 600; color: #444; }
  .panel input, .panel select, .panel textarea { font: inherit; font-weight: 400; font-size: 14px; padding: 9px 10px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); color: var(--ink); }
  .panel small { font-weight: 400; color: #888; font-size: 12px; }
  .panel fieldset { border: 1px solid #ece4d7; border-radius: 16px 0; padding: 12px; display: flex; flex-direction: column; gap: 12px; }
  .panel legend { font-weight: 600; color: var(--green); padding: 0 6px; }
  .panel details summary { cursor: pointer; font-weight: 600; color: var(--green); }
  .panel details[open] { display: flex; flex-direction: column; gap: 12px; }
  .count { font-weight: 400; color: #888; font-size: 12px; }
  .count.over { color: #b3261e; }
  .slug-row { display: flex; align-items: center; gap: 2px; font-weight: 400; color: #777; }
  .slug-row input { flex: 1; min-width: 0; }
  .serp { padding: 10px 12px; border-radius: 10px 0; background: #fafafa; font-family: Arial, sans-serif; }
  .serp p { margin: 0; }
  .serp-title { color: #1a0dab; font-size: 17px; line-height: 1.3; }
  .serp-url { color: #006621; font-size: 13px; }
  .serp-desc { color: #545454; font-size: 13px; line-height: 1.45; }
  .panel-status { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; color: #666; }
  .panel-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }

  @media (min-width: 1000px) {
    .editor-wrap { grid-template-columns: minmax(0, 1fr) 360px; }
    .panel { position: sticky; top: 61px; height: calc(100vh - 61px); overflow-y: auto; }
    .editor-wrap.panel-closed { grid-template-columns: minmax(0, 1fr); }
  }
  .editor-wrap.panel-closed .panel { display: none; }
</style>

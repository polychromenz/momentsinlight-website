---
// Moments Studio > Payments > Mileage: the trips behind the IRD kilometre-rate claim, made from
// jobs and appointments (Google driving distances from Tony's base), and the Xero manual journal
// for a period. Data from functions/api/studio/mileage.js (functions-lib/mileage.js).
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Mileage" section="mileage">
  <main class="mi">
    <h1>Mileage</h1>
    <p class="intro">Every wedding, shoot and appointment becomes a return trip from your base, with Google's driving distance. Check the trips, then download the journal for Xero (Accounting › Manual journals › Import).</p>

    <section class="card mi-bar">
      <div class="mi-period">
        <label>Period
          <select name="preset">
            <option value="this-month">This month</option>
            <option value="last-month">Last month</option>
            <option value="this-quarter">This quarter</option>
            <option value="this-half">This GST period (Apr–Sep or Oct–Mar)</option>
            <option value="last-half">Last GST period</option>
            <option value="this-year" selected>This income year (from 1 April)</option>
            <option value="last-year">Last income year</option>
            <option value="custom">Choose dates</option>
          </select>
        </label>
        <label>From <input type="date" name="from" /></label>
        <label>To <input type="date" name="to" /></label>
      </div>
      <p class="mi-total"></p>
      <div class="mi-dl">
        <button type="button" class="s-btn s-btn--solid" data-preview>Check the Xero journal</button>
        <a class="s-btn" data-dl="log" href="#">Download trip log</a>
      </div>
      <div class="mi-notes"></div>
    </section>

    <section class="card">
      <div class="tbl-wrap"><table class="mi-tbl">
        <thead><tr><th>Date</th><th>Trip</th><th class="r">Km (return)</th><th class="r">Claim</th><th></th></tr></thead>
        <tbody><tr><td colspan="5" class="muted">Loading…</td></tr></tbody>
      </table></div>
      <h2>Add a trip</h2>
      <form class="mi-add" autocomplete="off">
        <label>Date <input type="date" name="date" required /></label>
        <label class="grow">What for <input name="purpose" placeholder="e.g. Venue visit, Tui Hills" /></label>
        <label class="grow">Where <input name="destination" placeholder="Start typing a place or address" required /></label>
        <label>Km <small>(return; blank = Google)</small><input name="km" inputmode="decimal" /></label>
        <button type="submit" class="s-btn s-btn--solid">Add</button>
      </form>
    </section>

    <section class="card">
      <h2>Settings</h2>
      <form class="mi-set" autocomplete="off">
        <label class="wide">Your base (where trips start and end; private, never on the website)<input name="base" placeholder="Start typing your address" /></label>
        <label>Vehicle <select name="vehicle"></select></label>
        <label>Expense account code <input name="debit" placeholder="400 Motor Vehicle Expenses" /></label>
        <label>Shareholder account code <input name="credit" placeholder="504 Shareholder Current Account" /></label>
        <label>Tax rate <input name="tax" placeholder="No GST" /></label>
        <label>Tier 1 km a year <small>(the business share of 14,000)</small><input name="tier1_km" inputmode="numeric" /></label>
        <button type="submit" class="s-btn s-btn--solid">Save settings</button>
      </form>
      <p class="muted">IRD's kilometre rate covers all your car's costs, so there's no GST to claim on it. Tier 1 applies to the business share of the car's first 14,000 km each income year (private driving counts towards the 14,000): if about 60% of your driving is for work, set 8,400. Your accountant’s way: debit Motor Vehicle Expenses, credit 504 Shareholder Current Account (the company owes you the claim), No GST.</p>
    </section>
  </main>
  <dialog class="mi-prev" aria-label="Xero journal">
    <div class="mi-prev-in">
      <h2>Xero journal</h2>
      <p class="mi-prev-head"></p>
      <div class="tbl-wrap"><table class="mi-tbl"><thead><tr><th>Description</th><th>Account</th><th>Tax</th><th class="r">Debit</th><th class="r">Credit</th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
      <p class="mi-prev-sent mi-note" hidden></p>
      <p class="muted">Check it matches, then send it to Xero. It arrives as a draft (Accounting › Manual journals › Draft), so you look again and post it there. Or download it and import it in Xero yourself.</p>
      <div class="mi-prev-acts"><button type="button" class="s-btn s-btn--quiet" data-close>Close</button><a class="s-btn" data-dl="journal" href="#">Download</a><button type="button" class="s-btn s-btn--solid" data-send-xero>Send to Xero</button></div>
    </div>
  </dialog>
  <div class="s-toast" role="status"></div>
</StudioLayout>

<script>
  import { ask, askText } from '../../studio/dialogs';
  import { attachAddressLookup } from '../../studio/address-lookup';
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (n: number) => `$${n.toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const day = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  function toast(msg: string, error = false) {
    const t = $('.s-toast'); t.textContent = msg; t.classList.toggle('error', error); t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4500);
  }
  const post = async (body: unknown) => {
    const r = await fetch('/api/studio/mileage', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'That didn’t save. Are you still signed in?');
    return d;
  };
  const from = $<HTMLInputElement>('[name=from]'), to = $<HTMLInputElement>('[name=to]'), preset = $<HTMLSelectElement>('[name=preset]');
  function setPreset() {
    const now = new Date(), y = now.getFullYear(), m = now.getMonth();
    const startYear = m >= 3 ? y : y - 1; // the income year starts on 1 April
    const ranges: Record<string, [Date, Date]> = {
      'this-month': [new Date(y, m, 1), new Date(y, m + 1, 0)],
      'last-month': [new Date(y, m - 1, 1), new Date(y, m, 0)],
      'this-quarter': [new Date(y, m - (m % 3), 1), new Date(y, m - (m % 3) + 3, 0)],
      'this-year': [new Date(startYear, 3, 1), new Date(startYear + 1, 2, 31)],
      'last-year': [new Date(startYear - 1, 3, 1), new Date(startYear, 2, 31)],
      // GST periods: six months, April to September and October to March.
      'this-half': m >= 3 && m < 9 ? [new Date(y, 3, 1), new Date(y, 8, 30)] : [new Date(m >= 9 ? y : y - 1, 9, 1), new Date(m >= 9 ? y + 1 : y, 2, 31)],
      'last-half': m >= 3 && m < 9 ? [new Date(y - 1, 9, 1), new Date(y, 2, 31)] : [new Date(m >= 9 ? y : y - 1, 3, 1), new Date(m >= 9 ? y : y - 1, 8, 30)],
    };
    const r = ranges[preset.value];
    if (r) { from.value = iso(r[0]); to.value = iso(r[1]); }
  }
  let data: any = null;
  async function load() {
    const r = await fetch(`/api/studio/mileage?from=${from.value}&to=${to.value}`);
    data = await r.json().catch(() => null);
    if (!r.ok || !data) { $('.mi-tbl tbody').innerHTML = `<tr><td colspan="5">${esc(data?.error || 'Couldn’t load the trips.')}</td></tr>`; return; }
    draw();
  }
  function draw() {
    const { trips, totals, settings: s, maps } = data;
    $('.mi-total').innerHTML = `<strong>${money(totals.amount)}</strong> for ${totals.km.toLocaleString('en-NZ')} km over ${totals.trips} trip${totals.trips === 1 ? '' : 's'}`;
    const notes: string[] = [];
    if (!maps) notes.push('Google distances aren’t switched on yet (the Google Maps key), so type the km for now.');
    if (!s.base) notes.push('Add your base address in the settings below, and the km fill in.');
    if (!s.debit || !s.credit) notes.push('Add your Xero account codes in the settings before downloading the journal.');
    if (totals.waiting) notes.push(`${totals.waiting} trip${totals.waiting === 1 ? '' : 's'} still need${totals.waiting === 1 ? 's' : ''} km${maps && s.base ? ' (reload in a moment: Google is working them out)' : ''}.`);
    if (totals.provisional) notes.push('IRD hasn’t published this income year’s rates yet (they come out after 31 March), so the latest published rates are used. Download again once they’re out.');
    $('.mi-notes').innerHTML = notes.map((n) => `<p class="mi-note">${esc(n)}</p>`).join('');
    const q = `from=${from.value}&to=${to.value}`;
    $<HTMLAnchorElement>('[data-dl=journal]').href = `/api/studio/mileage?${q}&export=journal`;
    $<HTMLAnchorElement>('[data-dl=log]').href = `/api/studio/mileage?${q}&export=log`;
    $('[data-dl=journal]').classList.toggle('off', !s.debit || !s.credit);
    $('.mi-tbl tbody').innerHTML = trips.length ? trips.map((t: any) => `<tr data-id="${t.id}" class="${t.skip ? 'skip' : ''}">
      <td>${day(t.date)}</td>
      <td><strong>${esc(t.purpose)}</strong><br><span class="muted">${esc(t.destination)}</span>${t.error ? `<br><span class="warn">${esc(t.error)}</span>` : ''}${t.note ? `<br><em class="muted">${esc(t.note)}</em>` : ''}</td>
      <td class="r"><input class="km${t.km_edited ? ' typed' : ''}" value="${t.km ?? ''}" inputmode="decimal" aria-label="Km" title="${t.km_edited ? 'You typed this' : 'From Google'}" ${t.skip ? 'disabled' : ''} /></td>
      <td class="r">${t.amount ? `${money(t.amount)}<br><small class="muted">${t.tier}</small>` : '<span class="muted">–</span>'}</td>
      <td class="acts"><button type="button" class="s-btn s-btn--quiet" data-skip>${t.skip ? 'Include' : 'Skip'}</button>${t.km_edited && t.key ? '<button type="button" class="s-btn s-btn--quiet" data-recalc title="Use Google’s distance again">Google km</button>' : ''}<button type="button" class="s-btn s-btn--quiet" data-note>Note</button>${t.key ? '' : '<button type="button" class="s-btn s-btn--quiet" data-del>Delete</button>'}</td></tr>`).join('')
      : '<tr><td colspan="5" class="muted">No trips in these dates. Weddings and appointments with a venue or place appear here once their day has passed.</td></tr>';
    const f = $<HTMLFormElement>('.mi-set');
    const veh = f.elements.namedItem('vehicle') as HTMLSelectElement;
    if (!veh.options.length) veh.innerHTML = Object.entries(data.vehicles).map(([k, v]) => `<option value="${k}">${esc(v)}</option>`).join('');
    for (const k of ['base', 'vehicle', 'debit', 'credit', 'tax', 'tier1_km']) {
      const el = f.elements.namedItem(k) as HTMLInputElement;
      if (document.activeElement !== el) el.value = String(s[k] ?? '');
    }
  }
  preset.addEventListener('change', () => { if (preset.value !== 'custom') { setPreset(); load(); } });
  for (const el of [from, to]) el.addEventListener('change', () => { preset.value = 'custom'; if (from.value && to.value) load(); });
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-preview]')) {
      if (!data.settings.debit || !data.settings.credit) { toast('Add your Xero account codes in the settings first.', true); return; }
      const j = await fetch(`/api/studio/mileage?from=${from.value}&to=${to.value}&preview=journal`).then((r) => r.json()).catch(() => null);
      if (!j?.lines) { toast('Couldn’t make the journal.', true); return; }
      const dlg = $<HTMLDialogElement>('.mi-prev');
      dlg.querySelector('.mi-prev-head')!.innerHTML = `<strong>${esc(j.narration)}</strong> · dated ${day(j.date)}`;
      dlg.querySelector('tbody')!.innerHTML = j.lines.length ? j.lines.map((l: any) => `<tr><td>${esc(l.description)}</td><td>${esc(l.account)}</td><td>${esc(l.tax)}</td><td class="r">${l.amount > 0 ? money(l.amount) : ''}</td><td class="r">${l.amount < 0 ? money(-l.amount) : ''}</td></tr>`).join('')
        : '<tr><td colspan="5" class="muted">No trips to claim in these dates.</td></tr>';
      dlg.querySelector('tfoot')!.innerHTML = `<tr><th colspan="3">Total</th><th class="r">${money(j.total)}</th><th class="r">${money(j.total)}</th></tr>`;
      const sentNote = dlg.querySelector<HTMLElement>('.mi-prev-sent')!;
      const when = (x: any) => `${day(x.from)} to ${day(x.to)} went to Xero on ${new Date(x.at).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric' })} (${money(x.total)})`;
      sentNote.textContent = j.sent.length ? `Already sent: ${j.sent.map(when).join('; ')}.` : '';
      sentNote.hidden = !j.sent.length;
      const send = dlg.querySelector<HTMLButtonElement>('[data-send-xero]')!;
      send.hidden = !j.xero || !j.lines.length;
      send.title = j.xero ? `To ${j.xero}` : '';
      dlg.showModal();
      return;
    }
    const sendBtn = t.closest<HTMLButtonElement>('[data-send-xero]');
    if (sendBtn) {
      const go = async (again: boolean) => {
        sendBtn.disabled = true; sendBtn.textContent = 'Sending…';
        try { return await post({ action: 'xero', from: from.value, to: to.value, again }); }
        finally { sendBtn.disabled = false; sendBtn.textContent = 'Send to Xero'; }
      };
      try {
        let r = await go(false);
        if (r.already) {
          if (!await ask('Part of these dates has already gone to Xero. Send another journal anyway? (Delete the old one in Xero first if it’s being replaced.)')) return;
          r = await go(true);
        }
        $<HTMLDialogElement>('.mi-prev').close();
        toast(`Sent to Xero as a draft (${money(r.sent.total)}). Post it in Xero: Accounting › Manual journals › Draft.`);
      } catch (err) {
        // Shown in the preview itself: the toast would sit behind the open dialog.
        const n = $('.mi-prev-sent'); n.textContent = (err as Error).message; n.hidden = false;
      }
      return;
    }
    if (t.closest('.mi-prev [data-close]')) { $<HTMLDialogElement>('.mi-prev').close(); return; }
    const dl = t.closest<HTMLAnchorElement>('[data-dl]');
    if (dl && dl.classList.contains('off')) { e.preventDefault(); toast('Add your Xero account codes in the settings first.', true); return; }
    const row = t.closest<HTMLElement>('tr[data-id]');
    if (!row || !t.closest('button')) return;
    const id = Number(row.dataset.id);
    const trip = data.trips.find((x: any) => x.id === id);
    try {
      if (t.closest('[data-skip]')) await post({ action: 'edit', id, skip: !trip.skip });
      if (t.closest('[data-recalc]')) await post({ action: 'recalc', id });
      if (t.closest('[data-note]')) {
        const note = await askText('A note for this trip (e.g. combined with another trip)', trip.note ?? '');
        if (note === null) return;
        await post({ action: 'edit', id, note });
      }
      if (t.closest('[data-del]')) { if (!await ask('Delete this trip?')) return; await post({ action: 'delete', id }); }
      load();
    } catch (err) { toast((err as Error).message, true); }
  });
  document.addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    if (!el.matches('input.km')) return;
    const id = Number(el.closest<HTMLElement>('tr')!.dataset.id);
    try { await post({ action: 'edit', id, km: el.value.trim() }); toast(el.value.trim() ? 'Km saved.' : 'Google will work the km out.'); load(); }
    catch (err) { toast((err as Error).message, true); }
  });
  $<HTMLFormElement>('.mi-add').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    try { await post({ action: 'add', ...Object.fromEntries(new FormData(f)) }); f.reset(); toast('Trip added.'); load(); }
    catch (err) { toast((err as Error).message, true); }
  });
  $<HTMLFormElement>('.mi-set').addEventListener('submit', async (e) => {
    e.preventDefault();
    try { await post({ action: 'settings', ...Object.fromEntries(new FormData(e.target as HTMLFormElement)) }); toast('Settings saved.'); load(); }
    catch (err) { toast((err as Error).message, true); }
  });
  const api = { endpoint: '/api/studio/address' };
  attachAddressLookup($<HTMLInputElement>('.mi-set [name=base]'), api);
  attachAddressLookup($<HTMLInputElement>('.mi-add [name=destination]'), { ...api, onPick: (p, el) => { el.value = p.business && p.name ? `${p.name}, ${p.address}` : p.address; } });
  setPreset();
  load();
</script>

<style is:global>
  .mi-prev { width: min(900px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); border: 0; border-radius: 28px 0; padding: 0; box-shadow: 0 30px 60px -30px rgb(0 0 0 / .5); }
  .mi-prev::backdrop { background: rgb(30 30 20 / .45); }
  .mi-prev-in { padding: 22px 24px; }
  .mi-prev h2 { margin: 0 0 4px; font-weight: 300; font-size: 24px; }
  .mi-prev tfoot th { text-align: left; border-top: 2px solid #ddd3c4; padding-top: 8px; }
  .mi-prev tfoot th.r { text-align: right; }
  .mi-prev td.r, .mi-prev th.r { font-variant-numeric: tabular-nums; }
  .mi-prev-acts { display: flex; justify-content: flex-end; gap: 8px; }
  .mi { max-width: 1100px; margin: 0 auto; padding: 24px clamp(14px, 3vw, 32px) 80px; }
  .mi h1 { margin: 0; font-weight: 300; font-size: 32px; color: var(--ink); }
  .mi .intro { color: #666; margin: 4px 0 14px; max-width: 720px; }
  .mi .card { background: var(--white); border-radius: 24px 0; padding: 18px 22px; margin-bottom: 16px; }
  .mi h2 { margin: 20px 0 8px; font-weight: 300; font-size: 22px; }
  .mi .card > h2:first-child { margin-top: 0; }
  .mi .muted { color: #888; font-size: 14px; }
  .mi .warn { color: #a8432a; font-size: 13px; }
  .mi label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; color: #555; }
  .mi label small { font-weight: 400; color: #888; }
  .mi input, .mi select { font: inherit; font-size: 15px; font-weight: 400; padding: 8px 10px; border: 1px solid #ddd3c4; border-radius: 10px 0; background: var(--white); color: var(--ink); min-width: 0; }
  .mi-bar { display: grid; gap: 10px; }
  .mi-period, .mi-add, .mi-set { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; }
  .mi-add .grow { flex: 1 1 220px; }
  .mi-set label { flex: 1 1 200px; }
  .mi-set .wide { flex: 1 1 100%; }
  .mi-total { margin: 0; font-size: 18px; }
  .mi-total strong { font-weight: 600; color: var(--green); }
  .mi-dl { display: flex; flex-wrap: wrap; gap: 8px; }
  .mi-dl .off { opacity: 0.5; }
  .mi-note { margin: 0; padding: 8px 12px; border-radius: 10px 0; background: #fbf3df; color: #6b5310; font-size: 14px; }
  .mi .tbl-wrap { overflow-x: auto; }
  .mi-tbl { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 680px; }
  .mi-tbl th { text-align: left; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); padding: 8px; border-bottom: 1px solid #ece4d7; }
  .mi-tbl td { padding: 8px; border-bottom: 1px solid #f3eee6; vertical-align: top; }
  .mi-tbl td:first-child { white-space: nowrap; }
  .mi-tbl .r { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mi-tbl input.km { width: 84px; text-align: right; padding: 5px 8px; }
  .mi-tbl input.km.typed { background: #fbf8f2; }
  .mi-tbl .acts { white-space: nowrap; text-align: right; }
  .mi-tbl .acts .s-btn { padding: 4px 8px; font-size: 13px; }
  .mi-tbl tr.skip td { opacity: 0.5; }
</style>

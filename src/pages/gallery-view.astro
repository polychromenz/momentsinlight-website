---
// The client gallery (MIL Galleries 1c). One page for every gallery: functions/_middleware.js
// serves it at galleries.momentsinlight.co.nz/{slug} and momentsinlight.co.nz/g/{slug} (studio
// previews add ?preview=1). Everything shown comes from /api/gallery (functions-lib/gallery-access.js),
// limited by the visitor's link. Photos are laid out in justified rows so nothing is cropped;
// highlights get a row of their own.
import '@fontsource/raleway/300.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/500.css';
import '@fontsource/raleway/600.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { site } from '../data/site';
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Gallery · Moments In Light</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://photos.momentsinlight.co.nz" />
  </head>
  <body class="gv">
    <div class="gv-preview" hidden></div>
    <section class="cover" aria-live="polite">
      <a class="cover-logo" href="https://www.momentsinlight.co.nz/" aria-label="Moments In Light">
        <Image src={site.logo} alt="Moments In Light" widths={[220, 400]} sizes="160px" loading="eager" />
      </a>
      <div class="cover-photo"></div>
      <div class="cover-text">
        <h1 class="names">&nbsp;</h1>
        <p class="when"></p>
        <div class="gate"><p class="muted">Opening your gallery…</p></div>
      </div>
    </section>

    <div class="gallery" hidden>
      <header class="g-bar">
        <a class="g-logo" href="#top" aria-label="Back to the cover"><Image src={site.logo} alt="Moments In Light" widths={[220]} sizes="110px" /></a>
        <nav class="g-sections" aria-label="Sections"></nav>
        <div class="g-actions">
          <button type="button" class="g-btn g-btn--fav" data-lists hidden title="Favourites and lists">♥ <span class="fav-n">0</span></button>
          <button type="button" class="g-btn" data-select hidden>Select</button>
          <button type="button" class="g-btn" data-dl hidden>Download</button>
          <button type="button" class="g-btn" data-play>Slideshow</button>
        </div>
      </header>
      <p class="g-note" hidden></p>
      <p class="g-note g-vendor" hidden>These photos are yours to use on your website and social media, with a credit to <a href="https://www.momentsinlight.co.nz/">Moments in Light</a>. Download any you like.</p>
      <div class="g-filter" hidden></div>
      <main class="g-main"></main>
      <div class="selbar" hidden>
        <strong class="sel-n"></strong>
        <button type="button" class="sb-btn" data-sel-list>Save to list</button>
        <button type="button" class="sb-btn" data-sel-dl hidden>Download</button>
        <button type="button" class="sb-btn" data-sel-hide hidden>Hide</button>
        <button type="button" class="sb-btn" data-sel-unhide hidden>Show again</button>
        <button type="button" class="sb-btn sb-x" data-sel-done aria-label="Stop selecting">✕</button>
      </div>
      <footer class="g-foot">
        <p>Photos by <a href="https://www.momentsinlight.co.nz/">Moments In Light</a> · Tony Gorham · {site.phone}</p>
      </footer>
    </div>

    <div class="lb" hidden role="dialog" aria-modal="true" aria-label="Photo">
      <img class="lb-img" alt="" />
      <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
      <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
      <div class="lb-top">
        <span class="lb-count"></span>
        <span class="lb-tools">
          <button type="button" class="lb-tool lb-fav" data-lb-fav hidden aria-label="Favourite">♡</button>
          <button type="button" class="lb-tool" data-lb-list hidden>Add to list</button>
          <button type="button" class="lb-tool" data-lb-hide hidden>Hide</button>
          <button type="button" class="lb-tool" data-lb-play>Slideshow</button>
          <span class="lb-dl"></span>
          <button type="button" class="lb-tool" data-lb-close aria-label="Close">✕</button>
        </span>
      </div>
    </div>

    <dialog class="g-dlg g-dlg--side" data-lists-dlg aria-label="Favourites and lists"><div class="dlg-body"></div></dialog>
    <dialog class="g-dlg" data-pick-dlg aria-label="Save to a list"><div class="dlg-body"></div></dialog>
    <dialog class="g-dlg" data-dl-dlg aria-label="Download"><div class="dlg-body"></div></dialog>
    <dialog class="g-dlg" data-send-dlg aria-label="Send to Tony"><div class="dlg-body"></div></dialog>
    <div class="g-toast" role="status"></div>
  </body>
</html>

<script>
  import { ask, askText, tell } from '../studio/dialogs';
  type Img = { id: string; s: number; w: number; h: number; hero: number; ch?: number; thumb: string; web: string };
  type List = { id: number; name: string; kind: 'favourites' | 'custom' | 'selection_request'; purpose: string | null; status: string; min: number | null; max: number | null; deadline: string | null; instructions: string; note: string; submitted_at: string | null; ids: string[] };
  type View = {
    gallery: any; cover: any; sections: { id: number; name: string; is_bw: number }[]; images: Img[];
    rights: { downloads: 'none' | 'web' | 'highres'; watermark: boolean; kind: string; lists: boolean; hide: boolean; zip: boolean };
    lists?: List[]; purposes?: Record<string, string>; me?: { name: string; kind: string }; dropbox?: string | null;
    preview?: { status: string; link: string; gallery_id: string };
  };
  const $ = <T extends HTMLElement = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const params = new URLSearchParams(location.search);
  const parts = location.pathname.split('/').filter(Boolean);
  const slug = decodeURIComponent((parts[0] === 'g' ? parts[1] : parts[0]) ?? '');
  const preview = params.get('preview') === '1';
  const store = `mil-gallery-${slug}`;
  const saved = () => { try { return localStorage.getItem(store) ?? ''; } catch { return ''; } };
  const save = (v: string) => { try { v ? localStorage.setItem(store, v) : localStorage.removeItem(store); } catch {} };
  // Tony's "Open as client" pass from the studio (?sv=…): kept like any visitor's, then off the address bar.
  if (params.get('sv')) { save(params.get('sv')!); params.delete('sv'); history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : '')); }
  const day = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  let viewer = '';
  let view: View;
  // Favourites, lists, select mode and the list being viewed (1d). Nothing of this in the studio preview.
  let current: Img[] = [];            // the photos on the page now, in order (what the lightbox steps through)
  let filter = 0;                     // a list being viewed (0 = the whole gallery)
  let selecting = false;
  const selected = new Set<string>();
  const live = () => !!view && !view.preview;
  const lists = () => view.lists ?? [];
  const favList = () => lists().find((l) => l.kind === 'favourites');
  const isFav = (id: string) => !!favList()?.ids.includes(id);
  function toast(msg: string) {
    const t = $('.g-toast'); t.textContent = msg; t.classList.add('show');
    clearTimeout((toast as any).t); (toast as any).t = setTimeout(() => t.classList.remove('show'), 3500);
  }
  async function act(body: Record<string, unknown>) {
    const r = await fetch('/api/gallery/act', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ v: viewer, ...body }) });
    const d = await r.json().catch(() => ({ error: 'Something went wrong. Please try again.' }));
    if (!r.ok) { toast(d.error || 'Something went wrong.'); return null; }
    if (d.lists) view.lists = d.lists;
    return d;
  }

  // ---- Cover and gate ----
  function namesOf(g: any) {
    if (g.spouse_a && g.spouse_b) return `${g.spouse_a} <span class="amp">&amp;</span> ${g.spouse_b}`;
    return esc(g.name);
  }
  function showCover(g: any, cover: any) {
    if (!g) return;
    document.title = `${g.name} · Moments In Light`;
    $('.names').innerHTML = namesOf(g);
    $('.when').textContent = [g.event_date ? day(g.event_date) : '', g.venue].filter(Boolean).join(' · ');
    $('.cover-photo').innerHTML = cover ? `<img src="${esc(cover.web)}" alt="" width="${cover.w}" height="${cover.h}" fetchpriority="high" />` : '';
  }
  function gate(html: string) { $('.gate').innerHTML = html; }

  async function enter(extra: Record<string, unknown> = {}) {
    const r = await fetch('/api/gallery/enter', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug, key: params.get('k') || undefined, viewer: saved() || undefined, ...extra }) });
    const d = await r.json().catch(() => ({ status: 'error' }));
    showCover(d.gallery, d.cover);
    if (d.status === 'in') {
      viewer = d.viewer; save(viewer);
      // The link's key isn't left in the address bar, so a copied address doesn't share the couple's access.
      if (params.has('k')) { params.delete('k'); history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : '')); }
      return load();
    }
    if (d.status === 'gone') return gate('<p>This gallery isn’t available. If you were expecting to see photos here, please <a href="https://www.momentsinlight.co.nz/contact">get in touch with Tony</a>.</p>');
    if (d.status === 'expired') return gate(`<p>This gallery was online until ${d.gallery?.expires_at ? day(d.gallery.expires_at) : 'recently'}.</p><p>To bring it back online, please <a href="https://www.momentsinlight.co.nz/contact">get in touch with Tony</a>.</p>`);
    if (d.status === 'email') {
      gate(`<form class="g-form" data-email>
        <p>Please add your name and email to see the photos.</p>
        <label>Your name <input name="name" autocomplete="name" required /></label>
        <label>Email <input name="email" type="email" autocomplete="email" required /></label>
        <label class="check"><input type="checkbox" name="consent" /> Send me the occasional offer from Moments In Light (you can stop any time)</label>
        ${d.error ? `<p class="err">${esc(d.error)}</p>` : ''}
        <button class="g-cta" type="submit">View the gallery</button></form>`);
      $<HTMLFormElement>('[data-email]').addEventListener('submit', (e) => {
        e.preventDefault();
        const f = new FormData(e.target as HTMLFormElement);
        enter({ key: d.key, name: f.get('name'), email: f.get('email'), consent: !!f.get('consent') });
      });
      return;
    }
    // A private gallery: the visitor needs their link or a code.
    save('');
    gate(`<form class="g-form g-form--code" data-code>
      <p>This gallery is private. Open it with the link you were sent, or enter your access code.</p>
      <div class="row"><input name="code" aria-label="Access code" placeholder="Access code" autocomplete="off" required /><button class="g-cta" type="submit">Open</button></div>
      ${d.error ? `<p class="err">${esc(d.error)}</p>` : ''}</form>`);
    $<HTMLFormElement>('[data-code]').addEventListener('submit', (e) => {
      e.preventDefault();
      params.delete('k');
      enter({ key: undefined, viewer: undefined, code: new FormData(e.target as HTMLFormElement).get('code') });
    });
  }

  async function load() {
    const r = await fetch(preview ? `/api/studio/galleries/preview?slug=${encodeURIComponent(slug)}${params.get('link') ? `&link=${params.get('link')}` : ''}` : `/api/gallery/view?v=${viewer}`);
    if (r.status === 401 && !preview) { save(''); viewer = ''; return enter(); }
    if (!r.ok) return gate('<p>Something went wrong opening the gallery. Please reload the page.</p>');
    view = await r.json();
    showCover(view.gallery, view.cover);
    $('[data-lists]').hidden = !(live() && view.rights.lists);
    $('[data-select]').hidden = !(live() && (view.rights.lists || view.rights.zip || view.rights.hide));
    $('[data-dl]').hidden = !(live() && view.rights.zip);
    $('.g-vendor').hidden = view.rights.kind !== 'vendor';
    gate(`<a class="g-cta" href="#photos">View the gallery</a>`);
    if (view.preview) {
      const p = $('.gv-preview');
      p.hidden = false;
      p.innerHTML = `Preview${view.preview.link ? ` as “${esc(view.preview.link)}”` : ''}${view.preview.status !== 'online' ? ` · this gallery is <strong>${esc(view.preview.status)}</strong>, so clients can’t see it yet` : ''}${view.rights.watermark ? ' · this link’s visitors see your monogram on each photo' : ''}`;
    }
    const exp = view.gallery.expires_at;
    if (exp && !preview) {
      const days = Math.round((Date.parse(`${exp}T12:00:00Z`) - Date.now()) / 86400000);
      if (days <= 30) { const n = $('.g-note'); n.hidden = false; n.textContent = `This gallery is online until ${day(exp)}. Download your favourites before then.`; }
    }
    $('.gallery').hidden = false;
    draw();
    if (location.hash === '#photos') $('.gallery').scrollIntoView();
  }

  // ---- The photos: justified rows (nothing cropped). A highlight is shown big with two photos
  //      stacked beside it (sides alternate), sized so every photo fits whole. ----
  let GAP = 14;
  const thumbW = (i: Img) => (i.w >= i.h ? Math.min(600, i.w) : Math.round((Math.min(600, i.h) * i.w) / i.h));
  const webW = (i: Img) => (i.w >= i.h ? Math.min(2048, i.w) : Math.round((Math.min(2048, i.h) * i.w) / i.h));
  const ar = (i: Img) => i.w / i.h;
  // Preview's size buttons: arrows pointing out (show it big) or in (back to normal), which nudge
  // that way when hovered.
  const arrows = (a: string, b: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="ar ar--a" d="${a}"/><path class="ar ar--b" d="${b}"/></svg>`;
  const GROW = `<span class="sz sz--grow">${arrows('M14 4h6v6M20 4l-6.5 6.5', 'M10 20H4v-6M4 20l6.5-6.5')}</span>`;
  const SHRINK = `<span class="sz sz--shrink">${arrows('M14 4.5V10h5.5M20 4l-6 6', 'M10 19.5V14H4.5M4 20l6-6')}</span>`;
  function tile(i: Img, w: number, h: number) {
    const n = current.indexOf(i);
    const tools = live() ? `<span class="ph-tools">${view.rights.lists ? `<span class="pt pt-fav${isFav(i.id) ? ' on' : ''}" data-fav="${i.id}" role="button" tabindex="0" aria-label="Favourite">${isFav(i.id) ? '♥' : '♡'}</span>` : ''}${view.rights.hide ? `<span class="pt" data-hide="${i.id}" role="button" tabindex="0" title="${i.ch ? 'Show it again' : 'Hide it from anyone you share with'}">${i.ch ? '◉' : '⊘'}</span>` : ''}</span>` : '';
    return `<button type="button" class="ph${i.ch ? ' ph--hidden' : ''}${selected.has(i.id) ? ' sel' : ''}" data-n="${n}" data-id="${i.id}" style="width:${w}px;height:${h}px" aria-label="Open photo ${n + 1}">${selecting ? '<span class="ph-tick" aria-hidden="true">✓</span>' : ''}${i.ch ? '<span class="ph-hid">Hidden</span>' : ''}${tools}
      <img src="${esc(i.thumb)}" srcset="${esc(i.thumb)} ${thumbW(i)}w, ${esc(i.web)} ${webW(i)}w" sizes="${Math.ceil(w)}px" width="${Math.round(w)}" height="${Math.round(h)}" alt="" loading="lazy" decoding="async" />${view.preview ? `<span class="ph-star" data-star="${i.id}" role="button" tabindex="0" title="${i.hero ? 'Make it normal size' : 'Show it big (a highlight)'}">${i.hero ? SHRINK : GROW}</span>` : ''}</button>`;
  }
  function rows(list: Img[], width: number) {
    const phone = width < 600;
    const target = phone ? 200 : width < 1100 ? 300 : 400;
    const out: string[] = [];
    let row: Img[] = [];
    let side = 0;
    const line = (items: Img[], h: number, cls = '') => `<div class="row${cls}" style="gap:${GAP}px;margin-bottom:${GAP}px">${items.map((i) => tile(i, h * ar(i), h)).join('')}</div>`;
    const fill = (items: Img[]) => (width - GAP * (items.length - 1)) / items.reduce((a, i) => a + ar(i), 0);
    const cap = target * 1.6;
    // The last full row of plain photos, so a few left over can share it rather than leave a gap.
    let prev: { items: Img[]; at: number } | null = null;
    const flush = (last: boolean) => {
      if (!row.length) return;
      const full = fill(row);
      if (!last || full <= cap) {
        if (!last) prev = { items: row, at: out.length };
        out.push(line(row, full));
        row = [];
        return;
      }
      // Too few photos left to fill the width: split them and the row above into two rows that both
      // fill it, at the heights nearest the usual.
      if (prev) {
        const all = [...prev.items, ...row];
        let best = 0, score = Infinity;
        for (let s = 1; s < all.length; s++) {
          const a = fill(all.slice(0, s)), b = fill(all.slice(s));
          if (a > cap || b > cap) continue;
          const sc = Math.log(a / target) ** 2 + Math.log(b / target) ** 2;
          if (sc < score) { score = sc; best = s; }
        }
        if (best) {
          out[prev.at] = line(all.slice(0, best), fill(all.slice(0, best)));
          out.push(line(all.slice(best), fill(all.slice(best))));
          row = [];
          prev = null;
          return;
        }
      }
      // Still not enough (a section of only a few photos): they start at the left like the rows above.
      out.push(line(row, Math.min(target, full), ' row--end'));
      row = [];
    };
    for (let n = 0; n < list.length; n++) {
      const i = list[n];
      if (!i.hero) {
        row.push(i);
        if (row.reduce((a, x) => a + ar(x), 0) * target + GAP * (row.length - 1) >= width) flush(false);
        continue;
      }
      // Two photos to stack beside the highlight: a single waiting photo, then the next ones.
      const stack: Img[] = [];
      if (!phone) {
        if (row.length === 1) stack.push(row.pop()!);
        else if (row.length > 1) flush(true);
        prev = null;
        while (stack.length < 2 && n + 1 < list.length && !list[n + 1].hero) stack.push(list[++n]);
      } else { flush(true); prev = null; }
      if (stack.length === 2) {
        // Highlight width a·H, stack width c where c/b1 + c/b2 + gap = H, and a·H + gap + c = width.
        const k = 1 / ar(stack[0]) + 1 / ar(stack[1]);
        const H = Math.min((width - GAP + GAP / k) / (ar(i) + 1 / k), innerHeight * 0.9);
        const c = (H - GAP) / k;
        const big = tile(i, ar(i) * H, H);
        const col = `<div class="stack" style="gap:${GAP}px">${stack.map((s) => tile(s, c, c / ar(s))).join('')}</div>`;
        out.push(`<div class="row row--block" style="gap:${GAP}px;margin-bottom:${GAP}px;justify-content:center">${side++ % 2 ? col + big : big + col}</div>`);
      } else if (stack.length === 1) {
        // Only one photo to go with the highlight (e.g. two highlights in a row): side by side at the
        // same height, filling the width together, rather than a lone photo with a gap beside it.
        const H = Math.min((width - GAP) / (ar(i) + ar(stack[0])), innerHeight * 0.9);
        out.push(line(side++ % 2 ? [stack[0], i] : [i, stack[0]], H, ' row--block'));
      } else {
        row.push(...stack);
        flush(true);
        const h = Math.min(width / ar(i), innerHeight * 0.85, i.h);
        out.push(line([i], h, ' row--hero'));
      }
    }
    flush(true);
    return out.join('');
  }
  function draw() {
    const main = $('.g-main');
    // The space inside the side padding, a hair under so rounding never makes a row too wide.
    const cs = getComputedStyle(main);
    const width = Math.floor((main.clientWidth || innerWidth) - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight)) - 1;
    GAP = width < 600 ? 6 : width < 1100 ? 10 : 14;
    const multi = view.sections.length > 1;
    // Viewing one list: only its photos.
    const fl = filter ? lists().find((l) => l.id === filter) : null;
    if (filter && !fl) filter = 0;
    current = fl ? view.images.filter((i) => fl.ids.includes(i.id)) : view.images;
    drawFilter(fl);
    drawCounts();
    main.classList.toggle('selecting', selecting);
    main.innerHTML = view.sections.map((s) => {
      const list = current.filter((i) => i.s === s.id);
      return list.length ? `<section class="g-sec" id="s${s.id}" data-sec="${s.id}">${multi ? `<h2>${esc(s.name)}</h2>` : ''}${rows(list, width)}</section>` : '';
    }).join('') || `<p class="muted center">${fl ? 'No photos in this list yet. Tap ♡ on a photo, or use Select to add several.' : 'No photos here yet.'}</p>`;
    const used = view.sections.filter((s) => current.some((i) => i.s === s.id));
    $('.g-sections').innerHTML = multi ? `<div class="sec-list">${used.map((s) => `<a href="#s${s.id}" data-to="${s.id}">${esc(s.name)}</a>`).join('')}</div><details class="more" hidden><summary>More ▾</summary><div class="more-list"></div></details>` : `<span class="g-title">${esc(view.gallery.name)}</span>`;
    fitNav();
    watch();
  }
  // Sections that don't fit in the bar go under "More".
  function fitNav() {
    const list = document.querySelector<HTMLElement>('.sec-list');
    if (!list) return;
    const more = $<HTMLDetailsElement>('.more');
    const links = [...list.children] as HTMLElement[];
    links.forEach((a) => (a.hidden = false));
    more.hidden = true;
    $('.more-list').innerHTML = '';
    if (list.scrollWidth <= list.clientWidth + 1) return;
    more.hidden = false;
    for (let n = links.length - 1; n > 0 && list.scrollWidth > list.clientWidth + 1; n--) links[n].hidden = true;
    $('.more-list').innerHTML = links.filter((a) => a.hidden).map((a) => a.outerHTML.replace(' hidden=""', '')).join('');
  }
  let spy: IntersectionObserver | undefined;
  function watch() {
    spy?.disconnect();
    spy = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) document.querySelectorAll('[data-to]').forEach((a) => a.classList.toggle('on', a.getAttribute('data-to') === (e.target as HTMLElement).dataset.sec));
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('.g-sec').forEach((s) => spy!.observe(s));
  }
  let resizeT = 0;
  let lastW = innerWidth;
  addEventListener('resize', () => {
    if (!view || innerWidth === lastW) return;
    lastW = innerWidth;
    clearTimeout(resizeT);
    resizeT = window.setTimeout(draw, 150);
  });

  // ---- Lightbox and slideshow ----
  const lb = $('.lb');
  let at = 0;
  let playing = 0;
  function show(n: number) {
    const list = current;
    if (!list.length) return close();
    at = (n + list.length) % list.length;
    const i = list[at];
    const fav = $('[data-lb-fav]');
    fav.hidden = !(live() && view.rights.lists);
    fav.textContent = isFav(i.id) ? '♥' : '♡';
    fav.classList.toggle('on', isFav(i.id));
    $('[data-lb-list]').hidden = !(live() && view.rights.lists);
    const hide = $('[data-lb-hide]');
    hide.hidden = !(live() && view.rights.hide);
    hide.textContent = i.ch ? 'Show again' : 'Hide';
    const img = $<HTMLImageElement>('.lb-img');
    img.src = i.web;
    $('.lb-count').textContent = `${at + 1} / ${list.length}`;
    const dl = (size: string, label: string) => `<a class="lb-tool" href="/api/gallery/download?v=${viewer}&id=${i.id}&size=${size}" download>${label}</a>`;
    $('.lb-dl').innerHTML = preview || view.rights.downloads === 'none' ? '' : view.rights.downloads === 'highres' && !view.rights.watermark ? dl('original', 'Download') + dl('web', 'Web size') : dl('web', 'Download');
    // Load the next one ahead.
    const next = list[(at + 1) % list.length];
    if (next) new Image().src = next.web;
  }
  function open(n: number) { lb.hidden = false; document.body.classList.add('lb-open'); show(n); }
  function close() { lb.hidden = true; document.body.classList.remove('lb-open'); stop(); }
  function play() { if (lb.hidden) open(0); playing = window.setInterval(() => show(at + 1), 4000); $('[data-lb-play]').textContent = 'Pause'; }
  function stop() { clearInterval(playing); playing = 0; $('[data-lb-play]').textContent = 'Slideshow'; }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    // Preview only: the expand button makes a photo a highlight (or normal again), saved straight away.
    const star = t.closest<HTMLElement>('[data-star]');
    if (star && view.preview) {
      e.stopPropagation();
      const img = view.images.find((x) => x.id === star.dataset.star)!;
      const before = star.closest('.ph')!.getBoundingClientRect().top;
      fetch('/api/studio/galleries/photos', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ gallery_id: view.preview.gallery_id, ids: [img.id], set: { is_hero: img.hero ? 0 : 1 } }) })
        .then((r) => { if (!r.ok) throw new Error(); img.hero = img.hero ? 0 : 1; draw();
          // Keep that photo where it was on screen.
          const again = document.querySelector<HTMLElement>(`[data-star="${img.id}"]`)?.closest('.ph');
          if (again) { scrollBy(0, again.getBoundingClientRect().top - before); again.classList.add(img.hero ? 'ph--grew' : 'ph--shrank'); } })
        .catch(() => tell('Couldn’t save that. Are you still signed in to the studio?'));
      return;
    }
    if (live() && onClick(t, e)) return;
    const ph = t.closest<HTMLElement>('.ph');
    if (ph) return open(Number(ph.dataset.n));
    if (t.closest('[data-play]')) return play();
    if (t.closest('[data-lb-play]')) return playing ? stop() : play();
    if (t.closest('[data-lb-close]') || t === lb) return close();
    if (t.closest('.lb-prev')) { stop(); return show(at - 1); }
    if (t.closest('.lb-next')) { stop(); return show(at + 1); }
    if (t.closest('.more-list a')) (t.closest('details') as HTMLDetailsElement).open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') { stop(); show(at + 1); }
    else if (e.key === 'ArrowLeft') { stop(); show(at - 1); }
    else if (e.key === ' ') { e.preventDefault(); playing ? stop() : play(); }
  });
  let touchX = 0;
  lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) { stop(); show(at + (dx < 0 ? 1 : -1)); }
  });
  // Photos can't be dragged out or right-click saved (downloads go through the Download button).
  document.addEventListener('contextmenu', (e) => { if ((e.target as HTMLElement).closest('.ph, .lb-img, .cover-photo')) e.preventDefault(); });

  // ---- Favourites, lists, select mode, hiding and downloads (1d) ----
  const plural = (n: number, w = 'photo') => `${n} ${w}${n === 1 ? '' : 's'}`;
  const dlg = (name: string) => $<HTMLDialogElement>(`[data-${name}-dlg]`);
  function openDlg(name: string, html: string) {
    const d = dlg(name);
    $('.dlg-body', d).innerHTML = `<button type="button" class="dlg-x" data-close-dlg aria-label="Close">✕</button>${html}`;
    if (!d.open) d.showModal();
  }
  const closeDlgs = () => document.querySelectorAll<HTMLDialogElement>('.g-dlg[open]').forEach((d) => d.close());
  let shownN = 0; // photos selected when the bar was last drawn
  function drawCounts() {
    $('.fav-n').textContent = String(favList()?.ids.length ?? 0);
    const n = selected.size;
    const bar = $('.selbar');
    // Make the bar hard to miss: it slides up when selecting starts, and pops with a little heart
    // floating up each time a photo is picked.
    const nudge = (c: string) => { bar.classList.remove('sb-in', 'sb-pop'); void bar.offsetWidth; bar.classList.add(c); };
    if (selecting && bar.hidden) nudge('sb-in');
    else if (selecting && n > shownN) {
      nudge('sb-pop');
      const h = document.createElement('span');
      h.className = 'sb-heart'; h.textContent = '♥'; h.setAttribute('aria-hidden', 'true');
      h.style.left = `${30 + Math.random() * 40}%`;
      bar.append(h);
      h.addEventListener('animationend', () => h.remove());
      setTimeout(() => h.remove(), 1500);
    }
    shownN = n;
    bar.hidden = !selecting;
    $('.sel-n').textContent = n ? `${plural(n)} selected` : 'Tap photos to select them';
    $('[data-sel-dl]').hidden = !view.rights.zip || !n;
    const picked = view.images.filter((i) => selected.has(i.id));
    $('[data-sel-hide]').hidden = !view.rights.hide || !picked.some((i) => !i.ch);
    $('[data-sel-unhide]').hidden = !view.rights.hide || !picked.some((i) => i.ch);
    ($('[data-sel-list]') as HTMLButtonElement).disabled = !n;
    ($('[data-select]')).textContent = selecting ? 'Done' : 'Select';
  }
  function drawFilter(fl: List | null | undefined) {
    const f = $('.g-filter');
    f.hidden = !fl;
    if (!fl) return;
    f.innerHTML = `<span>Showing <strong>${esc(fl.name)}</strong> · ${plural(fl.ids.length)}</span>
      ${view.rights.zip && fl.ids.length ? `<button type="button" class="g-btn" data-dl-list="${fl.id}">Download</button>` : ''}
      <button type="button" class="g-btn" data-lists>All lists</button><button type="button" class="g-btn" data-show-all>Show every photo</button>`;
  }
  function listCard(l: List) {
    const n = l.ids.length;
    const locked = l.status !== 'open';
    const req = l.kind === 'selection_request';
    const range = req ? [l.min && l.max ? `Choose ${l.min} to ${l.max}` : l.min ? `Choose at least ${l.min}` : l.max ? `Choose up to ${l.max}` : '', l.deadline ? `by ${day(l.deadline)}` : ''].filter(Boolean).join(' ') : '';
    return `<li class="lc${req ? ' lc--req' : ''}">
      <div class="lc-top"><strong>${l.kind === 'favourites' ? '♥ ' : ''}${esc(l.name)}</strong><span>${plural(n)}${req && l.max ? ` of ${l.max}` : ''}</span></div>
      ${range ? `<p class="lc-req">${esc(range)}</p>` : ''}${req && l.instructions ? `<p class="lc-ins">${esc(l.instructions)}</p>` : ''}
      ${locked ? `<p class="lc-sent">Sent to Tony${l.submitted_at ? ` on ${day(l.submitted_at.slice(0, 10))}` : ''}${l.purpose && view.purposes?.[l.purpose] ? ` (${esc(view.purposes[l.purpose])})` : ''}.</p>` : ''}
      <div class="lc-btns">
        <button type="button" data-view-list="${l.id}">View</button>
        ${view.rights.zip && n ? `<button type="button" data-dl-list="${l.id}">Download</button>` : ''}
        ${n && !req ? `<button type="button" data-share-list="${l.id}">Share</button>` : ''}
        ${!locked && n ? `<button type="button" data-send-list="${l.id}">Send to Tony</button>` : ''}
        ${l.kind === 'custom' && !locked ? `<button type="button" data-rename-list="${l.id}">Rename</button><button type="button" data-del-list="${l.id}">Delete</button>` : ''}
      </div></li>`;
  }
  function listsPanel() {
    openDlg('lists', `<h2>Favourites &amp; lists</h2>
      <p class="dlg-hint">Tap ♡ on any photo to make it a favourite. Make lists for anything (“For Mum”, “Album picks”), share them, download them, or send one to Tony.</p>
      <ul class="lc-list">${lists().map(listCard).join('') || '<li class="muted">No favourites yet.</li>'}</ul>
      <form class="new-list" data-new-list><input name="name" placeholder="New list name, e.g. For Mum" maxlength="60" required /><button class="g-cta" type="submit">Add list</button></form>`);
  }
  let picking: string[] = [];
  function pickList(ids: string[]) {
    picking = ids;
    const open = lists().filter((l) => l.status === 'open');
    openDlg('pick', `<h2>Save ${plural(ids.length)} to a list</h2>
      <div class="pick">${open.map((l) => `<button type="button" data-pick="${l.id}">${l.kind === 'favourites' ? '♥ ' : ''}${esc(l.name)} <small>${plural(l.ids.length)}</small></button>`).join('')}</div>
      <form class="new-list" data-new-list data-with-pick><input name="name" placeholder="Or a new list, e.g. Album picks" maxlength="60" required /><button class="g-cta" type="submit">Make it</button></form>`);
  }
  function downloadDlg(what: string, label: string) {
    const link = (size: string) => `/api/gallery/zip?v=${encodeURIComponent(viewer)}&what=${encodeURIComponent(what)}&size=${size}`;
    const full = view.rights.downloads === 'highres';
    const secs = what === 'all' && view.sections.length > 1 ? view.sections.filter((s) => current.some((i) => i.s === s.id)) : [];
    openDlg('dl', `<h2>Download ${esc(label)}</h2>
      <div class="dl-opts">${full ? `<a class="g-cta" href="${link('original')}" download>Full size <small>for printing</small></a>` : ''}<a class="g-cta g-cta--quiet" href="${link('web')}" download>Web size <small>for phones and sharing</small></a></div>
      ${secs.length ? `<p class="dlg-hint">On a slow connection? Download one section at a time:</p><div class="dl-secs">${secs.map((s) => `<a href="/api/gallery/zip?v=${encodeURIComponent(viewer)}&what=section:${s.id}&size=${full ? 'original' : 'web'}" download>${esc(s.name)}</a>`).join('')}</div>` : ''}
      ${view.dropbox ? `<p class="dlg-hint">Or straight into your Dropbox, without using your phone or computer’s download:</p><div class="dl-opts"><button type="button" class="g-cta g-cta--quiet" data-dropbox="${esc(link(full ? 'original' : 'web'))}" data-name="${esc(`${view.gallery.name} - ${label}`)}">Save to Dropbox</button></div>` : ''}
      <p class="dlg-hint">Your photos come as one ZIP file with a print release. A whole gallery can be large and take a while: keep this page open until it finishes.</p>`);
  }
  // "Save to Dropbox" (Dropbox's Saver): Dropbox fetches the ZIP from here into the person's Dropbox.
  function loadDropbox(): Promise<any> {
    const w = window as any;
    if (w.Dropbox) return Promise.resolve(w.Dropbox);
    return new Promise((ok, fail) => {
      const sc = document.createElement('script');
      sc.src = 'https://www.dropbox.com/static/api/2/dropins.js';
      sc.id = 'dropboxjs';
      sc.dataset.appKey = view.dropbox!;
      sc.onload = () => ok(w.Dropbox);
      sc.onerror = () => fail(new Error('Dropbox didn’t load.'));
      document.head.append(sc);
    });
  }
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dropbox]');
    if (!b) return;
    b.disabled = true;
    try {
      const Dropbox = await loadDropbox();
      const name = `${(b.dataset.name || 'Photos').replace(/[\\/:*?"<>|]+/g, ' ').trim()}.zip`;
      Dropbox.save(new URL(b.dataset.dropbox!, location.href).toString(), name, {
        success: () => { toast('Saved to your Dropbox.'); b.disabled = false; },
        progress: () => {},
        cancel: () => { b.disabled = false; },
        error: (msg: string) => { toast(`Dropbox couldn’t save it (${msg}). Try downloading instead.`); b.disabled = false; },
      });
      toast('Dropbox is saving your photos in the background. You can close this page once it says it’s started.');
    } catch (err) { toast((err as Error).message); b.disabled = false; }
  });
  function sendDlg(l: List) {
    const p = view.purposes ?? {};
    openDlg('send', `<h2>Send “${esc(l.name)}” to Tony</h2>
      <p class="dlg-hint">${plural(l.ids.length)}. Once it’s sent the list is locked so Tony sees exactly what you chose; he can reopen it for you.</p>
      <form class="g-form" data-send="${l.id}">
        <label>What’s it for? <select name="purpose">${Object.entries(p).map(([k, v]) => `<option value="${k}"${(l.purpose ?? 'album') === k ? ' selected' : ''}>${esc(v)}</option>`).join('')}</select></label>
        <label>A note for Tony (optional) <textarea name="note" rows="3"></textarea></label>
        <button class="g-cta" type="submit">Send to Tony</button></form>`);
  }
  function refreshAfter() {
    draw();
    if (dlg('lists').open) listsPanel();
    if (!lb.hidden) show(at);
  }
  async function setFav(id: string, on: boolean) {
    if (await act({ action: 'fav', id, on })) { refreshAfter(); toast(on ? 'Added to your favourites.' : 'Taken out of your favourites.'); }
  }
  async function setHidden(ids: string[], hidden: boolean) {
    if (!(await act({ action: 'hide', ids, hidden }))) return;
    for (const i of view.images) if (ids.includes(i.id)) i.ch = hidden ? 1 : 0;
    refreshAfter();
    toast(hidden ? `${plural(ids.length)} hidden. Anyone you share the gallery with won’t see ${ids.length === 1 ? 'it' : 'them'}.` : `${plural(ids.length)} showing again.`);
  }

  /** Clicks for all of the above. Returns true when handled. */
  function onClick(t: HTMLElement, e: Event): boolean {
    const id = (sel: string) => t.closest<HTMLElement>(sel);
    let x: HTMLElement | null;
    if ((x = id('[data-fav]'))) { e.stopPropagation(); setFav(x.dataset.fav!, !isFav(x.dataset.fav!)); return true; }
    if ((x = id('[data-hide]'))) { e.stopPropagation(); const i = view.images.find((y) => y.id === x!.dataset.hide)!; setHidden([i.id], !i.ch); return true; }
    if (selecting && (x = id('.ph'))) {
      const pid = x.dataset.id!;
      selected.has(pid) ? selected.delete(pid) : selected.add(pid);
      x.classList.toggle('sel', selected.has(pid));
      drawCounts();
      return true;
    }
    if (id('[data-select]')) { selecting = !selecting; if (!selecting) selected.clear(); draw(); return true; }
    if (id('[data-sel-done]')) { selecting = false; selected.clear(); draw(); return true; }
    if (id('[data-sel-list]')) { if (selected.size) pickList([...selected]); return true; }
    if (id('[data-sel-dl]')) {
      if (selected.size > 300) toast('That’s a lot of photos: save them to a list, then download the list.');
      else downloadDlg(`ids:${[...selected].join(',')}`, plural(selected.size));
      return true;
    }
    if (id('[data-sel-hide]')) { setHidden([...selected], true); return true; }
    if (id('[data-sel-unhide]')) { setHidden([...selected], false); return true; }
    if (id('[data-lists]')) { listsPanel(); return true; }
    if (id('[data-dl]')) { downloadDlg('all', 'all your photos'); return true; }
    if (id('[data-show-all]')) { filter = 0; draw(); return true; }
    if (id('[data-lb-fav]')) { const i = current[at]; setFav(i.id, !isFav(i.id)); return true; }
    if (id('[data-lb-list]')) { pickList([current[at].id]); return true; }
    if (id('[data-lb-hide]')) { const i = current[at]; setHidden([i.id], !i.ch); return true; }
    if (id('[data-close-dlg]')) { (t.closest('dialog') as HTMLDialogElement).close(); return true; }
    if ((x = id('[data-view-list]'))) {
      filter = Number(x.dataset.viewList); closeDlgs(); if (!lb.hidden) close(); draw();
      $('.gallery').scrollIntoView({ behavior: 'smooth' });
      return true;
    }
    if ((x = id('[data-dl-list]'))) { const l = lists().find((y) => y.id === Number(x!.dataset.dlList))!; downloadDlg(`list:${l.id}`, `“${l.name}”`); return true; }
    if ((x = id('[data-send-list]'))) { sendDlg(lists().find((y) => y.id === Number(x!.dataset.sendList))!); return true; }
    if ((x = id('[data-share-list]'))) {
      act({ action: 'list-share', list_id: Number(x.dataset.shareList) }).then(async (d) => {
        if (!d) return;
        try { await navigator.clipboard.writeText(d.url); toast('Link copied. Anyone with it sees only the photos in this list.'); }
        catch { await askText('Copy this link to share the list:', d.url); }
      });
      return true;
    }
    if ((x = id('[data-rename-list]'))) {
      const l = lists().find((y) => y.id === Number(x!.dataset.renameList))!;
      askText('List name:', l.name).then((name) => { if (name?.trim()) act({ action: 'list-rename', list_id: l.id, name }).then((d) => d && refreshAfter()); });
      return true;
    }
    if ((x = id('[data-del-list]'))) {
      const l = lists().find((y) => y.id === Number(x!.dataset.delList))!;
      ask(`Delete the list “${l.name}”? The photos stay in the gallery.`).then((yes) => { if (yes) act({ action: 'list-delete', list_id: l.id }).then((d) => { if (d) { if (filter === l.id) filter = 0; refreshAfter(); } }); });
      return true;
    }
    if ((x = id('[data-pick]'))) {
      const l = lists().find((y) => y.id === Number(x!.dataset.pick))!;
      act({ action: 'list-add', list_id: l.id, ids: picking }).then((d) => {
        if (!d) return;
        dlg('pick').close(); toast(`Saved to “${l.name}”.`);
        if (selecting) { selecting = false; selected.clear(); }
        refreshAfter();
      });
      return true;
    }
    return false;
  }
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    if (f.matches('[data-new-list]')) {
      e.preventDefault();
      const name = String(new FormData(f).get('name') ?? '').trim();
      const withPick = f.hasAttribute('data-with-pick');
      act({ action: 'list-new', name, ids: withPick ? picking : [] }).then((d) => {
        if (!d) return;
        if (withPick) { dlg('pick').close(); toast(`Saved to “${name}”.`); if (selecting) { selecting = false; selected.clear(); } }
        refreshAfter();
      });
    }
    if (f.matches('[data-send]')) {
      e.preventDefault();
      const fd = new FormData(f);
      act({ action: 'list-send', list_id: Number(f.dataset.send), purpose: fd.get('purpose'), note: fd.get('note') }).then((d) => {
        if (!d) return;
        dlg('send').close(); toast('Sent. Tony will be in touch.'); refreshAfter();
      });
    }
  });
  // Clicking the dim area outside a panel closes it.
  document.querySelectorAll<HTMLDialogElement>('.g-dlg').forEach((d) => d.addEventListener('click', (e) => { if (e.target === d) d.close(); }));

  if (!slug) gate('<p>This gallery isn’t available.</p>');
  else if (preview) load();
  else enter();
</script>

<style is:global>
  .gv { margin: 0; background: var(--white); color: var(--ink); font-family: var(--font); }
  .gv .muted { color: #777; }
  .gv .center { text-align: center; }
  .gv-preview { position: sticky; top: 0; z-index: 60; padding: 8px 16px; background: var(--olive); color: var(--cream); font-size: 13px; text-align: center; }
  .gv [hidden] { display: none !important; }

  /* Cover: the logo, the cover photo in full (never cropped), names in spaced capitals, the date. */
  .cover { min-height: 100svh; display: flex; flex-direction: column; align-items: center; gap: clamp(14px, 3vh, 28px); padding: clamp(16px, 3vh, 32px) 16px clamp(28px, 5vh, 56px); background: var(--griseo); box-sizing: border-box; }
  .cover-logo { line-height: 0; }
  .cover-logo img { height: clamp(46px, 7vh, 72px); width: auto; }
  .cover-photo { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; width: 100%; }
  .cover-photo img { max-width: min(100%, 1400px); max-height: 62svh; width: auto; height: auto; display: block; box-shadow: 0 24px 50px -30px rgb(0 0 0 / 0.5); animation: gv-in 1.2s var(--ease) both; }
  .cover-text { text-align: center; max-width: 640px; }
  .names { margin: 0; font-weight: 300; font-size: clamp(24px, 4.2vw, 44px); letter-spacing: 0.32em; text-transform: uppercase; line-height: 1.35; padding-left: 0.32em; }
  .names .amp { letter-spacing: 0; text-transform: none; font-size: 0.8em; color: var(--green); }
  .when { margin: 8px 0 18px; font-size: 13px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green); }
  .gate p { margin: 0 0 12px; line-height: 1.6; }
  .gate a { color: var(--green); }
  .g-cta { display: inline-block; padding: 13px 30px; border: 0; border-radius: 14px 0; background: var(--green); color: var(--white) !important; font: inherit; font-size: 13px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: border-radius 0.4s var(--ease), background-color 0.3s var(--ease); }
  .g-cta:hover { border-radius: 0 14px; background: var(--green-dark); }
  .g-form { display: grid; gap: 12px; text-align: left; max-width: 420px; margin: 0 auto; }
  .g-form label { display: grid; gap: 4px; font-size: 13px; font-weight: 600; color: #555; }
  .g-form input:not([type='checkbox']) { font: inherit; font-size: 16px; padding: 11px 13px; border: 1px solid #cfd4c6; border-radius: 10px 0; background: var(--white); }
  .g-form .check { display: flex; gap: 8px; align-items: flex-start; font-weight: 400; }
  .g-form .row { display: flex; gap: 8px; }
  .g-form .row input { flex: 1; min-width: 0; text-transform: none; }
  .g-form .err { color: #a8432a; margin: 0; }
  .g-form button { justify-self: start; }
  .g-form--code { text-align: center; }

  /* The gallery */
  .g-bar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 14px; padding: 8px clamp(10px, 2vw, 24px); background: rgb(255 255 255 / 0.96); backdrop-filter: blur(6px); border-bottom: 1px solid #ecebe6; }
  .gv-preview:not([hidden]) ~ .gallery .g-bar { top: 34px; }
  .g-logo { line-height: 0; flex: none; }
  .g-logo img { height: 34px; width: auto; }

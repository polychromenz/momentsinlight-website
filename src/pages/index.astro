---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import Slideshow from '../components/Slideshow.astro';
import LoveStories from '../components/LoveStories.astro';
import TonyPhoto from '../components/TonyPhoto.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import { site } from '../data/site';
import reviews from '../data/reviews.json';
// The home page's Google title and description, main heading and opening line (editable from the
// studio's Rankings page).
import home from '../data/home.json';

const cf = (path: string) => `https://imagedelivery.net/qzGY-glAlQGHmkVvJZVh0Q/${path}/public`;

const hero = cf('2025-paige-and-connor/colour/_Q9A1313-Edit');

// Opening slideshow: shown whole on a deep olive background, cross-fading every 6 seconds.
// [path, width, height, alt]
const slides: [string, number, number, string][] = [
  [hero, 1500, 1000, 'Bride and groom kissing in front of a large wine barrel'],
  [cf('_from-website/colour/tay-barn-bronze-nzipp-2026-website'), 3000, 1703, 'Tay and Jesse at The Barn, Waimauku'],
  [cf('2026-felicity-and-ronan/colour/_Q9A9733'), 2048, 1365, 'Felicity and Ronan at Settlers Country Manor'],
  [cf('2026-emma-and-corey/colour/_30A4401-Edit'), 2048, 1366, 'Emma and Corey on their wedding day in Hamilton'],
  [cf('2026-tay-and-jesse/colour/_30A8112-Edit'), 2048, 1638, 'Tay and Jesse among the trees at golden hour'],
  [cf('2025-chiedza-and-foster/colour/_30A9554'), 2048, 1366, 'Chiedza and Foster at Abel Estate'],
];

// Where to next: three doors into the site.
const doors = [
  { label: 'Weddings & prices', href: '/weddings', src: cf('_from-website/mono/chanel-bronze-nzipp-2026-website'), w: 3000, h: 2001, alt: 'Black and white wedding photograph' },
  { label: 'Love stories', href: '/wedding-galleries', src: cf('2026-mikaela-and-dylan/colour/_Q9A0978'), w: 2048, h: 1366, alt: 'Mikaela and Dylan at The Barn, Waimauku' },
  { label: 'Your wedding photo guide', href: '/wedding-photo-guide', src: cf('2026-kayla-and-scott/colour/_30A0232'), w: 2048, h: 1366, alt: 'Kayla and Scott on their wedding day in Devonport' },
];

const reviewCount = reviews.reviews.length;
const rating = (reviews.reviews.reduce((t, r) => t + r.rating, 0) / reviewCount).toFixed(1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  telephone: '+64 21 625 943',
  image: hero,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '985a Hibiscus Coast Highway',
    addressLocality: 'Waiwera',
    addressRegion: 'Auckland',
    postalCode: '0994',
    addressCountry: 'NZ',
  },
  areaServed: 'New Zealand',
  founder: { '@type': 'Person', name: site.author },
};
---
<BaseLayout
  title={home.title}
  description={home.description}
  image={hero}
  heroImage={{ src: hero }}
  jsonLd={jsonLd}
>
  <Slideshow
    hero
    first
    label="Wedding photographs"
    interval={6}
    images={slides.map(([src, width, height, alt]) => ({ src, width, height, alt }))}
  >
    {/* One main heading for Google: "Auckland wedding photographer" + the headline, styled as before. */}
    <h1 class="hero-h1"><span class="hero-eyebrow">{home.eyebrow}</span> <span class="hero-title">{home.h1}</span></h1>
  </Slideshow>

  <section class="intro wrap" data-reveal>
    <hr class="hairline" />
    <h2 class="display intro-title">Refined wedding photography, captured naturally</h2>
    <p class="lead">{home.intro}</p>
    <p>My focus is on creating images that feel natural, effortless, and true to you — without over-direction or anything feeling forced. The result is a collection of photographs that not only look beautiful, but feel genuine and lasting over time.</p>
    <p>Based in Auckland, available throughout New Zealand.</p>
    <ul class="proof" data-stagger>
      <li><a href="/testimonials"><span class="stars" aria-hidden="true">★★★★★</span> {rating} from {reviewCount} Google reviews</a></li>
      <li>NZIPP Iris Awards 2026 · Bronze</li>
      <li>Featured in My Wedding Guide</li>
    </ul>
  </section>

  <section class="doors wrap" data-stagger>
    {doors.map((d) => (
      <a class="door" href={d.href}>
        <Img src={d.src} alt={d.alt} width={d.w} height={d.h} sizes="(min-width: 768px) 29vw, 88vw" />
        <span>{d.label}</span>
      </a>
    ))}
  </section>

  <section class="stories-band">
    <div class="wrap inner">
      <div class="band-head" data-reveal>
        <div>
          <p class="eyebrow">Recent weddings</p>
          <h2 class="display">Love stories</h2>
          <p class="sub">Each wedding I photograph is different, shaped by the people, the setting, and the moments that unfold naturally throughout the day. These are real weddings of real couples.</p>
        </div>
        <a class="more" href="/wedding-galleries">All love stories →</a>
      </div>
      <LoveStories />
    </div>
  </section>

  <section class="review">
    <div class="wrap" data-reveal>
      <ReviewCarousel names={['Tayla Johnson', 'Jade McQuoid', 'Leah Doolan', 'Mikaela Ellwood', 'Cerise Brown', 'Josh Stewart', 'Julia Passmore']} />
    </div>
  </section>

  <section class="approach wrap">
    <TonyPhoto />
    <div class="approach-text" data-reveal>
      <p class="eyebrow">Hello, I’m Tony</p>
      <h2 class="display">My approach</h2>
      <p>A calm, unobtrusive approach. I understand that most couples don’t want to feel like they’re on display all day. My role is to create space for you to enjoy your wedding, while quietly documenting everything as it happens. When guidance is needed, I’ll step in with a light touch — enough to help you feel comfortable, but never enough to interrupt the natural flow of the day.</p>
      <p>The focus is always on capturing moments that feel real, relaxed, and timeless.</p>
      <p><a class="btn" href="/a-guide-to-your-wedding-photos">How I work</a></p>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-inner">
      <div class="cta-text" data-reveal>
        <h2 class="display">Let’s talk about your day</h2>
        <p>If you’re planning your wedding and are looking for a photographer who will capture it in a natural, refined way, I’d love to hear about your plans.</p>
        <p><a class="btn btn--light" href="/contact">Check your date</a></p>
      </div>
      <div data-reveal="photo"><Img class="cta-img" src={cf('2026-tay-and-jesse/colour/_30A8106-Edit')} alt="Tay and Jesse at The Barn, Waimauku" width={2048} height={1638} sizes="(min-width: 900px) 44vw, 88vw" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Phone layout first, desktop below. */
  .hero-h1 { margin: 0; padding: 0; font: inherit; color: inherit; }
  .hero-eyebrow { display: block; margin: 0 0 10px; font-size: 12px; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--green); }
  .hero-title {
    display: block;
    margin: 0 auto;
    padding: 0;
    max-width: 1000px;
    color: var(--ink);
    font-size: clamp(28px, 3vw + 12px, 56px);
    font-weight: 300;
    line-height: 1.1;
  }

  .intro { max-width: calc(880px + 2 * var(--pad)); margin: 0 auto; padding-block: 72px 64px; text-align: center; }
  .intro-title { font-size: clamp(26px, 2vw + 16px, 40px); margin: 0 0 22px; }
  .intro .lead { font-size: clamp(19px, 0.6vw + 15px, 24px); font-weight: 300; line-height: 1.55; color: var(--ink); }
  .intro p { color: #444; line-height: 1.8; }
  .proof { list-style: none; margin: 36px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 40px; font-size: 14px; letter-spacing: 0.05em; color: #444; }
  .proof a { color: inherit; text-decoration: none; }

  .doors { display: grid; gap: 36px; padding-bottom: 80px; max-width: 1440px; margin: 0 auto; }
  .door { display: flex; flex-direction: column; gap: 16px; text-decoration: none; color: var(--ink); }
  .door :global(img) { width: 100%; height: auto; border-radius: 32px 0; transition: transform 0.8s var(--ease), box-shadow 0.8s var(--ease); }
  .door span { font-size: 13px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; }

  .stories-band { background: var(--champagne); padding-block: 72px; }
  .inner { max-width: calc(1240px + 2 * var(--pad)); margin: 0 auto; }
  .band-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px; margin-bottom: 40px; }
  .band-head h2 { font-size: clamp(32px, 2.4vw + 18px, 52px); margin: 0 0 14px; }
  .sub { max-width: 620px; color: #555; line-height: 1.7; }
  .more { font-size: 15px; letter-spacing: 0.04em; }

  .review { background: var(--olive); color: var(--champagne); padding-block: 88px; text-align: center; }
  .review .wrap { max-width: calc(1000px + 2 * var(--pad)); margin: 0 auto; }

  .approach { display: grid; gap: 40px; align-items: center; max-width: calc(1180px + 2 * var(--pad)); margin: 0 auto; padding-block: 80px; }
  .approach h2 { font-size: clamp(30px, 2vw + 18px, 46px); margin: 0 0 22px; }
  .approach p { line-height: 1.8; color: #333; }

  .cta { background: var(--green); color: var(--champagne); padding-block: 72px; }
  .cta-inner { display: grid; gap: 40px; align-items: center; max-width: calc(1240px + 2 * var(--pad)); margin: 0 auto; }
  .cta h2 { color: var(--champagne); font-size: clamp(30px, 2.2vw + 18px, 50px); margin: 0 0 20px; }
  .cta p { color: var(--cream); line-height: 1.75; }
  .cta :global(.cta-img) { width: 100%; height: auto; border-radius: 48px 0; }

  @media (hover: hover) {
    .door:hover { opacity: 1; }
    .door:hover :global(img) { transform: translateY(-4px); box-shadow: 0 18px 30px -22px rgb(0 0 0 / 0.45); }
  }

  @media (min-width: 768px) {
    .hero-eyebrow { font-size: 13px; margin-bottom: 16px; color: var(--white); }
    /* Over the photo: sized to the photo's width (the caption is a size container). */
    .hero-title { color: var(--white); font-size: clamp(22px, 5.4cqi, 60px); }
    .intro { padding-block: 120px 100px; }
    .doors { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; padding-bottom: 120px; align-items: start; }
    .door:nth-child(2) { margin-top: 64px; }
    .stories-band { padding-block: 110px; }
    .review { padding-block: 130px; }
    .approach { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 80px; padding-block: 130px; }
  }
  @media (min-width: 900px) {
    .cta { padding-block: 100px; }
    .cta-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .door :global(img) { transition: none; }
    .door:hover :global(img) { transform: none; }
  }
</style>

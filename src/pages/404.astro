---
// "Page not found". Cloudflare Pages serves this with a real 404 status for any address
// that doesn't exist (without it, Cloudflare would show the home page instead).
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Moments In Light" description="Sorry, that page can't be found.">
  <section class="not-found wrap">
    <h1>Sorry, that page can’t be found</h1>
    <p>It may have moved, or the link might have a small typo. These might help:</p>
    <ul>
      <li><a href="/weddings">Wedding photography</a></li>
      <li><a href="/wedding-galleries">Real wedding galleries</a></li>
      <li><a href="/portraits">Portraits</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul>
    <p><a class="btn" href="/">Back to the home page</a></p>
  </section>
</BaseLayout>

<style>
  .not-found { padding-block: clamp(40px, 8vw, 110px); max-width: calc(760px + 2 * var(--pad)); }
  ul { padding-left: 1.2em; margin: 0 0 30px; }
  li { margin-bottom: 0.4em; }
</style>

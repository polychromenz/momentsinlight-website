---
// /blog/tag/tui-hills etc. — same addresses as the live site.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogList from '../../../components/BlogList.astro';
import { sortedPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout
  title={`${tag} — Blog — Moments In Light`}
  description={`Posts tagged ${tag} from Moments In Light, Auckland wedding and portrait photographer.`}
  background="alt"
>
  <BlogList posts={posts} />
</BaseLayout>

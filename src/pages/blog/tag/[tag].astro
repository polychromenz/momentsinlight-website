---
// /blog/tag/tui-hills etc. — same addresses as the live site.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogList from '../../../components/BlogList.astro';
import { sortedPosts } from '../../../lib/blog';
import { venues } from '../../../data/venues';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
// Venue tags show the venue's name; other tags read as words ("winter-weddings" -> "Winter weddings").
const venue = venues.find((v) => v.tag === tag);
const words = tag!.replace(/-/g, ' ');
const heading = venue?.name ?? words[0].toUpperCase() + words.slice(1);
---
<BaseLayout
  title={venue ? `${venue.name} Weddings | Moments In Light` : `${heading} | Moments In Light Blog`}
  description={venue ? `Real weddings at ${venue.name} photographed by Auckland wedding photographer Tony Gorham, with the venue’s best spots and moments.` : `${heading}: stories and photos from Moments In Light, Auckland wedding and portrait photographer Tony Gorham.`}
>
  <BlogList posts={posts} heading={heading} eyebrow={venue ? 'Love stories at' : 'Journal'} />
</BaseLayout>

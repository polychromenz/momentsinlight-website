---
// A couple's private quote (/quote?t=…, the link in their "Quote ready" email), laid out like
// Tony's Studio Ninja quotes: quote number and date, from and to, the packages to choose from,
// extras, a summary (subtotal, GST, total), the payment schedule with dates, and notes. They
// choose, type their name and accept; they can also save it as a PDF or print it.
// Hidden from Google; the data comes from functions/api/quote.js (text already cleaned there).
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Your quote | Moments In Light" description="Your wedding photography quote from Moments in Light." noindex>
  <main class="quote-page">
    <p class="q-status" aria-live="polite">Loading your quote…</p>
    <div class="q" hidden>
      <header class="q-head">
        <p class="eyebrow q-eyebrow"></p>
        <h1 class="display q-title"></h1>
        <hr class="hairline" />
        <div class="q-intro"></div>
      </header>

      <section class="q-card q-meta">
        <div><h2>Quote</h2><dl><dt>Quote</dt><dd class="m-number"></dd><dt>Issued</dt><dd class="m-issued"></dd><dt>Valid until</dt><dd class="m-valid"></dd></dl></div>
        <div><h2>From</h2><p class="m-from"></p></div>
        <div><h2>For</h2><p class="m-client"></p></div>
      </section>

      <h2 class="q-section">Choose your package</h2>
      <section class="q-packages" aria-label="Packages"></section>
      <section class="q-card q-extras" hidden><h2>Add extras</h2><div class="q-extras-list"></div></section>

      <section class="q-card q-summary">
        <h2>Quote summary</h2>
        <table class="q-lines"><tbody></tbody></table>
        <table class="q-totals"><tbody></tbody></table>
      </section>

      <section class="q-card">
        <h2>Payment schedule</h2>
        <table class="q-plan"><thead><tr><th>Payment</th><th>Due</th><th>Amount</th></tr></thead><tbody></tbody></table>
      </section>

      <section class="q-card q-notes-card" hidden><h2>Notes</h2><div class="q-notes"></div></section>

      <form class="q-card q-accept" novalidate>
        <h2>Ready to go ahead?</h2>
        <p>Add your name and postal address, then click Accept. Next, I'll send your contract to sign and your deposit invoice.</p>
        <label>Your full name<input name="name" autocomplete="name" required /></label>
        <label>Your postal address<textarea name="address" rows="3" autocomplete="street-address" required placeholder="Street, suburb, town and postcode"></textarea></label>
        <label>Your phone number <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
        <p class="q-msg" role="alert" hidden></p>
        <div class="q-buttons"><button class="btn" type="submit">Accept quote</button><button class="btn btn--outline" type="button" data-print>Save as PDF / print</button></div>
      </form>

      <div class="q-card q-done" hidden tabindex="-1">
        <h2>Thank you, it's accepted!</h2>
        <p class="q-done-text"></p>
        <div class="q-buttons"><button class="btn btn--outline" type="button" data-print>Save as PDF / print</button></div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  type Pkg = { name: string; subtitle: string; price: number; description: string; recommended: boolean };
  type Extra = { name: string; price: number; description: string };
  type Part = { percent: number; label: string; when: string; days?: number; months?: number };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (c: number) => `$${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const short = (c: number) => `$${(c / 100).toLocaleString('en-NZ', { minimumFractionDigits: c % 100 ? 2 : 0, maximumFractionDigits: 2 })}`;
  const long = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const params = new URLSearchParams(location.search);
  const token = params.get('t') || '';
  const preview = params.has('preview');
  let q: { status: string; packages: Pkg[]; extras: Extra[]; discount: number; discount_label: string; schedule: Part[]; event_date: string | null; today: string; [k: string]: any };
  let chosen = -1;
  const extras = new Set<number>();

  const addDays = (d: string, n: number) => { const x = new Date(`${d}T12:00:00Z`); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };
  const addMonths = (d: string, n: number) => { const x = new Date(`${d}T12:00:00Z`); x.setUTCMonth(x.getUTCMonth() + n); return x.toISOString().slice(0, 10); };
  const subtotal = () => (chosen < 0 ? null : q.packages[chosen].price + [...extras].reduce((a, i) => a + q.extras[i].price, 0));
  const total = () => { const s = subtotal(); return s === null ? null : Math.max(0, s - (q.discount || 0)); };

  function update() {
    document.querySelectorAll<HTMLElement>('.pkg').forEach((el, i) => {
      el.classList.toggle('on', i === chosen);
      const b = el.querySelector<HTMLButtonElement>('button')!;
      b.setAttribute('aria-pressed', String(i === chosen));
      b.textContent = i === chosen ? '✓ Chosen' : 'Choose this package';
    });
    const t = total();
    const lines = chosen < 0 ? [] : [[q.packages[chosen].name + (q.packages[chosen].subtitle ? ` (${q.packages[chosen].subtitle})` : ''), q.packages[chosen].price], ...[...extras].map((i) => [q.extras[i].name, q.extras[i].price])];
    $('.q-lines tbody').innerHTML = lines.length ? lines.map(([n, p]) => `<tr><td>${esc(n)}</td><td>${money(p as number)}</td></tr>`).join('') : '<tr><td>Choose a package above.</td><td></td></tr>';
    $('.q-totals tbody').innerHTML = t === null ? '' : [
      ...(q.discount ? [[`${esc(q.discount_label || 'Discount')}`, `−${money(q.discount)}`]] : []),
      ['GST (15%, included)', money(Math.round((t * 3) / 23))],
      [`<strong>Total</strong>`, `<strong>${money(t)}</strong>`],
    ].map(([a, b]) => `<tr><td>${a}</td><td>${b}</td></tr>`).join('');
    const from = q.accepted_at ? q.accepted_at.slice(0, 10) : q.today;
    let left = t ?? 0;
    $('.q-plan tbody').innerHTML = t === null ? '<tr><td colspan="3">Choose a package to see your payments.</td></tr>' : q.schedule.map((p, i) => {
      const amount = i === q.schedule.length - 1 ? left : Math.round((t * p.percent) / 100);
      left -= amount;
      let due = from;
      if (p.when === 'accept') due = addDays(from, p.days || 0);
      else if (q.event_date) due = p.months ? addMonths(q.event_date, (p.when === 'before' ? -1 : 1) * p.months) : addDays(q.event_date, (p.when === 'before' ? -1 : 1) * (p.days || 0));
      const passed = due < from;
      if (passed) due = from;
      const when = due === from ? (q.status === 'accepted' ? long(due) : passed ? 'When you accept (the usual date has passed)' : 'When you accept') : long(due);
      return `<tr><td>${esc(p.label)} (${p.percent}%)</td><td>${when}</td><td>${money(amount)}</td></tr>`;
    }).join('');
  }

  async function load() {
    const r = await fetch(`/api/quote?t=${encodeURIComponent(token)}${preview ? '&preview=1' : ''}`);
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { $('.q-status').textContent = d.error || 'This quote isn’t available.'; return; }
    q = d;
    document.title = `Quote ${q.number} | Moments In Light`;
    $('.q-eyebrow').textContent = [q.event_date_long, q.venue].filter(Boolean).join(' · ');
    $('.q-title').textContent = `A quote for ${q.names}`;
    $('.q-intro').innerHTML = q.intro; // cleaned on the server
    $('.m-number').textContent = q.number;
    $('.m-issued').textContent = q.issued;
    $('.m-valid').textContent = q.valid_until_long || '–';
    $('.m-from').innerHTML = [`<strong>${esc(q.from.name)}</strong>`, esc(q.from.person), esc(q.from.phone), `<a href="mailto:${esc(q.from.email)}">${esc(q.from.email)}</a>`, esc(q.from.address)].join('<br>');
    $('.m-client').innerHTML = [`<strong>${esc(q.client.name)}</strong>`, esc(q.client.email), q.client.address && esc(q.client.address).replace(/\n/g, '<br>'), q.event_date_long && `Wedding: ${esc(q.event_date_long)}`, q.venue && esc(q.venue)].filter(Boolean).join('<br>');
    $('.q-packages').innerHTML = q.packages.map((p, i) => `<article class="pkg${p.recommended ? ' rec' : ''}">
      ${p.recommended ? '<span class="pkg-badge">♥ Recommended</span>' : ''}
      <h3>${esc(p.name)}</h3>${p.subtitle ? `<p class="pkg-sub">${esc(p.subtitle)}</p>` : ''}
      <p class="pkg-price">${short(p.price)}<small> incl. GST</small></p>
      <div class="pkg-desc">${p.description}</div>
      <button type="button" class="btn${p.recommended ? '' : ' btn--outline'}" data-pkg="${i}" aria-pressed="false">Choose this package</button>
    </article>`).join('');
    $('.q-extras').hidden = !q.extras.length;
    $('.q-extras-list').innerHTML = q.extras.map((x, i) => `<label class="extra"><input type="checkbox" data-extra="${i}" /> <span><strong>${esc(x.name)}</strong> ${short(x.price)}${x.description ? `<small>${esc(x.description)}</small>` : ''}</span></label>`).join('');
    $('.q-notes').innerHTML = q.notes || '';
    $('.q-notes-card').hidden = !q.notes;
    if (q.status === 'accepted') {
      chosen = q.chosen_package; (q.chosen_extras || []).forEach((i: number) => extras.add(i));
      $('.q-accept').hidden = true;
      $('.q-done').hidden = false;
      $('.q-done-text').textContent = `Accepted by ${q.accepted_name} on ${new Date(q.accepted_at).toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' })}. Thank you! I'll be in touch with your contract and deposit invoice.`;
      document.querySelectorAll<HTMLInputElement>('[data-pkg], [data-extra]').forEach((b) => (b.disabled = true));
    } else if (q.status === 'expired') {
      $('.q-accept').innerHTML = '<h2>This quote has expired</h2><p>Please get in touch for an updated quote. I’d love to hear from you.</p><p><a class="btn" href="/contact">Get in touch</a></p>';
    } else {
      chosen = Math.max(0, q.packages.findIndex((p) => p.recommended));
    }
    if (preview) { const b = $<HTMLButtonElement>('.q-accept button[type="submit"]'); if (b) { b.disabled = true; b.textContent = 'Accept (preview only)'; } }
    update();
    $('.q').hidden = false;
    $('.q-status').hidden = true;
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-print]')) { print(); return; }
    const b = t.closest<HTMLButtonElement>('[data-pkg]');
    if (b && q.status !== 'accepted') { chosen = Number(b.dataset.pkg); update(); }
  });
  document.addEventListener('change', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLInputElement>('[data-extra]');
    if (c) { c.checked ? extras.add(Number(c.dataset.extra)) : extras.delete(Number(c.dataset.extra)); update(); }
  });
  $<HTMLFormElement>('.q-accept').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (preview) return;
    const msg = $('.q-msg');
    const name = ($<HTMLInputElement>('.q-accept input[name="name"]')).value.trim();
    if (chosen < 0) { msg.textContent = 'Please choose a package.'; msg.hidden = false; return; }
    if (name.length < 2) { msg.textContent = 'Please type your full name.'; msg.hidden = false; return; }
    const address = ($<HTMLTextAreaElement>('.q-accept textarea[name="address"]')).value.trim();
    const phone = ($<HTMLInputElement>('.q-accept input[name="phone"]')).value.trim();
    if (address.length < 8) { msg.textContent = 'Please add your postal address.'; msg.hidden = false; return; }
    const btn = $<HTMLButtonElement>('.q-accept button[type="submit"]');
    btn.disabled = true; btn.textContent = 'Accepting…'; msg.hidden = true;
    const r = await fetch('/api/quote', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ t: token, package: chosen, extras: [...extras], name, address, phone }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { msg.textContent = d.error || 'Something went wrong. Please try again.'; msg.hidden = false; btn.disabled = false; btn.textContent = 'Accept quote'; return; }
    await load();
    $('.q-done').focus();
  });
  if (token) load(); else $('.q-status').textContent = 'This quote link isn’t complete. Please use the link in your email.';
</script>

<style>
  .quote-page { background: var(--champagne); padding: 48px var(--pad) 90px; min-height: 60vh; }
  .q-status { text-align: center; color: #666; }
  .q { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }
  .q-head { max-width: 760px; margin: 0 auto 8px; text-align: center; }
  .q-title { font-size: clamp(32px, 2.6vw + 18px, 54px); margin: 0 0 20px; padding: 0; }
  .q-intro { color: #444; line-height: 1.8; margin-top: 20px; }
  .q-intro :global(p), .q-notes :global(p) { margin: 0 0 10px; }
  .q-card { background: var(--white); border-radius: 28px 0; padding: 24px 26px; }
  .q-card h2, .q-section { margin: 0 0 12px; font-weight: 300; font-size: 22px; color: var(--ink); }
  .q-section { text-align: center; margin: 12px 0 0; font-size: 26px; }
  .q-meta { display: grid; gap: 20px; font-size: 14px; color: #444; line-height: 1.7; }
  .q-meta h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); margin-bottom: 6px; }
  .q-meta p { margin: 0; }
  .q-meta dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; margin: 0; }
  .q-meta dt { color: #777; }
  .q-meta dd { margin: 0; }
  .q-packages { display: grid; gap: 22px; }
  .q-packages :global(.pkg) { position: relative; display: flex; flex-direction: column; background: var(--white); border: 2px solid transparent; border-radius: 40px 0; padding: 34px 30px 30px; transition: border-color 0.4s var(--ease), border-radius 0.6s var(--ease), box-shadow 0.6s var(--ease); }
  .q-packages :global(.pkg.on) { border-color: var(--green); border-radius: 0 40px; box-shadow: 0 22px 40px -30px rgb(62 66 41 / 0.6); }
  .q-packages :global(.pkg-badge) { position: absolute; top: -12px; left: 30px; background: var(--green); color: var(--white); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; padding: 5px 12px; border-radius: 10px 0; }
  .q-packages :global(h3) { margin: 0; font-weight: 300; font-size: 28px; color: var(--ink); }
  .q-packages :global(.pkg-sub) { margin: 4px 0 0; font-size: 12px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green); }
  .q-packages :global(.pkg-price) { margin: 16px 0 6px; font-size: 34px; font-weight: 300; color: var(--ink); }
  .q-packages :global(.pkg-price small) { font-size: 14px; color: #777; }
  .q-packages :global(.pkg-desc) { flex: 1; color: #444; font-size: 15px; line-height: 1.7; }
  .q-packages :global(.pkg-desc ul) { padding-left: 18px; }
  .q-packages :global(.pkg-desc li) { margin-bottom: 8px; }
  .q-packages :global(.pkg-desc li p), .q-packages :global(.pkg-desc p) { margin: 0 0 8px; }
  .q-packages :global(.pkg-desc h3) { font-size: 11px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--green); margin: 14px 0 4px; }
  .q-packages :global(.pkg .btn) { align-self: flex-start; margin-top: 14px; }
  .q-packages :global(.pkg.on .btn) { background: var(--green); color: var(--white); border-color: var(--green); }
  .q-extras :global(.extra) { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; }
  .q-extras :global(.extra small) { display: block; color: #777; }
  .q table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .q th { text-align: left; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #777; padding: 8px 0; border-bottom: 1px solid #eee6d9; }
  .q td { padding: 10px 0; border-bottom: 1px solid #f3eee6; color: #333; }
  .q th:last-child, .q :global(td:last-child) { text-align: right; }
  .q-plan th:nth-child(2), .q-plan :global(td:nth-child(2)) { color: #555; }
  .q-totals { max-width: 360px; margin-left: auto; margin-top: 8px; }
  .q-totals :global(td) { border-bottom: 0; padding: 4px 0; }
  .q-totals :global(tr:last-child td) { font-size: 20px; border-top: 1px solid #eee6d9; padding-top: 10px; }
  .q-notes { color: #555; font-size: 14px; line-height: 1.7; }
  .q-accept, .q-done { display: flex; flex-direction: column; gap: 12px; }
  .q-accept p { margin: 0; color: #444; line-height: 1.7; }
  .q-accept label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; max-width: 420px; }
  .q-accept .opt { font-weight: 400; color: #888; }
  .q-accept textarea { font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #ddd3c4; border-radius: 14px 0; resize: vertical; }
  .q-accept input { font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #ddd3c4; border-radius: 14px 0; }
  .q-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
  .q-msg { padding: 10px 14px; background: #fbeee8; color: #8a3b1e; border-radius: 12px 0; }
  .q-accept[hidden], .q-done[hidden], .q-extras[hidden], .q-notes-card[hidden] { display: none; }
  .q-done h2 { margin: 0; font-weight: 300; font-size: 30px; color: var(--ink); }
  .q-done p { margin: 0; color: #444; }
  @media (min-width: 800px) {
    .q-packages { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
    .q-meta { grid-template-columns: 1fr 1fr 1fr; }
  }
  /* Save as PDF / print: just the quote, on white. */
  @media print {
    :global(header), :global(footer), :global(nav), :global(.announcement), .q-buttons, .q-accept label, .q-accept > p:not(.q-valid), .pkg .btn { display: none !important; }
    .quote-page { background: #fff; padding: 0; }
    .q-card, .q-packages :global(.pkg) { box-shadow: none !important; border: 1px solid #ddd; break-inside: avoid; }
    .q-packages :global(.pkg:not(.on)) { opacity: 0.6; }
  }
</style>
